import { getHttpConfig } from './config.uts'

export type HttpMethod = 'GET' | 'POST' | 'PUT' | 'DELETE'

interface RequestOptions {
  url: string
  method?: HttpMethod
  data?: any
  header?: Record<string, string>
  showLoading?: boolean
}

function withBaseURL(url: string): string {
  if (/^https?:\/\//i.test(url)) return url
  const { baseURL } = getHttpConfig()
  return `${baseURL.replace(/\/$/, '')}/${url.replace(/^\//, '')}`
}

export function request<T = any>(opts: RequestOptions): Promise<T> {
  const { url, method = 'GET', data, header = {}, showLoading = false } = opts
  const fullUrl = withBaseURL(url)
  const token = 'dXNlcjoyODY0Y2Q0MC01M2JkLTQxZmYtYTY2Yi0xY2NmMDA0OGUwZTY='
  const finalHeader: Record<string, string> = {
    'Content-Type': 'application/json',
    ...header,
  }
  finalHeader['Authorization'] = `Bearer ${token}`
  if (showLoading) uni.showLoading({ title: '加载中', mask: true })
  const { timeout } = getHttpConfig()
  return new Promise<T>((resolve, reject) => {
    uni.request({
      url: fullUrl,
      method: method as any,
      data,
      header: finalHeader,
      timeout,
      success: (res) => {
        const status = res.statusCode || 0
        if (status >= 200 && status < 300) {
          resolve(res.data as T)
        } else {
          reject(new Error(`请求失败: ${status}`))
        }
      },
      fail: (err) => reject(err),
      complete: () => { if (showLoading) uni.hideLoading() }
    })
  })
}

export function get<T = any>(url: string, params?: any, options?: Omit<RequestOptions, 'url' | 'method' | 'data'>): Promise<T> {
  return request<T>({ url, method: 'GET', data: params, ...(options || {}) })
}

export function post<T = any>(url: string, data?: any, options?: Omit<RequestOptions, 'url' | 'method' | 'data'>): Promise<T> {
  return request<T>({ url, method: 'POST', data, ...(options || {}) })
}
