import { request } from './http.uts'

// 导航栏接口
export const getImage = async (method: string, params?: any) => {
	const res = await request({
		url: '/wechat/carousels',
		method: (method || 'GET').toUpperCase() as any,
		data: params,
		showLoading: false,
	})
	return res
}

// 客片一级接口 — 已废弃，请使用 getCategories + getAlbumList
export const getalbum = async (method: string, params?: any) => {
	const res = await request({
		url: '/wechat/album',
		method: (method || 'GET').toUpperCase() as any,
		data: params,
		showLoading: false,
	})
	return res
}

// 获取客片分类
export const getCategories = async (shopId) => {
	const res = await request({
		url: '/wechat/categories',
		method: 'GET',
		data: { shopId },
		showLoading: false,
	})
	return res
}

// 获取客片列表（支持分页 + 搜索）
export const getAlbumList = async (params) => {
	const res = await request({
		url: '/wechat/albums',
		method: 'GET',
		data: params,
		showLoading: false,
	})
	return res
}

// 客片详情页接口
export const getalbumDetail = async (method: string, params?: any) => {
	const res = await request({
		url: '/wechat/album/detail',
		method: (method || 'GET').toUpperCase() as any,
		data: params,
		showLoading: false,
	})
	return res
}