{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["@dcloudio/types"],
    // Wot UI 2.3.2 以 .ts 源码分发（无独立 .d.ts），其内部 import 写法不满足
    // @vue/tsconfig 的 importsNotUsedAsValues=error；vue-tsc 会跟进 node_modules 内
    // .ts 源文件（skipLibCheck 只覆盖 .d.ts）⇒ 本工程降为 remove（TS 默认行为）。
    // 记录：migration-preflight §8.9（2026-09-17）。
    "importsNotUsedAsValues": "remove"
  },
  // 2026-10-13（CR ② 收口）：测试的 type-check 走**独立配置** `tsconfig.tests.json`（见 `npm run type-check`），
  // 避免把测试的宽松打桩口径强加到业务源码的严格档上；本文件保持「只管 src」。
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}
