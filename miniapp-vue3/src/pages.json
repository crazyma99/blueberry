{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
		}
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				// #ifdef MP-WEIXIN
				"navigationStyle": "custom",
				// #endif
				"navigationBarTitleText": "蓝梅旅拍"
			}
		},
		{
			"path": "pages/demoDetail/index",
			"style": {
				// #ifdef MP-WEIXIN
				"navigationStyle": "custom",
				// #endif
				"navigationBarTitleText": "客片列表"
			}
		},
		{
			"path": "pages/targetPhotoDetail/index",
			"style": {
				// #ifdef MP-WEIXIN
				"navigationStyle": "custom",
				// #endif
				"navigationBarTitleText": "客片详情"
			}
		},
		{
			"path": "pages/priceHomePage/index",
			"style": {
				// #ifdef MP-WEIXIN
				"navigationStyle": "custom",
				// #endif
				"navigationBarTitleText": "价目表"
			}
		},
		{
			"path": "pages/priceList/index",
			"style": {
				// #ifdef MP-WEIXIN
				"navigationStyle": "custom",
				// #endif
				"navigationBarTitleText": "价目表"
			}
		},
		{
			"path": "pages/mine/index",
			"style": {
				// #ifdef MP-WEIXIN
				"navigationStyle": "custom",
				// #endif
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/favorites/index",
			"style": {
				// #ifdef MP-WEIXIN
				"navigationStyle": "custom",
				// #endif
				"navigationBarTitleText": "我的收藏"
			}
		},
		{
			"path": "pages/brandHub/index",
			"style": {
				// #ifdef MP-WEIXIN
				"navigationStyle": "custom",
				// #endif
				"navigationBarTitleText": "品牌馆"
			}
		},
		{
			"path": "pages/webview/index",
			"style": {
				// #ifdef MP-WEIXIN
				"navigationStyle": "custom",
				// #endif
				"navigationBarTitleText": "详情"
			}
		},
		// #ifdef MP-WEIXIN
		{
			"path": "pages/aiTryOn/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "AI试衣"
			}
		},
		// AI 闭环 6 页（T8/T9b）仅微信侧注册——2026-09-17 主人拍板「抖音不注册 AI 六页」
		{
			"path": "pages/aiTryOnHistory/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "AI试衣记录"
			}
		},
		// 结果页：旧端 pages.json 仅注册 path（可见标题由 CustomNavBar 动态渲染「正在生成 → AI试衣结果」），
		// 新端按 AI 批次口径补 navigationStyle custom；navigationBarTitleText 取页面自身标题
		{
			"path": "pages/aiTryOnResult/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "AI试衣结果"
			}
		},
		// #endif
		{
			"path": "pages/_probe/wot-sample",
			"style": {
				"navigationBarTitleText": "Wot 资格样页"
			}
		},
		{
			"path": "pages/policies/user",
			"style": {
				"navigationBarTitleText": "用户协议"
			}
		},
		{
			"path": "pages/policies/privacy",
			"style": {
				"navigationBarTitleText": "隐私政策"
			}
		}
	],
	"tabBar": {
		// #ifdef MP-WEIXIN
		"custom": true,
		// #endif
		"color": "#F1CD91",
		"selectedColor": "#F1CD91",
		"backgroundColor": "#160F04",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/index/index",
				"iconPath": "static/home-bar.png",
				"selectedIconPath": "static/home-bar.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/priceHomePage/index",
				"iconPath": "static/price-bar.png",
				"selectedIconPath": "static/price-bar.png",
				"text": "价目表"
			},
			{
				"pagePath": "pages/mine/index",
				"iconPath": "static/my-bar.png",
				"selectedIconPath": "static/my-bar.png",
				"text": "我的"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	}
}
