<template>
  <view class="container">
    <!-- Loading 骨架屏 -->
    <view v-if="loading" class="sk-container" style="padding-top: 64rpx;">
      <view class="sk-row" style="margin-bottom: 40rpx;">
        <view class="sk-avatar sk-animate"></view>
        <view class="sk-text sk-animate" style="width: 200rpx; margin-left: 24rpx;"></view>
      </view>
      <view class="sk-menu sk-animate"></view>
      <view class="sk-banner sk-animate" style="border-radius: 16rpx;"></view>
    </view>

    <!-- 主内容 -->
    <view v-else class="content">
      <!-- 用户区域 -->
      <view class="user-section" @click="handleUserClick">
        <image
          class="avatar"
          :src="isLoggedIn ? (userInfo?.avatarUrl || defaultAvatar) : defaultAvatar"
          mode="aspectFill"
        ></image>
        <view class="user-info">
          <view class="nickname">
            {{ isLoggedIn ? (userInfo?.nickname || '微信用户') : '点击立即登陆' }}
          </view>
        </view>
      </view>

      <!-- 金刚区 -->
      <view class="menu-section">
        <view
          v-for="(item, index) in menuItems"
          :key="index"
          class="menu-item"
          @click="handleMenuClick(item)"
        >
          <image class="menu-icon" :src="item.imageUrl" mode="aspectFill"></image>
          <view class="menu-text">{{ item.title }}</view>
        </view>
      </view>

      <!-- 轮播图 Banner -->
      <view class="banner-section">
        <swiper
          class="banner-swiper"
          autoplay
          circular
          :interval="5000"
          :duration="500"
          indicator-dots
          indicator-color="rgba(255, 255, 255, 0.35)"
          indicator-active-color="#fff"
        >
          <swiper-item v-for="(banner, index) in banners" :key="index">
            <image
              class="banner-image"
              :src="banner.imageUrl"
              mode="aspectFill"
              @click="handleBannerClick(banner)"
            ></image>
          </swiper-item>
        </swiper>
      </view>
    </view>

    <!-- 登录弹窗 -->
    <view v-if="showLoginPopup" class="login-overlay" @click="closeLoginPopup">
      <view class="login-popup" @click.stop>
        <view class="login-popup-title">登录蓝梅</view>
        <view class="login-popup-desc">授权手机号以获得完整体验</view>
        <button
          class="login-phone-btn"
          open-type="getPhoneNumber"
          @getphonenumber="onGetPhoneNumber"
        >手机号快捷登录</button>
        <view class="login-cancel" @click="closeLoginPopup">暂不登录</view>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { isLoggedIn, getUserInfo, loginSuccess, logout } from '../../utils/auth.uts'
import { wxLogin, wxBindPhone, getPageConfig } from '../../utils/api.uts'

interface UserInfo {
  id: number
  openid: string
  phone: string | null
  nickname: string | null
  avatarUrl: string | null
}

export default {
  data() {
    return {
      loading: true,
      userInfo: null as UserInfo | null,
      isLoggedIn: false,
      banners: [] as any[],
      menuItems: [] as any[],
      defaultAvatar: '/static/default-avatar.png',
      showLoginPopup: false
    }
  },

  async onLoad() {
    await this.loadData()
  },

  async onShow() {
    // 页面显示时刷新登录状态（仅更新UI，不触发登录流程）
    this.updateLoginState()
  },

  methods: {
    // 加载页面数据
    async loadData() {
      try {
        this.loading = true

        // 更新登录状态
        this.updateLoginState()

        // 获取中台页配置（金刚区 + Banner）
        const configRes = await getPageConfig()
        if (configRes.code === 200 && configRes.data) {
          const configMenus = configRes.data.filter(item => item.type === 'icon_grid')[0].items || []
          this.menuItems = [...this.getDefaultMenuItems(), ...configMenus]
          this.banners = configRes.data.filter(item => item.type === 'banner')[0].items || []
        }
        // 金刚区为空时，设置默认入口
        if (this.menuItems.length === 0) {
          this.menuItems = this.getDefaultMenuItems()
        }
      } catch (err) {
        console.error('加载数据失败:', err)
        // 拉取失败，使用默认金刚区
        this.menuItems = this.getDefaultMenuItems()
      } finally {
        this.loading = false
      }
    },

    // 默认金刚区入口
    getDefaultMenuItems() {
      return [
        { title: '我的喜欢', imageUrl: '/static/liked.svg', linkUrl: '/pages/favorites/index', needLogin: true }
      ]
    },

    // 更新登录状态
    updateLoginState() {
      this.isLoggedIn = isLoggedIn()
      this.userInfo = getUserInfo()
    },

    // 处理用户区域点击
    handleUserClick() {
      if (!this.isLoggedIn) {
        // 未登录，显示登录弹窗
        this.showLoginPopup = true
      }
    },

    // 关闭登录弹窗
    closeLoginPopup() {
      this.showLoginPopup = false
    },

    // 手机号授权回调
    async onGetPhoneNumber(e: any) {
      const detail = e.detail || {}

      // 用户拒绝授权
      if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
        if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
          uni.showToast({ title: '已取消授权', icon: 'none' })
        } else {
          console.error('手机号授权失败:', detail.errMsg)
          uni.showToast({ title: '授权失败，请重试', icon: 'none' })
        }
        return
      }

      const phoneCode = detail.code
      if (!phoneCode) {
        console.error('未获取到 phoneCode，detail:', JSON.stringify(detail))
        uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
        return
      }

      try {
        uni.showLoading({ title: '登录中...', mask: true })

        // 第一步：静默登录获取 wx code
        const loginRes = await uni.login({ provider: 'weixin' })
        if (!loginRes.code) {
          uni.hideLoading()
          uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
          return
        }

        // 第二步：wx code 换 token
        const wxRes = await wxLogin({ code: loginRes.code })
        if (wxRes.code === 200 && wxRes.data) {
          loginSuccess(wxRes.data.token, wxRes.data.userInfo)
        } else {
          uni.hideLoading()
          uni.showToast({ title: wxRes.message || '登录失败', icon: 'none' })
          return
        }

        // 第三步：用 phoneCode 绑定手机号
        const phoneRes = await wxBindPhone(phoneCode)
        if (phoneRes.code === 200 && phoneRes.data) {
          // 更新本地用户信息（含手机号）
          const { setUserInfo } = await import('../../utils/auth.uts')
          setUserInfo(phoneRes.data)
        }

        // 完成
        this.showLoginPopup = false
        this.updateLoginState()
        uni.hideLoading()
        uni.showToast({ title: '登录成功', icon: 'success' })
      } catch (err) {
        console.error('手机号登录失败:', err)
        uni.hideLoading()
        uni.showToast({ title: '登录失败，请重试', icon: 'none' })
      }
    },

    // 判断是否为外部链接
    isExternalUrl(url: string): boolean {
      return url.startsWith('http://') || url.startsWith('https://')
    },

    // 统一跳转方法：自动区分内部路径和外部链接
    navigateToUrl(url: string) {
      if (this.isExternalUrl(url)) {
        uni.navigateTo({
          url: `/pages/webview/index?url=${encodeURIComponent(url)}`
        })
      } else {
        uni.navigateTo({
          url: url
        })
      }
    },

    // 处理金刚区点击
    handleMenuClick(item: any) {
      if (item.linkUrl) {
        // 需要登录的页面，先判断登录态
        if (item.needLogin && !isLoggedIn()) {
          this.showLoginPopup = true
          return
        }
        this.navigateToUrl(item.linkUrl)
      } else {
        uni.showToast({
          title: '功能开发中',
          icon: 'none'
        })
      }
    },

    // 处理 Banner 点击
    handleBannerClick(banner: any) {
      if (banner.link) {
        this.navigateToUrl(banner.link)
      }
    }
  }
}
</script>

<style>
.container {
  background: #000;
  min-height: 100vh;
  color: #fff;
}

.content {
  padding-bottom: 32rpx;
}

/* 用户区域 */
.user-section {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 32rpx 0;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #333;
}

.user-info {
  margin-left: 32rpx;
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 1);
}

/* 金刚区 */
.menu-section {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 32rpx 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  margin: 32rpx 32rpx;
  gap: 60rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  margin-bottom: 16rpx;
}

.menu-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  font-weight: 500;
}

/* 轮播图 */
.banner-section {
  margin: 0 32rpx;
}

.banner-swiper {
  width: 100%;
  height: 352rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

</style>
