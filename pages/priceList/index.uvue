<template>
	<view class="page">
		<!-- 顶部轮播图 -->
		<swiper class="banner" autoplay circular :interval="3000" :duration="500" indicator-dots
			indicator-color="rgba(255, 255, 255, 0.35)" indicator-active-color="#fff">
			<swiper-item v-for="(item, idx) in banners" :key="idx">
				<image class="banner-image" :src="item.imageUrl" mode="aspectFill"></image>
			</swiper-item>
		</swiper>
		<image :class="id === '2' ? 'price' : 'honghe-price'" :src="getPriceBg"></image>
		<view class="divide"></view>
		<view class="bottomdesc">Copyright 2025 蓝梅旗袍·汉服·民族服体验馆 - 版权所有</view>
	</view>
</template>

<script>
	import { getImage } from '../../utils/api'
	export default {
		data() {
			return {
				id: '',
				// 轮播图图片列表
				banners: []
			}
		},
		onLoad(query) {
			const id = query.idx ?? ''
			this.id = id
			id === '1'
			?
			  uni.setNavigationBarTitle({ title: '红河水乡店价目表' })
			:
			  uni.setNavigationBarTitle({ title: '太平湖店价目表' })
			this.getBanner(id)
		},
		computed: {
			getPriceBg() {
				return this.id === '1' ? '/static/honghe-price.png': '/static/price.png'
			}
		},
		methods: {
			async getBanner (id: string) {
				try {
					const res = await getImage('get', {
						type: id, // 首页轮播图
					})
					console.log('carousel api result:', res)
					const { code, data } = res
					if (code !== 200) return
					if (data?.length) this.banners = data
				} catch (err) {
					console.warn('获取轮播图失败', err)
				}
			}
		}
	}
</script>

<style>
.page{
	width: 100%;
	height: 100%;
	background: #000;
	overflow-y: scroll;
}
.banner{
	margin: 24rpx 0 8rpx;
	width: 100%;
	height: 384rpx;
	overflow: hidden;
}
.banner-image{
	width: 100%;
	height: 100%;
	display: block;
}
.price{
	width: 734rpx;
	height: 1478rpx;
	margin: 8rpx;
}
.honghe-price{
    width: 734rpx;
	height: 1664rpx;
	margin: 8rpx;
}
.divide{
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}
.bottomdesc{
	margin: 32rpx auto;
	font-size: 20rpx;
	color: rgba(255, 255, 255, 0.5);
}
</style>
