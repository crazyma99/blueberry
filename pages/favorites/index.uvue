<template>
	<view class="container">
		<!-- 自定义导航栏：搜索栏在标题栏位置 -->
		<view class="custom-nav">
			<view :style="{height: statusBarHeight + 'px'}"></view>
			<view class="nav-content">
				<image class="back-btn" src="/static/back-arrow.svg" mode="aspectFit" @click="goBack"></image>
				<view class="search-bar-nav">
					<image class="search-icon-small" src="/static/search.svg" mode="aspectFit"></image>
					<input
						class="search-input-nav"
						type="text"
						placeholder="搜索收藏内容"
						placeholder-style="color: rgba(255,255,255,0.3)"
						v-model="searchKeyword"
						confirm-type="search"
						@confirm="handleSearch"
					/>
				</view>
			</view>
		</view>
		<!-- 占位 -->
		<view :style="{height: (statusBarHeight + 44) + 'px'}"></view>

		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-row" style="flex-wrap: wrap;">
				<view v-for="i in 4" :key="i" class="sk-photo-item sk-animate"></view>
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else class="content">
			<!-- 空状态 -->
			<view v-if="isEmpty" class="empty-state">
				<view class="empty-title">暂无内容</view>
				<view class="empty-desc">{{ searchKeyword ? '换个搜索关键词试试吧' : '还没有收藏任何内容哦' }}</view>
			</view>

			<!-- 收藏列表 -->
			<view v-else class="favorites-list">
				<view
					v-for="(item, index) in favoriteList"
					:key="index"
					class="favorite-item"
					@click="handleItemClick(item)"
				>
					<image class="cover-image" :src="item.coverImageUrl" mode="aspectFill"></image>
					<view class="item-mask">
						<view class="item-info">
							<view class="item-title">{{ item.title }}</view>
							<view class="item-stats">
								<view class="like-count">
									<image class="like-icon" src="/static/like.svg" mode="aspectFit"></image>
									<text>{{ formatCount(item.likeCount) }}</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<!-- 加载更多 -->
			<view v-if="!isEmpty && !noMore" class="load-more" @click="loadMore">
				<text class="load-more-text">{{ loadingMore ? '加载中...' : '加载更多' }}</text>
			</view>
			<view v-if="noMore && favoriteList.length > 0" class="load-more">
				<text class="load-more-text">已经到底了</text>
			</view>

			<!-- Copyright -->
			<view class="copyright">
				Copyright 2025 蓝梅旗袍·汉服·民族服体验馆 - 版权所有
			</view>
		</view>
	</view>
</template>

<script lang="uts">
import { getFavoriteList, searchAlbums } from '../../utils/api.uts'

export default {
	data() {
		return {
			statusBarHeight: 20,
			loading: true,
			loadingMore: false,
			searchKeyword: '',
			favoriteList: [] as any[],
			isEmpty: false,
			page: 1,
			pageSize: 10,
			noMore: false,
			isSearching: false
		}
	},

	onLoad() {
		const systemInfo = uni.getSystemInfoSync()
		this.statusBarHeight = systemInfo.statusBarHeight || 20
		this.loadData()
	},

	methods: {
		goBack() {
			if (this.searchKeyword.trim()) {
				// 搜索框有值：清空搜索并重新加载收藏列表
				this.searchKeyword = ''
				this.loadData()
			} else {
				uni.navigateBack()
			}
		},

		async loadData() {
			try {
				this.loading = true
				this.page = 1
				this.noMore = false
				this.isSearching = false

				const res = await getFavoriteList()
				if (res.code === 200 && res.data) {
					this.favoriteList = res.data
					this.isEmpty = this.favoriteList.length === 0
				} else {
					this.isEmpty = true
				}
			} catch (err) {
				console.error('加载收藏列表失败:', err)
				uni.showToast({ title: '加载失败', icon: 'none' })
				this.isEmpty = true
			} finally {
				this.loading = false
			}
		},

		async handleSearch() {
			const keyword = this.searchKeyword.trim()
			if (!keyword) {
				await this.loadData()
				return
			}

			try {
				this.loading = true
				this.page = 1
				this.noMore = false
				this.isSearching = true

				const res = await searchAlbums(keyword, 1, this.pageSize)
				if (res.code === 200 && res.data) {
					this.favoriteList = res.data
					this.isEmpty = this.favoriteList.length === 0
					if (res.data.length < this.pageSize) {
						this.noMore = true
					}
				} else {
					this.favoriteList = []
					this.isEmpty = true
				}
			} catch (err) {
				console.error('搜索失败:', err)
				uni.showToast({ title: '搜索失败', icon: 'none' })
				this.isEmpty = true
			} finally {
				this.loading = false
			}
		},

		async loadMore() {
			if (this.noMore || this.loadingMore) return
			if (!this.isSearching) return

			try {
				this.loadingMore = true
				const nextPage = this.page + 1
				const res = await searchAlbums(this.searchKeyword.trim(), nextPage, this.pageSize)
				if (res.code === 200 && res.data) {
					this.favoriteList = this.favoriteList.concat(res.data)
					this.page = nextPage
					if (res.data.length < this.pageSize) {
						this.noMore = true
					}
				} else {
					this.noMore = true
				}
			} catch (err) {
				console.error('加载更多失败:', err)
			} finally {
				this.loadingMore = false
			}
		},

		handleItemClick(item: any) {
			uni.navigateTo({
				url: `/pages/targetPhotoDetail/index?idx=${item.id}`
			})
		},

		formatCount(count: number): string {
			if (count >= 10000) {
				return `${(count / 10000).toFixed(1)}万`
			}
			return String(count || 0)
		}
	}
}
</script>

<style>
.container {
	background: #000;
	min-height: 100vh;
	color: #fff;
}

/* 自定义导航栏 */
.custom-nav {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	background: #000;
	z-index: 100;
}
.nav-content {
	height: 44px;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 0 16rpx;
}
.back-btn {
	width: 44rpx;
	height: 44rpx;
	padding: 10rpx;
}
.search-bar-nav {
	flex: 1;
	display: flex;
	flex-direction: row;
	align-items: center;
	background: rgba(255, 255, 255, 0.1);
	border-radius: 32rpx;
	padding: 0 20rpx;
	height: 64rpx;
	margin-left: 12rpx;
}
.search-icon-small {
	width: 32rpx;
	height: 32rpx;
}
.search-input-nav {
	flex: 1;
	font-size: 26rpx;
	color: #fff;
	margin-left: 12rpx;
}

.content {
	padding: 0 8rpx 32rpx;
}

/* 空状态 */
.empty-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 200rpx 32rpx;
}
.empty-title {
	font-size: 32rpx;
	color: rgba(255, 255, 255, 0.5);
	margin-bottom: 16rpx;
}
.empty-desc {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.3);
}

/* 收藏列表 */
.favorites-list {
	display: flex;
	flex-wrap: wrap;
}
.favorite-item {
	width: 362rpx;
	height: 482rpx;
	margin: 0 8rpx 8rpx 0;
	position: relative;
	border-radius: 8rpx;
	overflow: hidden;
}
.favorite-item:nth-child(2n) {
	margin-right: 0;
}
.cover-image {
	width: 100%;
	height: 100%;
}
.item-mask {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: linear-gradient(180deg, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.4) 75%, rgba(0, 0, 0, 0.7) 89%, #000000 100%);
	display: flex;
	align-items: flex-end;
}
.item-info {
	padding: 16rpx;
	width: 100%;
}
.item-title {
	font-size: 28rpx;
	font-weight: 500;
	color: #fff;
	margin-bottom: 8rpx;
}
.item-stats {
	display: flex;
	align-items: center;
}
.like-count {
	display: flex;
	align-items: center;
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.7);
}
.like-icon {
	width: 28rpx;
	height: 28rpx;
	margin-right: 8rpx;
}

/* 加载更多 */
.load-more {
	padding: 32rpx;
	text-align: center;
}
.load-more-text {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.4);
}

/* Copyright */
.copyright {
	margin: 64rpx auto 32rpx;
	font-size: 20rpx;
	color: rgba(255, 255, 255, 0.5);
	text-align: center;
}
</style>
