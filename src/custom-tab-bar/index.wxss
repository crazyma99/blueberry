.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #160f04;
  border-top: 1rpx solid #000;
  z-index: 999;
}

.tabbar-inner {
  display: flex;
  flex-direction: row;
  height: 116rpx;
}

.tabbar-item {
  flex: 1;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tabbar-item--active {
  background: linear-gradient(180deg, rgba(241, 205, 145, 0.1) 0%, rgba(241, 205, 145, 0) 100%);
}

.tabbar-icon {
  width: 38rpx;
  height: 38rpx;
}

.tabbar-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  /* 字体由全局类控制（如 font-noto-serif），此处不再写死 font-family */
  color: #f1cd91;
}

/* 底部安全区占位 */
.tabbar::after {
  content: '';
  display: block;
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
