.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #160f04;
  border-top: 1rpx solid #000;
  z-index: 999;
}

.tabbar-inner {
  position: relative;
  display: flex;
  flex-direction: row;
  height: 116rpx;
}

/* 选中背景：单一高亮块（宽度＝1/3）；位移动效由 index.js 的 this.animate() 播放，
   这里不使用 CSS transition（视图层动画不依赖过渡与渲染帧对齐） */
.tabbar-highlight {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 33.3333%;
  background: linear-gradient(180deg, rgba(241, 205, 145, 0.1) 0%, rgba(241, 205, 145, 0) 100%);
  z-index: 0;
  pointer-events: none;
}

.tabbar-item {
  flex: 1;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.tabbar-icon {
  width: 38rpx;
  height: 38rpx;
  /* 未选中：图标同样压暗（与 55% 的文字一致，主人 2026-09-15 选定口径） */
  opacity: 0.55;
}

.tabbar-item--active .tabbar-icon {
  opacity: 1;
}

.tabbar-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  /* 字体由全局类控制（如 font-noto-serif），此处不再写死 font-family */
  /* 未选中：压暗（2026-09-15 主人指示） */
  color: rgba(241, 205, 145, 0.55);
}

.tabbar-item--active .tabbar-text {
  color: #f1cd91;
}

/* 底部安全区占位 */
.tabbar::after {
  content: '';
  display: block;
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
