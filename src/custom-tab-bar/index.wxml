<!--
  自定义底部 tabbar（对应 pages.json tabBar.custom = true）
  - 图标恒为选中态
  - 文字颜色恒为 #F1CD91
  - 选中 tab 背景为自上而下淡金色渐变
  - 所有 tab 均分宽度，高度 116rpx（另加底部安全区）
  当前选中项由 index.js 按页面路由 + 模块级共享下标自动判定，页面侧无需额外代码。
-->
<view class="tabbar">
  <view class="tabbar-inner">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tabbar-item {{selected === index ? 'tabbar-item--active' : ''}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <image class="tabbar-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <text class="tabbar-text font-noto-serif">{{item.text}}</text>
    </view>
  </view>
</view>
