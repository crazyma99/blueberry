<!--
  自定义底部 tabbar（对应 pages.json tabBar.custom = true）
  - 图标：未选中＝线性（outline，压暗），选中＝面性（filled，品牌金）——2026-09-15 主人指示
  - 文字：未选中 rgba(241,205,145,0.55)，选中 #F1CD91
  - 选中背景：**单一高亮块**，切换 Tab 时做位移动效（transform: translateX，0.28s）
  - 所有 tab 均分宽度，高度 116rpx（另加底部安全区）
  当前选中项由 index.js 按页面路由 + 模块级共享下标自动判定，页面侧无需额外代码。
-->
<view class="tabbar">
  <view class="tabbar-inner">
    <view
      class="tabbar-highlight {{slideReady ? 'tabbar-highlight--animate' : ''}}"
      style="transform: translateX({{selected * 100}}%);"
    ></view>
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tabbar-item {{selected === index ? 'tabbar-item--active' : ''}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <image class="tabbar-icon" src="{{selected === index ? item.iconActive : item.icon}}" mode="aspectFit"></image>
      <text class="tabbar-text font-noto-serif">{{item.text}}</text>
    </view>
  </view>
</view>
