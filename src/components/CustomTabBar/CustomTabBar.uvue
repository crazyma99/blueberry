<!--
  CustomTabBar — 底部自定义导航栏（替代微信 custom-tab-bar 方案）

  背景：微信 custom-tab-bar 每个 tab 页挂独立实例，切换时整个底栏重绘导致闪烁。
  本组件作为普通组件直接嵌入各 tab 页（页面保活，切换时底栏零重绘），
  原生 tabbar 在 tab 页 onShow 中通过 uni.hideTabBar 隐藏。

  使用：<CustomTabBar :active="0" />（active 为当前页在 tabBar list 中的下标）
  - 图标恒为选中态，文字恒为 #F1CD91
  - 选中 tab 背景为自上而下淡金色渐变
  - 所有 tab 均分宽度，高度 116rpx（另加底部安全区）
-->
<template>
	<view class="custom-tabbar">
		<view class="custom-tabbar-inner">
			<view
				v-for="(item, idx) in tabs"
				:key="idx"
				:class="active === idx ? 'ctab ctab-active' : 'ctab'"
				@click="onTap(idx)"
			>
				<image class="ctab-icon" :src="item.icon" mode="aspectFit"></image>
				<text class="ctab-text font-noto-serif">{{ item.text }}</text>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
type TabItem = {
	pagePath: string
	icon: string
	text: string
}

export default {
	name: 'CustomTabBar',
	props: {
		// 当前页在 tabBar list 中的下标：首页 0 / 价目表 1 / 我的 2
		active: {
			type: Number,
			default: 0
		}
	},
	data() {
		return {
			tabs: [
				{ pagePath: '/pages/index/index', icon: '/static/home-bar.png', text: '首页' },
				{ pagePath: '/pages/priceHomePage/index', icon: '/static/price-bar.png', text: '价目表' },
				{ pagePath: '/pages/mine/index', icon: '/static/my-bar.png', text: '我的' }
			] as TabItem[]
		}
	},
	methods: {
		onTap(idx: number) {
			if (idx === this.active) return
			uni.switchTab({ url: this.tabs[idx].pagePath })
		}
	}
}
</script>

<style>
.custom-tabbar {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	background: #160F04;
	border-top: 1rpx solid #000;
	z-index: 999;
	/* 底部安全区 */
	padding-bottom: constant(safe-area-inset-bottom);
	padding-bottom: env(safe-area-inset-bottom);
}
.custom-tabbar-inner {
	display: flex;
	flex-direction: row;
	height: 116rpx;
}
.ctab {
	flex: 1;
	height: 116rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}
.ctab-active {
	background: linear-gradient(180deg, rgba(241, 205, 145, 0.1) 0%, rgba(241, 205, 145, 0) 100%);
}
.ctab-icon {
	width: 48rpx;
	height: 48rpx;
}
.ctab-text {
	margin-top: 6rpx;
	font-size: 24rpx;
	color: #F1CD91;
  font-weight: 700;
}
</style>
