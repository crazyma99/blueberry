<!--
  ServiceContact — 「服务保障 / 联系我们」区块

  设计目标：
  - 收敛首页/价目表页底部的重复区块（服务保障列表 / 联系我们二维码与电话）。
  - 二维码 src、联系电话（及可选的商务合作电话）由 profile 注入脚本
    （scripts/lib/apply-profile.mjs 的 updateContactPage）一处替换，组件内不得含硬编码品牌信息。
  - 注入合同：保持 <image class="code"> 与 <view class="label">联系电话</view>
    + <view class="val">…</view> 的结构不变，脚本正则依赖此合同。
-->
<template>
	<view>
		<view class="divideTit">
      <image src="/static/left-divider.png" class="divider" mode="aspectFill"/>
      <view class="demoPhotoTit">
        <view class="font-noto-serif">服务保障</view>
        <image src="/static/service-icon.png" class="icon" mode="aspectFill"/>
      </view>
      <image src="/static/right-divider.png" class="divider" mode="aspectFill"/>
    </view>
    <view class="service-contain">
      <image src="/static/service-flower.png" class="flower" mode="aspectFill"/>
      <view class="tit font-noto-serif">{{ slogan }}</view>
      <view class="main-wrap">
        <view class="main">
          <view v-for="(item, index) in list" :key="index" class="item">
            <view class="content">
              <view class="item-mark">
                <image src="/static/service-li.png" class="li" mode="aspectFill"/>
                <view class="number">{{ index + 1 }}</view>
              </view>
              <text class="item-text">{{ item }}</text>
            </view>
            <!-- 最后一项不渲染分隔线 -->
            <view v-if="index !== list.length - 1" class="line"></view>
          </view>
        </view>
      </view>
    </view>
    <view class="divideTit">
      <image src="/static/left-divider.png" class="divider" mode="aspectFill"/>
      <view class="demoPhotoTit">
        <view class="font-noto-serif">联系我们</view>
        <image src="/static/contact-icon.png" class="icon" mode="aspectFill"/>
      </view>
      <image src="/static/right-divider.png" class="divider" mode="aspectFill"/>
    </view>
    <view class="service-contain">
      <view class="tit font-noto-serif">长按下面二维码添加客服</view>
      <view class="contact-main">
        <image src="/static/contact-bg.png" class="contact-bg" mode="aspectFill"/>
        <image
          class="code"
          :src="qrSrc"
          mode="aspectFit"
          show-menu-by-longpress="{{true}}"
        ></image>
        <view class="label">联系电话</view>
        <view class="val">{{ phone }}</view>
        <view class="label">商务合作</view>
        <view class="val">{{ coopPhone }}</view>
      </view>
    </view>
	</view>
</template>

<script lang="uts">
import { getPageConfig } from '../../utils/api.uts'

	export default {
		name: 'ServiceContact',
    data() {
			return {
        // 服务保障文案：优先 OPS 页面配置（/api/page-config 的 service_guarantee items），
        // 接口失败或未配置时使用下列默认值兜底。
        list: [
          '一价全包，全程无任何隐形消费',
          '妆面不满意免费重化，满意再出门',
          '拍摄不满意重拍，重拍不满意退款',
          '拍摄现场拍、看、审，品质保证',
          '全职专业摄影师、化妆师，拒绝兼职',
          '所有道具、饰品免费提供免费使用',
          '所有作品均自主创作，所见即所得',
          '明码标价，用心做品质，拒绝套路',
        ] as string[],
        // 服务保障标语：优先 OPS 页面配置（service_guarantee 的 config.slogan），失败时用默认值兜底。
        slogan: '蓝梅，让世界看见东方美' as string,
        // 联系我们：优先 OPS 页面配置（contact_info 的 config JSON），失败时用默认值兜底。
        qrSrc: 'https://www.lanmei66.cloud/admin/admin20250928234704_495_147.png' as string,
        phone: '18068842642' as string,
        coopPhone: '13269920775' as string,
      }
    },
    mounted() {
      this.loadContactConfig()
    },
    methods: {
      async loadContactConfig() {
        try {
          const res = await getPageConfig()
          if (res.code !== 200 || !Array.isArray(res.data)) return
          const comps = res.data as any[]
          const service = comps.filter((c: any) => c.type === 'service_guarantee')[0]
          if (service != null) {
            if (Array.isArray(service.items) && service.items.length > 0) {
              this.list = service.items.map((it: any) => it.title as string)
            }
            if (service.config != null && service.config.length > 0) {
              const cfg = JSON.parse(service.config as string)
              if (cfg.slogan != null && cfg.slogan.length > 0) this.slogan = cfg.slogan as string
            }
          }
          const contact = comps.filter((c: any) => c.type === 'contact_info')[0]
          if (contact != null && contact.config != null && contact.config.length > 0) {
            const cfg = JSON.parse(contact.config as string)
            if (cfg.qrSrc != null && cfg.qrSrc.length > 0) this.qrSrc = cfg.qrSrc as string
            if (cfg.phone != null && cfg.phone.length > 0) this.phone = cfg.phone as string
            if (cfg.coopPhone != null && cfg.coopPhone.length > 0) this.coopPhone = cfg.coopPhone as string
          }
        } catch (e) {
          // 拉取失败保持默认值，页面不中断
        }
      }
    }
	}
</script>

<style>
	.divideTit{
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 28rpx;
    .divider{
      width: 150rpx;
      height: 22rpx;
    }
    .demoPhotoTit {
      display: flex;
      flex-direction: column;
      font-size: 38rpx;
      font-weight: 700;
      color: #F1CD91;
      .icon{
        width: 143rpx;
        height: 56rpx;
        margin-top: -30rpx;
      }
    }
  }
  .service-contain{
    margin: 40rpx 20rpx;
    padding: 40rpx 20rpx 20rpx;
    border: 2rpx solid rgba(255, 255, 221, 0.3);
    border-radius: 24rpx;
    position: relative;
    .flower {
      position: absolute;
      right: 0;
      top: 40rpx;
      width: 167rpx;
      height: 222rpx;
      z-index: 9;
    }
    .tit{
      margin-bottom: 40rpx;
      text-align: center;
      font-weight: 700;
      font-size: 34rpx;
      color: rgba(241, 205, 145, 1);
    }
    .main-wrap {
      padding: 1rpx;
      border-radius: 15rpx;
      /* 外层渐变：只露出 1rpx 边框线 */
      background: linear-gradient(252.59deg, rgba(241, 205, 145, 0.2) 0%, rgba(241, 205, 145, 0.7) 33.41%, rgba(241, 205, 145, 0) 62.4%, rgba(241, 205, 145, 0.7) 100%);
    }
    .main {
      border-radius: 14rpx;
      /* 内层必须不透明：半透明会透出外层边框渐变。已把原 rgba(241,205,145,0.06)→transparent 合成到 #160F04 底 */
      background: linear-gradient(138.87deg, #231A0C 0%, #160F04 100%);
      padding: 20rpx;
      .item{
        display: flex;
        flex-direction: column;
      }
      .content{
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 10rpx 14rpx;
        gap: 26rpx;
        .item-mark{
          position: relative;
          display: flex;
          flex-direction: column;
          align-items: center;
          color: #F1CD91;
          font-size: 20rpx;
          font-weight: 700;
          .li{
            width: 44rpx;
            height: 42rpx;
          }
          .number{
            /* 绝对定位 + 自身 50% 位移：不依赖图标/数字尺寸，几何居中 */
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
          }
        }
        .item-text{
          flex: 1;
          font-size: 26rpx;
          color: #F1CD91;
        }
      }
      .line {
        width: 100%;
        height: 1rpx;
        background: linear-gradient(270deg, rgba(241, 205, 145, 0) 0%, rgba(241, 205, 145, 0.7) 50.48%, rgba(241, 205, 145, 0) 100%);
        margin: 10rpx 0;
      }
    }
    .contact-main {
      border-radius: 14rpx;
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #F1CD91;
      background: linear-gradient(139deg, rgba(241, 205, 145, 0.06) 0%, rgba(241, 205, 145, 0.00) 100%);
      border: 1px solid rgba(241, 205, 145, 0.20);
      position: relative;
      width: 670rpx;
      height: 536rpx;
      .contact-bg{
        position: absolute;
        width: 100%;
        height: 100%;
      }
      .code{
        margin: 30rpx auto;
        width: 250rpx;
        height: 248rpx;
      }
      .label{
        font-size: 26rpx;
        font-weight: 400;
        margin-bottom: 10rpx;
      }
      .val{
        font-size: 34rpx;
        font-weight: 700;
        margin-bottom: 20rpx;
      }
    }
  }
</style>
