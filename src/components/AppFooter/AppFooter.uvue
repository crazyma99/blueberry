<!--
  AppFooter — 全局页脚 Copyright 文本提供者

  设计目标：
  - 把原本散落在 6 页的 Copyright 字符串硬编码（favorites / demoDetail / priceList / index
    / priceHomePage / targetPhotoDetail）收敛到本组件的 default props，由 profile 注入脚本
    （scripts/lib/apply-profile.mjs）一处替换。
  - 渲染为行内 <text>，外层包裹由各页保留（.copyright / .bottomdesc / .beian），保证视觉零变化。
  - 2026-09-14 主人更正口径：等待页 footer 复用本组件样式与间距，改为
    「第一行 AI 生成提示、第二行技术支持文案」，故新增 mainText / supportText 覆盖 props
    （留空则维持 OPS copyright 配置与既有默认文案不变）。
-->
<template>
  <view class="app-footer">
    <text class="footer-main">{{ mainLine }}</text>
    <text class="footer-support">{{ supportLine }}</text>
  </view>
</template>

<script lang="uts">
import { getPageConfig } from '../../utils/api.uts'

export default {
  name: 'AppFooter',
  props: {
    copyrightText: {
      type: String,
      default: 'Copyright 2025 蓝梅旗袍·汉服·民族服体验馆 - 版权所有'
    },
    // 主行覆盖文案（等待页传「内容由 AI 生成…」）；留空则用 OPS copyright 配置，再退回上面默认
    mainText: {
      type: String,
      default: ''
    },
    // 支持行覆盖文案（等待页传「小程序与AI技术能力由 蓝梅网络 提供支持」）；留空则用配置/默认
    supportText: {
      type: String,
      default: ''
    }
  },
  data() {
    return {
      // OPS 页面配置（copyright 组件的 config.text）下发值；为空时回退 props/default。
      remoteText: '' as string,
      // 第二行支持文案：默认固定，OPS copyright 配置 supportText 可覆盖
      remoteSupportText: '小程序及AI技术能力由 蓝梅网络 提供支持' as string
    }
  },
  computed: {
    // 主行：props.mainText 优先（等待页 AI 生成提示）→ OPS 配置 → 默认版权
    mainLine(): string {
      if (this.mainText !== '') return this.mainText
      return this.remoteText !== '' ? this.remoteText : this.copyrightText
    },
    // 支持行：props.supportText 优先 → OPS 配置 → 默认
    supportLine(): string {
      return this.supportText !== '' ? this.supportText : this.remoteSupportText
    }
  },
  mounted() {
    this.loadCopyright()
  },
  methods: {
    async loadCopyright() {
      try {
        const res = await getPageConfig()
        if (res.code !== 200 || !Array.isArray(res.data)) return
        const comp = (res.data as any[]).filter((c: any) => c.type === 'copyright')[0]
        if (comp != null && comp.config != null && comp.config.length > 0) {
          const cfg = JSON.parse(comp.config as string)
          if (cfg.text != null && cfg.text.length > 0) this.remoteText = cfg.text as string
          // 第二行支持文案可配置覆盖（默认保留前端固定文案）
          if (cfg.supportText != null && (cfg.supportText as string).length > 0) {
            this.remoteSupportText = cfg.supportText as string
          }
        }
      } catch (e) {
        // 拉取失败保持默认值
      }
    }
  }
}
</script>

<style>
  .app-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .footer-support {
    margin-top: 8rpx;
    font-size: var(--font-size-caption);
    color: var(--color-primary-50);
  }
</style>
