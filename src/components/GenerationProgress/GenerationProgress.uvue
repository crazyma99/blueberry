<template>
	<view class="gp">
		<!-- 横向步骤条（2026-09-14 主人定稿：按设计图改版——圆形节点 + 渐变连线，图标一律 IconPark） -->
		<view class="gp-steps">
			<view v-for="(s, i) in steps" :key="i" class="gp-step">
				<!-- 连线：绝对定位于节点圆心高度，向右延伸正好一格（= 下一节点圆心），末节点不画 -->
				<view
					v-if="i < steps.length - 1"
					class="gp-line"
					:class="i < activeIndex - 1 ? 'gp-line-done' : (i === activeIndex - 1 ? 'gp-line-half' : 'gp-line-pending')"
				></view>
				<view
					class="gp-node"
					:class="i < activeIndex ? 'gp-node-done' : (i === activeIndex ? 'gp-node-active' : 'gp-node-pending')"
				>
					<!-- 已完成：金底白勾（金色勾落在金圆上不可见，故单列 check-white 变体）；当前/未完成：步骤序号 -->
					<image v-if="i < activeIndex" class="gp-check" src="/static/iconpark/check-white.svg" mode="aspectFit"></image>
					<text v-else class="gp-index" :class="i === activeIndex ? 'gp-index-active' : ''">{{ i + 1 }}</text>
				</view>
				<text
					class="gp-label"
					:class="i < activeIndex ? 'gp-label-done' : (i === activeIndex ? 'gp-label-active' : 'gp-label-pending')"
				>{{ s }}</text>
			</view>
		</view>
		<!-- 进度数字（主人指示：按参考图改版但保留进度数字；伪进度封顶 99%，任务完成时由父级置 100） -->
		<text class="gp-percent">{{ percent }}%</text>
	</view>
</template>

<script lang="uts">
	export default {
		name: 'GenerationProgress',
		props: {
			// 各步骤当前展示文案（父级已按状态计算好：已完成=完毕文案、其余=进行中文案）
			steps: {
				type: Array<string>,
				default: () => [] as string[]
			},
			// 当前进行中的步骤下标（0 起）
			activeIndex: {
				type: Number,
				default: 0
			},
			// 伪进度百分比（0-100；父级封顶 99，完成时置 100）
			percent: {
				type: Number,
				default: 0
			}
		}
	}
</script>

<style>
	.gp {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 28rpx 0 8rpx;
	}
	/* 步骤条：四等分格子，节点与文案均按格子居中（连线用绝对定位，不影响格子对齐） */
	.gp-steps {
		width: 100%;
		display: flex;
		flex-direction: row;
		align-items: flex-start;
	}
	.gp-step {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		position: relative;
	}
	/* 连线：top = 节点半径 - 线高一半（节点 88rpx / 线 6rpx） */
	.gp-line {
		position: absolute;
		left: 50%;
		top: 41rpx;
		width: 100%;
		height: 6rpx;
		border-radius: var(--radius-full);
	}
	.gp-line-done {
		background: linear-gradient(to right, var(--color-primary), var(--color-primary-deep));
	}
	/* 进入当前节点的那一段：金 → 暗，与设计图一致 */
	.gp-line-half {
		background: linear-gradient(to right, var(--color-primary-deep) 0%, rgba(255, 255, 255, 0.1) 100%);
	}
	.gp-line-pending {
		background: rgba(255, 255, 255, 0.1);
	}
	.gp-node {
		width: 88rpx;
		height: 88rpx;
		border-radius: 50%;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 1;
	}
	.gp-node-done {
		background: var(--gradient-btn-primary);
	}
	.gp-check {
		width: 44rpx;
		height: 44rpx;
	}
	/* 当前节点：暗底 + 金环 + 辉光（设计图同款） */
	.gp-node-active {
		background: var(--color-bg);
		border: 4rpx solid var(--color-primary);
		box-shadow: 0 0 24rpx rgba(241, 205, 145, 0.55);
		animation: gpGlow 1.6s ease-in-out infinite;
	}
	.gp-node-pending {
		/* 不透明底色：连线从节点圆心穿过，半透明会让线透出来 */
		background: var(--color-surface);
		border: 2rpx solid rgba(255, 255, 255, 0.12);
	}
	.gp-index {
		font-size: 32rpx;
		color: rgba(255, 255, 255, 0.35);
	}
	.gp-index-active {
		color: var(--color-primary);
	}
	/* 步骤文案：预留两行高度，避免步骤「进行中 → 完毕」换文案时整块跳动 */
	.gp-label {
		width: 100%;
		margin-top: 16rpx;
		padding: 0 6rpx;
		box-sizing: border-box;
		min-height: 62rpx;
		text-align: center;
		font-size: var(--font-size-body-sm);
		line-height: 1.35;
	}
	.gp-label-done {
		color: var(--color-primary-70);
	}
	.gp-label-active {
		color: var(--color-primary);
		font-weight: 500;
	}
	.gp-label-pending {
		color: rgba(255, 255, 255, 0.35);
	}
	.gp-percent {
		margin-top: 20rpx;
		font-size: var(--font-size-body-sm);
		color: var(--color-primary);
	}
	@keyframes gpGlow {
		0% { transform: scale(1); }
		50% { transform: scale(1.06); }
		100% { transform: scale(1); }
	}
</style>
