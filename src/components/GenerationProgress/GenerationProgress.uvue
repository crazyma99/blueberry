<template>
	<view class="gp">
		<!-- 动态进度条（design token；封顶 99%，任务完成时由父级置 100） -->
		<view class="gp-track">
			<view class="gp-fill" :style="'width: ' + percent + '%;'"></view>
		</view>
		<view class="gp-meta">
			<text class="gp-percent">{{ percent }}%</text>
		</view>
		<view
			v-for="(s, i) in steps"
			:key="i"
			class="gp-row"
			:class="i === activeIndex ? 'gp-row-active' : (i < activeIndex ? 'gp-row-done' : 'gp-row-pending')"
		>
			<view class="gp-icon">
				<!-- 禁止文字图标/emoji（主人指示）：完成勾引用 icon 包静态 SVG -->
				<image v-if="i < activeIndex" class="gp-check" src="/static/check-gold.svg" mode="aspectFit"></image>
				<view v-else-if="i === activeIndex" class="gp-dot gp-dot-active"></view>
				<view v-else class="gp-dot"></view>
			</view>
			<text class="gp-label">{{ s }}</text>
		</view>
	</view>
</template>

<script lang="uts">
	export default {
		name: 'GenerationProgress',
		props: {
			// 各步骤当前展示文案（父级已按状态计算好：已完成=完毕文案、其余=进行中文案）
			steps: {
				type: Array<string>,
				default: () => [] as string[]
			},
			// 当前进行中的步骤下标（0 起）
			activeIndex: {
				type: Number,
				default: 0
			},
			// 伪进度百分比（0-100；父级封顶 99，完成时置 100）
			percent: {
				type: Number,
				default: 0
			}
		}
	}
</script>

<style>
	.gp {
		width: 100%;
		display: flex;
		flex-direction: column;
		margin: 20rpx 0 12rpx;
	}
	/* 进度条轨道 + 品牌金渐变填充（design token） */
	.gp-track {
		width: 100%;
		height: 10rpx;
		border-radius: var(--radius-full);
		background: var(--color-primary-10);
		overflow: hidden;
	}
	.gp-fill {
		height: 100%;
		border-radius: var(--radius-full);
		background: var(--gradient-btn-primary);
		transition: width 0.6s ease-out;
	}
	.gp-meta {
		width: 100%;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
		margin: 10rpx 0 6rpx;
	}
	.gp-percent {
		font-size: var(--font-size-body-sm);
		color: var(--color-primary);
	}
	.gp-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 16rpx 0;
	}
	.gp-icon {
		width: 44rpx;
		height: 44rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 20rpx;
	}
	.gp-check {
		width: 30rpx;
		height: 30rpx;
	}
	.gp-dot {
		width: 16rpx;
		height: 16rpx;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.25);
	}
	.gp-dot-active {
		width: 18rpx;
		height: 18rpx;
		background: var(--color-primary);
		animation: gpPulse 1.1s ease-in-out infinite;
	}
	.gp-label {
		font-size: var(--font-size-body);
		color: rgba(255, 255, 255, 0.35);
	}
	.gp-row-active .gp-label {
		color: var(--color-primary);
		font-weight: 500;
	}
	.gp-row-done .gp-label {
		color: rgba(255, 255, 255, 0.72);
	}
	@keyframes gpPulse {
		0% { opacity: 0.35; transform: scale(0.85); }
		50% { opacity: 1; transform: scale(1.15); }
		100% { opacity: 0.35; transform: scale(0.85); }
	}
</style>
