<!--
  PhotoGrid — 店铺/客片网格展示组件

  设计目标：
  - 收敛 pages/index/index.uvue 与 pages/priceHomePage/index.uvue 中重复的
    demoPhotoContaner 结构与样式，统一店铺卡片网格的渲染规则。
  - 布局规则（基于首页 index.uvue 实现）：
    * 容器内 flex-wrap，gap 8rpx；
    * 单店铺时整行铺满（full-width）；
    * 多店铺时每行 2 个，每个占 (100% - 8rpx) / 2；
    * 奇数时最后一个落单仍占一半宽度，自然左对齐；
    * shopList 为空时回退到 2 张 demo 图（同样按 2 列展示）。
  - 点击交互通过事件透传给父组件（不同页面跳转目标不同）：
    * @shop-click(shop)  ：点击列表中的某个店铺
    * @demo-click(idx)   ：点击 fallback demo 图（idx = 1 或 2）
-->
<template>
	<view class="demoPhotoContaner">
		<view
			v-if="shopList.length > 0"
			v-for="(shop, index) in shopList"
			:key="index"
			:class="shopList.length === 1 ? 'shopCard full-width' : 'shopCard'"
			@click="onShopClick(shop)"
		>
			<image
				:class="shopList.length === 1 ? 'demoPhoto full-width' : 'demoPhoto'"
				:src="shop.homeImage"
				mode="aspectFill"
			></image>
			<view class="shopName">
				<view class="font-noto-serif">{{ shop.displayName }}</view>
				<view class="enName">{{ shop.displayNameEn }}</view>
			</view>
		</view>
		<!-- 占位卡：店铺数为奇数(≥3)时补全网格——统一尺寸「敬请期待」，不可点击 -->
		<view v-if="shopList.length > 1 && shopList.length % 2 === 1" class="shopCard shopCard-placeholder">
			<view class="placeholderContent">
				<view class="placeholderTitle font-noto-serif">敬请期待</view>
				<view class="placeholderSub">COMING SOON</view>
			</view>
		</view>
		<!-- 无店铺时 fallback：复用 shopCard 布局，自动按 2 列展示 -->
		<view v-if="shopList.length === 0" class="shopCard" @click="onDemoClick(1)">
			<image class="demoPhoto" src="/static/demo1.png" mode="aspectFill"></image>
		</view>
		<view v-if="shopList.length === 0" class="shopCard" @click="onDemoClick(2)">
			<image class="demoPhoto" src="/static/demo2.png" mode="aspectFill"></image>
		</view>
	</view>
</template>

<script lang="uts">
export default {
	name: 'PhotoGrid',
	props: {
		shopList: {
			type: Array,
			required: true
		}
	},
	emits: ['shop-click', 'demo-click'],
	methods: {
		onShopClick(shop) {
			this.$emit('shop-click', shop)
		},
		onDemoClick(idx) {
			this.$emit('demo-click', idx)
		}
	}
}
</script>

<style>
	.demoPhotoContaner{
		margin: 40rpx 0;
		padding: 0 8rpx;
		width: 100%;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 8rpx;
	}
	.shopCard {
		position: relative;
		width: calc((100% - 8rpx) / 2);
	}
	.full-width {
		width: 100%;
	}
	.shopCard.full-width {
		width: 100%;
	}
	.shopCard-placeholder {
		height: 226rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2rpx dashed rgba(243, 217, 172, 0.35);
		border-radius: var(--radius-card);
		background: rgba(255, 255, 255, 0.02);
	}
	.shopCard-placeholder .placeholderContent {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.shopCard-placeholder .placeholderTitle {
		font-size: var(--font-size-slogan);
		font-weight: 400;
		color: var(--color-primary-50);
		letter-spacing: 2rpx;
	}
	.shopCard-placeholder .placeholderSub {
		margin-top: 4rpx;
		font-size: 16rpx;
		color: var(--color-primary-30);
		letter-spacing: 2rpx;
	}
	.demoPhoto{
		width: 100%;
		height: 226rpx;
	}
	.full-width.demoPhoto {
		width: 100%;
	}
	.shopName {
		position: absolute;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		font-size: var(--font-size-slogan);
		color: var(--color-primary);
		font-weight: 400;
		background: linear-gradient(0deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3));
	}
	.shopName .enName {
		margin-top: 4rpx;
		font-size: 16rpx;
		font-weight: 400;
		color: var(--color-primary-70);
		letter-spacing: 2rpx;
	}
</style>
