<!--
  CustomNavBar — 全局自定义顶部导航栏

  背景：微信小程序原生导航栏 navigationBarTextStyle 只支持 black/white，
  无法实现 var(--color-primary) 金色标题与返回按钮，因此所有页面改用 navigationStyle: custom
  并在页面顶部放置本组件。

  使用：<CustomNavBar title="页面标题" />
  - title 传空字符串则只显示返回按钮（如 webview 页）
  - 页面栈深度 > 1 时自动显示返回按钮，tab 首页自动隐藏
-->
<template>
	<view :class="transparent ? 'custom-navbar custom-navbar-transparent' : 'custom-navbar'">
		<view :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="custom-navbar-content">
			<view v-if="showBack" class="custom-navbar-back" @click="goBack">
				<image class="custom-navbar-back-icon" src="/static/back-arrow.svg" mode="aspectFit"></image>
			</view>
			<text v-if="!transparent" class="custom-navbar-title">{{ title }}</text>
		</view>
	</view>
	<!-- 占位：撑开被 fixed 导航栏遮住的高度（transparent 模式同样保留，避免内容顶到状态栏） -->
	<view :style="{ height: (statusBarHeight + 44) + 'px' }"></view>
</template>

<script lang="uts">
export default {
	name: 'CustomNavBar',
	props: {
		title: {
			type: String,
			default: ''
		},
		transparent: {
			type: Boolean,
			default: false
		},
		// 无历史栈（如分享冷启动）时也显示返回按钮；点击回该 URL（缺省回首页）
		backFallbackUrl: {
			type: String,
			default: ''
		}
	},
	data() {
		return {
			statusBarHeight: 20
		}
	},
	computed: {
		// prop 晚到也响应：历史栈>1 或指定了返回兜底路由
		showBack() : boolean {
			return getCurrentPages().length > 1 || this.backFallbackUrl !== ''
		}
	},
	created() {
		const systemInfo = uni.getSystemInfoSync()
		this.statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
	},
	methods: {
		goBack() {
			if (getCurrentPages().length > 1) {
				uni.navigateBack()
			} else if (this.backFallbackUrl !== '') {
				uni.reLaunch({ url: this.backFallbackUrl })
			} else {
				uni.reLaunch({ url: '/pages/index/index' })
			}
		}
	}
}
</script>

<style>
.custom-navbar {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	background: var(--color-bg);
	z-index: 998;
}
.custom-navbar-transparent {
	background: transparent;
}
.custom-navbar-content {
	position: relative;
	height: 44px;
	display: flex;
	flex-direction: row;
	align-items: center;
}
.custom-navbar-back {
	width: 44px;
	height: 44px;
	display: flex;
	align-items: center;
	justify-content: center;
}
.custom-navbar-back-icon {
	width: 24px;
	height: 24px;
}
.custom-navbar-title {
	position: absolute;
	left: 88px;
	right: 88px;
	text-align: center;
	font-size: 17px;
	font-weight: 400;
	color: var(--color-primary);
	font-family: 'NotoSerifSC-Bold', serif;
	letter-spacing: 1px;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}
</style>
