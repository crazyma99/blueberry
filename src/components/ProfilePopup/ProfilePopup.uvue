<!--
  ProfilePopup — 完善个人资料弹窗（全局居中弹窗 · 与 LoginPopup 品牌视觉一致）

  视觉：居中卡片 + 顶部金色氛围光 + Noto Serif 金色标题 + 头像金描边角标
        + 深色输入面板 + 渐变主按钮 + 弹入动画
  交互：emit 事件交回页面既有 handler（业务逻辑完全不变）
  事件：@choose-avatar 头像选择；@update-nickname 昵称输入；@submit 确认；@skip 跳过/遮罩关闭
-->
<template>
  <view class="profile-overlay" @click="emit('skip')">
    <view class="profile-card" @click.stop>
      <!-- 顶部氛围光 -->
      <view class="card-aura"></view>
      <view class="card-title font-noto-serif">完善个人资料</view>
      <view class="card-desc">设置头像和昵称以获得完整体验</view>

      <!-- 头像选择 -->
      <button class="avatar-btn" open-type="chooseAvatar" @chooseavatar="emit('choose-avatar', $event)">
        <image class="avatar-img" :src="avatarUrl || '/static/mine.svg'" mode="aspectFill"></image>
        <view class="avatar-badge">+</view>
        <text class="avatar-tip">点击选择头像</text>
      </button>

      <!-- 昵称输入（组件化 AppInput，外层控制与下方按钮间距） -->
      <view class="input-wrap">
        <AppInput
          label="昵称"
          :value="nickname"
          placeholder="请输入昵称"
          @update="emit('update-nickname', $event)"
        />
      </view>

      <button class="confirm-btn btn-primary" hover-class="press-dim" @click="emit('submit')">确认</button>
      <view class="profile-skip" hover-class="press-dim" @click="emit('skip')">跳过</view>
    </view>
  </view>
</template>

<script lang="uts">
  export default {
    name: 'ProfilePopup',
    props: {
      avatarUrl: {
        type: String,
        default: ''
      },
      nickname: {
        type: String,
        default: ''
      }
    },
    emits: ['choose-avatar', 'update-nickname', 'submit', 'skip'],
    methods: {
      emit(name: string, event: any): void {
        this.$emit(name, event)
      }
    }
  }
</script>

<style>
  /* 遮罩 + 渐显（全屏：vw/vh 撑满） */
  .profile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999;
    animation: overlayFadeIn 0.25s ease-out;
  }
  @keyframes overlayFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* 居中卡片（与 LoginPopup login-card 同款视觉） */
  .profile-card {
    position: relative;
    width: 620rpx;
    background: var(--color-popup-card);
    border-radius: var(--radius-2xl);
    padding: 56rpx 48rpx 44rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    animation: cardPopIn 0.28s ease-out;
  }
  @keyframes cardPopIn {
    from { opacity: 0; transform: scale(0.92) translateY(24rpx); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* 顶部金色氛围光 */
  .card-aura {
    position: absolute;
    top: -100rpx;
    left: 50%;
    width: 420rpx;
    height: 220rpx;
    margin-left: -210rpx;
    background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(241, 205, 145, 0.2), rgba(241, 205, 145, 0) 70%);
    pointer-events: none;
  }

  .card-title {
    font-size: 40rpx;
    font-weight: 400;
    color: var(--color-primary);
    margin-bottom: 12rpx;
  }

  .card-desc {
    font-size: var(--font-size-body-sm);
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 36rpx;
  }

  /* 头像 */
  .avatar-btn {
    position: relative;
    background: transparent;
    border: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 32rpx;
    padding: 0 20rpx;
    width: 180rpx;
    box-sizing: border-box;
    line-height: normal;
  }
  .avatar-btn::after {
    border: none;
  }
  .avatar-img {
    width: 128rpx;
    height: 128rpx;
    border-radius: 50%;
    border: 3rpx solid var(--color-primary);
    background: rgba(255, 255, 255, 0.08);
  }
  .avatar-badge {
    position: absolute;
    right: 24rpx;
    bottom: 30rpx;
    width: 36rpx;
    height: 36rpx;
    border-radius: 50%;
    background: var(--gradient-btn-primary);
    color: var(--color-bg);
    font-size: 26rpx;
    font-weight: 400;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid var(--color-popup-card);
  }
  .avatar-tip {
    margin-top: 14rpx;
    font-size: var(--font-size-body-xs);
    color: rgba(255, 255, 255, 0.45);
  }



  /* 输入框间距（使用方控制，组件不带外距） */
  .input-wrap {
    width: 100%;
    margin-bottom: 36rpx;
  }

  /* 确认 + 跳过 */
  .confirm-btn {
    width: 100%;
    height: 92rpx;
    font-size: var(--font-size-body-plus);
  }
  .confirm-btn::after {
    border: none;
  }
  .profile-skip {
    margin-top: 28rpx;
    padding: 10rpx 40rpx;
    font-size: var(--font-size-body-sm);
    color: rgba(255, 255, 255, 0.4);
    transition: opacity 0.15s ease-out;
  }
</style>
