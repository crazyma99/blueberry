<script lang="uts">
  // #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
  // #endif

	export default {
		onLaunch: function () {
			console.log('App Launch')
			// 全局加载自定义字体（微信小程序需在 mp 后台配置 downloadFile 合法域名：www.lanmei66.cloud）
			// 使用方式：给 text/view 加全局类名 font-noto-serif 或 font-harmony
			uni.loadFontFace({
				global: true,
				family: 'NotoSerifSC-Bold',
				source: 'url("https://www.lanmei66.cloud/font/NotoSerifSC-Bold-subset.woff")',
				fail: (err) => {
					console.warn('NotoSerifSC-Bold 字体加载失败', err)
				}
			})
			uni.loadFontFace({
				global: true,
				family: 'HarmonyOS-Sans-SC',
				source: 'url("https://www.lanmei66.cloud/font/HarmonyOS_Sans_SC-subset.woff")',
				fail: (err) => {
					console.warn('HarmonyOS-Sans-SC 字体加载失败', err)
				}
			})
		},
		onShow: function () {
			console.log('App Show')
		},

		methods: {},
		onHide: function () {
			console.log('App Hide')
		},
		// #ifdef APP-ANDROID || APP-HARMONY
		onLastPageBackPress: function () {
			console.log('App LastPageBackPress')
			if (firstBackTime == 0) {
				uni.showToast({
					title: '再按一次退出应用',
					position: 'bottom',
				})
				firstBackTime = Date.now()
				setTimeout(() => {
					firstBackTime = 0
				}, 2000)
			} else if (Date.now() - firstBackTime < 2000) {
				firstBackTime = Date.now()
				uni.exit()
			}
		},
		// #endif
		onExit: function () {
			console.log('App Exit')
		},
	}
</script>

<style>
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

/* ========== 全局自定义字体（在 App onLaunch 中通过 uni.loadFontFace 全局加载） ========== */
/* 宋体标题：font-family: 'NotoSerifSC-Bold' */
.font-noto-serif {
  font-family: 'NotoSerifSC-Bold';
}
/* 正文/界面文字：font-family: 'HarmonyOS-Sans-SC' */
.font-harmony {
  font-family: 'HarmonyOS-Sans-SC';
}

/* 全局默认字体：HarmonyOS Sans SC（个别标题可用 font-noto-serif 覆盖） */
page {
  font-family: 'HarmonyOS-Sans-SC';
}

/* 自定义底部 tabbar 的页面占位（高度需与 src/custom-tab-bar 保持一致：116rpx + 底部安全区） */
.tabbar-safe-spacer {
  height: 116rpx;
  height: calc(116rpx + constant(safe-area-inset-bottom));
  height: calc(116rpx + env(safe-area-inset-bottom));
}
/* 隐藏所有页面的滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}
.hide-scrollbar::-webkit-scrollbar {
  display: none;
}

/* ========== 统一骨架屏样式 ========== */
@keyframes skeletonPulse {
  0% { opacity: 0.4; }
  50% { opacity: 0.8; }
  100% { opacity: 0.4; }
}
.sk-animate {
  animation: skeletonPulse 1.5s ease-in-out infinite;
}
/* 骨架屏容器 */
.sk-container {
  padding: 32rpx;
}
/* 通用矩形块 */
.sk-block {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
}
/* 圆形（头像等） */
.sk-circle {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}
/* 横向排列 */
.sk-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
/* 常用尺寸 */
.sk-banner {
  width: 100%;
  height: 384rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  margin-bottom: 32rpx;
}
.sk-title {
  width: 200rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 4rpx;
  margin: 0 auto 16rpx;
}
.sk-subtitle {
  width: 140rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}
.sk-text {
  height: 28rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 4rpx;
}
.sk-photo-card {
  width: 364rpx;
  height: 226rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  margin-right: 8rpx;
}
.sk-photo-card:last-child {
  margin-right: 0;
}
.sk-photo-item {
  width: 340rpx;
  height: 482rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  margin: 0 8rpx 8rpx 0;
}
.sk-photo-item:nth-child(2n) {
  margin: 0 0 8rpx;
}
.sk-tab {
  width: 128rpx;
  height: 42rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  margin-right: 16rpx;
}
.sk-avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}
.sk-menu {
  width: 100%;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

/* ========== 登录弹窗样式 ========== */
.login-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  z-index: 999;
}
.login-popup {
  width: 580rpx;
  background: #1a1a1a;
  border-radius: 24rpx;
  padding: 64rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}
.login-popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}
.login-popup-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 56rpx;
}
.login-auth-popup {
  align-self: flex-end;
  width: 710rpx;
  margin: 0 20rpx 20rpx;
  padding: 54rpx 48rpx 48rpx;
  background: #262626;
  border-radius: 52rpx;
  border: none;
  box-sizing: border-box;
}
.login-auth-popup .login-popup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 28rpx;
}
.login-agreement-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 48rpx;
  box-sizing: border-box;
}
.login-agreement-check {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #FFF1C5;
  border-radius: 50%;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}
.login-agreement-check.is-checked {
  background: #FFF1C5;
}
.login-agreement-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #262626;
}
.login-agreement-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 42rpx;
  color: rgba(255, 255, 255, 0.28);
}
.login-agreement-link {
  color: #fff;
  text-decoration: underline;
}
.login-auth-popup .login-phone-btn {
  height: 96rpx;
  line-height: 96rpx;
  background: #FFF1C5;
  color: #000;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}
.login-auth-popup .login-cancel-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  background: #17150F;
  border-radius: 16rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}
.login-phone-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #F3D9AC;
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  text-align: center;
  border: none;
  margin-bottom: 24rpx;
}
.login-phone-btn::after {
  border: none;
}
.login-cancel {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  padding: 16rpx 32rpx;
}

/* 头像昵称授权弹窗（复用 .login-overlay / .login-popup / .login-phone-btn / .login-cancel）*/
.profile-avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  padding: 0;
  margin: 0 0 32rpx;
  line-height: 1;
}
.profile-avatar-btn::after {
  border: none;
}
.profile-avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #333;
}
.profile-avatar-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}
.profile-nickname-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: 40rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  box-sizing: border-box;
}
.profile-nickname-label {
  font-size: 28rpx;
  color: #fff;
  margin-right: 24rpx;
}
.profile-nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}
</style>
