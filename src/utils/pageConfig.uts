// 页面组件配置（/api/page-config）解析工具
// 2026-09-15：品牌馆展示入口开关（OPS 首页配置 → brand_hub 组件 config.enabled）
// 抽成公共工具，供「首页入口显隐」与「品牌馆页自守卫」共用，避免两处解析口径分叉。
import { getPageConfig } from './api.uts'

/**
 * 解析「品牌馆展示入口」开关
 * 安全默认：组件缺失 / config 为空 / JSON 非法 / 接口失败，一律返回 false（不展示）
 */
export function parseBrandHubEnabled(res: any): boolean {
	if (res == null || res.code !== 200 || !Array.isArray(res.data)) return false
	const list = res.data as any[]
	for (let i = 0; i < list.length; i++) {
		const c = list[i]
		if (c != null && c.type === 'brand_hub') {
			const raw = c.config
			if (raw == null || (raw as string).length === 0) return false
			try {
				const cfg = JSON.parse(raw as string)
				return cfg.enabled === true
			} catch (e) {
				console.error('[pageConfig] 品牌馆开关配置解析失败', e)
				return false
			}
		}
	}
	return false
}

/**
 * 拉取页面配置并返回品牌馆开关状态
 * @param force 跳过 60s 缓存（下拉刷新/进品牌馆页自守卫时用）
 */
export async function isBrandHubEnabled(force: boolean = false): Promise<boolean> {
	try {
		const res = await getPageConfig(force)
		return parseBrandHubEnabled(res)
	} catch (e) {
		console.error('[pageConfig] 品牌馆开关查询失败', e)
		return false
	}
}
