/**
 * 认证工具模块
 * 管理用户登录状态、token 和用户信息
 */

// 用户信息接口
export interface UserInfo {
  id: number
  openid: string
  phone: string | null
  nickname: string | null
  avatarUrl: string | null
}

// ============ Token 管理 ============

/**
 * 获取 token
 * @returns token 字符串，未登录时返回空字符串
 */
export const getToken = (): string => {
  try {
    const token = uni.getStorageSync('token')
    return token ? String(token) : ''
  } catch (e) {
    console.error('获取 token 失败:', e)
    return ''
  }
}

/**
 * 设置 token
 * @param token token 字符串
 */
export const setToken = (token: string): void => {
  try {
    uni.setStorageSync('token', token)
  } catch (e) {
    console.error('设置 token 失败:', e)
  }
}

/**
 * 清除 token
 */
export const clearToken = (): void => {
  try {
    uni.removeStorageSync('token')
  } catch (e) {
    console.error('清除 token 失败:', e)
  }
}

// ============ 用户信息管理 ============

/**
 * 获取用户信息
 * @returns 用户信息对象，未登录时返回 null
 */
export const getUserInfo = (): UserInfo | null => {
  try {
    const userInfo = uni.getStorageSync('userInfo')
    if (userInfo) {
      return userInfo as UserInfo
    }
    return null
  } catch (e) {
    console.error('获取用户信息失败:', e)
    return null
  }
}

/**
 * 设置用户信息
 * @param userInfo 用户信息对象
 */
export const setUserInfo = (userInfo: UserInfo): void => {
  try {
    uni.setStorageSync('userInfo', userInfo)
  } catch (e) {
    console.error('设置用户信息失败:', e)
  }
}

/**
 * 合并写入用户信息（只有非空字段才覆盖）
 * 场景：wxBindPhone 响应只返回 phone 与部分字段，
 * 直接 setUserInfo 会将 step2 wxLogin 已写入的头像/昵称覆盖为空。
 * 此函数用传入的非空字段 patch 到 storage，保障已有用户信息不被意外抹掉。
 * @param partial 待合并的用户信息（可能字段缺失或为 null/空串）
 */
export const mergeUserInfo = (partial: UserInfo): void => {
  const current = getUserInfo()
  if (current == null) {
    setUserInfo(partial)
    return
  }
  const next: UserInfo = {
    id: (partial.id != null && partial.id !== 0) ? partial.id : current.id,
    openid: (partial.openid != null && partial.openid !== '') ? partial.openid : current.openid,
    phone: (partial.phone != null && partial.phone !== '') ? partial.phone : current.phone,
    nickname: (partial.nickname != null && partial.nickname !== '') ? partial.nickname : current.nickname,
    avatarUrl: (partial.avatarUrl != null && partial.avatarUrl !== '') ? partial.avatarUrl : current.avatarUrl,
  }
  setUserInfo(next)
}

/**
 * 清除用户信息
 */
export const clearUserInfo = (): void => {
  try {
    uni.removeStorageSync('userInfo')
  } catch (e) {
    console.error('清除用户信息失败:', e)
  }
}

// ============ 登录状态管理 ============

// 401 登录过期标志：当接口返回 401 时置为 true，页面 onShow 时消费并拉起登录弹窗
let _loginExpiredPending = false

/**
 * 标记登录已过期（由 http 层调用）
 */
export const markLoginExpired = (): void => {
  _loginExpiredPending = true
}

/**
 * 检查并消费登录过期标志（由页面 onShow 调用）
 * @returns 是否有待处理的登录过期事件
 */
export const consumeLoginExpired = (): boolean => {
  if (_loginExpiredPending) {
    _loginExpiredPending = false
    return true
  }
  return false
}

/**
 * 检查是否已登录
 * @returns 是否已登录
 */
export const isLoggedIn = (): boolean => {
  const token = getToken()
  return token !== '' && token !== 'undefined' && token !== 'null'
}

/**
 * 完整登录（保存 token 和用户信息）
 * @param token token 字符串
 * @param userInfo 用户信息对象
 */
export const loginSuccess = (token: string, userInfo: UserInfo): void => {
  setToken(token)
  setUserInfo(userInfo)
  console.log('登录成功:', userInfo.nickname)
}

/**
 * 完整登出（清除所有认证信息）
 */
export const logout = (): void => {
  clearToken()
  clearUserInfo()
  console.log('已登出')
}
