// 同步自定义底部 tabbar 的选中态
// 微信官方模式：tab 页 onShow 中通过 getTabBar() 拿到本页的 tabBar 实例。
// 背景（2026-09-15）：组件实例按 tab 页各自独立，且 webview 渲染器下自定义 tabbar 位于
// **独立元素树**（挂 document.documentElement、不在页面组件树内），很可能收不到 pageLifetimes.show
// ⇒ **页面 onShow 是唯一必然触发的入口**，选中态必须由页面侧同步（与是否有动画无关）。
export function syncTabBarSelected(index : number) : void {
	const pages = getCurrentPages()
	if (pages.length == 0) return
	const currentPage = pages[pages.length - 1] as any
	const tabBar: any = currentPage.getTabBar()
	if (tabBar == null) return
	// 新组件提供 setSelected（带越界守卫与幂等），旧组件退化为裸 setData
	if (typeof tabBar.setSelected === 'function') {
		tabBar.setSelected(index)
		return
	}
	// 值相同则不 setData，避免每次切换都触发一次无谓的重绘（闪烁来源之一）
	if (tabBar.data != null && tabBar.data.selected != index) {
		tabBar.setData({ selected: index })
	}
}
