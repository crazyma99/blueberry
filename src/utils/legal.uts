export const USER_AGREEMENT_NAME = '《蓝梅旅拍 SKILL 用户协议》'
export const PRIVACY_POLICY_NAME = '《蓝梅旅拍 SKILL 隐私政策》'

// 小程序后台/微信开发者工具生成的用户协议 URL 放这里。
// 目前仓库和项目配置里没有可读取的真实用户协议地址，避免写死不存在的链接。
export const USER_AGREEMENT_URL = ''

export function openUserAgreement(): void {
  if (USER_AGREEMENT_URL === '') {
    uni.showToast({
      title: '用户协议链接未配置',
      icon: 'none'
    })
    return
  }

  uni.navigateTo({
    url: `/pages/webview/index?url=${encodeURIComponent(USER_AGREEMENT_URL)}`
  })
}

export function openPrivacyPolicy(): void {
  // #ifdef MP-WEIXIN
  if (typeof wx !== 'undefined' && wx.openPrivacyContract != null) {
    wx.openPrivacyContract({
      fail: () => {
        uni.showToast({
          title: '暂无法打开隐私政策',
          icon: 'none'
        })
      }
    })
    return
  }
  // #endif

  uni.showToast({
    title: '当前环境不支持打开隐私政策',
    icon: 'none'
  })
}
