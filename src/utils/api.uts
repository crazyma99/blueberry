/**
 * 上传用户照片（用于AI试衣，需登录）
 * form field name 为 photo
 * 注意：code === 0 表示成功
 */
export const uploadPhoto = async (filePath: string) => {
  const { baseURL } = getHttpConfig()
  return new Promise<{ code: number; message: string; data: { file_url: string; filename: string } }>((resolve, reject) => {
    uni.uploadFile({
      url: `${baseURL}/api/aiface/upload`,
      filePath: filePath,
      name: 'photo',
      header: buildUploadHeader(),
      success: (res) => {
        // 上传接口同样处理 401 登录过期：挂起等待登录后重试
        if (res.statusCode === 401) {
          if (_uploadIsFlushing) {
            reject(new Error('未授权（重试失败）'))
            return
          }
          clearToken()
          clearUserInfo()
          markLoginExpired()
          _pendingUploads.push({
            filePath,
            resolve: resolve as (value: any) => void,
            reject: reject as (reason: any) => void,
          })
          if (!_uploadWaitingForLogin) {
            _uploadWaitingForLogin = true
            uni.$emit('login-required')
          }
          return
        }
        const data = JSON.parse(res.data)
        resolve(data)
      },
      fail: (err) => {
        reject(err)
      }
    })
  })
}

/**
 * 创建AI试衣任务（需登录）
 * 注意：code === 0 表示成功；code !== 0 表示失败（如：功能未启用 / 配额不足 / 缺少参数 / 店铺不存在），message 为错误提示
 */
export const submitAiTryOn = async (params: {
  templateId: number
  userPhotoFilename: string
  shopId: number
  userOpenid?: string
  category?: string
  bodyType?: string
  ageRange?: string
}) => {
  const res = await request({
    url: '/api/aiface/tasks',
    method: 'POST',
    data: params,
    showLoading: false,
  })
  return res as { code: number; message: string; data: { task_id: number } }
}

/**
 * 查询AI试衣任务状态（轮询）
 * 注意：code === 0 表示成功
 */
export const getAiTryOnResult = async (taskId: string) => {
  const res = await request({
    url: `/api/aiface/tasks/${taskId}`,
    method: 'GET',
    showLoading: false,
  })
  return res as {
    code: number
    message: string
    data: {
      id: number
      user_openid: string
      template_id: number
      // 任务状态：'pending' | 'processing' | 'completed' | 'failed'
      status: string
      result_image_url: string
      error_message: string
      template_image_url: string
      style_name: string
      category: string
      created_at: string
      updated_at: string
    }
  }
}

