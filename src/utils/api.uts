import { request } from './http.uts'
import { getHttpConfig } from './config.uts'
import { UserInfo, getToken, clearToken, clearUserInfo, markLoginExpired } from './auth.uts'
import { getBrandId } from './brand.uts'

// 手工拼 uploadFile 请求头（uni.uploadFile 不走 http.uts，品牌头需单独注入）
function buildUploadHeader(): Record<string, string> {
  const header: Record<string, string> = {
    'Authorization': `Bearer ${getToken()}`
  }
  const brandId = getBrandId()
  if (brandId !== '') {
    header['X-Brand-Id'] = brandId
  }
  return header
}

// ============ 上传接口 401 挂起队列 ============
interface PendingUpload {
  filePath: string
  resolve: (value: any) => void
  reject: (reason: any) => void
}

let _pendingUploads: PendingUpload[] = []
let _uploadWaitingForLogin = false
let _uploadIsFlushing = false

/**
 * 登录成功后调用：用新 token 重试所有挂起的上传请求
 */
export function flushPendingUploads(): void {
  if (_uploadIsFlushing) return
  _uploadIsFlushing = true
  const queue = [..._pendingUploads]
  _pendingUploads = []
  _uploadWaitingForLogin = false

  const { baseURL } = getHttpConfig()

  queue.forEach((p) => {
    uni.uploadFile({
      url: `${baseURL}/api/aiface/upload`,
      filePath: p.filePath,
      name: 'photo',
      header: buildUploadHeader(),
      success: (res) => {
        if (res.statusCode === 401) {
          p.reject(new Error('未授权（重试失败）'))
        } else {
          const data = JSON.parse(res.data)
          p.resolve(data)
        }
      },
      fail: (err) => p.reject(err)
    })
  })
  _uploadIsFlushing = false
}

/**
 * 用户取消登录时调用：reject 所有挂起的上传请求
 */
export function rejectAllPendingUploads(): void {
  const queue = [..._pendingUploads]
  _pendingUploads = []
  _uploadWaitingForLogin = false
  queue.forEach((p) => p.reject(new Error('用户取消登录')))
}

// ============ 类型定义 ============

export interface AlbumBasic {
  id: number
  title: string
  coverImageUrl: string
  shopId: number
  price?: number
  likeCount: number
  tryonDisabled?: boolean
}

export interface ShopInfo {
  id: number
  shopName: string
  displayName: string
  displayNameEn: string
  homeImage: string
  priceImage: string
  sortOrder: number
}

// ============ 原有接口 ============

// 导航栏接口
export const getImage = async (method: string, params?: any) => {
	const res = await request({
		url: '/wechat/carousels',
		method: (method || 'GET').toUpperCase() as any,
		data: params,
		showLoading: false,
	})
	return res
}

// 客片一级接口（支持分页）— 已废弃，请使用 getCategories + getAlbumList
export const getalbum = async (method: string, params?: any) => {
	const res = await request({
		url: '/wechat/album',
		method: (method || 'GET').toUpperCase() as any,
		data: params,
		showLoading: false,
	})
	return res
}

// ============ 客片分类 + 列表（拆分后的新接口） ============

/**
 * 获取客片分类（公开，无需登录）
 * @param shopId 店铺 ID
 */
export const getCategories = async (shopId: string | number) => {
  const res = await request({
    url: '/wechat/categories',
    method: 'GET',
    data: { shopId },
    showLoading: false,
  })
  return res as {
    code: number
    message: string
    data: Array<{
      id: number
      parentName: string
      sortOrder?: number
      subCategory: Array<{
        name: string
        sortOrder?: number
        query: Record<string, any>
      }>
    }>
  }
}

/**
 * 获取客片列表（公开，无需登录，支持分页 + 搜索）
 * @param params.shopId    店铺 ID（必填）
 * @param params           其余参数由子分类 query 对象透传（parentId/childId/subName 等）
 * @param params.keyword   搜索关键词（可选）
 * @param params.page      页码（可选）
 * @param params.size      每页大小（可选）
 */
export const getAlbumList = async (params: Record<string, any>) => {
  const res = await request({
    url: '/wechat/albums',
    method: 'GET',
    data: params,
    showLoading: false,
  })
  return res as {
    code: number
    message: string
    data: {
      albums: Array<{
        id: number
        title: string
        coverImageUrl: string
        price: number
        packageDesc: string
        likeCount: number
        liked: boolean
        tryonDisabled?: boolean
      }>
      total: number
      page: number
      size: number
    }
  }
}

// 客片详情页接口
export const getalbumDetail = async (method: string, params?: any) => {
