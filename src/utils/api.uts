import { request } from './http.uts'
import { UserInfo } from './auth.uts'

// ============ 类型定义 ============

export interface AlbumBasic {
  id: number
  title: string
  coverImageUrl: string
  shopId: number
  price?: number
  likeCount: number
}

export interface ShopInfo {
  id: number
  shopName: string
  displayName: string
  displayNameEn: string
  homeImage: string
  priceImage: string
  sortOrder: number
}

// ============ 原有接口 ============

// 导航栏接口
export const getImage = async (method: string, params?: any) => {
	const res = await request({
		url: '/wechat/carousels',
		method: (method || 'GET').toUpperCase() as any,
		data: params,
		showLoading: false,
	})
	return res
}

// 客片一级接口（支持分页）— 已废弃，请使用 getCategories + getAlbumList
export const getalbum = async (method: string, params?: any) => {
	const res = await request({
		url: '/wechat/album',
		method: (method || 'GET').toUpperCase() as any,
		data: params,
		showLoading: false,
	})
	return res
}

// ============ 客片分类 + 列表（拆分后的新接口） ============

/**
 * 获取客片分类（公开，无需登录）
 * @param shopId 店铺 ID
 */
export const getCategories = async (shopId: string | number) => {
  const res = await request({
    url: '/wechat/categories',
    method: 'GET',
    data: { shopId },
    showLoading: false,
  })
  return res as {
    code: number
    message: string
    data: Array<{
      id: number
      parentName: string
      sortOrder?: number
      subCategory: Array<{
        name: string
        sortOrder?: number
        query: Record<string, any>
      }>
    }>
  }
}

/**
 * 获取客片列表（公开，无需登录，支持分页 + 搜索）
 * @param params.shopId    店铺 ID（必填）
 * @param params           其余参数由子分类 query 对象透传（parentId/childId/subName 等）
 * @param params.keyword   搜索关键词（可选）
 * @param params.page      页码（可选）
 * @param params.size      每页大小（可选）
 */
export const getAlbumList = async (params: Record<string, any>) => {
  const res = await request({
    url: '/wechat/albums',
    method: 'GET',
    data: params,
    showLoading: false,
  })
  return res as {
    code: number
    message: string
    data: {
      albums: Array<{
        id: number
        title: string
        coverImageUrl: string
        price: number
        packageDesc: string
        likeCount: number
        liked: boolean
      }>
      total: number
      page: number
      size: number
    }
  }
}

// 客片详情页接口
export const getalbumDetail = async (method: string, params?: any) => {
	const res = await request({
		url: '/wechat/album/detail',
		method: (method || 'GET').toUpperCase() as any,
		data: params,
		showLoading: false,
	})
	return res
}

// ============ 微信登录模块 ============

/**
 * 微信登录，code 换 token
 */
export const wxLogin = async (params: {
  code: string
  nickname?: string
  avatarUrl?: string
}) => {
  const res = await request({
    url: '/api/wx/login',
    method: 'POST',
    data: params,
    showLoading: false,
  })
  return res as { code: number, message: string, data: { token: string, userInfo: UserInfo } }
}

/**
 * 绑定手机号（需登录）
 */
export const wxBindPhone = async (code: string) => {
  const res = await request({
    url: '/api/wx/phone',
    method: 'POST',
    data: { code },
    showLoading: false,
  })
  return res as { code: number, message: string, data: UserInfo }
}

/**
 * 获取当前登录用户信息（需登录）
 */
export const wxGetUserInfo = async () => {
  const res = await request({
    url: '/api/wx/userinfo',
    method: 'GET',
    showLoading: false,
  })
  return res as { code: number, message: string, data: UserInfo }
}

/**
 * 更新当前登录用户的头像 / 昵称（需登录）
 * 接口：PUT /api/wx/userinfo
 * 请求体：{ nickname?: string, avatarUrl?: string }（至少传一个）
 * Authorization 由 http.uts 统一注入：Bearer {token}
 * 返回：更新后的完整 UserInfo
 */
export const wxUpdateUserInfo = async (params: {
  nickname?: string
  avatarUrl?: string
}) => {
  // 仅保留有值的字段，避免把 '' / undefined 传给后端误覆盖
  const body: Record<string, any> = {}
  if (params.nickname != null && params.nickname !== '') body.nickname = params.nickname
  if (params.avatarUrl != null && params.avatarUrl !== '') body.avatarUrl = params.avatarUrl
  const res = await request({
    url: '/api/wx/userinfo',
    method: 'PUT',
    data: body,
    showLoading: false,
  })
  return res as { code: number, message: string, data: UserInfo }
}

// ============ 点赞模块 ============

/**
 * 点赞/取消点赞（toggle，需登录）
 */
export const toggleLike = async (albumId: number) => {
  const res = await request({
    url: '/api/like',
    method: 'POST',
    data: { albumId },
    showLoading: false,
  })
  return res as { code: number, data: { liked: boolean, likeCount: number } }
}

/**
 * 批量查询点赞状态（需登录）
 */
export const getLikeStatus = async (albumIds: string) => {
  const res = await request({
    url: '/api/like/status',
    method: 'GET',
    data: { albumIds },
    showLoading: false,
  })
  return res as { code: number, data: Array<{ albumId: number, liked: boolean, likeCount: number }> }
}

// ============ 收藏模块 ============

/**
 * 收藏/取消收藏（toggle，需登录）
 */
export const toggleFavorite = async (albumId: number) => {
  const res = await request({
    url: '/api/favorite',
    method: 'POST',
    data: { albumId },
    showLoading: false,
  })
  return res as { code: number, data: { favorited: boolean } }
}

/**
 * 批量查询收藏状态（需登录）
 */
export const getFavoriteStatus = async (albumIds: string) => {
  const res = await request({
    url: '/api/favorite/status',
    method: 'GET',
    data: { albumIds },
    showLoading: false,
  })
  return res as { code: number, data: Array<{ albumId: number, favorited: boolean }> }
}

/**
 * 我的收藏列表（需登录，支持门店筛选）
 */
export const getFavoriteList = async (shopId?: number) => {
  const res = await request({
    url: '/api/favorite/list',
    method: 'GET',
    data: shopId ? { shopId } : undefined,
    showLoading: false,
  })
  return res as { code: number, data: AlbumBasic[] }
}

// ============ 搜索模块 ============

/**
 * 相册模糊搜索（公开，无需登录，支持分页）
 * 返回分页数据结构
 */
export interface SearchPageResult {
  list: AlbumBasic[]
  total: number
  page: number
  pageSize: number
  totalPages: number
}

export const searchAlbums = async (keyword: string, page: number = 1, size: number = 10) => {
  const res = await request({
    url: '/api/search',
    method: 'GET',
    data: { keyword, page, size },
    showLoading: false,
  })
  return res as { code: number, data: SearchPageResult }
}

// ============ 店铺模块 ============

/**
 * 获取启用的店铺列表（公开，无需登录）
 */
export const getShops = async () => {
  const res = await request({
    url: '/api/shops',
    method: 'GET',
    showLoading: false,
  })
  return res as { code: number, data: ShopInfo[] }
}

// ============ 中台页配置 ============

/**
 * 获取中台页配置（金刚区+Banner，公开，无需登录）
 */
export const getPageConfig = async () => {
  const res = await request({
    url: '/api/page-config',
    method: 'GET',
    showLoading: false,
  })
  return res as { code: number, data: { menuItems: any[], banners: any[] } }
}
