}

/**
 * AI推荐模板（需登录）
 * 注意：code === 0 表示成功；参数为 camelCase
 */
export const getAiRecommend = async (params: {
  userPhotoFilename: string
  shopId: number
}) => {
  const res = await request({
    url: '/api/aiface/recommend',
    method: 'POST',
    data: params,
    showLoading: false,
  })
  return res as { code: number; message: string; data: AiTemplate[] }
}
