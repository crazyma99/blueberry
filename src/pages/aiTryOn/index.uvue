/* 按钮左右装饰 icon（复用客片详情页 AI 试衣按钮样式） */
.gen-btn-icon {
	width: 104rpx;
	height: 86rpx;
}
/* 生成按钮容器（预留 padding-top，避免角标上移后超出容器被裁剪） */
.gen-btn-wrap {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding-top: 20rpx;
}
/* 限免角标（相对容器定位：top 取 padding-top 即按钮顶边，right 取右侧 icon 宽度即按钮右边，
   再 translate 自身一半，使角标一半高一半宽与按钮右上角重叠） */
.gen-btn-badge {
	position: absolute;
	top: 20rpx;
	right: 104rpx;
	transform: translate(40%, -50%);
	z-index: 10;
	background: #ff3b30;
