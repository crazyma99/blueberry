<template>
	<view class="page">
		<!-- 提示文案 -->
		<view class="tip-bar">
			<text class="tip-text">左右横向滑动支持切换模板</text>
		</view>

		<!-- 服饰模板轮播 -->
		<view class="swiper-wrap">
			<swiper
				class="template-swiper"
				:indicator-dots="true"
				indicator-color="rgba(255,255,255,0.3)"
				indicator-active-color="#fff"
				:circular="true"
				:current="currentTemplateIndex"
				@change="onSwiperChange"
			>
				<swiper-item v-for="(item, index) in templates" :key="index">
					<image class="template-img" :src="item.imageUrl" mode="aspectFill"></image>
				</swiper-item>
			</swiper>
		</view>

		<!-- 体型选择 -->
		<view class="section">
			<text class="section-label">选择您的体型：</text>
			<view class="body-type-row">
				<view
					:class="bodyType === 'slim' ? 'body-btn body-btn-active' : 'body-btn'"
					@click="selectBodyType('slim')"
				>
					<text :class="bodyType === 'slim' ? 'body-btn-text body-btn-text-active' : 'body-btn-text'">瘦</text>
				</view>
				<view
					:class="bodyType === 'medium' ? 'body-btn body-btn-active' : 'body-btn'"
					@click="selectBodyType('medium')"
				>
					<text :class="bodyType === 'medium' ? 'body-btn-text body-btn-text-active' : 'body-btn-text'">微胖</text>
				</view>
				<view
					:class="bodyType === 'fat' ? 'body-btn body-btn-active' : 'body-btn'"
					@click="selectBodyType('fat')"
				>
					<text :class="bodyType === 'fat' ? 'body-btn-text body-btn-text-active' : 'body-btn-text'">胖</text>
				</view>
			</view>
		</view>

		<!-- 年龄选择 -->
		<view class="section">
			<text class="section-label">选择您的年龄：</text>
			<picker mode="selector" :range="ageOptions" :value="ageIndex" @change="selectAge">
				<view class="age-picker">
					<text class="age-picker-text">{{ ageRange }}</text>
					<view class="age-picker-arrow"></view>
				</view>
			</picker>
		</view>

		<!-- 照片上传 -->
		<view class="section">
			<text class="section-label">上传你的照片：</text>
			<view class="upload-area" @click="choosePhoto">
				<image v-if="photoPreviewUrl" class="upload-preview" :src="photoPreviewUrl" mode="widthFix"></image>
				<view v-else class="upload-placeholder">
					<text class="upload-plus">+</text>
					<text class="upload-hint">点击上传你的照片</text>
				</view>
			</view>
		</view>

		<!-- 底部占位（给固定按钮腾出空间） -->
		<view class="bottom-spacer"></view>

		<!-- 底部固定生成按钮 -->
		<view class="fixed-bottom">
			<view
				:class="photoPath ? 'generate-btn' : 'generate-btn generate-btn-disabled'"
				@click="handleGenerate"
			>
				<text class="generate-btn-text">生成 </text>
				<text class="generate-btn-ai">AI试衣</text>
				<text class="generate-btn-text"> 效果</text>
			</view>
			<view class="footer-copyright">
				<AppFooter />
			</view>
		</view>

		<!-- 登录弹窗 -->
		<view v-if="showLoginPopup" class="login-overlay" @click="closeLoginPopup">
			<view class="login-popup login-auth-popup" @click.stop>
				<view class="login-popup-title">微信授权登陆</view>
				<view class="login-agreement-row">
					<view
						:class="loginAgreementChecked ? 'login-agreement-check is-checked' : 'login-agreement-check'"
						@click.stop="toggleLoginAgreement"
					>
						<view v-if="loginAgreementChecked" class="login-agreement-dot"></view>
					</view>
					<text class="login-agreement-text"><text>登录即代表同意 </text><text class="login-agreement-link" @click.stop="openUserAgreement">{{ userAgreementName }}</text><text>、</text><text class="login-agreement-link" @click.stop="openPrivacyPolicy">{{ privacyPolicyName }}</text></text>
				</view>
				<button
					v-if="loginAgreementChecked"
					class="login-phone-btn"
					open-type="getPhoneNumber"
					@getphonenumber="onGetPhoneNumber"
				>一键登录</button>
				<button
					v-else
					class="login-phone-btn"
					@click="showLoginAgreementToast"
				>一键登录</button>
				<view class="login-cancel login-cancel-btn" @click="closeLoginPopup">暂不登陆</view>
			</view>
		</view>

		<!-- 头像昵称授权弹窗 -->
		<view v-if="showProfilePopup" class="login-overlay" @click="skipProfile">
			<view class="login-popup" @click.stop>
				<view class="login-popup-title">完善个人资料</view>
				<view class="login-popup-desc">设置头像和昵称以获得完整体验</view>
				<button
					class="profile-avatar-btn"
					open-type="chooseAvatar"
					@chooseavatar="onChooseAvatar"
				>
					<image class="profile-avatar-img" :src="profileAvatarUrl || '/static/mine.svg'" mode="aspectFill"></image>
					<text class="profile-avatar-tip">点击选择头像</text>
				</button>
				<view class="profile-nickname-row">
					<text class="profile-nickname-label">昵称</text>
					<input class="profile-nickname-input" type="nickname" placeholder="请输入昵称" v-model="profileNickname"/>
				</view>
				<button class="login-phone-btn" @click="submitProfile">确认</button>
				<view class="login-cancel" @click="skipProfile">跳过</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
import { getAiTemplates, uploadPhoto, submitAiTryOn } from '../../utils/api.uts'
import { isLoggedIn, getUserInfo, mergeUserInfo, UserInfo } from '../../utils/auth.uts'
import { runPhoneLogin } from '../../utils/loginFlow.uts'
import { submitUserProfile } from '../../utils/profileSubmit.uts'
import {
	USER_AGREEMENT_NAME,
	PRIVACY_POLICY_NAME,
	openUserAgreement,
	openPrivacyPolicy
} from '../../utils/legal.uts'

export default {
	data() {
		return {
			shopId: '',
			category: '',
			subCategory: '',
			templates: [] as any[],
			currentTemplateIndex: 0,
			bodyType: 'slim',
			ageRange: '10岁及以下',
			ageOptions: ['10岁及以下', '11-18岁', '19-30岁', '31-45岁', '46-60岁', '60岁以上'],
			ageIndex: 0,
			photoPath: '',
			photoPreviewUrl: '',
			isSubmitting: false,
			// 登录弹窗
			showLoginPopup: false,
			loginAgreementChecked: false,
			userAgreementName: USER_AGREEMENT_NAME,
			privacyPolicyName: PRIVACY_POLICY_NAME,
			// 头像昵称授权弹窗
			showProfilePopup: false,
			profileAvatarUrl: '',
			profileNickname: ''
		}
	},
	onLoad(options) {
		if (options && options.shopId) {
			this.shopId = String(options.shopId)
		}
		if (options && options.category) {
			this.category = String(options.category)
		}
		if (options && options.subCategory) {
			this.subCategory = String(options.subCategory)
		} else if (options && options.sub_category) {
			this.subCategory = String(options.sub_category)
		}
		this.loadTemplates()
	},
	methods: {
		async loadTemplates() {
			try {
				const params: Record<string, any> = {}
				if (this.shopId) params.shop_id = this.shopId
				if (this.category) params.category = this.category
				if (this.subCategory) params.sub_category = this.subCategory
				const res = await getAiTemplates(Object.keys(params).length > 0 ? params : undefined)
				if (res.code === 0 && res.data) {
					this.templates = res.data
				}
			} catch (err) {
				console.error('加载模板失败:', err)
			}
		},

		onSwiperChange(e: any) {
			this.currentTemplateIndex = e.detail.current
		},

		selectBodyType(type: string) {
			this.bodyType = type
		},

		selectAge(e: any) {
			const index = e.detail.value
			this.ageIndex = index
			this.ageRange = this.ageOptions[index]
		},

		choosePhoto() {
			uni.chooseImage({
				count: 1,
				sizeType: ['compressed'],
				sourceType: ['album', 'camera'],
				success: (res) => {
					const tempFile = res.tempFiles[0]
					// 检查文件大小 10MB
					if (tempFile.size > 10 * 1024 * 1024) {
						uni.showToast({ title: '照片大小不能超过10MB', icon: 'none' })
						return
					}
					this.photoPath = res.tempFilePaths[0]
					this.photoPreviewUrl = res.tempFilePaths[0]
				}
			})
		},

		async handleGenerate() {
			if (this.isSubmitting) return

			// 检查登录态
			if (!isLoggedIn()) {
				this.showLoginPopup = true
				return
			}

			// 检查是否已上传照片
			if (!this.photoPath) {
				uni.showToast({ title: '请先上传照片', icon: 'none' })
				return
			}

			// 检查模板
			if (this.templates.length === 0) {
				uni.showToast({ title: '暂无可用模板', icon: 'none' })
				return
			}

			const currentTemplate = this.templates[this.currentTemplateIndex]
			if (!currentTemplate) {
				uni.showToast({ title: '请选择模板', icon: 'none' })
				return
			}

			this.isSubmitting = true
			uni.showLoading({ title: '提交中...', mask: true })

			try {
				// 上传照片（code === 0 表示成功）
				const uploadRes = await uploadPhoto(this.photoPath)
				if (uploadRes.code !== 0 || !uploadRes.data) {
					uni.showToast({ title: uploadRes.message || '照片上传失败', icon: 'none' })
					return
				}

				const userPhotoFilename = uploadRes.data.filename

				// 创建AI试衣任务（code === 0 表示成功；code !== 0 统一以 message toast）
				const submitRes = await submitAiTryOn({
					templateId: currentTemplate.id,
					userPhotoFilename: userPhotoFilename,
					shopId: parseInt(this.shopId) || 0,
					bodyType: this.bodyType,
					ageRange: this.ageRange
				})

				if (submitRes.code === 0 && submitRes.data) {
					uni.navigateTo({
						url: `/pages/aiTryOnResult/index?taskId=${submitRes.data.task_id}`
					})
				} else {
					uni.showToast({ title: submitRes.message || '提交失败', icon: 'none' })
				}
			} catch (err) {
				console.error('生成AI试衣失败:', err)
				uni.showToast({ title: '提交失败，请重试', icon: 'none' })
			} finally {
				this.isSubmitting = false
				uni.hideLoading()
			}
		},

		// ========== 登录弹窗相关 ==========
		closeLoginPopup() {
			this.showLoginPopup = false
			this.loginAgreementChecked = false
		},

		toggleLoginAgreement() {
			this.loginAgreementChecked = !this.loginAgreementChecked
		},

		showLoginAgreementToast() {
			uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
		},

		openUserAgreement() {
			openUserAgreement()
		},

		openPrivacyPolicy() {
			openPrivacyPolicy()
		},

		// 手机号授权回调
		async onGetPhoneNumber(e: any) {
			if (!this.loginAgreementChecked) {
				this.showLoginAgreementToast()
				return
			}
			const detail = e.detail || {}

			// 用户拒绝授权
			if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
				if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
					uni.showToast({ title: '已取消授权', icon: 'none' })
				} else {
					console.error('[aiTryOn] 手机号授权失败:', detail.errMsg)
					uni.showToast({ title: '授权失败，请重试', icon: 'none' })
				}
				this.closeLoginPopup()
				return
			}

			const phoneCode = detail.code
			if (!phoneCode) {
				console.error('[aiTryOn] 未获取到 phoneCode，detail:', JSON.stringify(detail))
				uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
				this.closeLoginPopup()
				return
			}

			try {
				uni.showLoading({ title: '登录中...', mask: true })
				// 登录三步骤已下沉到 utils/loginFlow.uts
				const result = await runPhoneLogin(phoneCode)
				uni.hideLoading()

				if (!result.ok) {
					if (result.errorKind === 'login') {
						uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
					} else {
						uni.showToast({ title: result.errorMsg || '登录失败', icon: 'none' })
					}
					this.closeLoginPopup()
					return
				}

				// 关闭手机号登录弹窗
				this.showLoginPopup = false
				this.loginAgreementChecked = false
				if (result.phoneHasFullProfile) {
					// 后端已带头像昵称 → 直接登录完成
					uni.showToast({ title: '登录成功', icon: 'success' })
				} else {
					// 缺头像或昵称 → 弹出授权弹窗补齐
					this.openProfilePopup()
				}
			} catch (err) {
				uni.hideLoading()
				console.error('[aiTryOn] 手机号登录失败:', err)
				uni.showToast({ title: '登录失败，请重试', icon: 'none' })
			}
		},

		// 打开头像昵称授权弹窗
		openProfilePopup() {
			const info = getUserInfo()
			this.profileAvatarUrl = info?.avatarUrl || ''
			this.profileNickname = info?.nickname || ''
			this.showProfilePopup = true
		},

		// 用户选择头像回调
		onChooseAvatar(e: any) {
			const url = e?.detail?.avatarUrl
			if (url) this.profileAvatarUrl = String(url)
		},

		// 提交头像昵称
		async submitProfile() {
			const nickname = (this.profileNickname || '').trim()
			const avatarUrl = this.profileAvatarUrl || ''
			if (nickname === '' && avatarUrl === '') {
				this.skipProfile()
				return
			}
			// 乐观写入：保证后端响应不带 avatarUrl 时，本地仍能立即展示当会话头像
			const optimistic: UserInfo = {
				id: 0,
				openid: '',
				phone: null,
				nickname: nickname !== '' ? nickname : null,
				avatarUrl: avatarUrl !== '' ? avatarUrl : null
			}
			mergeUserInfo(optimistic)
			try {
				uni.showLoading({ title: '更新中...', mask: true })
				const result = await submitUserProfile({
					nickname: nickname !== '' ? nickname : undefined,
					avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
				})
				uni.hideLoading()
				if (!result.ok) {
					uni.showToast({ title: result.errorMsg || '更新失败', icon: 'none' })
				}
			} catch (err) {
				console.error('[aiTryOn] 更新头像昵称失败:', err)
				uni.hideLoading()
				uni.showToast({ title: '更新失败，请重试', icon: 'none' })
			} finally {
				this.finishProfile()
			}
		},

		skipProfile() {
			this.finishProfile()
		},

		finishProfile() {
			this.showProfilePopup = false
			this.profileAvatarUrl = ''
			this.profileNickname = ''
			uni.showToast({ title: '登录成功', icon: 'success' })
		}
	}
}
</script>

<style>
.page {
	background: #000;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	padding-bottom: 0;
}

/* 提示文案 */
.tip-bar {
	padding: 20rpx 0;
	display: flex;
	align-items: center;
	justify-content: center;
}
.tip-text {
	font-size: 26rpx;
	color: rgba(255, 255, 255, 0.5);
}

/* 模板轮播 */
.swiper-wrap {
	width: 100%;
	padding: 0 0 20rpx;
}
.template-swiper {
	width: 100%;
	height: 780rpx;
}
.template-img {
	width: 100%;
	height: 780rpx;
}
.template-empty {
	width: 100%;
	height: 780rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(255, 255, 255, 0.05);
}
.template-empty-text {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.3);
}

/* 通用 section */
.section {
	padding: 24rpx 40rpx;
}
.section-label {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.7);
	margin-bottom: 20rpx;
}

/* 体型选择 */
.body-type-row {
	display: flex;
	flex-direction: row;
	margin-top: 20rpx;
	border-radius: 44rpx;
	overflow: hidden;
	border-width: 1rpx;
	border-style: solid;
	border-color: rgba(255, 255, 255, 0.1);
}
.body-btn {
	flex: 1;
	height: 72rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: transparent;
  margin: 8rpx;
  border-radius: 44rpx;
}
.body-btn-active {
	background-color: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.body-btn-text {
	font-size: 28rpx;
	color: #fff;
}

/* 年龄选择 */
.age-picker {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	height: 80rpx;
	border-radius: 44rpx;
	border-width: 1rpx;
	border-style: solid;
	border-color: rgba(255, 255, 255, 0.1);
	padding: 0 32rpx;
	margin-top: 20rpx;
}
.age-picker-text {
	font-size: 28rpx;
	color: #fff;
}
.age-picker-arrow {
	width: 0;
	height: 0;
	border-left: 8rpx solid transparent;
	border-right: 8rpx solid transparent;
	border-top: 10rpx solid rgba(255, 255, 255, 0.6);
}

/* 照片上传 */
.upload-area {
	margin-top: 20rpx;
	width: 100%;
	min-height: 320rpx;
	border-radius: 16rpx;
	border-width: 2rpx;
	border-style: dashed;
	border-color: rgba(255, 255, 255, 0.3);
	background-color: rgba(255, 255, 255, 0.05);
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}
.upload-placeholder {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}
.upload-plus {
	font-size: 64rpx;
	color: rgba(255, 255, 255, 0.5);
	margin-bottom: 16rpx;
}
.upload-hint {
	font-size: 26rpx;
	color: rgba(255, 255, 255, 0.4);
}
.upload-preview {
	width: 100%;
}

/* 底部占位 */
.bottom-spacer {
	height: 260rpx;
}

/* 底部固定 */
.fixed-bottom {
	position: fixed;
	left: 0;
	bottom: 0;
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 24rpx 40rpx;
	padding-bottom: 40rpx;
	background-color: #000;
}

/* 生成按钮 */
.generate-btn {
	width: 520rpx;
	height: 88rpx;
	border-radius: 44rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background: linear-gradient(109deg, #f2949f 12%, #d7a3bf 31%, #a0a6ec 51%, #9daeea 71%, #7bace3 91%);
}
.generate-btn-disabled {
	opacity: 0.4;
}
.generate-btn-text {
	font-size: 32rpx;
	color: #fff;
	font-weight: 500;
}
.generate-btn-ai {
	font-size: 32rpx;
	color: #fff;
	font-weight: 700;
}

/* Copyright */
.footer-copyright {
	margin-top: 20rpx;
	font-size: 20rpx;
	color: rgba(255, 255, 255, 0.5);
}
</style>
