<template>
	<view class="page">
		<CustomNavBar title="AI试衣" />
		<!-- 提示文案 -->
		<view class="tip-bar">
			<text class="tip-text">左右横向滑动支持切换模板</text>
		</view>

		<!-- 服饰模板轮播 -->
		<view class="swiper-wrap">
			<swiper
				class="template-swiper"
				:indicator-dots="true"
				indicator-color="rgba(255,255,255,0.3)"
				indicator-active-color="#fff"
				:circular="true"
				:current="currentTemplateIndex"
				@change="onSwiperChange"
			>
				<swiper-item v-for="(item, index) in templates" :key="index">
					<image class="template-img" :src="item.imageUrl" mode="aspectFill"></image>
				</swiper-item>
			</swiper>
		</view>

		<!-- 体型选择 -->
		<view class="section">
			<text class="section-label">选择您的体型：</text>
			<view class="body-type-row">
				<view
					:class="bodyType === 'slim' ? 'body-btn body-btn-active' : 'body-btn'"
					@click="selectBodyType('slim')"
				>
					<text :class="bodyType === 'slim' ? 'body-btn-text body-btn-text-active' : 'body-btn-text'">瘦</text>
				</view>
				<view
					:class="bodyType === 'medium' ? 'body-btn body-btn-active' : 'body-btn'"
					@click="selectBodyType('medium')"
				>
					<text :class="bodyType === 'medium' ? 'body-btn-text body-btn-text-active' : 'body-btn-text'">微胖</text>
				</view>
				<view
					:class="bodyType === 'fat' ? 'body-btn body-btn-active' : 'body-btn'"
					@click="selectBodyType('fat')"
				>
					<text :class="bodyType === 'fat' ? 'body-btn-text body-btn-text-active' : 'body-btn-text'">胖</text>
				</view>
			</view>
		</view>

		<!-- 年龄选择 -->
		<view class="section">
			<text class="section-label">选择您的年龄：</text>
			<picker mode="selector" :range="ageOptions" :value="ageIndex" @change="selectAge">
				<view class="age-picker">
					<text class="age-picker-text">{{ ageRange }}</text>
					<view class="age-picker-arrow"></view>
				</view>
			</picker>
		</view>

		<!-- 照片上传 -->
		<view class="section">
			<text class="section-label">上传你的照片：</text>
			<view class="upload-area" @click="choosePhoto">
				<image v-if="photoPreviewUrl" class="upload-preview" :src="photoPreviewUrl" mode="widthFix"></image>
				<view v-else class="upload-placeholder">
					<text class="upload-plus">+</text>
					<text class="upload-hint">点击上传你的照片</text>
				</view>
				<view v-if="isUploading" class="upload-mask">
					<text class="upload-mask-text">上传中...</text>
				</view>
				<view v-else-if="photoPreviewUrl && uploadedFilename === ''" class="upload-mask upload-mask-fail">
					<text class="upload-mask-text">上传失败，点击重试</text>
				</view>
			</view>
		</view>

		<!-- 底部占位（给固定按钮腾出空间） -->
		<view class="bottom-spacer"></view>

		<!-- 底部固定生成按钮 -->
		<view class="fixed-bottom">
			<!-- 付费模式且无限免次数：原按钮样式 + 价格文案，点击引导充值/兑换 -->
			<view v-if="isPaidMode && creditBalance <= 0" class="gen-btn-wrap">
				<image src="/static/btn-left-icon.png" class="gen-btn-icon" mode="aspectFill"/>
				<view
					:class="(uploadedFilename !== '' && !isUploading) ? 'generate-btn' : 'generate-btn generate-btn-disabled'"
					@click="handleGenerate"
				>
					<text class="generate-btn-ai">¥{{ priceText }}</text>
					<text class="generate-btn-text"> 马上生成 </text>
					<image src="/static/aitry-text.png" class="generate-btn-ai-img" mode="aspectFill"/>
					<text class="generate-btn-text"> 效果</text>
				</view>
				<image src="/static/btn-right-icon.png" class="gen-btn-icon" mode="aspectFill"/>
			</view>
			<!-- 非付费模式或有限免次数：原样式按钮，有限免时右上角展示角标 -->
			<view v-else class="gen-btn-wrap">
				<image src="/static/btn-left-icon.png" class="gen-btn-icon" mode="aspectFill"/>
				<view
					:class="(uploadedFilename !== '' && !isUploading) ? 'generate-btn' : 'generate-btn generate-btn-disabled'"
					@click="handleGenerate"
				>
					<text class="generate-btn-text">生成 </text>
					<image src="/static/aitry-text.png" class="generate-btn-ai-img" mode="aspectFill"/>
					<text class="generate-btn-text"> 效果</text>
				</view>
				<image src="/static/btn-right-icon.png" class="gen-btn-icon" mode="aspectFill"/>
				<!-- 角标放在最后渲染，避免被右侧 icon 盖住 -->
				<view v-if="isPaidMode && creditBalance > 0" class="gen-btn-badge">
					<text class="gen-btn-badge-text">限时免费 {{ creditBalance }} 次</text>
				</view>
			</view>
			<view class="footer-copyright">
				<AppFooter />
			</view>
		</view>

		<!-- 登录弹窗 -->
		<view v-if="showLoginPopup" class="login-overlay" @click="closeLoginPopup">
			<view class="login-popup login-auth-popup" @click.stop>
				<view class="login-popup-title">微信授权登陆</view>
				<view class="login-agreement-row">
					<view
						:class="loginAgreementChecked ? 'login-agreement-check is-checked' : 'login-agreement-check'"
						@click.stop="toggleLoginAgreement"
					>
						<view v-if="loginAgreementChecked" class="login-agreement-dot"></view>
					</view>
					<text class="login-agreement-text"><text>登录即代表同意 </text><text class="login-agreement-link" @click.stop="openUserAgreement">{{ userAgreementName }}</text><text>、</text><text class="login-agreement-link" @click.stop="openPrivacyPolicy">{{ privacyPolicyName }}</text></text>
				</view>
				<button
					v-if="loginAgreementChecked"
					class="login-phone-btn"
					open-type="getPhoneNumber"
					@getphonenumber="onGetPhoneNumber"
				>一键登录</button>
				<button
					v-else
					class="login-phone-btn"
					@click="showLoginAgreementToast"
				>一键登录</button>
				<view class="login-cancel login-cancel-btn" @click="closeLoginPopup">暂不登陆</view>
			</view>
		</view>

		<!-- 头像昵称授权弹窗 -->
		<view v-if="showProfilePopup" class="login-overlay" @click="skipProfile">
			<view class="login-popup" @click.stop>
				<view class="login-popup-title">完善个人资料</view>
				<view class="login-popup-desc">设置头像和昵称以获得完整体验</view>
				<button
					class="profile-avatar-btn"
					open-type="chooseAvatar"
					@chooseavatar="onChooseAvatar"
				>
					<image class="profile-avatar-img" :src="profileAvatarUrl || '/static/mine.svg'" mode="aspectFill"></image>
					<text class="profile-avatar-tip">点击选择头像</text>
				</button>
				<view class="profile-nickname-row">
					<text class="profile-nickname-label">昵称</text>
					<input class="profile-nickname-input" type="nickname" placeholder="请输入昵称" v-model="profileNickname"/>
				</view>
				<button class="login-phone-btn" @click="submitProfile">确认</button>
				<view class="login-cancel" @click="skipProfile">跳过</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
import { getAiTemplates, uploadPhoto, submitAiTryOn, rejectAllPendingUploads, getCreditBalance, createCreditRecharge, getCreditRechargeStatus } from '../../utils/api.uts'
import { isLoggedIn, getUserInfo, mergeUserInfo, UserInfo, consumeLoginExpired } from '../../utils/auth.uts'
import { runPhoneLogin } from '../../utils/loginFlow.uts'
import { submitUserProfile } from '../../utils/profileSubmit.uts'
import { rejectAllPending } from '../../utils/http.uts'
import {
	USER_AGREEMENT_NAME,
	PRIVACY_POLICY_NAME,
	openUserAgreement,
	openPrivacyPolicy
} from '../../utils/legal.uts'

export default {
	data() {
		return {
			shopId: '',
			category: '',
			subCategory: '',
			style: '',
			gender: '',
			templates: [] as any[],
			currentTemplateIndex: 0,
			bodyType: 'slim',
			ageRange: '10岁及以下',
			ageOptions: ['10岁及以下', '11-18岁', '19-30岁', '31-45岁', '46-60岁', '60岁以上'],
			ageIndex: 0,
			photoPath: '',
			photoPreviewUrl: '',
			uploadedFilename: '',
			isUploading: false,
			isSubmitting: false,
			// 登录弹窗
			showLoginPopup: false,
			loginAgreementChecked: false,
			userAgreementName: USER_AGREEMENT_NAME,
			privacyPolicyName: PRIVACY_POLICY_NAME,
			// 头像昵称授权弹窗
			showProfilePopup: false,
			profileAvatarUrl: '',
			profileNickname: '',
			// 试衣次数 / 支付
			creditBalance: -1,        // 剩余次数，-1 = 未查询到
			priceFenPerCredit: 0,     // 单次价格（分），0 = 未开通付费购买（非付费模式）
			creditLoaded: false,      // 是否已成功查询到余额
			isPaying: false,
			resumeGenerateAfterCredit: false, // 支付成功后自动继续生成
			payPollToken: 0           // 到账轮询会话标记，自增即失效
		}
	},
	computed: {
		// 付费模式：已查询到余额且商户配置了单次价格
		isPaidMode(): boolean {
			return this.creditLoaded && this.priceFenPerCredit > 0
		},
		// 单次价格文案（分 → 元，整元去小数）
		priceText(): string {
			const fen = this.priceFenPerCredit
			if (fen <= 0) return '0'
			if (fen % 100 === 0) return `${fen / 100}`
			return (fen / 100).toFixed(2)
		}
	},
	onLoad(options) {
		if (options && options.shopId) {
			this.shopId = String(options.shopId)
		}
		if (options && options.category) {
			this.category = String(options.category)
		}
		if (options && options.subCategory) {
			this.subCategory = String(options.subCategory)
		} else if (options && options.sub_category) {
			this.subCategory = String(options.sub_category)
		}
		if (options && options.style) {
			this.style = decodeURIComponent(String(options.style))
		}
		if (options && options.gender) {
			this.gender = String(options.gender)
		}
		this.loadTemplates()
	},
	onShow() {
		// 监听 401 登录过期事件，自动拉起登录弹窗
		uni.$off('login-required')
		uni.$on('login-required', () => {
			this.showLoginPopup = true
		})
		// 兑底：其他页面触发 401 后导航回来时自动弹出
		if (consumeLoginExpired()) {
			this.showLoginPopup = true
		}
		// 查询试衣次数余额（需登录；未登录时保持原按钮，避免进页即拉起登录）
		if (isLoggedIn()) {
			this.loadCreditInfo()
		}
	},
	onHide() {
		uni.$off('login-required')
		// 页面隐藏时终止可能进行中的到账轮询
		this.payPollToken = this.payPollToken + 1
	},
	methods: {
		async loadTemplates() {
			try {
				const params: Record<string, any> = { category: 'travel' }
				if (this.style) params.style = this.style
				if (this.gender) params.gender = this.gender
				const res = await getAiTemplates(params)
				if ((res.code === 0 || res.code === 200) && res.data) {
					this.templates = res.data
				}
			} catch (err) {
				console.error('加载模板失败:', err)
			}
		},

		onSwiperChange(e: any) {
			this.currentTemplateIndex = e.detail.current
		},

		selectBodyType(type: string) {
			this.bodyType = type
		},

		selectAge(e: any) {
			const index = e.detail.value
			this.ageIndex = index
			this.ageRange = this.ageOptions[index]
		},

		choosePhoto() {
			if (this.isUploading) return
			// 上传前检查登录态，未登录先拉起登录弹窗
			if (!isLoggedIn()) {
				this.showLoginPopup = true
				return
			}
			uni.chooseImage({
				count: 1,
				sizeType: ['compressed'],
				sourceType: ['album', 'camera'],
				success: (res) => {
					const tempFile = res.tempFiles[0]
					// 检查文件大小 10MB
					if (tempFile.size > 10 * 1024 * 1024) {
						uni.showToast({ title: '照片大小不能超过10MB', icon: 'none' })
						return
					}
					this.photoPath = res.tempFilePaths[0]
					this.photoPreviewUrl = res.tempFilePaths[0]
					// 选择后立即上传
					this.uploadSelectedPhoto()
				}
			})
		},

		async uploadSelectedPhoto() {
			if (!this.photoPath) return
			this.isUploading = true
			this.uploadedFilename = ''
			uni.showLoading({ title: '上传中...', mask: true })
			try {
				const uploadRes = await uploadPhoto(this.photoPath)
				if ((uploadRes.code === 0 || uploadRes.code === 200) && uploadRes.data) {
					this.uploadedFilename = uploadRes.data.filename
				} else {
					this.uploadedFilename = ''
					uni.showToast({ title: uploadRes.message || '照片上传失败，请重新选择', icon: 'none' })
				}
			} catch (err) {
				console.error('照片上传失败:', err)
				this.uploadedFilename = ''
				uni.showToast({ title: '照片上传失败，请重新选择', icon: 'none' })
			} finally {
				this.isUploading = false
				uni.hideLoading()
			}
		},

		bodyTypeText(): string {
			if (this.bodyType === 'medium') return '微胖'
			if (this.bodyType === 'fat') return '胖'
			return '瘦'
		},

		async handleGenerate() {
			if (this.isSubmitting) return

			// 检查登录态
			if (!isLoggedIn()) {
				this.showLoginPopup = true
				return
			}

			// 上传中提示
			if (this.isUploading) {
				uni.showToast({ title: '照片上传中，请稍候', icon: 'none' })
				return
			}

			// 检查是否已上传完成
			if (!this.photoPath) {
				uni.showToast({ title: '请先上传照片', icon: 'none' })
				return
			}
			if (this.uploadedFilename === '') {
				uni.showToast({ title: '照片上传失败，请重新选择', icon: 'none' })
				return
			}

			// 检查模板
			if (this.templates.length === 0) {
				uni.showToast({ title: '暂无可用模板', icon: 'none' })
				return
			}

			const currentTemplate = this.templates[this.currentTemplateIndex]
			if (!currentTemplate) {
				uni.showToast({ title: '请选择模板', icon: 'none' })
				return
			}

			// 付费模式且已知无剩余次数：直接拉起支付，省一次必败请求
			if (this.isPaidMode && this.creditBalance <= 0) {
				this.handleRecharge()
				return
			}

			this.isSubmitting = true
			uni.showLoading({ title: '提交中...', mask: true })

			try {
				const userInfo = getUserInfo()
				const userOpenid = userInfo?.openid || ''
				const submitParams: Record<string, any> = {
					templateId: currentTemplate.id,
					userPhotoFilename: this.uploadedFilename,
					shopId: parseInt(this.shopId) || 0,
					category: 'travel',
					bodyType: this.bodyTypeText(),
					ageRange: this.ageRange
				}
				if (userOpenid !== '') submitParams.userOpenid = userOpenid

				// 创建AI试衣任务（code === 0 表示成功；code !== 0 统一以 message toast）
				const submitRes = await submitAiTryOn(submitParams as any)

				if ((submitRes.code === 0 || submitRes.code === 200) && submitRes.data) {
					// 任务创建成功即扣 1 次，本地余额同步 -1（角标实时刷新）
					if (this.isPaidMode && this.creditBalance > 0) {
						this.creditBalance = this.creditBalance - 1
					}
					uni.navigateTo({
						url: `/pages/aiTryOnResult/index?taskId=${submitRes.data.task_id}&shopId=${this.shopId}`
					})
				} else if (submitRes.code === 4001) {
					// 试衣次数不足 → 直接拉起支付
					this.creditBalance = 0
					this.handleRecharge()
				} else {
					uni.showToast({ title: submitRes.message || '提交失败', icon: 'none' })
				}
			} catch (err) {
				console.error('生成AI试衣失败:', err)
				uni.showToast({ title: '提交失败，请重试', icon: 'none' })
			} finally {
				this.isSubmitting = false
				uni.hideLoading()
			}
		},

		// ========== 试衣次数 / 支付 ==========

		// 查询试衣次数余额与单次定价（失败时静默，保持原按钮）
		async loadCreditInfo() {
			try {
				const shopIdNum = parseInt(this.shopId) || 0
				const res = await getCreditBalance(shopIdNum > 0 ? shopIdNum : undefined)
				if (res.code === 200 && res.data) {
					this.creditBalance = res.data.balance
					this.priceFenPerCredit = res.data.priceFenPerCredit
					this.creditLoaded = true
				}
			} catch (err) {
				console.error('[aiTryOn] 查询试衣次数失败:', err)
			}
		},

		// 充值：创建订单 → 拉起微信支付 → 轮询到账
		async handleRecharge() {
			if (this.isPaying) return
			this.isPaying = true
			// 支付由生成流程触发，到账后自动继续生成
			this.resumeGenerateAfterCredit = true
			try {
				const shopIdNum = parseInt(this.shopId) || 0
				const res = await createCreditRecharge({ shopId: shopIdNum, credits: 1 })
				if (res.code !== 200 || !res.data) {
					this.isPaying = false
					uni.showToast({ title: res.message || '下单失败，请重试', icon: 'none' })
					return
				}
				const order = res.data
				const outTradeNo = order.outTradeNo
				uni.requestPayment({
					provider: 'wxpay',
					timeStamp: order.timeStamp,
					nonceStr: order.nonceStr,
					package: order.package,
					signType: order.signType,
					paySign: order.paySign,
					success: () => {
						// 支付成功：到账为微信异步回调入账，轮询订单状态确认
						this.pollRechargeStatus(outTradeNo)
					},
					fail: (payErr: any) => {
						this.isPaying = false
						const errMsg: string = payErr?.errMsg ?? ''
						if (errMsg.indexOf('cancel') !== -1) {
							uni.showToast({ title: '已取消支付', icon: 'none' })
						} else {
							console.error('[aiTryOn] 拉起支付失败:', errMsg)
							uni.showToast({ title: '支付未完成，请重试', icon: 'none' })
						}
					}
				} as any)
			} catch (err) {
				this.isPaying = false
				console.error('[aiTryOn] 创建充值订单失败:', err)
				uni.showToast({ title: '下单失败，请重试', icon: 'none' })
			}
		},

		// 轮询充值订单状态：每 2.5 秒一次，最多 48 次（约 2 分钟兜底），paid = true 即到账
		pollRechargeStatus(outTradeNo: string) {
			this.payPollToken = this.payPollToken + 1
			const token = this.payPollToken
			const maxTimes = 48
			let count = 0
			uni.showLoading({ title: '确认到账中...', mask: true })
			const check = async () => {
				if (token !== this.payPollToken) {
					uni.hideLoading()
					return
				}
				count = count + 1
				try {
					const res = await getCreditRechargeStatus(outTradeNo)
					if (res.code === 200 && res.data && res.data.paid) {
						uni.hideLoading()
						this.isPaying = false
						this.creditBalance = res.data.balance
						uni.showToast({ title: `支付成功，${res.data.credits} 次到账`, icon: 'none' })
						this.resumeGenerateIfNeeded()
						return
					}
				} catch (err) {
					console.error('[aiTryOn] 查询充值状态失败:', err)
				}
				if (count >= maxTimes) {
					uni.hideLoading()
					this.isPaying = false
					uni.showToast({ title: '到账确认超时，请稍后查看余额', icon: 'none' })
					return
				}
				setTimeout(check, 2500)
			}
			check()
		},

		// 支付到账后，自动继续之前被打断的生成
		resumeGenerateIfNeeded() {
			if (this.resumeGenerateAfterCredit) {
				this.resumeGenerateAfterCredit = false
				this.handleGenerate()
			}
		},

		// ========== 登录弹窗相关 ==========
		closeLoginPopup() {
			this.showLoginPopup = false
			this.loginAgreementChecked = false
			// 用户主动取消登录，reject 所有挂起的 401 请求
			rejectAllPending()
			rejectAllPendingUploads()
		},

		toggleLoginAgreement() {
			this.loginAgreementChecked = !this.loginAgreementChecked
		},

		showLoginAgreementToast() {
			uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
		},

		openUserAgreement() {
			openUserAgreement()
		},

		openPrivacyPolicy() {
			openPrivacyPolicy()
		},

		// 手机号授权回调
		async onGetPhoneNumber(e: any) {
			if (!this.loginAgreementChecked) {
				this.showLoginAgreementToast()
				return
			}
			const detail = e.detail || {}

			// 用户拒绝授权
			if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
				if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
					uni.showToast({ title: '已取消授权', icon: 'none' })
				} else {
					console.error('[aiTryOn] 手机号授权失败:', detail.errMsg)
					uni.showToast({ title: '授权失败，请重试', icon: 'none' })
				}
				this.closeLoginPopup()
				return
			}

			const phoneCode = detail.code
			if (!phoneCode) {
				console.error('[aiTryOn] 未获取到 phoneCode，detail:', JSON.stringify(detail))
				uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
				this.closeLoginPopup()
				return
			}

			try {
				uni.showLoading({ title: '登录中...', mask: true })
				// 登录三步骤已下沉到 utils/loginFlow.uts
				const result = await runPhoneLogin(phoneCode)
				uni.hideLoading()

				if (!result.ok) {
					if (result.errorKind === 'login') {
						uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
					} else {
						uni.showToast({ title: result.errorMsg || '登录失败', icon: 'none' })
					}
					this.closeLoginPopup()
					return
				}

				// 关闭手机号登录弹窗
				this.showLoginPopup = false
				this.loginAgreementChecked = false
				// 登录成功后查询试衣次数余额（首次查询后端会惰性发放免费次数）
				this.loadCreditInfo()
				if (result.phoneHasFullProfile) {
					// 后端已带头像昵称 → 直接登录完成
					uni.showToast({ title: '登录成功', icon: 'success' })
				} else {
					// 缺头像或昵称 → 弹出授权弹窗补齐
					this.openProfilePopup()
				}
			} catch (err) {
				uni.hideLoading()
				console.error('[aiTryOn] 手机号登录失败:', err)
				uni.showToast({ title: '登录失败，请重试', icon: 'none' })
			}
		},

		// 打开头像昵称授权弹窗
		openProfilePopup() {
			const info = getUserInfo()
			this.profileAvatarUrl = info?.avatarUrl || ''
			this.profileNickname = info?.nickname || ''
			this.showProfilePopup = true
		},

		// 用户选择头像回调
		onChooseAvatar(e: any) {
			const url = e?.detail?.avatarUrl
			if (url) this.profileAvatarUrl = String(url)
		},

		// 提交头像昵称
		async submitProfile() {
			const nickname = (this.profileNickname || '').trim()
			const avatarUrl = this.profileAvatarUrl || ''
			if (nickname === '' && avatarUrl === '') {
				this.skipProfile()
				return
			}
			// 乐观写入：保证后端响应不带 avatarUrl 时，本地仍能立即展示当会话头像
			const optimistic: UserInfo = {
				id: 0,
				openid: '',
				phone: null,
				nickname: nickname !== '' ? nickname : null,
				avatarUrl: avatarUrl !== '' ? avatarUrl : null
			}
			mergeUserInfo(optimistic)
			try {
				uni.showLoading({ title: '更新中...', mask: true })
				const result = await submitUserProfile({
					nickname: nickname !== '' ? nickname : undefined,
					avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
				})
				uni.hideLoading()
				if (!result.ok) {
					uni.showToast({ title: result.errorMsg || '更新失败', icon: 'none' })
				}
			} catch (err) {
				console.error('[aiTryOn] 更新头像昵称失败:', err)
				uni.hideLoading()
				uni.showToast({ title: '更新失败，请重试', icon: 'none' })
			} finally {
				this.finishProfile()
			}
		},

		skipProfile() {
			this.finishProfile()
		},

		finishProfile() {
			this.showProfilePopup = false
			this.profileAvatarUrl = ''
			this.profileNickname = ''
			uni.showToast({ title: '登录成功', icon: 'success' })
		}
	}
}
</script>

