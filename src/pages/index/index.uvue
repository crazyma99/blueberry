<template>
	<view class="container">
		<!-- 首页无导航栏：Banner 沉浸式延伸到状态栏顶部 -->
		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-banner sk-animate" style="height: 794rpx;"></view>
			<view class="sk-title sk-animate"></view>
			<view class="sk-subtitle sk-animate"></view>
			<view class="sk-row">
				<view class="sk-photo-card sk-animate"></view>
				<view class="sk-photo-card sk-animate"></view>
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else class="main-content">
			<!-- 顶部通栏轮播：无指示点；文案已烘焙进 banner 图，高度随首图宽高比自适应避免裁切 -->
			<swiper class="hero" autoplay circular :interval="3000" :duration="500" :style="{ height: heroHeight }">
				<swiper-item v-for="(item, idx) in banners" :key="idx">
					<image class="hero-image" :src="item.imageUrl" mode="aspectFill" @load="onHeroImageLoad"></image>
				</swiper-item>
			</swiper>

			<!-- 客片欣赏：shop-container.png 以 border-image 点九图方式作背景，高度由内容撑开 -->
			<view class="shop-section">
				<view class="shop-content">
					<view class="shop-header-wrap">
						<image class="shop-top" src="/static/shop-container-top.png" mode="aspectFill" />
					</view>
					<view class="shop-container">
						<view class="shop-inner-line"></view>
						<view class="shop-header">
							<view class="shop-title-wrap">
								<text class="shop-title font-noto-serif">客片欣赏</text>
								<text class="shop-subtitle">COLLECTION</text>
							</view>
						</view>
						<view class="photo-grid">
							<view
								v-for="(shop, index) in shopList"
								:key="index"
								:class="shopList.length === 1 ? 'photo-card photo-card-full' : 'photo-card'"
								@click="onShopClick(shop)"
							>
								<image class="photo-card-img" :src="shop.homeImage" mode="aspectFill"></image>
								<view class="photo-card-mask"></view>
								<view class="photo-card-info">
									<text class="photo-card-name font-noto-serif">{{ shop.displayName }}</text>
									<text class="photo-card-sub">{{ shop.displayNameEn }}</text>
								</view>
							</view>
							<!-- 无店铺时 fallback：demo 图，同 2 列布局 -->
							<view v-if="shopList.length === 0" class="photo-card" @click="onDemoClick(1)">
								<image class="photo-card-img" src="/static/demo1.png" mode="aspectFill"></image>
							</view>
							<view v-if="shopList.length === 0" class="photo-card" @click="onDemoClick(2)">
								<image class="photo-card-img" src="/static/demo2.png" mode="aspectFill"></image>
							</view>
						</view>
					</view>
				</view>
			</view>
			<!-- 服务保障 + 联系我们（已抽为 ServiceContact 组件，样式随组件迁移） -->
			<ServiceContact />
			<view class="page-footer">
				<view class="beian"><AppFooter /></view>
			</view>
		</view>

		<!-- 登录弹窗 -->
		<view v-if="showLoginPopup" class="login-overlay login-overlay-above-tab" @click="closeLoginPopup">
			<view class="login-popup login-auth-popup" @click.stop>
				<view class="login-popup-title">手机号快捷登陆</view>
				<view class="login-agreement-row">
					<view
						:class="loginAgreementChecked ? 'login-agreement-check is-checked' : 'login-agreement-check'"
						@click.stop="toggleLoginAgreement"
					>
						<view v-if="loginAgreementChecked" class="login-agreement-dot"></view>
					</view>
					<text class="login-agreement-text"><text>登录即代表同意 </text><text class="login-agreement-link" @click.stop="openUserAgreement">{{ userAgreementName }}</text><text>、</text><text class="login-agreement-link" @click.stop="openPrivacyPolicy">{{ privacyPolicyName }}</text></text>
				</view>
				<button
					v-if="loginAgreementChecked"
					class="login-phone-btn"
					open-type="getPhoneNumber"
					@getphonenumber="onGetPhoneNumber"
				>一键登录</button>
				<button
					v-else
					class="login-phone-btn"
					@click="showLoginAgreementToast"
				>一键登录</button>
				<view class="login-cancel login-cancel-btn" @click="closeLoginPopup">暂不登陆</view>
			</view>
		</view>

		<!-- 头像昵称授权弹窗 -->
		<view v-if="showProfilePopup" class="login-overlay login-overlay-above-tab" @click="skipProfile">
			<view class="login-popup" @click.stop>
				<view class="login-popup-title">完善个人资料</view>
				<view class="login-popup-desc">设置头像和昵称以获得完整体验</view>
				<button
					class="profile-avatar-btn"
					open-type="chooseAvatar"
					@chooseavatar="onChooseAvatar"
				>
					<image class="profile-avatar-img" :src="profileAvatarUrl || '/static/mine.svg'" mode="aspectFill"></image>
					<text class="profile-avatar-tip">点击选择头像</text>
				</button>
				<view class="profile-nickname-row">
					<text class="profile-nickname-label">昵称</text>
					<input class="profile-nickname-input" type="nickname" placeholder="请输入昵称" v-model="profileNickname"/>
				</view>
				<button class="login-phone-btn" @click="submitProfile">确认</button>
				<view class="login-cancel" @click="skipProfile">跳过</view>
			</view>
		</view>

		<!-- 自定义底部 tabbar 占位（116rpx + 安全区） -->
		<view class="tabbar-safe-spacer"></view>
	</view>
</template>

<script>
	import { getImage, getShops, wxLogin, wxBindPhone, wxUpdateUserInfo, rejectAllPendingUploads } from '../../utils/api.uts'
	import { rejectAllPending } from '../../utils/http.uts'
	import { loginSuccess, setUserInfo, mergeUserInfo, getUserInfo, consumeLoginExpired } from '../../utils/auth.uts'
	import { runPhoneLogin } from '../../utils/loginFlow.uts'
	import { submitUserProfile } from '../../utils/profileSubmit.uts'
	import { setBrandId } from '../../utils/brand.uts'
	import { syncTabBarSelected } from '../../utils/tabbar.uts'
	import { cosThumb } from '../../utils/imageLoader.uts'
	import {
		USER_AGREEMENT_NAME,
		PRIVACY_POLICY_NAME,
		openUserAgreement,
		openPrivacyPolicy
	} from '../../utils/legal.uts'

	export default {
		data() {
			return {
				loading: true,
				banners: [],
				shopList: [],
				// 轮播高度：随首张 banner 图宽高比自适应（兜底 794rpx ≈ 设计稿比例）
				heroHeight: '794rpx',
				heroHeightReady: false,
				showLoginPopup: false,
				loginAgreementChecked: false,
				userAgreementName: USER_AGREEMENT_NAME,
				privacyPolicyName: PRIVACY_POLICY_NAME,
				// 头像昵称授权弹窗
				showProfilePopup: false,
				profileAvatarUrl: '',
				profileNickname: '',
				// profile 弹窗是否由登录流程拉起（仅登录流程关闭弹窗时才弹"登录成功"toast）
				profileFromLogin: false
			}
		},
		async onLoad(options : any) {
			// 扫品牌小程序码进入：场景值写入品牌上下文（纯内存，冷启动即恢复默认逻辑）
			const scene = decodeURIComponent(options?.scene || '')
			const brandId = scene !== '' ? scene : (options?.brandId ?? '')
			if (brandId !== '') {
				setBrandId(brandId)
			}
			try {
				// 并行加载轮播图和店铺列表
				const [bannerRes, shopRes] = await Promise.all([
					getImage('get', { type: 0 }).catch(() => null),
					getShops().catch(() => null)
				])
				if (bannerRes && bannerRes.code === 200) {
					// banner 出 750px WebP 缩略图，降低内存占用
					this.banners = (bannerRes.data || []).map(item => {
						item.imageUrl = cosThumb(item.imageUrl, 750)
						return item
					})
				}
				if (shopRes && shopRes.code === 200 && shopRes.data) {
					// 网格封面图出 600px WebP 缩略图
					this.shopList = shopRes.data.map(item => {
						item.homeImage = cosThumb(item.homeImage, 600)
						return item
					})
				}
			} catch (err) {
				console.warn('加载首页数据失败', err)
			} finally {
				this.loading = false
			}
		},
		onShow() {
			// 同步自定义底部 tabbar 选中态（本页下标 0）
			syncTabBarSelected(0)
			// 监听 401 登录过期事件，自动拉起登录弹窗
			uni.$off('login-required')
			uni.$on('login-required', () => {
				this.showLoginPopup = true
			})
			// 兑底：其他页面触发 401 后导航回来时自动弹出
			if (consumeLoginExpired()) {
				this.showLoginPopup = true
			}
		},
		onHide() {
			uni.$off('login-required')
		},
		// 右上角胶囊菜单「转发」：定义该生命周期后菜单自动亮起，无需接入额外 API
		onShareAppMessage() {
			return {
				title: '蓝梅旗袍·汉服·民族服体验馆',
				path: '/pages/index/index'
			}
		},
		// 右上角胶囊菜单「分享到朋友圈」
		onShareTimeline() {
			return {
				title: '蓝梅旗袍·汉服·民族服体验馆'
			}
		},
		methods: {
			// 关闭登录弹窗
			closeLoginPopup() {
				this.showLoginPopup = false
				this.loginAgreementChecked = false
				// 用户主动取消登录，reject 所有挂起的 401 请求
				rejectAllPending()
				rejectAllPendingUploads()
			},

			toggleLoginAgreement() {
				this.loginAgreementChecked = !this.loginAgreementChecked
			},

			showLoginAgreementToast() {
				uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
			},

			openUserAgreement() {
				openUserAgreement()
			},

			openPrivacyPolicy() {
				openPrivacyPolicy()
			},

			// 手机号授权回调
			async onGetPhoneNumber(e) {
				if (!this.loginAgreementChecked) {
					this.showLoginAgreementToast()
					return
				}
				const detail = e.detail || {}
				// 用户拒绝授权
				if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
					if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
						uni.showToast({ title: '已取消授权', icon: 'none' })
					} else {
						console.error('手机号授权失败:', detail.errMsg)
						uni.showToast({ title: '授权失败，请重试', icon: 'none' })
					}
					return
				}

				const phoneCode = detail.code
				if (!phoneCode) {
					console.error('未获取到 phoneCode，detail:', JSON.stringify(detail))
					uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
					return
				}

				try {
					uni.showLoading({ title: '登录中...', mask: true })
					// 登录三步骤已下沉到 utils/loginFlow.uts
					const result = await runPhoneLogin(phoneCode)
					uni.hideLoading()

					if (!result.ok) {
						if (result.errorKind === 'login') {
							uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
						} else {
							uni.showToast({ title: result.errorMsg || '登录失败', icon: 'none' })
						}
						return
					}

					this.showLoginPopup = false
					if (result.phoneHasFullProfile) {
						// 后端已带头像昵称 → 直接登录完成
						uni.showToast({ title: '登录成功', icon: 'success' })
					} else {
						// 缺头像或昵称 → 弹出授权弹窗补齐
						this.profileFromLogin = true
						this.openProfilePopup()
					}
				} catch (err) {
					console.error('手机号登录失败:', err)
					uni.hideLoading()
					uni.showToast({ title: '登录失败，请重试', icon: 'none' })
				}
			},

			// 打开头像昵称授权弹窗
			openProfilePopup() {
				const info = getUserInfo()
				this.profileAvatarUrl = info?.avatarUrl || ''
				this.profileNickname = info?.nickname || ''
				this.showProfilePopup = true
			},

			// 用户选择头像回调
			onChooseAvatar(e) {
				const url = e?.detail?.avatarUrl
				if (url) this.profileAvatarUrl = String(url)
			},

			// 提交头像昵称：调用 PUT /api/wx/userinfo 更新后台用户信息
			async submitProfile() {
				const nickname = (this.profileNickname || '').trim()
				const avatarUrl = this.profileAvatarUrl || ''
				// 两项都未填，等同跳过
				if (nickname === '' && avatarUrl === '') {
					this.skipProfile()
					return
				}
				// 乐观写入：先把用户刚选的头像/昵称同步到本地
				const optimistic = {
					id: 0,
					openid: '',
					phone: null,
					nickname: nickname !== '' ? nickname : null,
					avatarUrl: avatarUrl !== '' ? avatarUrl : null
				}
				mergeUserInfo(optimistic)
				try {
					uni.showLoading({ title: '更新中...', mask: true })
					const result = await submitUserProfile({
						nickname: nickname !== '' ? nickname : undefined,
						avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
					})
					uni.hideLoading()
					if (!result.ok) {
						uni.showToast({ title: result.errorMsg || '更新失败', icon: 'none' })
					}
				} catch (err) {
					console.error('更新头像昵称失败:', err)
					uni.hideLoading()
					uni.showToast({ title: '更新失败，请重试', icon: 'none' })
				} finally {
					this.finishProfile()
				}
			},

			skipProfile() {
				this.finishProfile()
			},

			finishProfile() {
				this.showProfilePopup = false
				this.profileAvatarUrl = ''
				this.profileNickname = ''
				// 只有登录流程拉起的弹窗关闭时才提示登录成功；
				// 已登录态修改资料后关闭（跳过/点蒙层）不提示
				if (this.profileFromLogin) {
					uni.showToast({ title: '登录成功', icon: 'success' })
				}
				this.profileFromLogin = false
			},

			// 首张 banner 加载完成后按图片真实宽高比设定轮播高度（只取第一次，避免后续图跳动）
			onHeroImageLoad(e) {
				if (this.heroHeightReady) return
				const w = e.detail?.width ?? 0
				const h = e.detail?.height ?? 0
				if (w > 0 && h > 0) {
					const rpx = Math.round(750 * h / w)
					this.heroHeight = Math.min(Math.max(rpx, 400), 1200) + 'rpx'
					this.heroHeightReady = true
				}
			},
			onShopClick(shop) {
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${shop.id}`
				})
			},
			onDemoClick(idx) {
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${idx}`
				})
			}
		}
	}
</script>

<style>
	.container{
		background: #160F04;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		overflow: scroll;
	}
	.main-content {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.page-footer {
		margin-top: auto;
	}
	/* 顶部通栏轮播：无指示点，高度由脚本按首图宽高比写入 */
	.hero{
		width: 100%;
		overflow: hidden;
	}
	.hero-image{
		width: 100%;
		height: 100%;
		display: block;
	}
	/* 客片欣赏：shop-container.png 以 border-image 点九图方式铺满，高度由内容撑开。
	   切片（源图 1424×486）：顶 250px 含整条金色光线（最低点 y≈240）、底 46px 含底部边线与圆角、
	   左右 42px 含圆角转角；中段透明，随内容纵向拉伸。
	   注意：border-image 仅小程序/web 端可用，App 端 uvue 原生不支持该属性。 */
	.shop-section{
		margin: 0 20rpx 40rpx;
	}
	.shop-header-wrap{
		position: relative;
		width: 710rpx;
		height: 163rpx;
		.shop-top{
			width: 100%;
			height: 100%;
			position: absolute;
		}
	}
	.shop-header{
		position: absolute;
		/* 上移 60rpx 进入切图区：只动标题自身，容器边框线位置不受影响 */
		top: -60rpx;
		left: 20rpx;
		right: 20rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.shop-title-wrap{
		display: flex;
		flex-direction: column;
	}
	.shop-title{
		font-size: 38rpx;
		font-weight: 700;
		color: #F1CD91;
	}
	.shop-subtitle{
		font-size: 14rpx;
		color: rgba(241, 205, 145, 0.7);
		font-weight: 400;
    letter-spacing: 4rpx;
	}
	.shop-container{
		position: relative;
		/* 覆盖 uni-app x view 默认 overflow: hidden，允许标题上移溢出显示 */
		overflow: visible;
		/* 顶部 padding 为标题行留位（标题 absolute 不占流，照片从 padding-top 处开始） */
		padding: 20rpx;
	}
	/* 内边框线框：内层绝对定位 view 画左/右/下三边线，缩进与内容 padding 对齐（20rpx）
	   改 left/right/bottom 为 0 即贴边（等同原 border 效果）；顶部开口与切图拼接 */
	.shop-inner-line{
		position: absolute;
		top: 0;
		left: 0rpx;
		right: 5rpx;
		bottom: 0rpx;
		border-left: 2rpx solid rgba(255, 255, 219, 0.3);
		border-right: 2rpx solid rgba(255, 255, 219, 0.3);
		border-bottom: 2rpx solid rgba(255, 255, 219, 0.3);
		/* 只保留下方两角圆角（border-radius 简写会四角同时生效） */
		border-bottom-left-radius: 24rpx;
		border-bottom-right-radius: 24rpx;
		pointer-events: none;
	}
	.photo-grid{
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 20rpx;
		/* 与上方「客片欣赏/COLLECTION」标题拉开距离 */
		margin-top: 20rpx;
	}
	.photo-card{
		position: relative;
		width: calc((100% - 20rpx) / 2);
		height: 183rpx;
		border-radius: 12rpx;
		overflow: hidden;
		border: 1rpx solid rgba(243, 217, 172, 0.35);
	}
	.photo-card-full{
		width: 100%;
	}
	.photo-card-img{
		width: 100%;
		height: 100%;
		display: block;
	}
	.photo-card-mask{
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 70%;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.75));
	}
	.photo-card-info{
		position: absolute;
		left: 0;
		right: 0;
		bottom: 10rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.photo-card-name{
		font-size: 26rpx;
		font-weight: 700;
		color: #F1CD91;
	}
	.photo-card-sub{
		margin-top: 2rpx;
		font-size: 14rpx;
		font-weight: 400;
		color: rgba(241, 205, 145, 0.7);
	}
	/* 店铺卡片网格样式见 .photo-grid / .photo-card（首页已不再使用 PhotoGrid 组件） */
	.beian{
		margin: 40rpx auto 32rpx;
		font-size: 18rpx;
		color: rgba(241, 205, 145, 0.5);
		font-weight: 400;
		text-align: center;
	}
</style>
