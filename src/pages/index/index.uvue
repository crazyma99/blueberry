<template>
	<view class="container">
		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-banner sk-animate"></view>
			<view class="sk-title sk-animate"></view>
			<view class="sk-subtitle sk-animate"></view>
			<view class="sk-row">
				<view class="sk-photo-card sk-animate"></view>
				<view class="sk-photo-card sk-animate"></view>
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else class="main-content">
			<!-- 顶部轮播图 -->
			<swiper class="banner" autoplay circular :interval="3000" :duration="500" indicator-dots
				indicator-color="rgba(255, 255, 255, 0.35)" indicator-active-color="#fff">
				<swiper-item v-for="(item, idx) in banners" :key="idx">
					<image class="banner-image" :src="item.imageUrl" mode="aspectFill"></image>
				</swiper-item>
			</swiper>
			<view class="divideTit">PHOTOGRAPHY</view>
			<view class="demoPhotoTit">客片欣赏</view>
			<PhotoGrid :shop-list="shopList" @shop-click="onShopClick" @demo-click="onDemoClick" />
			<view class="divideTit">SERVICE INFORMATION</view>
			<view class="demoPhotoTit">服务说明</view>
			<image class="service" src="/static/service.png"></image>
			<view class="divideTit">CONTACT US</view>
			<view class="demoPhotoTit">联系我们</view>
			<image
				class="code"
				src="https://www.lanmei66.cloud/admin/admin20250928234704_495_147.png"
				mode="aspectFit"
				show-menu-by-longpress="{{true}}"
			></image>
			<view class="contact">联系电话 & 商务合作</view>
			<view class="contact">18068842642（微信同号）</view>
			<view class="page-footer">
				<view class="beian"><AppFooter /></view>
			</view>
		</view>

		<!-- 登录弹窗 -->
		<view v-if="showLoginPopup" class="login-overlay" @click="closeLoginPopup">
			<view class="login-popup login-auth-popup" @click.stop>
				<view class="login-popup-title">微信授权登陆</view>
				<view class="login-agreement-row">
					<view
						:class="loginAgreementChecked ? 'login-agreement-check is-checked' : 'login-agreement-check'"
						@click.stop="toggleLoginAgreement"
					>
						<view v-if="loginAgreementChecked" class="login-agreement-dot"></view>
					</view>
					<text class="login-agreement-text"><text>登录即代表同意 </text><text class="login-agreement-link" @click.stop="openUserAgreement">{{ userAgreementName }}</text><text>、</text><text class="login-agreement-link" @click.stop="openPrivacyPolicy">{{ privacyPolicyName }}</text></text>
				</view>
				<button
					v-if="loginAgreementChecked"
					class="login-phone-btn"
					open-type="getPhoneNumber"
					@getphonenumber="onGetPhoneNumber"
				>一键登录</button>
				<button
					v-else
					class="login-phone-btn"
					@click="showLoginAgreementToast"
				>一键登录</button>
				<view class="login-cancel login-cancel-btn" @click="closeLoginPopup">暂不登陆</view>
			</view>
		</view>

		<!-- 头像昵称授权弹窗 -->
		<view v-if="showProfilePopup" class="login-overlay" @click="skipProfile">
			<view class="login-popup" @click.stop>
				<view class="login-popup-title">完善个人资料</view>
				<view class="login-popup-desc">设置头像和昵称以获得完整体验</view>
				<button
					class="profile-avatar-btn"
					open-type="chooseAvatar"
					@chooseavatar="onChooseAvatar"
				>
					<image class="profile-avatar-img" :src="profileAvatarUrl || '/static/mine.svg'" mode="aspectFill"></image>
					<text class="profile-avatar-tip">点击选择头像</text>
				</button>
				<view class="profile-nickname-row">
					<text class="profile-nickname-label">昵称</text>
					<input class="profile-nickname-input" type="nickname" placeholder="请输入昵称" v-model="profileNickname"/>
				</view>
				<button class="login-phone-btn" @click="submitProfile">确认</button>
				<view class="login-cancel" @click="skipProfile">跳过</view>
			</view>
		</view>
	</view>
</template>

<script>
	import { getImage, getShops, wxLogin, wxBindPhone, wxUpdateUserInfo, rejectAllPendingUploads } from '../../utils/api.uts'
	import { rejectAllPending } from '../../utils/http.uts'
	import { loginSuccess, setUserInfo, mergeUserInfo, getUserInfo, consumeLoginExpired } from '../../utils/auth.uts'
	import { runPhoneLogin } from '../../utils/loginFlow.uts'
	import { submitUserProfile } from '../../utils/profileSubmit.uts'
	import { setBrandId } from '../../utils/brand.uts'
	import {
		USER_AGREEMENT_NAME,
		PRIVACY_POLICY_NAME,
		openUserAgreement,
		openPrivacyPolicy
	} from '../../utils/legal.uts'

	export default {
		data() {
			return {
				loading: true,
				banners: [],
				shopList: [],
				showLoginPopup: false,
				loginAgreementChecked: false,
				userAgreementName: USER_AGREEMENT_NAME,
				privacyPolicyName: PRIVACY_POLICY_NAME,
				// 头像昵称授权弹窗
				showProfilePopup: false,
				profileAvatarUrl: '',
				profileNickname: ''
			}
		},
		async onLoad(options : any) {
			// 扫品牌小程序码进入：场景值写入品牌上下文（纯内存，冷启动即恢复默认逻辑）
			const scene = decodeURIComponent(options?.scene || '')
			const brandId = scene !== '' ? scene : (options?.brandId ?? '')
			if (brandId !== '') {
				setBrandId(brandId)
			}
			try {
				// 并行加载轮播图和店铺列表
				const [bannerRes, shopRes] = await Promise.all([
					getImage('get', { type: 0 }).catch(() => null),
					getShops().catch(() => null)
				])
				if (bannerRes && bannerRes.code === 200) {
					this.banners = bannerRes.data || []
				}
				if (shopRes && shopRes.code === 200 && shopRes.data) {
					this.shopList = shopRes.data
				}
			} catch (err) {
				console.warn('加载首页数据失败', err)
			} finally {
				this.loading = false
			}
		},
		onShow() {
			// 监听 401 登录过期事件，自动拉起登录弹窗
			uni.$off('login-required')
			uni.$on('login-required', () => {
				this.showLoginPopup = true
			})
			// 兑底：其他页面触发 401 后导航回来时自动弹出
			if (consumeLoginExpired()) {
				this.showLoginPopup = true
			}
		},
		onHide() {
			uni.$off('login-required')
		},
		// 右上角胶囊菜单「转发」：定义该生命周期后菜单自动亮起，无需接入额外 API
		onShareAppMessage() {
			return {
				title: '蓝梅旗袍·汉服·民族服体验馆',
				path: '/pages/index/index'
			}
		},
		// 右上角胶囊菜单「分享到朋友圈」
		onShareTimeline() {
			return {
				title: '蓝梅旗袍·汉服·民族服体验馆'
			}
		},
		methods: {
			// 关闭登录弹窗
			closeLoginPopup() {
				this.showLoginPopup = false
				this.loginAgreementChecked = false
				// 用户主动取消登录，reject 所有挂起的 401 请求
				rejectAllPending()
				rejectAllPendingUploads()
			},

			toggleLoginAgreement() {
				this.loginAgreementChecked = !this.loginAgreementChecked
			},

			showLoginAgreementToast() {
				uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
			},

			openUserAgreement() {
				openUserAgreement()
			},

			openPrivacyPolicy() {
				openPrivacyPolicy()
			},

			// 手机号授权回调
			async onGetPhoneNumber(e) {
				if (!this.loginAgreementChecked) {
					this.showLoginAgreementToast()
					return
				}
				const detail = e.detail || {}
				// 用户拒绝授权
				if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
					if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
						uni.showToast({ title: '已取消授权', icon: 'none' })
					} else {
						console.error('手机号授权失败:', detail.errMsg)
						uni.showToast({ title: '授权失败，请重试', icon: 'none' })
					}
					return
				}

				const phoneCode = detail.code
				if (!phoneCode) {
					console.error('未获取到 phoneCode，detail:', JSON.stringify(detail))
					uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
					return
				}

				try {
					uni.showLoading({ title: '登录中...', mask: true })
					// 登录三步骤已下沉到 utils/loginFlow.uts
					const result = await runPhoneLogin(phoneCode)
					uni.hideLoading()

					if (!result.ok) {
						if (result.errorKind === 'login') {
							uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
						} else {
							uni.showToast({ title: result.errorMsg || '登录失败', icon: 'none' })
						}
						return
					}

					this.showLoginPopup = false
					if (result.phoneHasFullProfile) {
						// 后端已带头像昵称 → 直接登录完成
						uni.showToast({ title: '登录成功', icon: 'success' })
					} else {
						// 缺头像或昵称 → 弹出授权弹窗补齐
						this.openProfilePopup()
					}
				} catch (err) {
					console.error('手机号登录失败:', err)
					uni.hideLoading()
					uni.showToast({ title: '登录失败，请重试', icon: 'none' })
				}
			},

			// 打开头像昵称授权弹窗
			openProfilePopup() {
				const info = getUserInfo()
				this.profileAvatarUrl = info?.avatarUrl || ''
				this.profileNickname = info?.nickname || ''
				this.showProfilePopup = true
			},

			// 用户选择头像回调
			onChooseAvatar(e) {
				const url = e?.detail?.avatarUrl
				if (url) this.profileAvatarUrl = String(url)
			},

			// 提交头像昵称：调用 PUT /api/wx/userinfo 更新后台用户信息
			async submitProfile() {
				const nickname = (this.profileNickname || '').trim()
				const avatarUrl = this.profileAvatarUrl || ''
				// 两项都未填，等同跳过
				if (nickname === '' && avatarUrl === '') {
					this.skipProfile()
					return
				}
				// 乐观写入：先把用户刚选的头像/昵称同步到本地
				const optimistic = {
					id: 0,
					openid: '',
					phone: null,
					nickname: nickname !== '' ? nickname : null,
					avatarUrl: avatarUrl !== '' ? avatarUrl : null
				}
				mergeUserInfo(optimistic)
				try {
					uni.showLoading({ title: '更新中...', mask: true })
					const result = await submitUserProfile({
						nickname: nickname !== '' ? nickname : undefined,
						avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
					})
					uni.hideLoading()
					if (!result.ok) {
						uni.showToast({ title: result.errorMsg || '更新失败', icon: 'none' })
					}
				} catch (err) {
					console.error('更新头像昵称失败:', err)
					uni.hideLoading()
					uni.showToast({ title: '更新失败，请重试', icon: 'none' })
				} finally {
					this.finishProfile()
				}
			},

			skipProfile() {
				this.finishProfile()
			},

			finishProfile() {
				this.showProfilePopup = false
				this.profileAvatarUrl = ''
				this.profileNickname = ''
				uni.showToast({ title: '登录成功', icon: 'success' })
			},

			onShopClick(shop) {
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${shop.id}`
				})
			},
			onDemoClick(idx) {
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${idx}`
				})
			}
		}
	}
</script>

<style>
	.container{
		background: #000;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		overflow: scroll;
	}
	.main-content {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.page-footer {
		margin-top: auto;
	}
	.banner{
		margin: 24rpx 0 32rpx;
		width: 100%;
		height: 384rpx;
		overflow: hidden;
	}
	.banner-image{
		width: 100%;
		height: 100%;
		display: block;
	}
	.divideTit {
		text-align: center;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.3);
	}
	.demoPhotoTit{
		margin-top: 16rpx;
		font-size: 36rpx;
		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	/* demoPhotoContaner / demoPhoto / shopCard / shopName 等样式已收敛至 PhotoGrid 组件 */
	.service{
		margin: 40rpx 8rpx 40rpx;
		width: 736rpx;
		height: 910rpx;
	}
	.code{
		margin: 40rpx auto;
		width: 200rpx;
		height: 200rpx;
	}
	.contact{
		font-size: 24rpx;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	.beian{
		margin: 64rpx auto 32rpx;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.5);
		text-align: center;
	}
</style>
