<template>
	<view class="container">
		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-banner sk-animate"></view>
			<view class="sk-title sk-animate"></view>
			<view class="sk-subtitle sk-animate"></view>
			<view class="sk-row">
				<view class="sk-photo-card sk-animate"></view>
				<view class="sk-photo-card sk-animate"></view>
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else class="main-content">
			<!-- 顶部轮播图 -->
			<swiper class="banner" autoplay circular :interval="3000" :duration="500" indicator-dots
				indicator-color="rgba(255, 255, 255, 0.35)" indicator-active-color="#fff">
				<swiper-item v-for="(item, idx) in banners" :key="idx">
					<image class="banner-image" :src="item.imageUrl" mode="aspectFill"></image>
				</swiper-item>
			</swiper>
			<view class="divideTit">PHOTOGRAPHY</view>
			<view class="demoPhotoTit">客片欣赏</view>
			<view class="demoPhotoContaner">
				<view v-if="shopList.length > 0" v-for="(shop, index) in shopList" :key="index" class="shopCard" @click="onShopClick(shop)">
					<image class="demoPhoto" :src="shop.homeImage" mode="aspectFill"></image>
					<view class="shopName">
						<view>{{ shop.displayName || 1234 }}</view>
						<view class="enName">{{ shop.displayNameEn || 1234 }}</view>
					</view>
				</view>
				<!-- 无店铺时 fallback -->
				<image v-if="shopList.length === 0" class="demoPhoto mr" src="/static/demo1.png" @click="onDemoClick(1)"></image>
				<image v-if="shopList.length === 0" class="demoPhoto" src="/static/demo2.png" @click="onDemoClick(2)"></image>
			</view>
			<view class="divideTit">SERVICE INFORMATION</view>
			<view class="demoPhotoTit">服务说明</view>
			<image class="service" src="/static/service.png"></image>
			<view class="divideTit">CONTACT US</view>
			<view class="demoPhotoTit">联系我们</view>
			<image
				class="code"
				src="https://www.lanmei66.cloud/admin/admin20250928234704_495_147.png"
				mode="aspectFit"
				show-menu-by-longpress="{{true}}"
			></image>
			<view class="contact">联系电话 & 商务合作</view>
			<view class="contact">18068842642（微信同号）</view>
			<view class="page-footer">
				<view class="beian">Copyright 2025 蓝梅旗袍·汉服·民族服体验馆 - 版权所有</view>
			</view>
		</view>

		<!-- 登录弹窗 -->
		<view v-if="showLoginPopup" class="login-overlay" @click="closeLoginPopup">
			<view class="login-popup" @click.stop>
				<view class="login-popup-title">登录蓝梅</view>
				<view class="login-popup-desc">授权手机号以获得完整体验</view>
				<button
					class="login-phone-btn"
					open-type="getPhoneNumber"
					@getphonenumber="onGetPhoneNumber"
				>手机号快捷登录</button>
				<view class="login-cancel" @click="closeLoginPopup">暂不登录</view>
			</view>
		</view>
	</view>
</template>

<script>
	import { getImage, getShops, wxLogin, wxBindPhone } from '../../utils/api.uts'
	import { isLoggedIn, loginSuccess, setUserInfo } from '../../utils/auth.uts'

	export default {
		data() {
			return {
				loading: true,
				banners: [],
				shopList: [],
				showLoginPopup: false
			}
		},
		async onLoad() {
			try {
				// 并行加载轮播图和店铺列表
				const [bannerRes, shopRes] = await Promise.all([
					getImage('get', { type: 0 }).catch(() => null),
					getShops().catch(() => null)
				])
				if (bannerRes && bannerRes.code === 200) {
					this.banners = bannerRes.data || []
				}
				if (shopRes && shopRes.code === 200 && shopRes.data) {
					this.shopList = shopRes.data
				}
			} catch (err) {
				console.warn('加载首页数据失败', err)
			} finally {
				this.loading = false
				// 接口请求完成后，检查是否需要弹出登录弹窗
				this.checkAndShowLogin()
			}
		},
		onShow() {
			// 如果数据已加载完成且有待弹出的登录弹窗标记，立即弹出
			if (!this.loading) {
				this.checkAndShowLogin()
			}
		},
		methods: {
			// 检查并弹出登录弹窗（首次进入 + 未登录 + 接口加载完成后）
			checkAndShowLogin() {
				const app = getApp()
				if (app.globalData && app.globalData.needShowLogin && !isLoggedIn()) {
					this.showLoginPopup = true
					app.globalData.needShowLogin = false
				}
			},
			// 关闭登录弹窗
			closeLoginPopup() {
				this.showLoginPopup = false
			},

			// 手机号授权回调
			async onGetPhoneNumber(e) {
				const detail = e.detail || {}
				// 用户拒绝授权
				if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
					if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
						uni.showToast({ title: '已取消授权', icon: 'none' })
					} else {
						console.error('手机号授权失败:', detail.errMsg)
						uni.showToast({ title: '授权失败，请重试', icon: 'none' })
					}
					return
				}

				const phoneCode = detail.code
				if (!phoneCode) {
					console.error('未获取到 phoneCode，detail:', JSON.stringify(detail))
					uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
					return
				}

				try {
					uni.showLoading({ title: '登录中...', mask: true })

					// 第一步：静默登录获取 wx code
					const loginRes = await uni.login({ provider: 'weixin' })
					if (!loginRes.code) {
						uni.hideLoading()
						uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
						return
					}

					// 第二步：wx code 换 token
					const wxRes = await wxLogin({ code: loginRes.code })
					if (wxRes.code === 200 && wxRes.data) {
						loginSuccess(wxRes.data.token, wxRes.data.userInfo)
					} else {
						uni.hideLoading()
						uni.showToast({ title: wxRes.message || '登录失败', icon: 'none' })
						return
					}

					// 第三步：用 phoneCode 绑定手机号
					const phoneRes = await wxBindPhone(phoneCode)
					if (phoneRes.code === 200 && phoneRes.data) {
						setUserInfo(phoneRes.data)
					}

					this.showLoginPopup = false
					uni.hideLoading()
					uni.showToast({ title: '登录成功', icon: 'success' })
				} catch (err) {
					console.error('手机号登录失败:', err)
					uni.hideLoading()
					uni.showToast({ title: '登录失败，请重试', icon: 'none' })
				}
			},

			onShopClick(shop) {
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${shop.id}`
				})
			},
			onDemoClick(idx) {
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${idx}`
				})
			}
		}
	}
</script>

<style>
	.container{
		background: #000;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		overflow: scroll;
	}
	.main-content {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.page-footer {
		margin-top: auto;
	}
	.banner{
		margin: 24rpx 0 32rpx;
		width: 100%;
		height: 384rpx;
		overflow: hidden;
	}
	.banner-image{
		width: 100%;
		height: 100%;
		display: block;
	}
	.divideTit {
		text-align: center;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.3);
	}
	.demoPhotoTit{
		margin-top: 16rpx;
		font-size: 36rpx;
		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	.demoPhotoContaner{
		margin: 40rpx 0;
		padding: 0 8rpx;
		width: 100%;
		display: flex;
		flex-direction: row;
	}
	.demoPhoto{
		width: 364rpx;
		height: 226rpx;
	}
	.demoPhoto:last-child{
		margin-right: 0;
	}
	.service{
		margin: 40rpx 8rpx 40rpx;
		width: 736rpx;
		height: 910rpx;
	}
	.code{
		margin: 40rpx auto;
		width: 200rpx;
		height: 200rpx;
	}
	.contact{
		font-size: 24rpx;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	.beian{
		margin: 64rpx auto 32rpx;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.5);
		text-align: center;
	}
	.shopCard {
		position: relative;
		margin-right: 8rpx;
	}
	.shopCard:last-child {
		margin-right: 0;
	}
	.mr {
		margin-right: 8rpx;
	}
	.shopName {
		position: absolute;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		font-size: 34rpx;
		color: #fff;
		font-weight: 600;
		background: linear-gradient(0deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3));
		.enName {
			margin-top: 4rpx;
			font-size: 16rpx;
			font-weight: 300;
		}
	}
</style>
