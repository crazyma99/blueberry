<template>
	<view class="container">
		<!-- 顶部轮播图 -->
		<swiper class="banner" autoplay circular :interval="3000" :duration="500" indicator-dots
			indicator-color="rgba(255, 255, 255, 0.35)" indicator-active-color="#fff">
			<swiper-item v-for="(item, idx) in banners" :key="idx">
				<image class="banner-image" :src="item.imageUrl" mode="aspectFill"></image>
			</swiper-item>
		</swiper>
		<view class="divideTit">PHOTOGRAPHY</view>
		<view class="demoPhotoTit">客片欣赏</view>
		<view class="demoPhotoContaner">
			<image class="demoPhoto" src="/static/demo1.png"  @click="onDemoClick(1)"></image>
			<image class="demoPhoto" src="/static/demo2.png"  @click="onDemoClick(2)"></image>
		</view>
		<view class="divideTit">SERVICE INFORMATION</view>
		<view class="demoPhotoTit">服务说明</view>
		<image class="service" src="/static/service.png"></image>
		<view class="divideTit">CONTACT US</view>
		<view class="demoPhotoTit">联系我们</view>
		<image
			class="code"
			src="https://www.lanmei66.cloud/admin/admin20250928234704_495_147.png"
			mode="aspectFit"
		    show-menu-by-longpress="{{true}}"
		    binderror="onQrCodeError"
		></image>
		<view class="contact">联系电话 & 商务合作</view>
        <view class="contact">18068842642（微信同号）</view>
		<view class="beian">Copyright 2025 蓝梅旗袍·汉服·民族服体验馆 - 版权所有</view>
	</view>
</template>

<script>
	import { getImage } from '../../utils/api'
	export default {
		data() {
			return {
				// 轮播图图片列表（可替换为你的线上图片地址）
				banners: []
			}
		},
		async onLoad() {
			try {
				const res = await getImage('get', {
					type: 0, // 首页轮播图
				})
				console.log('carousel api result:', res)
				const { code, data } = res
				if (code !== 200) return
				this.banners = data
			} catch (err) {
				console.warn('获取轮播图失败', err)
			}
		},
		methods: {
			onDemoClick(idx) {
				// 跳转到非 tabBar 页面（不会在底部 Tab 展示为一个 Tab）
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${idx}`
				})
			}
		}
	}
</script>

