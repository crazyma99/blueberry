<template>
	<view class="container">
		<!-- 首页无导航栏：Banner 沉浸式延伸到状态栏顶部 -->
		<!-- 品牌馆入口（home 按钮）：圆形悬浮左上角，点击进入中台切换品牌 -->
		<view class="home-btn" :style="{ top: (statusBarHeight + 8) + 'px' }" hover-class="press-dim" @click="goBrandHub">
			<text class="home-btn-text font-noto-serif">馆</text>
		</view>
		<!-- 骨架屏：与真实页面间距 1:1（hero 通栏 → 客片欣赏标题/副标题 → 店铺卡片区） -->
		<view v-if="loading" class="sk-container" style="padding: 0;">
			<SkeletonBlock height="794rpx" radius="0" />
			<!-- 客片欣赏标题区（与真实 shop-section 同间距） -->
			<view style="margin: 40rpx var(--spacing-sm) 0;">
				<SkeletonBlock width="46%" height="48rpx" radius="8rpx" />
				<view style="height: 16rpx;"></view>
				<SkeletonBlock width="26%" height="24rpx" radius="6rpx" />
			</view>
			<!-- 店铺卡片区（与真实 shop-card 网格同间距） -->
			<view class="sk-row" style="margin: 28rpx var(--spacing-sm) 0; justify-content: space-between;">
				<SkeletonBlock width="48%" height="320rpx" radius="12rpx" />
				<SkeletonBlock width="48%" height="320rpx" radius="12rpx" />
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else class="main-content">
			<!-- 顶部通栏轮播：无指示点，高度随首图宽高比自适应避免裁切；双层视差（背景图+前景层） -->
			<view class="hero-wrap">
				<swiper class="hero" autoplay circular :interval="3000" :duration="500" :style="{ height: heroHeight }"
					@change="onHeroChange">
					<swiper-item v-for="(item, idx) in banners" :key="idx">
						<!-- 背景层：底层铺满容器，滑动时渐隐渐显（仅 opacity，不做位移） -->
						<image
							class="hero-image fade-in hero-bg-layer"
							:src="item.imageUrl"
							mode="aspectFill"
							:style="heroBgOpacity(idx)"
							@load="onHeroImageLoad"
							@click="onBannerClick(item)"
						></image>
					</swiper-item>
				</swiper>
				<!-- Figma 渐变遮罩：图片底部渐隐融入页面背景（透明50% → #160F04 78.19%） -->
				<view class="hero-mask"></view>
				<!-- 前景层（顶层）：文字=bottom:0+height:25% 居中；图片=全幅 hero-fg-layer-full，与 bg 等高等宽严丝合缝覆盖 -->
				<view class="hero-fg-layer" :class="currentBanner.overlayType === 2 ? 'hero-fg-layer-full' : ''">
					<!-- 上层配置 2 选 1：上层图片 / 标题(NotoSerif)+副标题(HarmonyOS Sans)；
					     :key=fgTick 每次切换重挂载；渐入渐出=两段式 opacity 过渡（先淡出旧、再淡入新） -->
					<view v-if="banners.length > 0" :key="fgTick" :class="fgHidden ? 'hero-fg-content hero-fg-hide' : 'hero-fg-content'">
						<image v-if="currentBanner.overlayType === 2 && currentBanner.overlayImage" class="hero-fg-image" :src="currentBanner.overlayImage" mode="aspectFill"></image>
						<view v-else-if="currentBanner.title" class="hero-fg-text">
							<text class="hero-fg-title">{{ currentBanner.title }}</text>
							<text v-if="currentBanner.subtitle" class="hero-fg-subtitle">{{ currentBanner.subtitle }}</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 客片欣赏：shop-container.png 以 border-image 点九图方式作背景，高度由内容撑开 -->
			<view class="shop-section">
				<view class="shop-content">
					<view class="shop-header-wrap">
						<image class="shop-top" src="/static/shop-container-top.png" mode="aspectFill" />
					</view>
					<view class="shop-container">
						<view class="shop-inner-line"></view>
						<view class="shop-header">
							<view class="shop-title-wrap">
								<text class="shop-title font-noto-serif">客片欣赏</text>
								<text class="shop-subtitle">COLLECTION</text>
							</view>
						</view>
						<view class="photo-grid">
							<view
								v-for="(shop, index) in shopList"
								:key="index"
								:class="shopList.length === 1 ? 'photo-card photo-card-full' : 'photo-card'"
								hover-class="press-dim"
								@click="onShopClick(shop)"
							>
								<image class="photo-card-img fade-in" :src="shop.homeImage" mode="aspectFill"></image>
								<view class="photo-card-mask"></view>
								<view class="photo-card-info">
									<text class="photo-card-name font-noto-serif">{{ shop.displayName }}</text>
									<text class="photo-card-sub">{{ shop.displayNameEn }}</text>
								</view>
							</view>
							<!-- 无店铺时 fallback：demo 图，同 2 列布局 -->
							<view v-if="shopList.length === 0" class="photo-card" hover-class="press-dim"
					@click="onDemoClick(1)">
								<image class="photo-card-img" src="/static/demo1.png" mode="aspectFill"></image>
							</view>
							<view v-if="shopList.length === 0" class="photo-card" hover-class="press-dim"
					@click="onDemoClick(2)">
								<image class="photo-card-img" src="/static/demo2.png" mode="aspectFill"></image>
							</view>
						</view>
					</view>
				</view>
			</view>
			<!-- 服务保障 + 联系我们（已抽为 ServiceContact 组件，样式随组件迁移） -->
			<ServiceContact />
			<view class="page-footer">
				<view class="beian"><AppFooter /></view>
			</view>
		</view>

		<!-- 登录弹窗 -->
		<LoginPopup
			v-if="showLoginPopup"
			:agreement-checked="loginAgreementChecked"
			:user-agreement-name="userAgreementName"
			:privacy-policy-name="privacyPolicyName"
			@close="closeLoginPopup"
			@toggle-agreement="toggleLoginAgreement"
			@show-toast="showLoginAgreementToast"
			@open-user="openUserAgreement"
			@open-privacy="openPrivacyPolicy"
			@get-phone="onGetPhoneNumber"
		/>

		<ProfilePopup
			v-if="showProfilePopup"
			:avatar-url="profileAvatarUrl"
			:nickname="profileNickname"
			@choose-avatar="onChooseAvatar"
			@update-nickname="(v: string) => { this.profileNickname = v }"
			@submit="submitProfile"
			@skip="skipProfile"
		/>

		<!-- 自定义底部 tabbar 占位（116rpx + 安全区） -->
		<view class="tabbar-safe-spacer"></view>
	</view>
</template>

<script>
	import { getImage, getShops, wxLogin, wxBindPhone, wxUpdateUserInfo, rejectAllPendingUploads } from '../../utils/api.uts'
	import { hapticTap } from '../../utils/haptics.uts'
	import { rejectAllPending } from '../../utils/http.uts'
	import { loginSuccess, setUserInfo, mergeUserInfo, getUserInfo, consumeLoginExpired } from '../../utils/auth.uts'
	import { runPhoneLogin } from '../../utils/loginFlow.uts'
	import { submitUserProfile } from '../../utils/profileSubmit.uts'
	import { setBrandId, getBrandId } from '../../utils/brand.uts'
	import { syncTabBarSelected } from '../../utils/tabbar.uts'
	import { cosThumb } from '../../utils/imageLoader.uts'
	import {
		USER_AGREEMENT_NAME,
		PRIVACY_POLICY_NAME,
		openUserAgreement,
		openPrivacyPolicy
	} from '../../utils/legal.uts'
	import { resolveShareCard } from '../../utils/share.uts'

	export default {
		data() {
			return {
				loading: true,
				banners: [],
				shopList: [],
				// 品牌馆入口按钮定位 + 品牌切换检测
				statusBarHeight: 20,
				lastBrandId: '',
				// banner 点击防重复（300ms 节流）
				lastBannerClickAt: 0,
				// 轮播高度：随首张 banner 图宽高比自适应（兜底 794rpx ≈ 设计稿比例）
				heroHeight: '794rpx',
				heroHeightReady: false,
				// 双层视差：当前轮播索引 / 动效重播 tick（每次切换必递增） / 渐隐标记 / 前景层当前项
				currentIndex: 0,
				fgTick: 0,
				fgHidden: false,
				currentBanner: {} as any,
				showLoginPopup: false,
				loginAgreementChecked: false,
				userAgreementName: USER_AGREEMENT_NAME,
				privacyPolicyName: PRIVACY_POLICY_NAME,
				// 头像昵称授权弹窗
				showProfilePopup: false,
				profileAvatarUrl: '',
				profileNickname: '',
				// profile 弹窗是否由登录流程拉起（仅登录流程关闭弹窗时才弹"登录成功"toast）
				profileFromLogin: false,
				// 分享卡片（品牌配置 > 中台全局 > 代码默认），onLoad 异步解析后覆盖
				shareCard: { title: '一键解锁AI推荐｜AI试衣｜客片展示', imageUrl: '/static/share-home.jpg' }
			}
		},
		async onLoad(options : any) {
			// 状态栏高度（品牌馆 home 按钮定位）
			const sysInfo = uni.getSystemInfoSync()
			this.statusBarHeight = sysInfo.statusBarHeight != null ? sysInfo.statusBarHeight : 20
			// 扫品牌小程序码进入：场景值写入品牌上下文（持久化，冷启动保留）
			const scene = decodeURIComponent(options?.scene || '')
			const brandId = scene !== '' ? scene : (options?.brandId ?? '')
			if (brandId !== '') {
				setBrandId(brandId)
			}
			this.loadShareCard()
			await this.reloadHomeData()
			// 记录当前品牌基线，onShow 只在品牌变化时重载
			this.lastBrandId = getBrandId()
		},
		onShow() {
			// 同步自定义底部 tabbar 选中态（本页下标 0）
			syncTabBarSelected(0)
			// 品牌馆切换品牌后回首页：品牌变化 → 重载首页数据
			const brandId = getBrandId()
			if (brandId !== this.lastBrandId) {
				this.lastBrandId = brandId
				this.loading = true
				this.reloadHomeData()
				this.loadShareCard()
			}
			// 监听 401 登录过期事件，自动拉起登录弹窗
			uni.$off('login-required')
			uni.$on('login-required', () => {
				this.showLoginPopup = true
			})
			// 兑底：其他页面触发 401 后导航回来时自动弹出
			if (consumeLoginExpired()) {
				this.showLoginPopup = true
			}
		},
		onHide() {
			uni.$off('login-required')
		},
		// 下拉刷新：重新加载首页数据（轮播配置含上层文字/图片同步刷新 + 店铺 + 分享卡片）；
		// 刷新完成后重挂载前景层（fgTick+1）重播渐入动效，配置变化一眼可见
		onPullDownRefresh() {
			this.reloadHomeData().then(() => {
				this.loadShareCard()
				this.fgTick = this.fgTick + 1
				uni.stopPullDownRefresh()
			}).catch(() => {
				uni.stopPullDownRefresh()
			})
		},
		// 右上角胶囊菜单「转发」：卡片动态化（品牌落地 + 首张 banner 图）
		onShareAppMessage() {
			const brandId = getBrandId()
			return {
				title: this.shareCard.title,
				path: '/pages/index/index' + (brandId !== '' ? '?brandId=' + brandId : ''),
				imageUrl: this.shareCard.imageUrl
			}
		},
		// 右上角胶囊菜单「分享到朋友圈」
		onShareTimeline() {
			return {
				title: this.shareCard.title,
				imageUrl: this.shareCard.imageUrl
			}
		},
		methods: {
			// ===== 双层视差：状态与方法（仅扩展，不改动原有业务逻辑） =====
			// 轮播索引同步（手动/自动轮播都会触发）：两段式渐入渐出——
			// ① 先置隐藏（旧内容淡出）② 220ms 后换内容重挂载（仍隐藏）③ 250ms 后取消隐藏（新内容淡入）
			onHeroChange(e) {
				const next = e?.detail?.current ?? 0
				this.currentIndex = next
				this.fgHidden = true
				const self = this
				setTimeout(() => {
					self.fgTick = self.fgTick + 1
					self.updateCurrentBanner()
				}, 220)
				setTimeout(() => {
					self.fgHidden = false
				}, 260)
			},
			// 前景层当前展示项（循环安全取模，无越界）
			updateCurrentBanner() {
				const n = this.banners.length
				if (n === 0) {
					this.currentBanner = {}
					return
				}
				const i = ((this.currentIndex % n) + n) % n
				this.currentBanner = this.banners[i] ?? {}
			},
			// 背景层：只做渐隐渐显（当前页 opacity=1，其余 0.3），位移交给 swiper 原生滑动
			heroBgOpacity(index) {
				const n = this.banners.length
				if (n === 0) return ''
				let diff = index - this.currentIndex
				if (diff > n / 2) diff -= n
				if (diff < -n / 2) diff += n
				return 'opacity: ' + (diff === 0 ? 1 : 0.3) + '; will-change: opacity;'
			},
			// 分享卡片解析：品牌配置 > 中台全局 > 代码默认（{brand} 占位符自动替换品牌名）
			async loadShareCard() {
				try {
					this.shareCard = await resolveShareCard('index')
				} catch (e) {
					// 解析失败保留默认卡片
				}
			},
			// 首页数据加载（onLoad 与品牌切换 onShow 共用）
		async reloadHomeData() {
			try {
				// 并行加载轮播图和店铺列表（X-Brand-Id 由 http 层自动携带）
				const [bannerRes, shopRes] = await Promise.all([
					// t 时间戳防缓存：下拉刷新时 banner 配置必定重新拉取
					getImage('get', { type: 0, t: Date.now() }).catch(() => null),
					getShops().catch(() => null)
				])
				if (bannerRes && bannerRes.code === 200) {
					// banner 出 750px WebP 缩略图，降低内存占用
					this.banners = (bannerRes.data || []).map(item => {
						item.imageUrl = cosThumb(item.imageUrl, 750)
						return item
					})
					// 双层视差：banners 就绪后刷新前景层当前项
					this.updateCurrentBanner()
				}
				if (shopRes && shopRes.code === 200 && shopRes.data) {
					// 网格封面图出 600px WebP 缩略图
					this.shopList = shopRes.data.map(item => {
						item.homeImage = cosThumb(item.homeImage, 600)
						return item
					})
				}
			} catch (err) {
				console.warn('加载首页数据失败', err)
			} finally {
				this.loading = false
			}
		},
			// 关闭登录弹窗
			closeLoginPopup() {
				this.showLoginPopup = false
				this.loginAgreementChecked = false
				// 用户主动取消登录，reject 所有挂起的 401 请求
				rejectAllPending()
				rejectAllPendingUploads()
			},

			toggleLoginAgreement() {
				this.loginAgreementChecked = !this.loginAgreementChecked
			},

			showLoginAgreementToast() {
				uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
			},

			openUserAgreement() {
				openUserAgreement()
			},

			openPrivacyPolicy() {
				openPrivacyPolicy()
			},

			// 手机号授权回调
			async onGetPhoneNumber(e) {
				if (!this.loginAgreementChecked) {
					this.showLoginAgreementToast()
					return
				}
				const detail = e.detail || {}
				// 用户拒绝授权
				if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
					if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
						uni.showToast({ title: '已取消授权', icon: 'none' })
					} else {
						console.error('手机号授权失败:', detail.errMsg)
						uni.showToast({ title: '授权失败，请重试', icon: 'none' })
					}
					return
				}

				const phoneCode = detail.code
				if (!phoneCode) {
					console.error('未获取到 phoneCode，detail:', JSON.stringify(detail))
					uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
					return
				}

				try {
					uni.showLoading({ title: '登录中...', mask: true })
					// 登录三步骤已下沉到 utils/loginFlow.uts
					const result = await runPhoneLogin(phoneCode)
					uni.hideLoading()

					if (!result.ok) {
						if (result.errorKind === 'login') {
							uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
						} else {
							uni.showToast({ title: result.errorMsg || '登录失败', icon: 'none' })
						}
						return
					}

					this.showLoginPopup = false
					if (result.phoneHasFullProfile) {
						// 后端已带头像昵称 → 直接登录完成
						uni.showToast({ title: '登录成功', icon: 'success' })
					} else {
						// 缺头像或昵称 → 弹出授权弹窗补齐
						this.profileFromLogin = true
						this.openProfilePopup()
					}
				} catch (err) {
					console.error('手机号登录失败:', err)
					uni.hideLoading()
					uni.showToast({ title: '登录失败，请重试', icon: 'none' })
				}
			},

			// 打开头像昵称授权弹窗
			openProfilePopup() {
				const info = getUserInfo()
				this.profileAvatarUrl = info?.avatarUrl || ''
				this.profileNickname = info?.nickname || ''
				this.showProfilePopup = true
			},

			// 用户选择头像回调
			onChooseAvatar(e) {
				const url = e?.detail?.avatarUrl
				if (url) this.profileAvatarUrl = String(url)
			},

			// 提交头像昵称：调用 PUT /api/wx/userinfo 更新后台用户信息
			async submitProfile() {
				const nickname = (this.profileNickname || '').trim()
				const avatarUrl = this.profileAvatarUrl || ''
				// 两项都未填，等同跳过
				if (nickname === '' && avatarUrl === '') {
					this.skipProfile()
					return
				}
				// 乐观写入：先把用户刚选的头像/昵称同步到本地
				const optimistic = {
					id: 0,
					openid: '',
					phone: null,
					nickname: nickname !== '' ? nickname : null,
					avatarUrl: avatarUrl !== '' ? avatarUrl : null
				}
				mergeUserInfo(optimistic)
				try {
					uni.showLoading({ title: '更新中...', mask: true })
					const result = await submitUserProfile({
						nickname: nickname !== '' ? nickname : undefined,
						avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
					})
					uni.hideLoading()
					if (!result.ok) {
						uni.showToast({ title: result.errorMsg || '更新失败', icon: 'none' })
					}
				} catch (err) {
					console.error('更新头像昵称失败:', err)
					uni.hideLoading()
					uni.showToast({ title: '更新失败，请重试', icon: 'none' })
				} finally {
					this.finishProfile()
				}
			},

			skipProfile() {
				this.finishProfile()
			},

			finishProfile() {
				this.showProfilePopup = false
				this.profileAvatarUrl = ''
				this.profileNickname = ''
				// 只有登录流程拉起的弹窗关闭时才提示登录成功；
				// 已登录态修改资料后关闭（跳过/点蒙层）不提示
				if (this.profileFromLogin) {
					uni.showToast({ title: '登录成功', icon: 'success' })
				}
				this.profileFromLogin = false
			},

			// 首张 banner 加载完成后按图片真实宽高比设定轮播高度（只取第一次，避免后续图跳动）
			onHeroImageLoad(e) {
				if (this.heroHeightReady) return
				const w = e.detail?.width ?? 0
				const h = e.detail?.height ?? 0
				if (w > 0 && h > 0) {
					const rpx = Math.round(750 * h / w)
					this.heroHeight = Math.min(Math.max(rpx, 400), 1200) + 'rpx'
					this.heroHeightReady = true
				}
			},
			goBrandHub() {
			// 触感反馈 + 进入品牌馆（中台页面）
			hapticTap()
			uni.navigateTo({ url: '/pages/brandHub/index' })
		},
		onBannerClick(item: any) {
			// 无跳转链接：不响应
			const linkUrl = (item != null && item.linkUrl != null) ? (item.linkUrl as string).trim() : ''
			if (linkUrl === '') return
			// 防重复点击（300ms 节流）
			const now = Date.now()
			if (now - this.lastBannerClickAt < 300) return
			this.lastBannerClickAt = now
			hapticTap()
			// 前端白名单兜底：仅 /pages/ 或 http(s) 允许跳转
			if (linkUrl.startsWith('/pages/')) {
				if (linkUrl.startsWith('/pages/index/index') || linkUrl.startsWith('/pages/priceHomePage/index') || linkUrl.startsWith('/pages/mine/index')) {
					uni.switchTab({ url: linkUrl })
				} else {
					uni.navigateTo({ url: linkUrl })
				}
			} else if (linkUrl.startsWith('http://') || linkUrl.startsWith('https://')) {
				uni.navigateTo({ url: '/pages/webview/index?url=' + encodeURIComponent(linkUrl) })
			}
		},
		onShopClick(shop) {
				// 触感反馈：客片卡片点击轻振动
				hapticTap()
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${shop.id}`
				})
			},
			onDemoClick(idx) {
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${idx}`
				})
			}
		}
	}
</script>

<style>
	/* 品牌馆入口：圆形悬浮按钮（沉浸式左上角） */
	.home-btn {
		position: absolute;
		left: 16px;
		width: 64rpx;
		height: 64rpx;
		border-radius: 50%;
		background: rgba(22, 15, 4, 0.55);
