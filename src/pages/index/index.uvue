<template>
	<view class="container">
		<!-- 骨架屏 -->
		<view v-if="loading" class="skeleton">
			<view class="skeleton-banner skeleton-animate"></view>
			<view class="skeleton-title skeleton-animate"></view>
			<view class="skeleton-subtitle skeleton-animate"></view>
			<view class="skeleton-photo-row">
				<view class="skeleton-photo skeleton-animate"></view>
				<view class="skeleton-photo skeleton-animate"></view>
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else>
			<!-- 顶部轮播图 -->
			<swiper class="banner" autoplay circular :interval="3000" :duration="500" indicator-dots
				indicator-color="rgba(255, 255, 255, 0.35)" indicator-active-color="#fff">
				<swiper-item v-for="(item, idx) in banners" :key="idx">
					<image class="banner-image" :src="item.imageUrl" mode="aspectFill"></image>
				</swiper-item>
			</swiper>
			<view class="divideTit">PHOTOGRAPHY</view>
			<view class="demoPhotoTit">客片欣赏</view>
			<view class="demoPhotoContaner">
				<view v-if="shopList.length > 0" v-for="(shop, index) in shopList" :key="index" class="shopCard" @click="onShopClick(shop)">
					<image class="demoPhoto" :src="shop.homeImage" mode="aspectFill"></image>
					<view class="shopName">
						<view>{{ shop.displayName || 1234 }}</view>
						<view class="enName">{{ shop.displayNameEn || 1234 }}</view>
					</view>
				</view>
				<!-- 无店铺时 fallback -->
				<image v-if="shopList.length === 0" class="demoPhoto mr" src="/static/demo1.png" @click="onDemoClick(1)"></image>
				<image v-if="shopList.length === 0" class="demoPhoto" src="/static/demo2.png" @click="onDemoClick(2)"></image>
			</view>
			<view class="divideTit">SERVICE INFORMATION</view>
			<view class="demoPhotoTit">服务说明</view>
			<image class="service" src="/static/service.png"></image>
			<view class="divideTit">CONTACT US</view>
			<view class="demoPhotoTit">联系我们</view>
			<image
				class="code"
				src="https://www.lanmei66.cloud/admin/admin20250928234704_495_147.png"
				mode="aspectFit"
				show-menu-by-longpress="{{true}}"
			></image>
			<view class="contact">联系电话 & 商务合作</view>
			<view class="contact">18068842642（微信同号）</view>
			<view class="beian">Copyright 2025 蓝梅旗袍·汉服·民族服体验馆 - 版权所有</view>
		</view>
	</view>
</template>

<script>
	import { getImage, getShops, wxLogin } from '../../utils/api.uts'
	import { isLoggedIn, loginSuccess } from '../../utils/auth.uts'

	export default {
		data() {
			return {
				loading: true,
				banners: [],
				shopList: []
			}
		},
		async onLoad() {
			try {
				// 并行加载轮播图和店铺列表
				const [bannerRes, shopRes] = await Promise.all([
					getImage('get', { type: 0 }).catch(() => null),
					getShops().catch(() => null)
				])
				if (bannerRes && bannerRes.code === 200) {
					this.banners = bannerRes.data || []
				}
				if (shopRes && shopRes.code === 200 && shopRes.data) {
					this.shopList = shopRes.data
				}
			} catch (err) {
				console.warn('加载首页数据失败', err)
			} finally {
				this.loading = false
			}
		},
		onShow() {
			// 登录态检查已移至 App.onLaunch，页面切换时不再重复检查
			// 如需强制刷新登录态，可手动调用 doLogin
		},
		methods: {
			async doLogin() {
				try {
					const loginRes = await uni.login({ provider: 'weixin' })
					if (loginRes.code) {
						const res = await wxLogin({ code: loginRes.code })
						if (res.code === 200 && res.data) {
							loginSuccess(res.data.token, res.data.userInfo)
							uni.showToast({ title: '登录成功', icon: 'success' })
						} else {
							uni.showToast({ title: res.message || '登录失败', icon: 'none' })
						}
					}
				} catch (err) {
					console.error('登录失败:', err)
				}
			},
			onShopClick(shop) {
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${shop.id}`
				})
			},
			onDemoClick(idx) {
				uni.navigateTo({
					url: `/pages/demoDetail/index?from=banner&idx=${idx}`
				})
			}
		}
	}
</script>

<style>
	.container{
		background: #000;
		height: 100%;
		overflow: scroll;
	}
	.banner{
		margin: 24rpx 0 32rpx;
		width: 100%;
		height: 384rpx;
		overflow: hidden;
	}
	.banner-image{
		width: 100%;
		height: 100%;
		display: block;
	}
	.divideTit {
		text-align: center;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.3);
	}
	.demoPhotoTit{
		margin-top: 16rpx;
		font-size: 36rpx;
		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	.demoPhotoContaner{
		margin: 40rpx 0;
		padding: 0 8rpx;
		width: 100%;
		display: flex;
		flex-direction: row;
	}
	.demoPhoto{
		width: 364rpx;
		height: 226rpx;
	}
	.demoPhoto:last-child{
		margin-right: 0;
	}
	.service{
		margin: 40rpx 8rpx 40rpx;
		width: 736rpx;
		height: 910rpx;
	}
	.code{
		margin: 40rpx auto;
		width: 200rpx;
		height: 200rpx;
	}
	.contact{
		font-size: 24rpx;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	.beian{
		margin: 64rpx auto 32rpx;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.5);
		text-align: center;
	}
	/* 店铺卡片 */
	.shopCard {
		position: relative;
		margin-right: 8rpx;
	}
	.shopCard:last-child {
		margin-right: 0;
	}
	.mr {
		margin-right: 8rpx;
	}
	.shopName {
		position: absolute;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		font-size: 34rpx;
		color: #fff;
		font-weight: 600;
		background: linear-gradient(0deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3));
		.enName {
			margin-top: 4rpx;
			font-size: 16rpx;
			font-weight: 300;
		}
	}
	/* 骨架屏 */
	.skeleton {
		padding: 24rpx 8rpx;
	}
	.skeleton-banner {
		width: 100%;
		height: 384rpx;
		border-radius: 8rpx;
		background: rgba(255, 255, 255, 0.08);
		margin-bottom: 40rpx;
	}
	.skeleton-title {
		width: 200rpx;
		height: 24rpx;
		border-radius: 4rpx;
		background: rgba(255, 255, 255, 0.08);
		margin: 0 auto 16rpx;
	}
	.skeleton-subtitle {
		width: 140rpx;
		height: 36rpx;
		border-radius: 4rpx;
		background: rgba(255, 255, 255, 0.08);
		margin: 0 auto 40rpx;
	}
	.skeleton-photo-row {
		display: flex;
		flex-direction: row;
	}
	.skeleton-photo {
		width: 364rpx;
		height: 226rpx;
		border-radius: 8rpx;
		background: rgba(255, 255, 255, 0.08);
		margin-right: 8rpx;
	}
	.skeleton-photo:last-child {
		margin-right: 0;
	}
	@keyframes skeletonPulse {
		0% { opacity: 0.4; }
		50% { opacity: 0.8; }
		100% { opacity: 0.4; }
	}
	.skeleton-animate {
		animation: skeletonPulse 1.5s ease-in-out infinite;
	}
</style>
