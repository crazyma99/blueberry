	}
	.main-content {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.page-footer {
		margin-top: auto;
	}
	/* 顶部通栏轮播：无指示点，高度由脚本按首图宽高比写入 */
	.hero-wrap{
		position: relative;
		width: 100%;
	}
	.hero{
		width: 100%;
		overflow: hidden;
	}
	/* Figma 渐变遮罩：图片底部渐隐融入页面背景 */
	.hero-mask{
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 50%;
		background: linear-gradient(#160f0400 20%, #160f04 96%);
		pointer-events: none;
		z-index: 10;
	}
	.hero-image{
		width: 100%;
		height: 100%;
		display: block;
	}
	/* ===== 双层视差图层（仅本页作用域，基于 design token） ===== */
	/* 背景层：底层铺满容器；滑动渐隐渐显（仅 opacity 过渡，位移交给 swiper 原生滑动） */
	.hero-bg-layer{
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		transition: opacity 500ms ease;
		will-change: opacity;
	}
	/* 前景层：顶层，位于 hero-mask 之上；区域 bottom:0 + height:25%，文字在区域内水平垂直居中 */
	.hero-fg-layer{
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 25%;
		z-index: 30;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		pointer-events: none;
		will-change: transform, opacity;
	}
	.hero-fg-content{
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	/* 渐入渐出：仅透明度过渡（两段式：淡出旧→淡入新），不位移 */
	.hero-fg-content{
		transition: opacity 220ms ease;
	}
	.hero-fg-hide{
		opacity: 0;
	}
	.hero-fg-text{
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8rpx;
		padding: 0 48rpx;
	}
	.hero-fg-title{
		width: 100%;
		font-family: var(--font-display);
		font-size: 44rpx;
		letter-spacing: 0.1em;
		color: var(--color-primary);
		text-align: center;
	}
	.hero-fg-subtitle{
		width: 100%;
		font-family: var(--font-body);
		font-size: 26rpx;
		letter-spacing: 0.2em;
		color: var(--color-primary-70);
		text-align: center;
	}
	/* 上层图片模式：前景层全幅覆盖（top:0 + height:100%），与背景图等高等宽 */
	.hero-fg-layer-full{
		top: 0;
		bottom: auto;
		height: 100%;
	}
	.hero-fg-layer-full .hero-fg-content{
		height: 100%;
	}
	.hero-fg-image{
		width: 100%;
		height: 100%;
	}
	/* 客片欣赏：shop-container.png 以 border-image 点九图方式铺满，高度由内容撑开。
	   切片（源图 1424×486）：顶 250px 含整条金色光线（最低点 y≈240）、底 46px 含底部边线与圆角、
	   左右 42px 含圆角转角；中段透明，随内容纵向拉伸。
	   注意：border-image 仅小程序/web 端可用，App 端 uvue 原生不支持该属性。 */
	.shop-section{
		margin: 0 var(--spacing-sm) 40rpx;
	}
	.shop-header-wrap{
		position: relative;
		width: 710rpx;
		height: 163rpx;
		.shop-top{
			width: 100%;
			height: 100%;
			position: absolute;
		}
	}
	.shop-header{
		position: absolute;
		/* 上移 60rpx 进入切图区：只动标题自身，容器边框线位置不受影响 */
		top: -60rpx;
		left: 20rpx;
		right: 20rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.shop-title-wrap{
		display: flex;
		flex-direction: column;
	}
	.shop-title{
		font-size: var(--font-size-display);
		font-weight: 400;
		color: var(--color-primary);
	}
	.shop-subtitle{
		font-size: var(--font-size-caption);
		color: var(--color-primary-70);
		font-weight: 400;
    letter-spacing: 4rpx;
	}
	.shop-container{
		position: relative;
		/* 覆盖 uni-app x view 默认 overflow: hidden，允许标题上移溢出显示 */
		overflow: visible;
		/* 顶部 padding 为标题行留位（标题 absolute 不占流，照片从 padding-top 处开始） */
		padding: var(--spacing-sm);
	}
	/* 内边框线框：内层绝对定位 view 画左/右/下三边线，缩进与内容 padding 对齐（20rpx）
	   改 left/right/bottom 为 0 即贴边（等同原 border 效果）；顶部开口与切图拼接 */
	.shop-inner-line{
		position: absolute;
		top: 0;
		left: 0rpx;
		right: 5rpx;
		bottom: 0rpx;
		border-left: 2rpx solid var(--color-border-soft);
		border-right: 2rpx solid var(--color-border-soft);
		border-bottom: 2rpx solid var(--color-border-soft);
		/* 只保留下方两角圆角（border-radius 简写会四角同时生效） */
		border-bottom-left-radius: 24rpx;
		border-bottom-right-radius: 24rpx;
		pointer-events: none;
	}
	.photo-grid{
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		/* 与上方「客片欣赏/COLLECTION」标题拉开距离 */
		margin-top: var(--spacing-sm);
	}
	.photo-card{
		position: relative;
		width: calc((100% - 20rpx) / 2);
		height: 182rpx;
		/* 圆角/高度对齐设计稿（design-token.md 差异对照） */
		border-radius: var(--radius-card);
		overflow: hidden;
		border: 1rpx solid rgba(243, 217, 172, 0.35);
	}
	.photo-card-full{
		width: 100%;
	}
	.photo-card-img{
		width: 100%;
		height: 100%;
		display: block;
	}
	.photo-card-mask{
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 70%;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.75));
	}
	.photo-card-info{
