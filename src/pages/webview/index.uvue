<!--
  webview 页：web-view 为微信原生组件且自动铺满整个页面，
  普通 view 无法覆盖其上，因此这里用 cover-view/cover-image 绘制金色返回栏（无标题）。
-->
<template>
  <view class="webview-container">
    <web-view :src="url"></web-view>
    <cover-view class="wv-nav" :style="{ paddingTop: statusBarHeight + 'px' }">
      <cover-view class="wv-nav-back" @click="goBack">
        <cover-image class="wv-nav-back-icon" src="/static/back-arrow.png"></cover-image>
      </cover-view>
    </cover-view>
  </view>
</template>

<script lang="uts">
export default {
  data() {
    return {
      url: '',
      statusBarHeight: 20
    }
  },
  onLoad(options: any) {
    if (options.url) {
      this.url = decodeURIComponent(options.url)
    }
    const systemInfo = uni.getSystemInfoSync()
    this.statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
  },
  methods: {
    goBack() {
      uni.navigateBack()
    }
  }
}
</script>

<style>
.webview-container {
  width: 100%;
  height: 100vh;
}
.wv-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
}
.wv-nav-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wv-nav-back-icon {
  width: 48rpx;
  height: 48rpx;
}
</style>
