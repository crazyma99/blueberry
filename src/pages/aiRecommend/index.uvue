<template>
	<view class="page">
		<!-- 描述文案 -->
		<view class="desc-bar">
			<text class="desc-text">上传照片，AI为您推荐最合适的服饰风格</text>
		</view>

		<!-- 上传图片框 -->
		<view class="section">
			<view class="upload-area" @click="choosePhoto">
				<image v-if="photoPreviewUrl" class="upload-preview" :src="photoPreviewUrl" mode="widthFix"></image>
				<view v-else class="upload-placeholder">
					<text class="upload-plus">+</text>
					<text class="upload-hint">点击上传你的照片</text>
				</view>
			</view>
		</view>

		<!-- 底部占位 -->
		<view class="bottom-spacer"></view>

		<!-- 底部固定按钮 -->
		<view class="fixed-bottom">
			<view
				:class="photoPreviewUrl !== '' ? 'action-btn' : 'action-btn action-btn-disabled'"
				@click="handleStartAnalysis"
			>
				<text class="action-btn-text">开始AI分析推荐</text>
			</view>
			<view class="footer-copyright">
				<AppFooter />
			</view>
		</view>
	</view>
</template>

<script lang="uts">
import AppFooter from '../../components/AppFooter/AppFooter.uvue'

export default {
	components: { AppFooter },
	data() {
		return {
			photoPath: '',
			photoPreviewUrl: ''
		}
	},
	methods: {
		choosePhoto() {
			uni.chooseImage({
				count: 1,
				sizeType: ['compressed'],
				sourceType: ['album', 'camera'],
				success: (res) => {
					const tempFile = res.tempFiles[0]
					if (tempFile.size > 10 * 1024 * 1024) {
						uni.showToast({ title: '照片大小不能超过10MB', icon: 'none' })
						return
					}
					this.photoPath = res.tempFilePaths[0]
					this.photoPreviewUrl = res.tempFilePaths[0]
				}
			})
		},

		handleStartAnalysis() {
			if (this.photoPreviewUrl === '') {
				uni.showToast({ title: '请先上传照片', icon: 'none' })
				return
			}
			uni.navigateTo({
				url: '/pages/aiRecommendLoading/index'
			})
		}
	}
}
</script>

<style>
.page {
	background: #000;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
}

/* 描述文案 */
.desc-bar {
	padding: 40rpx 32rpx 8rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.desc-text {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.7);
	text-align: center;
}

/* 上传区 */
.section {
	padding: 24rpx 32rpx;
}
.upload-area {
	position: relative;
	width: 100%;
	min-height: 320rpx;
	border-radius: 16rpx;
	border-width: 2rpx;
	border-style: dashed;
	border-color: rgba(255, 255, 255, 0.3);
	background-color: rgba(255, 255, 255, 0.05);
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}
.upload-placeholder {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}
.upload-plus {
	font-size: 64rpx;
	color: rgba(255, 255, 255, 0.5);
	margin-bottom: 16rpx;
}
.upload-hint {
	font-size: 26rpx;
	color: rgba(255, 255, 255, 0.4);
}
.upload-preview {
	width: 100%;
}

/* 底部占位 */
.bottom-spacer {
	height: 260rpx;
}

/* 底部固定 */
.fixed-bottom {
	position: fixed;
	left: 0;
	bottom: 0;
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 24rpx 32rpx;
	padding-bottom: 40rpx;
	background-color: #000;
}

/* 分析按钮 — 与AI试衣生成按钮一致的渐变背景 */
.action-btn {
	width: 100%;
	height: 88rpx;
	border-radius: 44rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background: linear-gradient(109deg, #f2949f 12%, #d7a3bf 31%, #a0a6ec 51%, #9daeea 71%, #7bace3 91%);
}
.action-btn-disabled {
	opacity: 0.4;
}
.action-btn-text {
	font-size: 32rpx;
	color: #fff;
	font-weight: 500;
}

/* Copyright */
.footer-copyright {
	margin-top: 20rpx;
	font-size: 20rpx;
	color: rgba(255, 255, 255, 0.5);
}
</style>
