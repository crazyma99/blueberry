<template>
	<view class="page">
		<!-- 描述文案 -->
		<view class="desc-bar">
			<text class="desc-text">上传照片，AI为您推荐最合适的服饰风格</text>
		</view>

		<!-- 上传图片框 -->
		<view class="section">
			<view class="upload-area" @click="choosePhoto">
				<image v-if="photoPreviewUrl" class="upload-preview" :src="photoPreviewUrl" mode="widthFix"></image>
				<view v-else class="upload-placeholder">
					<text class="upload-plus">+</text>
					<text class="upload-hint">点击上传你的照片</text>
				</view>
			</view>
		</view>

		<!-- 底部占位 -->
		<view class="bottom-spacer"></view>

		<!-- 底部固定按钮 -->
		<view class="fixed-bottom">
			<!-- 付费模式且无剩余次数：价格按钮，点击引导充值，到账后自动继续分析 -->
			<view v-if="isPaidMode && creditBalance <= 0" class="action-btn-wrap">
				<view
					:class="photoPreviewUrl !== '' ? 'action-btn' : 'action-btn action-btn-disabled'"
					@click="handleStartAnalysis"
				>
					<text class="action-btn-price">¥{{ priceText }}</text>
					<text class="action-btn-text"> 马上开启AI分析推荐</text>
				</view>
			</view>
			<!-- 非付费模式或有剩余次数：原按钮，有限免时右上角展示角标 -->
			<view v-else class="action-btn-wrap">
				<view
					:class="photoPreviewUrl !== '' ? 'action-btn' : 'action-btn action-btn-disabled'"
					@click="handleStartAnalysis"
				>
					<text class="action-btn-text">{{ uploading ? '上传中...' : '开始AI分析推荐' }}</text>
				</view>
				<view v-if="isPaidMode && creditBalance > 0" class="action-btn-badge">
					<text class="action-btn-badge-text">限时免费 {{ creditBalance }} 次</text>
				</view>
			</view>
			<view class="footer-copyright">
				<AppFooter />
			</view>
		</view>

		<!-- 登录弹窗 -->
		<view v-if="showLoginPopup" class="login-overlay" @click="closeLoginPopup">
			<view class="login-popup login-auth-popup" @click.stop>
				<view class="login-popup-title">微信授权登陆</view>
				<view class="login-agreement-row">
					<view
						:class="loginAgreementChecked ? 'login-agreement-check is-checked' : 'login-agreement-check'"
						@click.stop="toggleLoginAgreement"
					>
						<view v-if="loginAgreementChecked" class="login-agreement-dot"></view>
					</view>
					<text class="login-agreement-text"><text>登录即代表同意 </text><text class="login-agreement-link" @click.stop="openUserAgreement">{{ userAgreementName }}</text><text>、</text><text class="login-agreement-link" @click.stop="openPrivacyPolicy">{{ privacyPolicyName }}</text></text>
				</view>
				<button
					v-if="loginAgreementChecked"
					class="login-phone-btn"
					open-type="getPhoneNumber"
					@getphonenumber="onGetPhoneNumber"
				>一键登录</button>
				<button
					v-else
					class="login-phone-btn"
					@click="showLoginAgreementToast"
				>一键登录</button>
				<view class="login-cancel login-cancel-btn" @click="closeLoginPopup">暂不登陆</view>
			</view>
		</view>

		<!-- 头像昵称授权弹窗 -->
		<view v-if="showProfilePopup" class="login-overlay" @click="skipProfile">
			<view class="login-popup" @click.stop>
				<view class="login-popup-title">完善个人资料</view>
				<view class="login-popup-desc">设置头像和昵称以获得完整体验</view>
				<button
					class="profile-avatar-btn"
					open-type="chooseAvatar"
					@chooseavatar="onChooseAvatar"
				>
					<image class="profile-avatar-img" :src="profileAvatarUrl || '/static/mine.svg'" mode="aspectFill"></image>
					<text class="profile-avatar-tip">点击选择头像</text>
				</button>
				<view class="profile-nickname-row">
					<text class="profile-nickname-label">昵称</text>
					<input class="profile-nickname-input" type="nickname" placeholder="请输入昵称" v-model="profileNickname"/>
				</view>
				<button class="login-phone-btn" @click="submitProfile">确认</button>
				<view class="login-cancel" @click="skipProfile">跳过</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
import AppFooter from '../../components/AppFooter/AppFooter.uvue'
import { uploadPhoto, rejectAllPendingUploads, getCreditBalance, createCreditRecharge, getCreditRechargeStatus } from '../../utils/api.uts'
import { isLoggedIn, getUserInfo, mergeUserInfo, UserInfo, consumeLoginExpired } from '../../utils/auth.uts'
import { runPhoneLogin } from '../../utils/loginFlow.uts'
import { submitUserProfile } from '../../utils/profileSubmit.uts'
import { rejectAllPending } from '../../utils/http.uts'
import {
	USER_AGREEMENT_NAME,
	PRIVACY_POLICY_NAME,
	openUserAgreement,
	openPrivacyPolicy
} from '../../utils/legal.uts'

export default {
	components: { AppFooter },
	data() {
		return {
			shopId: '',
			photoPath: '',
			photoPreviewUrl: '',
			uploadedFilename: '',
			uploading: false,
			// 登录弹窗
			showLoginPopup: false,
			loginAgreementChecked: false,
			userAgreementName: USER_AGREEMENT_NAME,
			privacyPolicyName: PRIVACY_POLICY_NAME,
			// 头像昵称弹窗
			showProfilePopup: false,
			profileAvatarUrl: '',
			profileNickname: '',
			// 推荐次数 / 支付
			creditBalance: -1,        // 剩余推荐次数，-1 = 未查询到
			priceFenPerCredit: 0,     // 推荐单次价格（分），0 = 未开通付费购买（非付费模式）
			creditLoaded: false,      // 是否已成功查询到推荐余额
			isPaying: false,
			resumeAnalyzeAfterCredit: false, // 支付成功后自动继续分析
			payPollToken: 0           // 到账轮询会话标记，自增即失效
		}
	},
	computed: {
		// 付费模式：已查询到推荐余额且商户配置了单次价格
		isPaidMode(): boolean {
			return this.creditLoaded && this.priceFenPerCredit > 0
		},
		// 单次价格文案（分 → 元，整元去小数）
		priceText(): string {
			const fen = this.priceFenPerCredit
			if (fen <= 0) return '0'
			if (fen % 100 === 0) return `${fen / 100}`
			return (fen / 100).toFixed(2)
		}
	},
	onLoad(options : any) {
		this.shopId = options?.shopId ?? ''
	},
	onShow() {
		// 监听 401 登录过期事件，自动拉起登录弹窗
		uni.$off('login-required')
		uni.$on('login-required', () => {
			this.showLoginPopup = true
		})
		// 兑底：其他页面触发 401 后导航回来时自动弹出
		if (consumeLoginExpired()) {
			this.showLoginPopup = true
		}
		// 查询推荐次数余额（需登录；未登录时保持原按钮，避免进页即拉起登录）
		if (isLoggedIn()) {
			this.loadCreditInfo()
		}
	},
	onHide() {
		uni.$off('login-required')
		// 页面隐藏时终止可能进行中的到账轮询
		this.payPollToken = this.payPollToken + 1
	},
	methods: {
		choosePhoto() {
			if (this.uploading) return
			uni.chooseImage({
				count: 1,
				sizeType: ['compressed'],
				sourceType: ['album', 'camera'],
				success: (res) => {
					const tempFile = res.tempFiles[0]
					if (tempFile.size > 10 * 1024 * 1024) {
						uni.showToast({ title: '照片大小不能超过10MB', icon: 'none' })
						return
					}
					this.photoPath = res.tempFilePaths[0]
					this.photoPreviewUrl = res.tempFilePaths[0]
					this.uploadedFilename = ''
				}
			})
		},

		async handleStartAnalysis() {
			if (this.photoPreviewUrl === '') {
				uni.showToast({ title: '请先上传照片', icon: 'none' })
				return
			}
			if (this.uploading) return

			// 上传前检查登录态，未登录先拉起登录弹窗
			if (!isLoggedIn()) {
				this.showLoginPopup = true
				return
			}

			// 付费模式且已知无剩余次数：直接拉起支付，省一次必败请求
			if (this.isPaidMode && this.creditBalance <= 0) {
				this.handleRecharge()
				return
			}

			// 如果已经上传过，直接跳转
			if (this.uploadedFilename !== '') {
				this.navigateToLoading()
				return
			}

			this.uploading = true
			try {
				const res = await uploadPhoto(this.photoPath)
				if ((res.code === 0 || res.code === 200) && res.data && res.data.filename) {
					this.uploadedFilename = res.data.filename
					this.uploading = false
					this.navigateToLoading()
				} else {
					this.uploading = false
					uni.showToast({ title: res.message || '上传失败，请重试', icon: 'none' })
				}
			} catch (err) {
				this.uploading = false
				// 401 已由全局机制处理，这里只捕获其他错误
				const errMsg = (err as Error)?.message ?? ''
				if (errMsg.indexOf('取消') === -1 && errMsg.indexOf('未授权') === -1) {
					uni.showToast({ title: '上传失败，请重试', icon: 'none' })
				}
			}
		},

		navigateToLoading() {
			uni.navigateTo({
				url: `/pages/aiRecommendLoading/index?filename=${encodeURIComponent(this.uploadedFilename)}&shopId=${this.shopId}`
			})
		},

		// ========== 推荐次数 / 支付 ==========

		// 查询推荐次数余额与单次定价（失败时静默，保持原按钮）
		async loadCreditInfo() {
			try {
				const shopIdNum = parseInt(this.shopId) || 0
				const res = await getCreditBalance(shopIdNum > 0 ? shopIdNum : undefined, 'recommend')
				if (res.code === 200 && res.data) {
					this.creditBalance = res.data.balance
					this.priceFenPerCredit = res.data.priceFenPerCredit
					this.creditLoaded = true
				}
			} catch (err) {
				console.error('[aiRecommend] 查询推荐次数失败:', err)
			}
		},

		// 充值：创建订单 → 拉起微信支付 → 轮询到账
		async handleRecharge() {
			if (this.isPaying) return
			this.isPaying = true
			// 支付由分析流程触发，到账后自动继续分析
			this.resumeAnalyzeAfterCredit = true
			try {
				const shopIdNum = parseInt(this.shopId) || 0
				const res = await createCreditRecharge({ shopId: shopIdNum, credits: 1, feature: 'recommend' })
				if (res.code !== 200 || !res.data) {
					this.isPaying = false
					uni.showToast({ title: res.message || '下单失败，请重试', icon: 'none' })
					return
				}
				const order = res.data
				const outTradeNo = order.outTradeNo
				uni.requestPayment({
					provider: 'wxpay',
					timeStamp: order.timeStamp,
					nonceStr: order.nonceStr,
					package: order.package,
					signType: order.signType,
					paySign: order.paySign,
					success: () => {
						// 支付成功：到账为微信异步回调入账，轮询订单状态确认
						this.pollRechargeStatus(outTradeNo)
					},
					fail: (payErr: any) => {
						this.isPaying = false
						const errMsg: string = payErr?.errMsg ?? ''
						if (errMsg.indexOf('cancel') !== -1) {
								uni.showToast({ title: '已取消支付', icon: 'none' })
						} else {
								console.error('[aiRecommend] 拉起支付失败:', errMsg)
								uni.showToast({ title: '支付未完成，请重试', icon: 'none' })
						}
					}
				} as any)
			} catch (err) {
				this.isPaying = false
				console.error('[aiRecommend] 创建充值订单失败:', err)
				uni.showToast({ title: '下单失败，请重试', icon: 'none' })
			}
		},

		// 轮询充值订单状态：每 2.5 秒一次，最多 48 次（约 2 分钟兑底），paid = true 即到账
		pollRechargeStatus(outTradeNo: string) {
			this.payPollToken = this.payPollToken + 1
			const token = this.payPollToken
			const maxTimes = 48
			let count = 0
			uni.showLoading({ title: '确认到账中...', mask: true })
			const check = async () => {
				if (token !== this.payPollToken) {
					uni.hideLoading()
					return
				}
				count = count + 1
				try {
					const res = await getCreditRechargeStatus(outTradeNo)
					if (res.code === 200 && res.data && res.data.paid) {
						uni.hideLoading()
						this.isPaying = false
						this.creditBalance = res.data.balance
						uni.showToast({ title: `支付成功，${res.data.credits} 次到账`, icon: 'none' })
						this.resumeAnalyzeIfNeeded()
						return
					}
				} catch (err) {
					console.error('[aiRecommend] 查询充值状态失败:', err)
				}
				if (count >= maxTimes) {
					uni.hideLoading()
					this.isPaying = false
					uni.showToast({ title: '到账确认超时，请稍后查看余额', icon: 'none' })
					return
				}
				setTimeout(check, 2500)
			}
			check()
		},

		// 支付到账后，自动继续之前被打断的分析
		resumeAnalyzeIfNeeded() {
			if (this.resumeAnalyzeAfterCredit) {
				this.resumeAnalyzeAfterCredit = false
				this.handleStartAnalysis()
			}
		},

		// ========== 登录弹窗相关 ==========
		closeLoginPopup() {
			this.showLoginPopup = false
			this.loginAgreementChecked = false
			// 用户主动取消登录，reject 所有挂起的 401 请求
			rejectAllPending()
			rejectAllPendingUploads()
		},

		toggleLoginAgreement() {
			this.loginAgreementChecked = !this.loginAgreementChecked
		},

		showLoginAgreementToast() {
			uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
		},

		openUserAgreement() {
			openUserAgreement()
		},

		openPrivacyPolicy() {
			openPrivacyPolicy()
		},

		// 手机号授权回调
		async onGetPhoneNumber(e: any) {
			if (!this.loginAgreementChecked) {
				this.showLoginAgreementToast()
				return
			}
			const detail = e.detail || {}

			// 用户拒绝授权
			if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
				if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
					uni.showToast({ title: '已取消授权', icon: 'none' })
				} else {
					console.error('[aiRecommend] 手机号授权失败:', detail.errMsg)
					uni.showToast({ title: '授权失败，请重试', icon: 'none' })
				}
				this.closeLoginPopup()
				return
			}

			const phoneCode = detail.code
			if (!phoneCode) {
				console.error('[aiRecommend] 未获取到 phoneCode，detail:', JSON.stringify(detail))
				uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
				this.closeLoginPopup()
				return
			}

			try {
				uni.showLoading({ title: '登录中...', mask: true })
				const result = await runPhoneLogin(phoneCode)
				uni.hideLoading()

				if (!result.ok) {
					if (result.errorKind === 'login') {
						uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
					} else {
						uni.showToast({ title: result.errorMsg || '登录失败', icon: 'none' })
					}
					this.closeLoginPopup()
					return
				}

				// 关闭手机号登录弹窗
				this.showLoginPopup = false
				this.loginAgreementChecked = false
				// 登录成功后查询推荐次数余额（首次查询后端会惰性发放免费次数）
				this.loadCreditInfo()
				if (result.phoneHasFullProfile) {
					uni.showToast({ title: '登录成功', icon: 'success' })
				} else {
					this.openProfilePopup()
				}
			} catch (err) {
				uni.hideLoading()
				console.error('[aiRecommend] 手机号登录失败:', err)
				uni.showToast({ title: '登录失败，请重试', icon: 'none' })
			}
		},

		// 打开头像昵称授权弹窗
		openProfilePopup() {
			const info = getUserInfo()
			this.profileAvatarUrl = info?.avatarUrl || ''
			this.profileNickname = info?.nickname || ''
			this.showProfilePopup = true
		},

		onChooseAvatar(e: any) {
			const url = e?.detail?.avatarUrl
			if (url) this.profileAvatarUrl = String(url)
		},

		async submitProfile() {
			const nickname = (this.profileNickname || '').trim()
			const avatarUrl = this.profileAvatarUrl || ''
			if (nickname === '' && avatarUrl === '') {
				this.skipProfile()
				return
			}
			const optimistic: UserInfo = {
				id: 0,
				openid: '',
				phone: null,
				nickname: nickname !== '' ? nickname : null,
				avatarUrl: avatarUrl !== '' ? avatarUrl : null
			}
			mergeUserInfo(optimistic)
			try {
				uni.showLoading({ title: '更新中...', mask: true })
				const result = await submitUserProfile({
					nickname: nickname !== '' ? nickname : undefined,
					avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
				})
				uni.hideLoading()
				if (!result.ok) {
					uni.showToast({ title: result.errorMsg || '更新失败', icon: 'none' })
				}
			} catch (err) {
				console.error('[aiRecommend] 更新头像昵称失败:', err)
				uni.hideLoading()
				uni.showToast({ title: '更新失败，请重试', icon: 'none' })
			} finally {
				this.finishProfile()
			}
		},

		skipProfile() {
			this.finishProfile()
		},

		finishProfile() {
			this.showProfilePopup = false
			this.profileAvatarUrl = ''
			this.profileNickname = ''
			uni.showToast({ title: '登录成功', icon: 'success' })
		}
	}
}
</script>

<style>
.page {
	background: #160F04;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
}

/* 描述文案 */
.desc-bar {
	padding: 40rpx 32rpx 8rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.desc-text {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.7);
	text-align: center;
}

/* 上传区 */
.section {
	padding: 24rpx 32rpx;
}
.upload-area {
	position: relative;
	width: 100%;
	min-height: 320rpx;
	border-radius: 16rpx;
	border-width: 2rpx;
	border-style: dashed;
	border-color: rgba(255, 255, 255, 0.3);
	background-color: rgba(255, 255, 255, 0.05);
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}
.upload-placeholder {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}
.upload-plus {
	font-size: 64rpx;
	color: rgba(255, 255, 255, 0.5);
	margin-bottom: 16rpx;
}
.upload-hint {
	font-size: 26rpx;
	color: rgba(255, 255, 255, 0.4);
}
.upload-preview {
	width: 100%;
}

/* 底部占位 */
.bottom-spacer {
	height: 260rpx;
}

/* 底部固定 */
.fixed-bottom {
	position: fixed;
	left: 0;
	bottom: 0;
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 24rpx 32rpx;
	padding-bottom: 40rpx;
	background-color: #160F04;
}

/* 分析按钮 — 与AI试衣生成按钮一致的渐变背景 */
.action-btn {
	width: 100%;
	height: 88rpx;
	border-radius: 44rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background: linear-gradient(109deg, #f2949f 12%, #d7a3bf 31%, #a0a6ec 51%, #9daeea 71%, #7bace3 91%);
}
.action-btn-disabled {
	opacity: 0.4;
}
.action-btn-text {
	font-size: 32rpx;
	color: #fff;
	font-weight: 500;
}
.action-btn-price {
	font-size: 32rpx;
	color: #fff;
	font-weight: 700;
}

/* 分析按钮容器（预留 padding-top 承载角标，避免角标负偏移被裁剪） */
.action-btn-wrap {
	position: relative;
	width: 100%;
	padding-top: 20rpx;
}
/* 限免角标（整体落在容器 padding 预留空间内，不用负偏移，避免被裁剪） */
.action-btn-badge {
	position: absolute;
	top: 0rpx;
	right: 0rpx;
	z-index: 1;
	background: #ff3b30;
	border-radius: 16rpx;
	padding: 4rpx 12rpx;
}
.action-btn-badge-text {
	font-size: 20rpx;
	color: #fff;
}

/* Copyright */
.footer-copyright {
