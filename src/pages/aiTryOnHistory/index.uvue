<template>
	<view class="container">
		<!-- 自定义导航栏（与 favorites 一致：fixed + 返回按钮 + 标题） -->
		<view class="custom-nav">
			<view :style="{height: statusBarHeight + 'px'}"></view>
			<view class="nav-content">
				<image class="back-btn" src="/static/back-arrow.svg" mode="aspectFit" @click="goBack"></image>
				<view class="nav-title">AI试衣记录</view>
			</view>
		</view>
		<!-- 占位 -->
		<view :style="{height: (statusBarHeight + 44) + 'px'}"></view>

		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container main-content">
			<view class="sk-row" style="flex-wrap: wrap;">
				<view v-for="i in 4" :key="i" class="sk-photo-item sk-animate"></view>
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else class="content main-content">
			<!-- 空状态 -->
			<view v-if="isEmpty" class="empty-state">
				<view class="empty-title">暂无内容</view>
				<view class="empty-desc">还没有 AI 试衣记录哦</view>
			</view>

			<!-- AI 试衣记录列表 -->
			<view v-else class="photolistContainer">
				<view
					v-for="(item, index) in taskList"
					:key="index"
					class="photoItem"
					hover-class="press-dim"
					@click="handleItemClick(item)"
				>
					<image
						:src="getCoverUrl(item)"
						class="photo fade-in"
						mode="aspectFill"
					/>
					<!-- 状态遮罩：生成中 -->
					<view v-if="isProcessing(item.status)" class="status-overlay">
						<view class="status-badge processing">
							<view class="loading-dot"></view>
							<text class="status-text">生成中</text>
						</view>
					</view>
					<!-- 状态遮罩：生成失败 -->
					<view v-else-if="item.status === 'failed'" class="status-overlay">
						<view class="status-badge failed">
							<text class="status-text">生成失败</text>
						</view>
					</view>

					<!-- 底部信息：风格名 + 创建时间 -->
					<view class="mask">
						<view class="desc">
							<view class="photoName">{{ item.style_name || 'AI 试衣' }}</view>
							<view class="time">{{ formatTime(item.created_at) }}</view>
						</view>
					</view>
				</view>
			</view>
		</view>

		<!-- 页脚 Copyright -->
		<view class="page-footer">
			<view class="divide"></view>
			<view class="copyright"><AppFooter /></view>
		</view>
	</view>
</template>

<script lang="uts">
import { getAiTasks } from '../../utils/api.uts'
import { getUserInfo } from '../../utils/auth.uts'

type AiTaskItem = {
	id: number
	status: string
	result_image_url: string
	template_image_url: string
	style_name: string
	created_at: string
}

export default {
	data() {
		return {
			statusBarHeight: 20,
			loading: true,
			taskList: [] as AiTaskItem[],
			isEmpty: false,
			// 首次进入：onLoad 已触发 loadData，onShow 跳过一次避免重复请求
			firstShow: true
		}
	},

	onLoad() {
		const systemInfo = uni.getSystemInfoSync()
		this.statusBarHeight = systemInfo.statusBarHeight || 20
		this.loadData()
	},

	onShow() {
		if (this.firstShow) {
			this.firstShow = false
			return
		}
		// 用户从结果页返回时，状态可能已更新，刷新列表
		this.loadData()
	},

	methods: {
		goBack() {
			uni.navigateBack()
		},

		async loadData() {
			try {
				this.loading = true

				const userInfo = getUserInfo()
				const openid = (userInfo != null && userInfo.openid != null) ? userInfo.openid : ''
				if (openid === '') {
					this.taskList = []
					this.isEmpty = true
					return
				}

				const res = await getAiTasks(openid)
				// aiface 接口 code === 0 或 200 表示成功
				if ((res.code === 0 || res.code === 200) && res.data != null) {
					this.taskList = res.data
					this.isEmpty = this.taskList.length === 0
				} else {
					this.taskList = []
					this.isEmpty = true
				}
			} catch (err) {
				console.error('加载 AI 试衣记录失败:', err)
				uni.showToast({ title: '加载失败', icon: 'none' })
				this.isEmpty = true
			} finally {
				this.loading = false
			}
		},

		// 点击卡片：仅 completed 状态可跳转结果详情页
		handleItemClick(item: AiTaskItem) {
			if (item.status === 'completed') {
				uni.navigateTo({
					url: `/pages/aiTryOnResult/index?taskId=${item.id}`
				})
			} else if (item.status === 'pending' || item.status === 'processing') {
				// 进行中：也跳转到结果页继续轮询
				uni.navigateTo({
					url: `/pages/aiTryOnResult/index?taskId=${item.id}`
				})
			} else if (item.status === 'failed') {
				uni.showToast({ title: '该记录生成失败', icon: 'none' })
			}
		},

		// 选择卡片封面图：completed 用结果图，其它用模板图兜底
		getCoverUrl(item: AiTaskItem): string {
			if (item.status === 'completed' && item.result_image_url != null && item.result_image_url !== '') {
				return item.result_image_url
			}
			return item.template_image_url || ''
		},

		isProcessing(status: string): boolean {
			return status === 'pending' || status === 'processing'
		},

		// 格式化创建时间为 "MM-DD HH:mm"，无法解析则原样返回
		formatTime(input: string): string {
			if (input == null || input === '') return ''
			// 兼容 "2024-05-12 14:30:00" / ISO 字符串
			const normalized = input.replace(' ', 'T')
			const ts = Date.parse(normalized)
			if (isNaN(ts)) return input
			const d = new Date(ts)
			const mm = this.pad(d.getMonth() + 1)
			const dd = this.pad(d.getDate())
			const hh = this.pad(d.getHours())
			const mi = this.pad(d.getMinutes())
			return `${mm}-${dd} ${hh}:${mi}`
		},

		pad(n: number): string {
			return n < 10 ? `0${n}` : `${n}`
		}
	}
}
</script>

<style>
.container {
	background: var(--color-bg);
	min-height: 100vh;
	color: #fff;
	display: flex;
	flex-direction: column;
}
.main-content {
	flex: 1;
}
.page-footer {
	margin-top: auto;
}
.divide {
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}

/* 自定义导航栏 */
.custom-nav {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	background: var(--color-bg);
	z-index: 100;
}
.nav-content {
	height: 44px;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 0 16rpx;
}
.back-btn {
	width: 44rpx;
	height: 44rpx;
	padding: var(--spacing-xs);
}
.nav-title {
	flex: 1;
	text-align: center;
	font-size: 32rpx;
	font-weight: 400;
	color: var(--color-primary);
	/* 视觉补偿返回按钮宽度，使标题真正居中 */
	margin-right: 64rpx;
}

.content {
	padding: 0 8rpx var(--spacing-lg);
}

/* 空状态 */
.empty-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 200rpx var(--spacing-lg);
}
.empty-title {
	font-size: 32rpx;
	color: rgba(255, 255, 255, 0.5);
	margin-bottom: 16rpx;
}
.empty-desc {
	font-size: var(--font-size-body);
	color: rgba(255, 255, 255, 0.3);
}

/* 卡片网格（与 favorites 一致） */
.photolistContainer {
	margin: 16rpx 0;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
.photoItem {
	width: 362rpx;
	height: 482rpx;
	margin: 0 8rpx 8rpx 0;
	position: relative;
}
.photoItem:nth-child(2n) {
	margin: 0 0 8rpx;
}
.photo {
	width: 100%;
	height: 100%;
	border-radius: var(--radius-xs);
	background: rgba(255, 255, 255, 0.06);
}
.mask {
	position: absolute;
	width: 362rpx;
	height: 482rpx;
	top: 0;
	left: 0;
	border-radius: var(--radius-xs);
	background: linear-gradient(180deg, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.4) 75%, rgba(0, 0, 0, 0.7) 89%, #000000 100%);
}
.desc {
	margin: 436rpx 16rpx 0;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}
.photoName {
	font-size: var(--font-size-body-plus);
	font-weight: 400;
	color: #fff;
	flex: 1;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.time {
	font-size: var(--font-size-body-sm);
	color: rgba(255, 255, 255, 0.6);
	margin-left: 12rpx;
}

/* 状态遮罩：生成中 / 生成失败 */
.status-overlay {
	position: absolute;
	width: 362rpx;
	height: 482rpx;
	top: 0;
	left: 0;
	border-radius: var(--radius-xs);
	background: rgba(0, 0, 0, 0.55);
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 2;
}
.status-badge {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 12rpx 24rpx;
	border-radius: var(--radius-lg);
	border: 1rpx solid rgba(255, 255, 255, 0.25);
}
.status-badge.processing {
	background: rgba(243, 217, 172, 0.18);
}
.status-badge.failed {
	background: rgba(221, 82, 77, 0.25);
	border-color: rgba(221, 82, 77, 0.5);
}
.status-text {
	font-size: var(--font-size-body);
	color: #fff;
	font-weight: 400;
}
.loading-dot {
	width: 12rpx;
	height: 12rpx;
	border-radius: 50%;
	background: #F3D9AC;
	margin-right: var(--spacing-xs);
	animation: dotPulse 1s ease-in-out infinite;
}
@keyframes dotPulse {
	0% { opacity: 0.3; transform: scale(0.8); }
	50% { opacity: 1; transform: scale(1.1); }
	100% { opacity: 0.3; transform: scale(0.8); }
}

/* Copyright */
.copyright {
	margin: var(--spacing-lg) auto;
	font-size: var(--font-size-caption-md);
	color: var(--color-primary-50);
	font-weight: 400;
	text-align: center;
}
</style>
