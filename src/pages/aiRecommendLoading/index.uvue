<template>
	<view class="page">
		<!-- 加载态 -->
		<view class="center-content">
			<view class="loading-wrapper">
				<view class="loading-spinner"></view>
				<text class="loading-tip">正在为您分析推荐，请稍候...</text>
				<text class="elapsed-text" v-if="elapsedSeconds > 0">已等待 {{ elapsedSeconds }} 秒</text>
			</view>
		</view>

		<!-- 底部 Copyright -->
		<view class="page-footer">
			<view class="divide"></view>
			<view class="bottomdesc"><AppFooter /></view>
		</view>
	</view>
</template>

<script lang="uts">
import AppFooter from '../../components/AppFooter/AppFooter.uvue'

export default {
	components: { AppFooter },
	data() {
		return {
			elapsedSeconds: 0,
			countdownTimer: null as any
		}
	},
	onLoad() {
		this.startCountdown()
	},
	onUnload() {
		this.stopCountdown()
	},
	methods: {
		startCountdown() {
			this.elapsedSeconds = 0
			this.countdownTimer = setInterval(() => {
				this.elapsedSeconds++
			}, 1000)
		},
		stopCountdown() {
			if (this.countdownTimer) {
				clearInterval(this.countdownTimer)
				this.countdownTimer = null
			}
		}
	}
}
</script>

<style>
.page {
	background: #000;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	position: relative;
}

/* 居中内容区域 */
.center-content {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 64rpx;
}

/* 加载态 */
.loading-wrapper {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.loading-spinner {
	width: 80rpx;
	height: 80rpx;
	border: 6rpx solid rgba(255, 255, 255, 0.2);
	border-top-color: rgba(255, 255, 255, 0.8);
	border-radius: 50%;
	margin-bottom: 48rpx;
	animation: spin 1s linear infinite;
}
@keyframes spin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}
.loading-tip {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.7);
	text-align: center;
	line-height: 44rpx;
}
.elapsed-text {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.4);
	margin-top: 24rpx;
}

/* 底部 */
.page-footer {
	margin-top: auto;
}
.divide {
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}
.bottomdesc {
	margin: 32rpx auto;
	font-size: 20rpx;
	color: rgba(255, 255, 255, 0.5);
}
</style>
