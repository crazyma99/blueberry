<template>
	<view class="page">
		<CustomNavBar title="AI分析中" />
		<!-- 加载态 -->
		<view class="center-content">
			<view class="loading-wrapper">
				<view class="loading-spinner"></view>
				<text class="loading-tip">正在为您分析推荐，请稍候...</text>
				<text class="elapsed-text" v-if="elapsedSeconds > 0">已等待 {{ elapsedSeconds }} 秒</text>
			</view>
		</view>

		<!-- 失败态 -->
		<view v-if="status === 'failed'" class="center-content" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: #160F04;">
			<view class="fail-wrapper">
				<text class="fail-text">AI分析失败，请重试</text>
				<view class="retry-btn" @click="handleRetry">
					<text class="retry-btn-text">重试</text>
				</view>
				<view class="back-btn-wrapper" @click="handleBack">
					<text class="back-btn-text">返回</text>
				</view>
			</view>
		</view>

		<!-- 底部 Copyright -->
		<view class="page-footer">
			<view class="divide"></view>
			<view class="bottomdesc"><AppFooter /></view>
		</view>
	</view>
</template>

<script lang="uts">
import AppFooter from '../../components/AppFooter/AppFooter.uvue'
import { getAiRecommend, createCreditRecharge, getCreditRechargeStatus } from '../../utils/api.uts'

export default {
	components: { AppFooter },
	data() {
		return {
			filename: '',
			shopId: '',
			status: 'processing' as string,  // 'processing' | 'failed'
			elapsedSeconds: 0,
			countdownTimer: null as any,
			pollingTimer: null as any,
			failCount: 0,
			// 推荐次数不足（4001）时的充值支付
			isPaying: false,
			payPollToken: 0    // 到账轮询会话标记，自增即失效
		}
	},
	onLoad(options : any) {
		this.filename = options?.filename ?? ''
		this.shopId = options?.shopId ?? ''
		if (this.filename !== '') {
			this.startAnalysis()
		} else {
			this.status = 'failed'
		}
	},
	onUnload() {
		this.stopAll()
	},
	methods: {
		startAnalysis() {
			this.status = 'processing'
			this.elapsedSeconds = 0
			this.failCount = 0

			// 计时器：每秒更新已等待时间
			this.countdownTimer = setInterval(() => {
				this.elapsedSeconds += 1
				// 超时 180 秒（3分钟），停止轮询，展示失败
				if (this.elapsedSeconds >= 180) {
					this.stopAll()
					this.status = 'failed'
				}
			}, 1000)

			// 立即调用一次
			this.callRecommend()

			// 每 30 秒轮询
			this.pollingTimer = setInterval(() => {
				this.callRecommend()
			}, 30000)
		},

		async callRecommend() {
			try {
				const res = await getAiRecommend({
					user_photo_filename: this.filename,
					shop_id: parseInt(this.shopId) || 0
				})
				// aiface 接口 code === 0 或 200 表示成功
				if ((res.code === 0 || res.code === 200) && res.data) {
					this.stopAll()
					// 跳转结果页，通过全局事件传递数据（shopId 供详情页 type 参数使用）
					const resultData = JSON.stringify(res.data)
					uni.redirectTo({
						url: `/pages/aiRecommendResult/index?shopId=${this.shopId}&data=${encodeURIComponent(resultData)}`
					})
					return
				}
				// 4001 = 推荐次数不足：停止轮询，拉起充值支付，到账后自动重新分析
				if (res.code === 4001) {
					this.stopAll()
					this.handleRecharge()
					return
				}
				// 其他业务码 → 等待下一轮轮询
			} catch (err) {
				console.error('AI推荐请求失败:', err)
				this.failCount += 1
				// 连续 3 次网络错误，展示失败
				if (this.failCount >= 3) {
					this.stopAll()
					this.status = 'failed'
				}
				// 否则等待下一轮轮询
			}
		},

		stopAll() {
			if (this.pollingTimer != null) {
				clearInterval(this.pollingTimer)
				this.pollingTimer = null
			}
			if (this.countdownTimer != null) {
				clearInterval(this.countdownTimer)
				this.countdownTimer = null
			}
			// 页面卸载/停止时终止可能进行中的到账轮询
			this.payPollToken = this.payPollToken + 1
		},

		// 4001 推荐次数不足：创建充值订单 → 拉起微信支付 → 轮询到账 → 自动重新分析
		async handleRecharge() {
			if (this.isPaying) return
			this.isPaying = true
			uni.showToast({ title: '推荐次数不足，请完成支付', icon: 'none' })
			try {
				const shopIdNum = parseInt(this.shopId) || 0
				const res = await createCreditRecharge({ shopId: shopIdNum, credits: 1, feature: 'recommend' })
				if (res.code !== 200 || !res.data) {
					this.isPaying = false
					this.status = 'failed'
					uni.showToast({ title: res.message || '下单失败，请重试', icon: 'none' })
					return
				}
				const order = res.data
				const outTradeNo = order.outTradeNo
				uni.requestPayment({
					provider: 'wxpay',
					timeStamp: order.timeStamp,
					nonceStr: order.nonceStr,
					package: order.package,
					signType: order.signType,
					paySign: order.paySign,
					success: () => {
						// 支付成功：到账为微信异步回调入账，轮询订单状态确认
						this.pollRechargeStatus(outTradeNo)
					},
					fail: (payErr: any) => {
						this.isPaying = false
						this.status = 'failed'
						const errMsg: string = payErr?.errMsg ?? ''
						if (errMsg.indexOf('cancel') !== -1) {
								uni.showToast({ title: '已取消支付', icon: 'none' })
							} else {
								console.error('[aiRecommendLoading] 拉起支付失败:', errMsg)
								uni.showToast({ title: '支付未完成，请重试', icon: 'none' })
						}
					}
				} as any)
			} catch (err) {
				this.isPaying = false
				this.status = 'failed'
				console.error('[aiRecommendLoading] 创建充值订单失败:', err)
				uni.showToast({ title: '下单失败，请重试', icon: 'none' })
			}
		},

		// 轮询充值订单状态：每 2.5 秒一次，最多 48 次（约 2 分钟兑底），paid = true 即到账
		pollRechargeStatus(outTradeNo: string) {
			this.payPollToken = this.payPollToken + 1
			const token = this.payPollToken
			const maxTimes = 48
			let count = 0
			uni.showLoading({ title: '确认到账中...', mask: true })
			const check = async () => {
				if (token !== this.payPollToken) {
					uni.hideLoading()
					return
				}
				count = count + 1
				try {
					const res = await getCreditRechargeStatus(outTradeNo)
					if (res.code === 200 && res.data && res.data.paid) {
						uni.hideLoading()
						this.isPaying = false
						uni.showToast({ title: `支付成功，${res.data.credits} 次到账`, icon: 'none' })
						// 到账后自动重新开始分析（余额已到账，无需重复支付）
						this.startAnalysis()
						return
					}
				} catch (err) {
					console.error('[aiRecommendLoading] 查询充值状态失败:', err)
				}
				if (count >= maxTimes) {
					uni.hideLoading()
					this.isPaying = false
					this.status = 'failed'
					uni.showToast({ title: '到账确认超时，请重试', icon: 'none' })
					return
				}
				setTimeout(check, 2500)
			}
			check()
		},

		handleRetry() {
			this.failCount = 0
			this.startAnalysis()
		},

		handleBack() {
			this.stopAll()
			uni.navigateBack()
		}
	}
}
</script>

<style>
.page {
	background: #160F04;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	position: relative;
}

/* 居中内容区域 */
.center-content {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 64rpx;
}

/* 加载态 */
.loading-wrapper {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.loading-spinner {
	width: 80rpx;
	height: 80rpx;
	border: 6rpx solid rgba(255, 255, 255, 0.2);
	border-top-color: rgba(255, 255, 255, 0.8);
	border-radius: 50%;
	margin-bottom: 48rpx;
	animation: spin 1s linear infinite;
}
@keyframes spin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}
.loading-tip {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.7);
	text-align: center;
	line-height: 44rpx;
}
.elapsed-text {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.4);
	margin-top: 24rpx;
}

/* 失败态 */
.fail-wrapper {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.fail-text {
	font-size: 30rpx;
	color: rgba(255, 255, 255, 0.7);
	margin-bottom: 48rpx;
	text-align: center;
}
.retry-btn {
	background: #fff;
	border-radius: 48rpx;
	padding: 24rpx 80rpx;
	margin-bottom: 24rpx;
}
.retry-btn-text {
	font-size: 32rpx;
	color: #000;
	font-weight: 500;
}
.back-btn-wrapper {
	padding: 24rpx 80rpx;
}
.back-btn-text {
	font-size: 28rpx;
	color: rgba(241, 205, 145, 0.9);
}

/* 底部 */
.page-footer {
	margin-top: auto;
}
.divide {
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}
.bottomdesc {
	margin: 32rpx auto;
	font-size: 18rpx;
	color: rgba(241, 205, 145, 0.5);
	font-weight: 400;
}
</style>
