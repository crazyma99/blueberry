<template>
	<view class="page">
		<!-- 自定义导航栏：返回按钮 + 客片欣赏/DETAILS + 装饰线 -->
		<view class="custom-nav">
			<view :style="{height: statusBarHeight + 'px'}"></view>
			<view class="nav-content">
				<view class="nav-center">
					<view class="title-group">
						<view class="cn font-noto-serif">客片欣赏</view>
						<view class="en">DETAILS</view>
					</view>
					<image src="/static/category-title-line.png" class="line" mode="aspectFill"/>
				</view>
			</view>
		</view>
		<!-- 状态栏+导航栏占位 -->
		<view :style="{height: (statusBarHeight + 44) + 'px'}"></view>
		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-row" style="justify-content: space-between; margin-bottom: 24rpx;">
				<view>
					<view class="sk-text sk-animate" style="width: 280rpx; height: 36rpx; margin-bottom: 16rpx;"></view>
					<view class="sk-text sk-animate" style="width: 200rpx;"></view>
				</view>
				<view class="sk-block sk-animate" style="width: 48rpx; height: 48rpx; border-radius: 50%;"></view>
			</view>
			<view class="sk-text sk-animate" style="width: 320rpx; margin-bottom: var(--spacing-lg);"></view>
			<view class="sk-block sk-animate" style="width: 100%; height: 500rpx; margin-bottom: 16rpx;"></view>
			<view class="sk-block sk-animate" style="width: 100%; height: 500rpx;"></view>
		</view>

		<!-- 主内容 -->
		<view v-else class="main-content">
			<view class="title">
				<view class="title-first">
					<view class="text font-noto-serif">{{ detail?.title }}</view>
					<image src="/static/cloud.png" class="cloud" mode="aspectFill"/>
				</view>
				<view class="info-row">
					<view class="info-left">
						<view class="price">
							<image src="/static/prize-icon.png" class="icon" mode="aspectFill"/>
							<view>服务价格：</view>
							<view class="count txt">{{ detail?.price }}</view>
						</view>
						<view class="package">
							<image src="/static/desc-icon.png" class="icon" mode="aspectFill"/>
							<view class="txt">套餐内容：{{ detail?.packageDesc }}</view>
						</view>
					</view>
					<view class="collect" hover-class="press-dim"
					@click="handleLike">
						<image
							:src="liked ? '/static/liked.svg' : '/static/like.svg'"
							class="heart"
						></image>
						<text class="like-num">{{ formatCount(likeCount) }}</text>
					</view>
				</view>
			</view>
			<view class="photo-wrap">
				<image
					v-for="(item, index) in (detail?.images || [])"
					class="photo fade-in"
					:src="item.imageUrl"
					mode="widthFix"
					:key="index"
				></image>
			</view>
			<!-- 底部固定栏（组件化：按钮组由 slot 传入，版权 footer 组件内置） -->
			<BottomActionBar>
				<view v-if="!loading && detail?.tryonDisabled !== true" class="ai-tryon-btn">
					<image src="/static/btn-left-icon.png" class="btn-icon" mode="aspectFill"/>
					<view class="btn btn-primary" hover-class="press-dim" @click="goToAiTryOn">
						<view>生成</view>
						<image src="/static/aitry-text.png" class="text" mode="aspectFill"/>
						<view>效果</view>
					</view>
					<image src="/static/btn-right-icon.png" class="btn-icon" mode="aspectFill"/>
				</view>
			</BottomActionBar>
			<!-- 底部占位：覆盖固定栏高度（按钮组+版权footer） -->
			<view class="ai-tryon-spacer"></view>
		</view>

		<!-- 登录弹窗 -->
		<LoginPopup
	v-if="showLoginPopup"
	:agreement-checked="loginAgreementChecked"
	:user-agreement-name="userAgreementName"
	:privacy-policy-name="privacyPolicyName"
	@close="closeLoginPopup"
	@toggle-agreement="toggleLoginAgreement"
	@show-toast="showLoginAgreementToast"
	@open-user="openUserAgreement"
	@open-privacy="openPrivacyPolicy"
	@get-phone="onGetPhoneNumber"
/>

		<!-- 头像昵称授权弹窗 -->
		<ProfilePopup
	v-if="showProfilePopup"
	:avatar-url="profileAvatarUrl"
	:nickname="profileNickname"
	@choose-avatar="onChooseAvatar"
	@update-nickname="(v: string) => { this.profileNickname = v }"
	@submit="submitProfile"
	@skip="skipProfile"
/>
	</view>
</template>

<script>
	import { getalbumDetail, toggleLike, getLikeStatus, wxLogin, wxBindPhone, rejectAllPendingUploads } from '../../utils/api.uts'
	import { hapticTap } from '../../utils/haptics.uts'
	import { isLoggedIn, loginSuccess, setUserInfo, mergeUserInfo, getUserInfo, consumeLoginExpired } from '../../utils/auth.uts'
	import { runPhoneLogin } from '../../utils/loginFlow.uts'
	import { rejectAllPending } from '../../utils/http.uts'
	import {
		USER_AGREEMENT_NAME,
		PRIVACY_POLICY_NAME,
		openUserAgreement,
		openPrivacyPolicy
	} from '../../utils/legal.uts'
	import { formatCount as _formatCount } from '../../utils/format.uts'
	import { preloadImage as _preloadImage, preloadImages as _preloadImages } from '../../utils/imageLoader.uts'
	import { resolveShareCard } from '../../utils/share.uts'

	export default {
		data() {
			return {
				loading: true,
				statusBarHeight: 20,
				liked: false,
				likeCount: 0,
				detail: null,
				albumId: '',
				shopId: '',
				category: '',
				subCategory: '',
				style: '',
				showLoginPopup: false,
				loginAgreementChecked: false,
				userAgreementName: USER_AGREEMENT_NAME,
				privacyPolicyName: PRIVACY_POLICY_NAME,
				// 头像昵称授权弹窗
				showProfilePopup: false,
				profileAvatarUrl: '',
				profileNickname: '',
				// 分享卡片（品牌配置 > 中台全局 > 代码默认），onLoad 异步解析后覆盖
				shareCard: { title: '点击查看客片详情信息，也支持一键AI试衣哦～', imageUrl: '/static/share-aitryon.jpg' }
			}
		},
		onShareAppMessage() {
			return {
				title: this.shareCard.title,
				path: `/pages/targetPhotoDetail/index?idx=${this.albumId}&type=${this.shopId}`,
				imageUrl: this.shareCard.imageUrl
			}
		},
		onLoad(query) {
			const systemInfo = uni.getSystemInfoSync()
			this.statusBarHeight = systemInfo.statusBarHeight || 20
			const id = query?.idx ?? ''
			const type = query?.type ?? ''
			this.albumId = id
			this.shopId = type
			this.category = query?.category ?? ''
			this.subCategory = query?.subCategory ?? ''
			this.style = query?.style ? decodeURIComponent(query.style) : ''
			this.liked = query?.liked === 'true'
			this.loadShareCard()
			this.getDetail(id, type)
		},
		onShow() {
			// 监听 401 登录过期事件，自动拉起登录弹窗
			uni.$off('login-required')
			uni.$on('login-required', () => {
				this.showLoginPopup = true
			})
			// 兑底：其他页面触发 401 后导航回来时自动弹出
			if (consumeLoginExpired()) {
				this.showLoginPopup = true
			}
		},
		onHide() {
			uni.$off('login-required')
		},
		methods: {
			// 分享卡片解析：品牌配置 > 中台全局 > 代码默认（{brand} 占位符自动替换品牌名）
			async loadShareCard() {
				try {
					this.shareCard = await resolveShareCard('targetPhotoDetail')
				} catch (e) {
					// 解析失败保留默认卡片
				}
			},
			// ====== 图片预加载工具方法（转发至 utils/imageLoader） ======
			preloadImage(url) {
				return _preloadImage(url)
			},
			async preloadImages(urls, timeout = 5000) {
				return _preloadImages(urls, timeout)
			},
			async getDetail(id, type) {
				try {
					this.loading = true
					const res = await getalbumDetail('get', {
						albumId: id,
						type
					})
					const { code, data } = res
					if (code !== 200) return
					this.detail = data
					if (id) {
						await this.refreshLikeStatus(id)
					}

					// 预加载前几张详情图片（最多前3张），图片缓存就绪后再隐藏骨架屏
					const imageUrls = (data?.images || [])
						.slice(0, 3)
						.map(img => img.imageUrl)
						.filter(Boolean)
					await this.preloadImages(imageUrls, 2500)
				} catch (err) {
					console.error('获取详情失败:', err)
				} finally {
					this.loading = false
				}
			},
			async refreshLikeStatus(albumId) {
				try {
					const likeRes = await getLikeStatus(String(albumId)).catch(() => null)
					if (likeRes && likeRes.code === 200 && likeRes.data && likeRes.data.length > 0) {
						this.liked = likeRes.data[0].liked
						this.likeCount = likeRes.data[0].likeCount
					}
				} catch (err) {
					console.warn('获取点赞状态失败:', err)
				}
			},
			async handleLike() {
				if (!this.albumId) return
				if (!isLoggedIn()) {
					// 未登录，弹出登录弹窗
					this.showLoginPopup = true
					return
				}
				await this.doToggleLike()
			},
			// 执行点赞切换
			async doToggleLike() {
				try {
					const res = await toggleLike(Number(this.albumId))
					if (res.code === 200 && res.data) {
						this.liked = res.data.liked
						this.likeCount = res.data.likeCount
					}
				} catch (err) {
					console.error('点赞失败:', err)
					uni.showToast({ title: '操作失败', icon: 'none' })
				}
			},
			// 关闭登录弹窗
			closeLoginPopup() {
				this.showLoginPopup = false
				this.loginAgreementChecked = false
				// 用户主动取消登录，reject 所有挂起的 401 请求
				rejectAllPending()
				rejectAllPendingUploads()
			},
			toggleLoginAgreement() {
				this.loginAgreementChecked = !this.loginAgreementChecked
			},
			showLoginAgreementToast() {
				uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
			},
			openUserAgreement() {
				openUserAgreement()
			},
			openPrivacyPolicy() {
				openPrivacyPolicy()
			},
			// 手机号授权回调
			async onGetPhoneNumber(e) {
				if (!this.loginAgreementChecked) {
					this.showLoginAgreementToast()
					return
				}
				const detail = e.detail || {}
				// 用户拒绝授权
				if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
					if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
						uni.showToast({ title: '已取消授权', icon: 'none' })
					} else {
						console.error('手机号授权失败:', detail.errMsg)
						uni.showToast({ title: '授权失败，请重试', icon: 'none' })
					}
					this.closeLoginPopup()
					return
				}

				const phoneCode = detail.code
				if (!phoneCode) {
					console.error('未获取到 phoneCode，detail:', JSON.stringify(detail))
					uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
					this.closeLoginPopup()
					return
				}

				try {
					uni.showLoading({ title: '登录中...', mask: true })
					// 登录三步骤已下沉到 utils/loginFlow.uts
					const result = await runPhoneLogin(phoneCode)
					uni.hideLoading()

					if (!result.ok) {
						if (result.errorKind === 'login') {
							uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
						} else {
							uni.showToast({ title: result.errorMsg || '登录失败', icon: 'none' })
						}
						this.closeLoginPopup()
						return
					}

					// 本页无 phoneHasFullProfile 短路：始终弹 profile 补齐（保持现状）
					this.showLoginPopup = false
					this.openProfilePopup()
				} catch (err) {
					uni.hideLoading()
					console.error('登录失败:', err)
					uni.showToast({ title: '登录失败，请重试', icon: 'none' })
				}
			},

			// 打开头像昵称授权弹窗
			openProfilePopup() {
				const info = getUserInfo()
				this.profileAvatarUrl = info?.avatarUrl || ''
				this.profileNickname = info?.nickname || ''
				this.showProfilePopup = true
			},

			onChooseAvatar(e) {
				const url = e?.detail?.avatarUrl
				if (url) this.profileAvatarUrl = String(url)
			},

			async submitProfile() {
				const nickname = (this.profileNickname || '').trim()
				const avatarUrl = this.profileAvatarUrl || ''
				if (nickname === '' && avatarUrl === '') {
					this.skipProfile()
					return
				}
				try {
					uni.showLoading({ title: '更新中...', mask: true })
					const loginRes = await uni.login({ provider: 'weixin' })
					if (!loginRes.code) {
						uni.hideLoading()
						this.finishProfile()
						return
					}
					const wxRes = await wxLogin({
						code: loginRes.code,
						nickname: nickname !== '' ? nickname : undefined,
						avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
					})
					if (wxRes.code === 200 && wxRes.data) {
						loginSuccess(wxRes.data.token, wxRes.data.userInfo)
					}
					uni.hideLoading()
				} catch (err) {
					console.error('更新头像昵称失败:', err)
					uni.hideLoading()
				} finally {
					await this.finishProfile()
				}
			},

			skipProfile() {
				this.finishProfile()
			},

			async finishProfile() {
				this.showProfilePopup = false
				this.profileAvatarUrl = ''
				this.profileNickname = ''
				uni.showToast({ title: '登录成功', icon: 'success' })
				// 登录成功后，自动执行点赞操作
				await this.doToggleLike()
			},
			formatCount(count) {
				return _formatCount(count)
			},
			goToAiTryOn() {
				// 触感反馈：主操作按钮轻振动
				hapticTap()
				const albumId = this.albumId || ''
				const style = encodeURIComponent(this.style || '')
				uni.navigateTo({
					url: `/pages/aiTryOn/index?albumId=${albumId}&shopId=${this.shopId}&category=${this.category}&subCategory=${this.subCategory}&style=${style}`
				})
			}
		}
	}
</script>

<style>
.page{
	background: var(--color-bg);
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	color: #fff;
}
.main-content {
	flex: 1;
	display: flex;
	flex-direction: column;
}
/* 自定义导航栏 */
.custom-nav {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	background: var(--color-bg);
	z-index: 100;
}
.nav-content {
	height: 44px;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 0 18rpx;
}
.nav-center {
	flex: 1;
	display: flex;
	flex-direction: row;
	align-items: center;
	/* 左右相距 28rpx */
	gap: var(--spacing-md);
}
.title-group {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.cn{
	font-size: var(--font-size-display);
	font-weight: 400;
	color: var(--color-primary);
}
.en{
	font-size: var(--font-size-body-xs);
	font-weight: 400;
	color: var(--color-primary-70);
	letter-spacing: 2rpx;
}
.line{
	width: 300rpx;
	height: 18rpx;
}
.title{
	margin: 24rpx 18rpx 24rpx;
}
.title-first{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	.text{
		font-size: var(--font-size-display-xl);
		font-weight: 400;
		background: linear-gradient(180deg, var(--color-primary) 20%, var(--color-primary-deep) 79.81%);
		/* 文字渐变：背景裁剪到文字区域 + 文字透明，露出渐变 */
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.cloud{
		width: 122rpx;
		height: 40rpx;
	}
}
.info-row{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	/* info-left 与 collect 之间至少 10rpx */
	gap: var(--spacing-xs);
}
.info-left{
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
}
.txt{
	flex: 1;
	min-width: 0;
}
.price{
	margin-top: 12rpx;
	font-size: var(--font-size-body-lg);
	color: var(--color-primary-70);
	display: flex;
	flex-direction: row;
  line-height: 38rpx;
}
.icon{
	width: 38rpx;
	height: 38rpx;
	margin-right: 12rpx;
}
.count{
	color: var(--color-primary-70);
}
.package{
	margin-top: 12rpx;
	font-size: var(--font-size-body-lg);
	color: var(--color-primary-70);
	display: flex;
	flex-direction: row;
  line-height: 38rpx;
}
.collect {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.heart{
	width: 48rpx;
	height: 40rpx;
}
.like-num {
	font-size: var(--font-size-body-xs);
	color: var(--color-primary-70);
	margin-top: 4rpx;
}
.photo-wrap {
	padding: 0 8rpx;
}
.photo {
	width: 100%;
	margin-bottom: 8rpx;
	display: block;
}
/* 按钮组行：items-end 底部对齐、水平居中；按钮为金色药丸、深色描边、px40/py26、gap12 */
.ai-tryon-btn {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	justify-content: center;
	.btn-icon{
		width: 104rpx;
		height: 86rpx;
	}
	.btn{
		/* 通用金色按钮规范已收敛至全局 .btn-primary */
		.text{
			width: 118rpx;
			height: 34rpx;
		}
	}
}

/* 底部占位：固定栏高度（按钮组+版权footer，爸爸确认 200rpx） */
.ai-tryon-spacer {
	height: 200rpx;
}
</style>
