		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	.demoPhotoContaner{
		margin: 40rpx 0;
		padding: 0 8rpx;
		width: 100%;
		display: flex;
		flex-direction: row;
	}
	.demoPhoto{
		width: 364rpx;
		height: 226rpx;
		margin-right: 8rpx;
		border-radius: 8rpx;
	}
	.demoPhoto:last-child{
		margin-right: 0;
	}
