<template>
	<view class="container">
		<CustomNavBar title="蓝梅旗袍·汉服·民..." />
		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-title sk-animate" style="margin-top: 40rpx;"></view>
			<view class="sk-subtitle sk-animate"></view>
			<view class="sk-row">
				<view class="sk-photo-card sk-animate"></view>
				<view class="sk-photo-card sk-animate"></view>
			</view>
		</view>

		<view v-else>
			<view class="divideTit">PRICE LIST</view>
			<view class="demoPhotoTit font-noto-serif">价目表</view>
			<PhotoGrid :shop-list="shopList" @shop-click="onShopClick" @demo-click="onDemoClick" />
			<!-- 服务保障 + 联系我们（已抽为 ServiceContact 组件，样式随组件迁移） -->
			<ServiceContact />
			<view class="beian"><AppFooter /></view>
		</view>
		<!-- 自定义底部 tabbar 占位（116rpx + 安全区） -->
		<view class="tabbar-safe-spacer"></view>
	</view>
</template>

<script>
	import { getShops } from '../../utils/api.uts'
	import { syncTabBarSelected } from '../../utils/tabbar.uts'
	import { cosThumb } from '../../utils/imageLoader.uts'
	export default {
		data() {
			return {
				loading: true,
				shopList: []
			}
		},
		async onLoad() {
			try {
				const res = await getShops()
				if (res.code === 200 && res.data) {
					// 网格封面图出 600px WebP 缩略图，降低内存占用
					this.shopList = res.data.map(item => {
						item.homeImage = cosThumb(item.homeImage, 600)
						return item
					})
				}
			} catch (err) {
				console.warn('加载店铺列表失败', err)
			} finally {
				this.loading = false
			}
		},
		onShow() {
			// 同步自定义底部 tabbar 选中态（本页下标 1）
			syncTabBarSelected(1)
		},
		methods: {
			onShopClick(shop) {
				uni.navigateTo({
					url: `/pages/priceList/index?from=banner&idx=${shop.id}&shopName=${shop.shopName}&priceImage=${shop.priceImage}`
				})
			},
			onDemoClick(idx) {
				uni.navigateTo({
					url: `/pages/priceList/index?from=banner&idx=${idx}`
				})
			}
		}
	}
</script>

<style>
	.container{
		background: #160F04;
		height: 100%;
		overflow: scroll;
	}
	/* 价目表标题「PRICE LIST / 价目表」仍在使用这两个类，勿删；服务保障/联系我们样式已随 ServiceContact 组件迁移 */
	.divideTit {
		text-align: center;
		font-size: 20rpx;
		color: rgba(241, 205, 145, 0.3);
	}
	.demoPhotoTit{
		margin-top: 16rpx;
		font-size: 36rpx;
		color: #F1CD91;
		text-align: center;
	}
	/* demoPhotoContaner / demoPhoto / shopCard / shopName 等样式已收敛至 PhotoGrid 组件 */
	.beian{
		margin: 40rpx auto 32rpx;
		font-size: 18rpx;
		color: rgba(241, 205, 145, 0.5);
		font-weight: 400;
		text-align: center;
	}
	/* 骨架屏已移至全局样式 */
</style>
