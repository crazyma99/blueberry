<template>
	<view class="container">
		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-title sk-animate" style="margin-top: 40rpx;"></view>
			<view class="sk-subtitle sk-animate"></view>
			<view class="sk-row">
				<view class="sk-photo-card sk-animate"></view>
				<view class="sk-photo-card sk-animate"></view>
			</view>
		</view>

		<view v-else>
			<view class="divideTit">PRICE LIST</view>
			<view class="demoPhotoTit">价目表</view>
			<PhotoGrid :shop-list="shopList" @shop-click="onShopClick" @demo-click="onDemoClick" />
			<view class="divideTit">SERVICE INFORMATION</view>
			<view class="demoPhotoTit">服务说明</view>
			<image class="service" src="/static/service.png"></image>
			<view class="divideTit">CONTACT US</view>
			<view class="demoPhotoTit">联系我们</view>
			<image
				class="code"
				src="https://www.lanmei66.cloud/admin/admin20250928234704_495_147.png"
				mode="aspectFit"
				show-menu-by-longpress="{{true}}"
			></image>
			<view class="contact">联系电话 & 商务合作</view>
			<view class="contact">18068842642（微信同号）</view>
			<view class="beian"><AppFooter /></view>
		</view>
	</view>
</template>

<script>
	import { getShops } from '../../utils/api.uts'
	export default {
		data() {
			return {
				loading: true,
				shopList: []
			}
		},
		async onLoad() {
			try {
				const res = await getShops()
				if (res.code === 200 && res.data) {
					this.shopList = res.data
				}
			} catch (err) {
				console.warn('加载店铺列表失败', err)
			} finally {
				this.loading = false
			}
		},
		methods: {
			onShopClick(shop) {
				uni.navigateTo({
					url: `/pages/priceList/index?from=banner&idx=${shop.id}&shopName=${shop.shopName}&priceImage=${shop.priceImage}`
				})
			},
			onDemoClick(idx) {
				uni.navigateTo({
					url: `/pages/priceList/index?from=banner&idx=${idx}`
				})
			}
		}
	}
</script>

<style>
	.container{
		background: #000;
		height: 100%;
		overflow: scroll;
	}
	.divideTit {
		text-align: center;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.3);
	}
	.demoPhotoTit{
		margin-top: 16rpx;
		font-size: 36rpx;
		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	/* demoPhotoContaner / demoPhoto / shopCard / shopName 等样式已收敛至 PhotoGrid 组件 */
	.service{
		margin: 40rpx 8rpx 40rpx;
		width: 736rpx;
		height: 910rpx;
	}
	.code{
		margin: 40rpx auto;
		width: 200rpx;
		height: 200rpx;
	}
	.contact{
		font-size: 24rpx;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	.beian{
		margin: 64rpx auto 32rpx;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.5);
		text-align: center;
	}
	/* 骨架屏已移至全局样式 */
</style>
