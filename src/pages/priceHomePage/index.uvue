		margin: 40rpx 8rpx 40rpx;
		width: 736rpx;
		height: 910rpx;
	}
	.code{
		margin: 40rpx auto;
		width: 200rpx;
		height: 200rpx;
	}
	.contact{
		font-size: 24rpx;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.9);
		text-align: center;
	}
	.beian{
		margin: 64rpx auto 32rpx;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.5);
		text-align: center;
	}
	/* 骨架屏 */
	.skeleton {
		padding: 24rpx 8rpx;
	}
	.skeleton-title {
		width: 200rpx;
		height: 24rpx;
		border-radius: 4rpx;
		background: rgba(255, 255, 255, 0.08);
		margin: 40rpx auto 16rpx;
	}
	.skeleton-subtitle {
		width: 140rpx;
		height: 36rpx;
		border-radius: 4rpx;
		background: rgba(255, 255, 255, 0.08);
		margin: 0 auto 40rpx;
	}
	.skeleton-photo-row {
		display: flex;
		flex-direction: row;
	}
	.skeleton-photo {
		width: 364rpx;
		height: 226rpx;
		border-radius: 8rpx;
		background: rgba(255, 255, 255, 0.08);
		margin-right: 8rpx;
	}
	.skeleton-photo:last-child {
		margin-right: 0;
	}
	@keyframes skeletonPulse {
		0% { opacity: 0.4; }
		50% { opacity: 0.8; }
		100% { opacity: 0.4; }
	}
	.skeleton-animate {
		animation: skeletonPulse 1.5s ease-in-out infinite;
	}
