<template>
	<view class="container">
		<!-- 自定义导航栏：搜索栏在标题栏位置 -->
		<view class="custom-nav">
			<view :style="{height: statusBarHeight + 'px'}"></view>
			<view class="nav-content">
				<image class="back-btn" src="/static/back-arrow.svg" mode="aspectFit" @click="goBack"></image>
				<view class="search-bar-wrap">
					<view class="search-bar-nav">
						<image class="search-icon-small" src="/static/search.png" mode="aspectFit"></image>
						<input
							class="search-input-nav"
							type="text"
							placeholder="搜索收藏内容"
							placeholder-style="color: var(--color-primary-70)"
							v-model="searchKeyword"
							confirm-type="search"
							@confirm="handleSearch"
						/>
					</view>
				</view>
			</view>
		</view>
		<!-- 占位 -->
		<view :style="{height: (statusBarHeight + 44) + 'px'}"></view>

		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container main-content">
			<view class="sk-row" style="flex-wrap: wrap;">
				<view v-for="i in 4" :key="i" class="sk-photo-item sk-animate"></view>
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else class="content main-content">
			<!-- 空状态 -->
			<view v-if="isEmpty" class="empty-state">
				<view class="empty-title">暂无内容</view>
				<view class="empty-desc">{{ searchKeyword ? '换个搜索关键词试试吧' : '还没有收藏任何内容哦' }}</view>
			</view>

			<!-- 收藏列表 -->
			<view v-else class="photolistContainer">
				<view
					v-for="(item, index) in favoriteList"
					:key="index"
					class="photoItem-wrap"
					hover-class="press-dim"
					@click="handleItemClick(item)"
				>
					<view class="photoItem">
						<image :src="item.coverImageUrl" class="photo fade-in" mode="aspectFill" />
						<view class="mask">
							<view class="desc">
								<view class="photoName font-noto-serif">{{ item.title }}</view>
								<view class="desc-row">
									<view class="collect">
										<image class="heart" mode="aspectFit" src="/static/liked.svg"></image>
										<text class="stat-count">{{ formatCount(item.likeCount) }}</text>
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<!-- 加载更多（仅搜索模式下启用分页，非搜索模式接口一次性返回全部，无需分页 UI） -->
			<view v-if="isSearching && !isEmpty && !noMore" class="load-more" hover-class="press-dim"
					@click="loadMore">
				<text class="load-more-text">{{ loadingMore ? '加载中...' : '加载更多' }}</text>
			</view>
			<view v-if="isSearching && noMore && favoriteList.length > 0" class="load-more">
				<text class="load-more-text">已经到底了</text>
			</view>
		</view>

		<!-- 页脚 Copyright -->
		<view class="page-footer">
			<view class="divide"></view>
			<view class="copyright"><AppFooter /></view>
		</view>
	</view>
</template>

<script lang="uts">
import { getFavoriteList, searchAlbums } from '../../utils/api.uts'
import { formatCount as _formatCount } from '../../utils/format.uts'

export default {
	data() {
		return {
			statusBarHeight: 20,
			loading: true,
			loadingMore: false,
			searchKeyword: '',
			favoriteList: [] as any[],
			isEmpty: false,
			page: 1,
			pageSize: 10,
			noMore: false,
			isSearching: false,
			// 首次显示由 onLoad 触发 loadData，onShow 跳过一次，
			// 之后从详情页返回时由 onShow 负责刷新列表，保证收藏状态最新
			firstShow: true
		}
	},

	onLoad() {
		const systemInfo = uni.getSystemInfoSync()
		this.statusBarHeight = systemInfo.statusBarHeight || 20
		this.loadData()
	},

	onShow() {
		// 首次进入：onLoad 已触发 loadData，跳过避免重复请求
		if (this.firstShow) {
			this.firstShow = false
			return
		}
		// 从客片详情页返回：刷新当前视图（搜索态重搜，非搜索态重拉收藏列表）
		if (this.isSearching && this.searchKeyword.trim() !== '') {
			this.handleSearch()
		} else {
			this.loadData()
		}
	},

	methods: {
		goBack() {
			if (this.searchKeyword.trim()) {
				// 搜索框有值：清空搜索并重新加载收藏列表
				this.searchKeyword = ''
				this.loadData()
			} else {
				uni.navigateBack()
			}
		},

		async loadData() {
			try {
				this.loading = true
				this.page = 1
				this.isSearching = false
				// 收藏列表接口一次性返回全部数据，不分页，进入即视为已到底
				this.noMore = true

				const res = await getFavoriteList()
				if (res.code === 200 && res.data) {
					this.favoriteList = res.data
					this.isEmpty = this.favoriteList.length === 0
				} else {
					this.favoriteList = []
					this.isEmpty = true
				}
			} catch (err) {
				console.error('加载收藏列表失败:', err)
				uni.showToast({ title: '加载失败', icon: 'none' })
				this.isEmpty = true
			} finally {
				this.loading = false
			}
		},

		async handleSearch() {
			const keyword = this.searchKeyword.trim()
			if (!keyword) {
				await this.loadData()
				return
			}

			try {
				this.loading = true
				this.page = 1
				this.noMore = false
				this.isSearching = true

				const res = await searchAlbums(keyword, 1, this.pageSize)
				if (res.code === 200 && res.data) {
					const dataList = this.getSearchItems(res.data)
					const total = this.getSearchTotal(res.data, dataList.length)
					const totalPages = Math.ceil(total / this.pageSize)
					this.favoriteList = dataList
					this.isEmpty = this.favoriteList.length === 0
					if (1 >= totalPages || dataList.length < this.pageSize) {
						this.noMore = true
					}
				} else {
					this.favoriteList = []
					this.isEmpty = true
				}
			} catch (err) {
				console.error('搜索失败:', err)
				uni.showToast({ title: '搜索失败', icon: 'none' })
				this.isEmpty = true
			} finally {
				this.loading = false
			}
		},

		async loadMore() {
			if (this.noMore || this.loadingMore) return
			if (!this.isSearching) return

			try {
				this.loadingMore = true
				const nextPage = this.page + 1
				const res = await searchAlbums(this.searchKeyword.trim(), nextPage, this.pageSize)
				if (res.code === 200 && res.data) {
					const dataList = this.getSearchItems(res.data)
					const total = this.getSearchTotal(res.data, this.favoriteList.length + dataList.length)
					const totalPages = Math.ceil(total / this.pageSize)
					this.favoriteList = this.favoriteList.concat(dataList)
					this.page = nextPage
					if (nextPage >= totalPages || dataList.length < this.pageSize) {
						this.noMore = true
					}
				} else {
					this.noMore = true
				}
			} catch (err) {
				console.error('加载更多失败:', err)
			} finally {
				this.loadingMore = false
			}
		},

		getSearchItems(data: any): any[] {
			if (Array.isArray(data)) return data
			if (data != null && Array.isArray(data.list)) return data.list
			return []
		},

		getSearchTotal(data: any, fallback: number): number {
			if (data != null && data.total != null) return Number(data.total)
			return fallback
		},

		handleItemClick(item: any) {
			// 与客片列表页保持一致：必须携带 type(shopId) 与 liked，否则详情接口会 400
			const shopId = item.shopId != null ? item.shopId : ''
			const liked = item.liked != null ? item.liked : true
			uni.navigateTo({
				url: `/pages/targetPhotoDetail/index?idx=${item.id}&liked=${liked}&type=${shopId}`
			})
		},

		formatCount(count: number): string {
			return _formatCount(count)
		}
	}
}
</script>

<style>
.container {
	background: var(--color-bg);
	min-height: 100vh;
	color: #fff;
	display: flex;
	flex-direction: column;
}
.main-content {
	flex: 1;
}
.page-footer {
	margin-top: auto;
}
.divide {
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}

/* 自定义导航栏 */
.custom-nav {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	background: var(--color-bg);
	z-index: 100;
}
.nav-content {
	height: 44px;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 0 16rpx;
}
.back-btn {
	width: 44rpx;
	height: 44rpx;
	padding: var(--spacing-xs);
}
.search-bar-wrap {
	width: 65%;
	margin-left: 12rpx;
	box-sizing: border-box;
	/* 纯色描边（标准 border） */
	border: 1rpx solid var(--color-primary-30);
	border-radius: var(--radius-lg);
}
.search-bar-nav {
	display: flex;
	flex-direction: row;
	align-items: center;
	/* 内层填充 = 半透明金渐变 + 页面底色 var(--color-bg) 合成 */
	background: linear-gradient(99.85deg, rgba(241, 205, 145, 0.12) 0%, rgba(241, 205, 145, 0) 100%), var(--color-bg);
	/* 内圈圆角 = 外圈 32rpx − 1rpx 描边，圆角处贴合 */
	border-radius: 31rpx;
	padding: 0 var(--spacing-sm);
	height: 64rpx;
}
.search-icon-small {
	width: 38rpx;
	height: 38rpx;
}
.search-input-nav {
	flex: 1;
	font-size: var(--font-size-body-lg);
	color: var(--color-primary);
	margin-left: 12rpx;
}

.content {
	padding: 0 0 var(--spacing-lg);
}

/* 空状态 */
.empty-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 200rpx var(--spacing-lg);
}
.empty-title {
	font-size: 32rpx;
	color: rgba(255, 255, 255, 0.5);
	margin-bottom: 16rpx;
}
.empty-desc {
	font-size: var(--font-size-body);
	color: rgba(255, 255, 255, 0.3);
}

/* 客片卡片（与客片列表页保持一致）*/
.photolistContainer {
	/* 与相册 list 页一致：左右 24rpx 内边距 + 16rpx 卡片间距 */
	padding: 24rpx 24rpx 0;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 16rpx;
}
.photoItem-wrap {
	width: calc((100% - 16rpx) / 2);
	/* border-box：避免 content-box 下 1rpx border 使每行实际占宽多出 4rpx 导致第二列溢出换行 */
	box-sizing: border-box;
	/* 纯色描边（标准 border） */
	border: 1rpx solid var(--color-primary-30);
	border-radius: var(--radius-card);
}
.photoItem {
	width: 100%;
	height: 460rpx;
	position: relative;
	/* 内圈圆角 = 外圈 var(--radius-card) 14rpx − 1rpx 描边，两段圆弧同心，边框四角才贴合图片 */
	border-radius: 13rpx;
	overflow: hidden;
}
.photo {
	width: 100%;
	height: 100%;
}
.mask {
	position: absolute;
	width: 100%;
	height: 100%;
	top: 0;
	left: 0;
	background: linear-gradient(180deg, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.45) 75%, rgba(0, 0, 0, 0.85) 100%);
}
.desc {
	position: absolute;
	left: 20rpx;
	right: 20rpx;
	bottom: 20rpx;
	display: flex;
	flex-direction: column;
}
.desc-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}
.photoName {
	/* 与相册 list 页一致：26rpx */
	font-size: var(--font-size-body-lg);
	font-weight: 400;
	color: var(--color-primary);
}
.collect {
	display: flex;
	flex-direction: row;
	align-items: center;
	font-size: var(--font-size-body);
	color: var(--color-primary);
}
.heart {
	width: 48rpx;
	height: 40rpx;
	position: relative;
}
.stat-count {
	margin-left: 4rpx;
}

/* 加载更多 */
.load-more {
	padding: var(--spacing-lg);
	text-align: center;
}
.load-more-text {
	font-size: var(--font-size-body);
	color: rgba(241, 205, 145, 0.4);
}

/* Copyright */
.copyright {
	margin: var(--spacing-lg) auto;
	font-size: var(--font-size-caption-md);
	color: var(--color-primary-50);
	font-weight: 400;
	text-align: center;
}
</style>
