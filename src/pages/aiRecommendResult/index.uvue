	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.8);
	padding: 8rpx 24rpx;
	border-radius: 24rpx;
	background: rgba(255, 255, 255, 0.1);
	margin-right: 16rpx;
	margin-bottom: 12rpx;
}

