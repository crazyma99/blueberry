<template>
	<view class="page">
		<CustomNavBar title="AI推荐结果" />
		<!-- AI 分析结果卡片 -->
		<view class="analysis-card" v-if="analysis">
			<text class="card-title">AI 分析结果</text>
			<view class="analysis-grid">
				<view class="analysis-item">
					<text class="analysis-label">性别</text>
					<text class="analysis-value">{{ analysis.gender }}</text>
				</view>
				<view class="analysis-item">
					<text class="analysis-label">人群</text>
					<text class="analysis-value">{{ analysis.estimatedAge }}</text>
				</view>
				<view class="analysis-item">
					<text class="analysis-label">脸型</text>
					<text class="analysis-value">{{ analysis.faceShape }}</text>
				</view>
				<view class="analysis-item">
					<text class="analysis-label">体型</text>
					<text class="analysis-value">{{ analysis.bodyType }}</text>
				</view>
			</view>
			<view class="keywords-row" v-if="analysis.styleKeywords.length > 0">
				<text class="keyword-tag" v-for="(kw, idx) in analysis.styleKeywords" :key="idx">{{ kw }}</text>
			</view>
		</view>

		<!-- 推荐风格列表 -->
		<view class="recommend-section">
			<text class="section-title">推荐服饰风格</text>
			<view
				v-for="(rec, idx) in recommendations"
				:key="idx"
				class="rec-card"
			>
				<!-- 预览图：点击跳转 AI 试衣（主人指示时序：先骨架图、图加载完成后完全渲染；统一走缩略图） -->
				<view class="rec-preview-wrap">
					<view v-if="rec.previewUrl && !rec.previewLoaded" class="rec-preview-skeleton"></view>
					<image
						v-if="rec.previewUrl"
						class="rec-preview"
						:src="previewThumb(rec.previewUrl)"
						mode="aspectFill"
						@load="onPreviewLoad(idx)"
					></image>
					<view v-else class="rec-preview rec-preview-placeholder">
						<text class="placeholder-text">暂无预览</text>
					</view>
				</view>
				<!-- 信息 -->
				<view class="rec-info">
					<view class="rec-header">
						<text class="rec-name">{{ rec.styleName }}</text>
						<text class="rec-score" v-if="rec.finalScore > 0">{{ rec.finalScore }}分</text>
					</view>
					<text class="rec-reason">{{ rec.reason }}</text>
					<view class="rec-footer">
						<text class="rec-action" @click="onViewTemplateClick(rec)">查看模板</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 底部占位 -->
		<view class="bottom-spacer"></view>

		<!-- 底部 Copyright -->
		<view class="page-footer">
			<view class="divide"></view>
			<view class="bottomdesc"><AppFooter /></view>
		</view>
	</view>
</template>

<script lang="uts">
import AppFooter from '../../components/AppFooter/AppFooter.uvue'
import { cosThumb } from '../../utils/imageLoader.uts'

export default {
	components: { AppFooter },
	data() {
		return {
			analysis: null as any,
			recommendations: [] as any[],
			gender: '',
			shopId: ''
		}
	},
	onLoad(options : any) {
		this.shopId = options?.shopId ?? ''
		const raw = options?.data ?? ''
		if (raw !== '') {
			try {
				const parsed = JSON.parse(decodeURIComponent(raw))
				this.analysis = parsed.analysis
				const recs: any[] = parsed.recommendations ?? []
			// 先落列表再打骨架标记（CR 🟡：脏数据异常不应导致整列丢失）
			this.recommendations = recs
			for (let i = 0; i < recs.length; i++) {
				if (recs[i] != null) {
					recs[i].previewLoaded = false
				}
			}
				// 记录用户性别用于后续模板筛选
				const g = (this.analysis?.gender ?? '').toLowerCase()
				if (g === '男' || g === 'male') {
					this.gender = 'male'
				} else if (g === '女' || g === 'female') {
					this.gender = 'female'
				}
			} catch (e) {
				console.error('[aiRecommendResult] 解析推荐结果失败:', e)
				uni.showToast({ title: '结果解析失败，请重试', icon: 'none' })
			}
		}
	},
	methods: {
		// 列表预览图统一走 COS 万象缩略图（400px）：原图直出会拖慢整屏卡片渲染
		previewThumb(url: string): string {
			return cosThumb(url, 400)
		},

		// 单卡预览图加载完成 → 收掉骨架图
		onPreviewLoad(idx: number) {
			const list = this.recommendations
			if (idx >= 0 && idx < list.length) {
				list[idx].previewLoaded = true
			}
		},
		// 点击「查看模板」：有 albumId 跳客片详情页，否则 toast 提示
		onViewTemplateClick(rec : any) {
			const albumId = rec.albumId ?? 0
			if (albumId > 0) {
				// 详情接口要求携带 type=shopId，style 供「我也要拍」带回试衣页
				const style = encodeURIComponent(rec.styleName ?? '')
				uni.navigateTo({
					url: `/pages/targetPhotoDetail/index?idx=${albumId}&type=${this.shopId}&liked=false&style=${style}`
				})
			} else {
				uni.showToast({ title: '查询不到对应样片稍后再试', icon: 'none' })
			}
		},

		// 点击封面图：跳转 AI 试衣模板列表（shopId 供试衣提交与支付使用）
		onPreviewClick(rec : any) {
			const style = encodeURIComponent(rec.styleName ?? '')
			uni.navigateTo({
				url: `/pages/aiTryOn/index?style=${style}&gender=${this.gender}&shopId=${this.shopId}`
			})
		}
	}
}
</script>

<style>
.page {
	background: var(--color-bg);
	min-height: 100vh;
	display: flex;
	flex-direction: column;
}

/* 分析卡片 */
.analysis-card {
	margin: 24rpx var(--spacing-lg);
	padding: var(--spacing-lg);
	border-radius: var(--radius-sm);
	background: rgba(255, 255, 255, 0.05);
}
.card-title {
	font-size: 32rpx;
	font-family: var(--font-display);
	color: #fff;
	font-weight: 400;
	margin-bottom: 24rpx;
}
.analysis-grid {
	display: flex;
	flex-wrap: wrap;
}
.analysis-item {
	width: 50%;
	margin-bottom: var(--spacing-sm);
}
.analysis-label {
	font-size: var(--font-size-body);
	color: rgba(255, 255, 255, 0.4);
	margin-bottom: 8rpx;
}
.analysis-value {
	font-size: var(--font-size-body-plus);
	color: rgba(255, 255, 255, 0.9);
}
.keywords-row {
	display: flex;
	flex-wrap: wrap;
	margin-top: 8rpx;
	flex-direction: row;
}
.keyword-tag {
	font-size: var(--font-size-body);
	color: rgba(255, 255, 255, 0.8);
	padding: 8rpx 24rpx;
	border-radius: var(--radius-container);
	background: rgba(255, 255, 255, 0.1);
	margin-right: 16rpx;
	margin-bottom: 12rpx;
}

/* 推荐列表 */
.recommend-section {
	padding: 0 var(--spacing-lg);
}
.section-title {
	font-size: 32rpx;
	font-family: var(--font-display);
	color: #fff;
	font-weight: 400;
	margin-bottom: 24rpx;
}
.rec-card {
	display: flex;
	flex-direction: row;
	align-items: stretch;
	margin-bottom: 24rpx;
	border-radius: var(--radius-sm);
	padding: var(--spacing-sm) 24rpx;
	overflow: hidden;
	background: rgba(255, 255, 255, 0.05);
	gap: 16rpx;
}
.rank-text {
	font-size: var(--font-size-body);
	color: rgba(255, 255, 255, 0.8);
	font-weight: 400;
}
/* 预览图容器：固定 280rpx 方图，骨架图绝对覆盖（图加载完成后收掉） */
.rec-preview-wrap {
	position: relative;
	width: 280rpx;
	height: 280rpx;
	flex: none;
	border-radius: var(--radius-xs);
	overflow: hidden;
}
.rec-preview-skeleton {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background: linear-gradient(135deg, var(--color-primary-10) 0%, var(--color-primary-06) 100%);
	animation: skPulse 1.4s ease-in-out infinite;
}
@keyframes skPulse {
	0% { opacity: 0.5; }
	50% { opacity: 1; }
	100% { opacity: 0.5; }
}
.rec-preview {
	width: 100%;
	height: 100%;
}
.rec-preview-placeholder {
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(255, 255, 255, 0.03);
}
.placeholder-text {
	font-size: var(--font-size-body-sm);
	color: rgba(255, 255, 255, 0.3);
}
.rec-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}
.rec-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.rec-name {
	font-size: 30rpx;
	color: #fff;
	font-weight: 400;
}
.rec-score {
	font-size: var(--font-size-body-lg);
	color: #f3d9ac;
	font-weight: 400;
}
.rec-reason {
	font-size: var(--font-size-body);
	color: rgba(255, 255, 255, 0.5);
	line-height: 36rpx;
	margin-top: 8rpx;
}
.rec-footer {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 12rpx;
}
.rec-action {
	font-size: var(--font-size-body);
	color: rgba(123, 172, 227, 0.9);
}

/* 底部 */
.bottom-spacer {
	height: 120rpx;
}
.page-footer {
	margin-top: auto;
}
.divide {
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}
.bottomdesc {
	margin: var(--spacing-lg) auto;
	font-size: var(--font-size-caption-md);
	color: var(--color-primary-50);
	font-weight: 400;
}
</style>
