	align-items: stretch;
	margin-bottom: 24rpx;
	border-radius: 16rpx;
	padding: 20rpx 24rpx;
	overflow: hidden;
	background: rgba(255, 255, 255, 0.05);
	gap: 16rpx;
}
.rank-text {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.8);
	font-weight: 600;
}
.rec-preview {
	width: 280rpx;
	height: 280rpx;
}
.rec-preview-placeholder {
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(255, 255, 255, 0.03);
}
.placeholder-text {
