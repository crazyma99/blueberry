<template>
  <view class="container">
    <!-- Loading 骨架屏 -->
    <view v-if="loading" class="sk-container" style="padding-top: 64rpx;">
      <view class="sk-row" style="margin-bottom: 40rpx;">
        <view class="sk-avatar sk-animate"></view>
        <view class="sk-text sk-animate" style="width: 200rpx; margin-left: 24rpx;"></view>
      </view>
      <view class="sk-menu sk-animate"></view>
      <view class="sk-banner sk-animate" style="border-radius: 16rpx;"></view>
    </view>

    <!-- 主内容 -->
    <view v-else class="content">
      <!-- 用户区域 -->
      <view class="user-section" @click="handleUserClick">
        <!-- 头像容器：始终展示 .avatar 灰色色值 DOM；image 仅在有可用头像 url 时渲染 -->
        <!-- 加载失败时 image 透明，仍露出 .avatar 灰色背景，避免任何兜底图 -->
        <view class="avatar">
          <image
            v-if="displayAvatar !== ''"
            class="avatar-img"
            :src="displayAvatar"
            mode="aspectFill"
          ></image>
        </view>
        <view class="user-info">
          <view class="nickname">
            {{ displayNickname }}
          </view>
        </view>
      </view>

      <!-- 金刚区 -->
      <view class="menu-section">
        <view
          v-for="(item, index) in menuItems"
          :key="index"
          class="menu-item"
          @click="handleMenuClick(item)"
        >
          <image class="menu-icon" :src="item.imageUrl" mode="aspectFill"></image>
          <view class="menu-text">{{ item.title }}</view>
        </view>
      </view>

      <!-- 轮播图 Banner -->
      <view class="banner-section">
        <swiper
          class="banner-swiper"
          autoplay
          circular
          :interval="5000"
          :duration="500"
          indicator-dots
          indicator-color="rgba(255, 255, 255, 0.35)"
          indicator-active-color="#fff"
        >
          <swiper-item v-for="(banner, index) in banners" :key="index">
            <image
              class="banner-image"
              :src="banner.imageUrl"
              mode="aspectFill"
              @click="handleBannerClick(banner)"
            ></image>
          </swiper-item>
        </swiper>
      </view>

      <view v-if="isLoggedIn" class="logout-section">
        <button class="logout-button" @click.stop="confirmLogout">退出登录</button>
      </view>
    </view>

    <!-- 登录弹窗 -->
    <view v-if="showLoginPopup" class="login-overlay" @click="closeLoginPopup">
      <view class="login-popup login-auth-popup" @click.stop>
        <view class="login-popup-title">微信授权登陆</view>
        <view class="login-agreement-row">
          <view
            :class="loginAgreementChecked ? 'login-agreement-check is-checked' : 'login-agreement-check'"
            @click.stop="toggleLoginAgreement"
          >
            <view v-if="loginAgreementChecked" class="login-agreement-dot"></view>
          </view>
          <text class="login-agreement-text"><text>登录即代表同意 </text><text class="login-agreement-link" @click.stop="openUserAgreement">{{ userAgreementName }}</text><text>、</text><text class="login-agreement-link" @click.stop="openPrivacyPolicy">{{ privacyPolicyName }}</text></text>
        </view>
        <button
          v-if="loginAgreementChecked"
          class="login-phone-btn"
          open-type="getPhoneNumber"
          @getphonenumber="onGetPhoneNumber"
        >一键登录</button>
        <button
          v-else
          class="login-phone-btn"
          @click="showLoginAgreementToast"
        >一键登录</button>
        <view class="login-cancel login-cancel-btn" @click="closeLoginPopup">暂不登陆</view>
      </view>
    </view>

    <!-- 头像昵称授权弹窗 -->
    <view v-if="showProfilePopup" class="login-overlay" @click="skipProfile">
      <view class="login-popup" @click.stop>
        <view class="login-popup-title">完善个人资料</view>
        <view class="login-popup-desc">设置头像和昵称以获得完整体验</view>
        <button
          class="profile-avatar-btn"
          open-type="chooseAvatar"
          @chooseavatar="onChooseAvatar"
        >
          <image
            class="profile-avatar-img"
            :src="profileAvatarUrl || defaultAvatar"
            mode="aspectFill"
          ></image>
          <text class="profile-avatar-tip">点击选择头像</text>
        </button>
        <view class="profile-nickname-row">
          <text class="profile-nickname-label">昵称</text>
          <input
            class="profile-nickname-input"
            type="nickname"
            placeholder="请输入昵称"
            v-model="profileNickname"
          />
        </view>
        <button class="login-phone-btn" @click="submitProfile">确认</button>
        <view class="login-cancel" @click="skipProfile">跳过</view>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { isLoggedIn, getUserInfo, loginSuccess, logout, setUserInfo, mergeUserInfo, UserInfo } from '../../utils/auth.uts'
import { wxLogin, wxBindPhone, wxGetUserInfo, wxUpdateUserInfo, getPageConfig } from '../../utils/api.uts'
import {
  USER_AGREEMENT_NAME,
  PRIVACY_POLICY_NAME,
  openUserAgreement,
  openPrivacyPolicy
} from '../../utils/legal.uts'

export default {
  data() {
    return {
      loading: true,
      // 拆成扁平基本类型字段，避免 uvue 对 userInfo.avatarUrl 这种嵌套路径依赖追踪不可靠
      // 导致登录/更新后 computed 不重算、image 不刷新的问题
      userAvatarUrl: '',
      userNickname: '',
      isLoggedIn: false,
      banners: [] as any[],
      menuItems: [] as any[],
      // 仅供 profile 弹窗里 chooseAvatar 占位使用，user-section 不再用兜底图
      defaultAvatar: '/static/mine.svg',
      showLoginPopup: false,
      loginAgreementChecked: false,
      userAgreementName: USER_AGREEMENT_NAME,
      privacyPolicyName: PRIVACY_POLICY_NAME,
      // 头像昵称授权弹窗
      showProfilePopup: false,
      profileAvatarUrl: '',
      profileNickname: ''
    }
  },

  computed: {
    // 显示用头像 URL：仅依赖两个基本类型字段，响应式追踪可靠
    // - 未登录 / 无头像 url → ''（image 不渲染，露出 .avatar 灰色 DOM）
    displayAvatar(): string {
      if (!this.isLoggedIn) return ''
      return this.userAvatarUrl
    },
    // 显示用昵称：同样只依赖基本类型字段
    displayNickname(): string {
      if (!this.isLoggedIn) return '点击立即登陆'
      if (this.userNickname === '') return '点击获取用户信息'
      return this.userNickname
    }
  },

  async onLoad() {
    await this.loadData()
  },

  async onShow() {
    // 页面显示时刷新登录状态（仅更新UI，不触发登录流程）
    this.updateLoginState()
    // 兑底：已登录但本地缺头像 → 拉取一次后端最新用户信息，
    // 修复其他页面登录时被覆盖掉头像的历史数据
    if (this.isLoggedIn && this.userAvatarUrl === '') {
      try {
        const res = await wxGetUserInfo()
        if (res.code === 200 && res.data) {
          mergeUserInfo(res.data)
          this.updateLoginState()
        }
      } catch (err) {
        console.warn('[mine.onShow] 拉取最新用户信息失败:', err)
      }
    }
  },

  methods: {
    // 加载页面数据
    async loadData() {
      try {
        this.loading = true

        // 更新登录状态
        this.updateLoginState()

        // 获取中台页配置（金刚区 + Banner）
        const configRes = await getPageConfig()
        if (configRes.code === 200 && configRes.data) {
          const configMenus = configRes.data.filter(item => item.type === 'icon_grid')[0].items || []
          this.menuItems = [...this.getDefaultMenuItems(), ...configMenus]
          this.banners = configRes.data.filter(item => item.type === 'banner')[0].items || []
        }
        // 金刚区为空时，设置默认入口
        if (this.menuItems.length === 0) {
          this.menuItems = this.getDefaultMenuItems()
        }
      } catch (err) {
        console.error('加载数据失败:', err)
        // 拉取失败，使用默认金刚区
        this.menuItems = this.getDefaultMenuItems()
      } finally {
        this.loading = false
      }
    },

    // 默认金刚区入口
    getDefaultMenuItems() {
      return [
        { title: '我的喜欢', imageUrl: '/static/liked.svg', linkUrl: '/pages/favorites/index', needLogin: true }
      ]
    },

    // 更新登录状态 → 同步到两个扁平字段，触发响应式重渲染
    updateLoginState() {
      this.isLoggedIn = isLoggedIn()
      const info = getUserInfo()
      if (info != null) {
        this.userAvatarUrl = (info.avatarUrl != null && info.avatarUrl !== '') ? info.avatarUrl : ''
        this.userNickname = (info.nickname != null && info.nickname !== '') ? info.nickname : ''
      } else {
        this.userAvatarUrl = ''
        this.userNickname = ''
      }
    },

    // 处理用户区域点击
    handleUserClick() {
      if (!this.isLoggedIn) {
        // 未登录 → 拉起手机号登录弹窗
        this.showLoginPopup = true
        return
      }
      // 已登录 → 拉起头像昵称授权/修改弹窗
      // 场景：用户在其他页面（首页/详情页）完成手机号登录后，
      // 若当时选择跳过或未弹出 profile popup，此处兜底允许其补齐或修改头像昵称
      this.openProfilePopup()
    },

    // 关闭登录弹窗
    closeLoginPopup() {
      this.showLoginPopup = false
      this.loginAgreementChecked = false
    },

    toggleLoginAgreement() {
      this.loginAgreementChecked = !this.loginAgreementChecked
    },

    showLoginAgreementToast() {
      uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
    },

    openUserAgreement() {
      openUserAgreement()
    },

    openPrivacyPolicy() {
      openPrivacyPolicy()
    },

    // 手机号授权回调
    async onGetPhoneNumber(e: any) {
      if (!this.loginAgreementChecked) {
        this.showLoginAgreementToast()
        return
      }
      const detail = e.detail || {}
      console.log('[login] step0 getPhoneNumber detail=', JSON.stringify(detail))

      // 用户拒绝授权
      if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
        if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
          uni.showToast({ title: '已取消授权', icon: 'none' })
        } else {
          console.error('[login] 手机号授权失败:', detail.errMsg)
          uni.showToast({ title: '授权失败，请重试', icon: 'none' })
        }
        return
      }

      const phoneCode = detail.code
      if (!phoneCode) {
        console.error('[login] 未获取到 phoneCode，detail:', JSON.stringify(detail))
        uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
        return
      }

      try {
        uni.showLoading({ title: '登录中...', mask: true })

        // 第一步：静默登录获取 wx code
        const loginRes = await uni.login({ provider: 'weixin' })
        console.log('[login] step1 uni.login result code=', loginRes.code)
        if (!loginRes.code) {
          uni.hideLoading()
          uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
          return
        }

        // 第二步：wx code 换 token
        const wxRes = await wxLogin({ code: loginRes.code })
        console.log('[login] step2 wxLogin response=', JSON.stringify(wxRes))
        if (wxRes.code === 200 && wxRes.data) {
          loginSuccess(wxRes.data.token, wxRes.data.userInfo)
        } else {
          uni.hideLoading()
          uni.showToast({ title: wxRes.message || '登录失败', icon: 'none' })
          return
        }

        // 第三步：用 phoneCode 绑定手机号
        const phoneRes = await wxBindPhone(phoneCode)
        console.log('[login] step3 wxBindPhone response=', JSON.stringify(phoneRes))
        let phoneHasFullProfile = false
        if (phoneRes.code === 200 && phoneRes.data) {
          // 用合并写入，避免 step2 已拿到的头像/昵称被本步响应中的 null 覆盖
          mergeUserInfo(phoneRes.data)
          // 若 phone 接口已下发 nickname & avatarUrl，则无需再让用户手动授权
          const pNick = phoneRes.data.nickname
          const pAvatar = phoneRes.data.avatarUrl
          phoneHasFullProfile =
            pNick != null && pNick !== '' &&
            pAvatar != null && pAvatar !== ''
        }

        uni.hideLoading()

        // 第四步：关闭手机号登录弹窗
        this.showLoginPopup = false
        if (phoneHasFullProfile) {
          // 后端已带头像昵称 → 直接登录完成，刷新 UI
          this.updateLoginState()
          uni.showToast({ title: '登录成功', icon: 'success' })
        } else {
          // 缺头像或昵称 → 弹出授权弹窗补齐
          console.log('[login] step4 before openProfilePopup')
          this.openProfilePopup()
        }
      } catch (err) {
        console.error('[login] 手机号登录失败(catch):', err)
        uni.hideLoading()
        uni.showToast({ title: '登录失败，请重试', icon: 'none' })
      }
    },

    // 打开头像昵称授权弹窗，并用当前已保存信息作为初始值
    openProfilePopup() {
      const info = getUserInfo()
      this.profileAvatarUrl = info?.avatarUrl || ''
      this.profileNickname = info?.nickname || ''
      this.showProfilePopup = true
      console.log('[openProfilePopup] showProfilePopup=', this.showProfilePopup, 'avatar=', this.profileAvatarUrl, 'nickname=', this.profileNickname)
    },

    // 用户选择头像回调（open-type="chooseAvatar"）
    onChooseAvatar(e: any) {
      const url = e?.detail?.avatarUrl
      if (url) {
        this.profileAvatarUrl = String(url)
      }
    },

    // 提交头像昵称：调用 PUT /api/wx/userinfo 更新后台用户信息
    // 不再调用 wxLogin，避免刷新 token 与覆盖其他字段
    async submitProfile() {
      const nickname = (this.profileNickname || '').trim()
      const avatarUrl = this.profileAvatarUrl || ''
      // 都未授权，等同跳过
      if (nickname === '' && avatarUrl === '') {
        this.skipProfile()
        return
      }
      // 乐观写入：先把用户刚选的头像/昵称同步到本地，
      // 保证后端响应不带 avatarUrl 时，本地仍能立即展示当会话头像。
      const optimistic: UserInfo = {
        id: 0,
        openid: '',
        phone: null,
        nickname: nickname !== '' ? nickname : null,
        avatarUrl: avatarUrl !== '' ? avatarUrl : null
      }
      mergeUserInfo(optimistic)
      try {
        uni.showLoading({ title: '更新中...', mask: true })
        const updateRes = await wxUpdateUserInfo({
          nickname: nickname !== '' ? nickname : undefined,
          avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
        })
        if (updateRes.code === 200 && updateRes.data) {
          // 合并写入，避免后端返回的空字段覆盖本地已有信息
          mergeUserInfo(updateRes.data)
        } else {
          uni.showToast({ title: updateRes.message || '更新失败', icon: 'none' })
        }
        uni.hideLoading()
      } catch (err) {
        console.error('更新头像昵称失败:', err)
        uni.hideLoading()
        uni.showToast({ title: '更新失败，请重试', icon: 'none' })
      } finally {
        this.finishProfile()
      }
    },

    // 跳过头像昵称授权
    skipProfile() {
      this.finishProfile()
    },

    confirmLogout() {
      uni.showModal({
        title: '确认退出登录',
        content: '退出后将清除当前账号登录状态',
        cancelText: '取消',
        confirmText: '确认',
        success: (res) => {
          if (res.confirm) {
            logout()
            this.showLoginPopup = false
            this.showProfilePopup = false
            this.loginAgreementChecked = false
            this.updateLoginState()
            uni.showToast({ title: '已退出登录', icon: 'success' })
          }
        }
      })
    },

    // 关闭头像昵称弹窗并刷新登录态
    finishProfile() {
      this.showProfilePopup = false
      this.profileAvatarUrl = ''
      this.profileNickname = ''
      this.updateLoginState()
      uni.showToast({ title: '登录成功', icon: 'success' })
    },

    // 判断是否为外部链接
    isExternalUrl(url: string): boolean {
      return url.startsWith('http://') || url.startsWith('https://')
    },

    // 统一跳转方法：自动区分内部路径和外部链接
    navigateToUrl(url: string) {
      if (this.isExternalUrl(url)) {
        uni.navigateTo({
          url: `/pages/webview/index?url=${encodeURIComponent(url)}`
        })
      } else {
        uni.navigateTo({
          url: url
        })
      }
    },

    // 处理金刚区点击
    handleMenuClick(item: any) {
      if (item.linkUrl) {
        // 需要登录的页面，先判断登录态
        if (item.needLogin && !isLoggedIn()) {
          this.showLoginPopup = true
          return
        }
        this.navigateToUrl(item.linkUrl)
      } else {
        uni.showToast({
          title: '功能开发中',
          icon: 'none'
        })
      }
    },

    // 处理 Banner 点击
    handleBannerClick(banner: any) {
      if (banner.link) {
        this.navigateToUrl(banner.link)
      }
    }
  }
}
</script>

<style>
.container {
  background: #000;
  min-height: 100vh;
  color: #fff;
}

.content {
  padding-bottom: 32rpx;
}

/* 用户区域 */
.user-section {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 32rpx 0;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #333;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.user-info {
  margin-left: 32rpx;
  flex: 1;
}

.nickname {
  font-size: 34rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 1);
}

/* 金刚区 */
.menu-section {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 32rpx 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  margin: 32rpx 32rpx;
  gap: 60rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  margin-bottom: 16rpx;
}

.menu-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  font-weight: 500;
}

/* 轮播图 */
.banner-section {
  margin: 0 32rpx;
}

.banner-swiper {
  width: 100%;
  height: 352rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.logout-section {
  margin: 56rpx 32rpx 0;
  padding-bottom: 24rpx;
}

.logout-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ff6b6b;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid rgba(255, 107, 107, 0.45);
}

.logout-button::after {
  border: none;
}

</style>
