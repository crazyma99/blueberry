<template>
  <view class="container">
    <!-- 顶部氛围光晕（金色弥散，解决纯色背景的干拔感） -->
    <view class="bg-aura"></view>
    <CustomNavBar title="我的" />
    <!-- Loading 骨架屏 -->
    <view v-if="loading" class="sk-container" style="padding-top: 64rpx;">
      <view class="sk-row" style="margin-bottom: 40rpx;">
        <view class="sk-avatar sk-animate"></view>
        <view class="sk-text sk-animate" style="width: 200rpx; margin-left: 24rpx;"></view>
      </view>
      <view class="sk-menu sk-animate"></view>
      <view class="sk-banner sk-animate" style="border-radius: var(--radius-sm);"></view>
    </view>

    <!-- 主内容：list 布局（高性能列表） -->
    <view v-else class="content">
      <list-view class="content-list" :show-scrollbar="false">
        <!-- 资料+功能列表：合成一块（视觉换新：统一容器 + 分割线） -->
        <view class="profile-group">
          <view class="user-card" hover-class="press-dim" @click="handleUserClick">
            <!-- 卡片右侧金色光斑（视觉换新：材质感） -->
            <view class="user-card-glow"></view>
            <!-- 头像容器：始终展示 .avatar 灰色色值 DOM；image 仅在有可用头像 url 时渲染 -->
            <!-- 加载失败时 image 透明，仍露出 .avatar 灰色背景，避免任何兜底图 -->
            <view class="avatar">
              <image
                v-if="displayAvatar !== ''"
                class="avatar-img fade-in"
                :src="displayAvatar"
                mode="aspectFill"
              ></image>
            </view>
            <view class="user-info">
              <view class="nickname font-noto-serif">
                {{ displayNickname }}
              </view>
              <view class="user-sub font-harmony">
                {{ isLoggedIn ? (userNickname === '' ? '完善头像昵称，获得完整体验' : '欢迎回来，蓝梅旅拍') : '登录后可收藏与体验AI试衣' }}
              </view>
            </view>
            <view class="user-arrow">›</view>
          </view>

          <!-- 功能列表项：紧凑合成一块 -->
          <view
            v-for="(item, index) in menuItems"
            :key="index"
            class="menu-row"
            hover-class="press-row"
            @click="handleMenuClick(item)"
          >
            <view class="menu-title font-harmony">{{ item.title }}</view>
            <view class="menu-arrow">›</view>
          </view>
        </view>

        <list-item>
          <!-- 轮播图 Banner -->
          <view class="banner-section">
            <swiper
              class="banner-swiper"
              autoplay
              circular
              :interval="5000"
              :duration="500"
            >
              <swiper-item v-for="(banner, index) in banners" :key="index">
                <image
                  class="banner-image fade-in"
                  :src="banner.imageUrl"
                  mode="aspectFill"
                  @click="handleBannerClick(banner)"
                ></image>
              </swiper-item>
            </swiper>
          </view>
        </list-item>

        <!-- 退出登录占位（按钮已移入底部固定栏） -->
        <list-item v-if="isLoggedIn">
          <view class="logout-spacer"></view>
        </list-item>

        <!-- 底部留白，保证最后一个 list-item 之后有呼吸空间 -->
        <list-item>
          <view class="footer-space"></view>
        </list-item>
      </list-view>
    </view>

    <!-- 登录弹窗 -->
    <LoginPopup
	v-if="showLoginPopup"
	:agreement-checked="loginAgreementChecked"
	:user-agreement-name="userAgreementName"
	:privacy-policy-name="privacyPolicyName"
	@close="closeLoginPopup"
	@toggle-agreement="toggleLoginAgreement"
	@show-toast="showLoginAgreementToast"
	@open-user="openUserAgreement"
	@open-privacy="openPrivacyPolicy"
	@get-phone="onGetPhoneNumber"
/>

    <!-- 头像昵称授权弹窗 -->
    <ProfilePopup
	v-if="showProfilePopup"
	:avatar-url="profileAvatarUrl"
	:nickname="profileNickname"
	@choose-avatar="onChooseAvatar"
	@update-nickname="(v: string) => { this.profileNickname = v }"
	@submit="submitProfile"
	@skip="skipProfile"
/>

    <!-- 退出登录底部固定栏（secondary 款，上移避开 tabbar） -->
    <BottomActionBarSecondary v-if="isLoggedIn" bottomOffset="calc(116rpx + env(safe-area-inset-bottom))">
      <view class="logout-btn" hover-class="press-dim" @click.stop="confirmLogout">退出登录</view>
    </BottomActionBarSecondary>

    <!-- 自定义底部 tabbar 占位（116rpx + 安全区） -->
    <view class="tabbar-safe-spacer"></view>
  </view>
</template>

<script lang="uts">
import { isLoggedIn, getUserInfo, loginSuccess, logout, setUserInfo, mergeUserInfo, UserInfo, consumeLoginExpired } from '../../utils/auth.uts'
import { wxLogin, wxBindPhone, wxGetUserInfo, wxUpdateUserInfo, getPageConfig, rejectAllPendingUploads } from '../../utils/api.uts'
import { hapticTap } from '../../utils/haptics.uts'
import { runPhoneLogin } from '../../utils/loginFlow.uts'
import { submitUserProfile } from '../../utils/profileSubmit.uts'
import { rejectAllPending } from '../../utils/http.uts'
import { syncTabBarSelected } from '../../utils/tabbar.uts'
import { cosThumb } from '../../utils/imageLoader.uts'
import {
  USER_AGREEMENT_NAME,
  PRIVACY_POLICY_NAME,
  openUserAgreement,
  openPrivacyPolicy
} from '../../utils/legal.uts'

export default {
  data() {
    return {
      loading: true,
      // 拆成扁平基本类型字段，避免 uvue 对 userInfo.avatarUrl 这种嵌套路径依赖追踪不可靠
      // 导致登录/更新后 computed 不重算、image 不刷新的问题
      userAvatarUrl: '',
      userNickname: '',
      isLoggedIn: false,
      banners: [] as any[],
      menuItems: [] as any[],
      // 仅供 profile 弹窗里 chooseAvatar 占位使用，user-section 不再用兜底图
      defaultAvatar: '/static/mine.svg',
      showLoginPopup: false,
      loginAgreementChecked: false,
      userAgreementName: USER_AGREEMENT_NAME,
      privacyPolicyName: PRIVACY_POLICY_NAME,
      // 头像昵称授权弹窗
      showProfilePopup: false,
      profileAvatarUrl: '',
      profileNickname: '',
      // profile 弹窗是否由登录流程拉起（仅登录流程关闭弹窗时才弹"登录成功"toast）
      profileFromLogin: false
    }
  },

  computed: {
    // 显示用头像 URL：仅依赖两个基本类型字段，响应式追踪可靠
    // - 未登录 / 无头像 url → ''（image 不渲染，露出 .avatar 灰色 DOM）
    displayAvatar(): string {
      if (!this.isLoggedIn) return ''
      return this.userAvatarUrl
    },
    // 显示用昵称：同样只依赖基本类型字段
    displayNickname(): string {
      if (!this.isLoggedIn) return '点击立即登陆'
      if (this.userNickname === '') return '点击获取用户信息'
      return this.userNickname
    }
  },

  async onLoad() {
    await this.loadData()
  },

  async onShow() {
    // 同步自定义底部 tabbar 选中态（本页下标 2）
    syncTabBarSelected(2)
    // 监听 401 登录过期事件，自动拉起登录弹窗
    uni.$off('login-required')
    uni.$on('login-required', () => {
      this.showLoginPopup = true
    })
    // 兑底：其他页面触发 401 后导航回来时自动弹出
    if (consumeLoginExpired()) {
      this.showLoginPopup = true
    }
    // 页面显示时刷新登录状态（仅更新UI，不触发登录流程）
    this.updateLoginState()
    // 兑底：已登录但本地缺头像 → 拉取一次后端最新用户信息，
    // 修复其他页面登录时被覆盖掉头像的历史数据
    if (this.isLoggedIn && this.userAvatarUrl === '') {
      try {
        const res = await wxGetUserInfo()
        if (res.code === 200 && res.data) {
          mergeUserInfo(res.data)
          this.updateLoginState()
        }
      } catch (err) {
        console.warn('[mine.onShow] 拉取最新用户信息失败:', err)
      }
    }
  },

  onHide() {
    uni.$off('login-required')
  },

  methods: {
    // 加载页面数据
    async loadData() {
      try {
        this.loading = true

        // 更新登录状态
        this.updateLoginState()

        // 获取中台页配置（金刚区 + Banner）
        const configRes = await getPageConfig()
        if (configRes.code === 200 && configRes.data) {
          const configMenus = configRes.data.filter(item => item.type === 'icon_grid')[0].items || []
          this.menuItems = [...this.getDefaultMenuItems(), ...configMenus]
          // banner 出 750px WebP 缩略图，降低内存占用
          this.banners = (configRes.data.filter(item => item.type === 'banner')[0].items || []).map(item => {
            item.imageUrl = cosThumb(item.imageUrl, 750)
            return item
          })
        }
        // 金刚区为空时，设置默认入口
        if (this.menuItems.length === 0) {
          this.menuItems = this.getDefaultMenuItems()
        }
      } catch (err) {
        console.error('加载数据失败:', err)
        // 拉取失败，使用默认金刚区
        this.menuItems = this.getDefaultMenuItems()
      } finally {
        this.loading = false
      }
    },

    // 默认金刚区入口
    getDefaultMenuItems() {
      return [
        { title: '我的喜欢', imageUrl: '/static/liked.svg', linkUrl: '/pages/favorites/index', needLogin: true },
        { title: 'AI试衣', imageUrl: '/static/starred.svg', linkUrl: '/pages/aiTryOnHistory/index', needLogin: true, specialFont: true }
      ]
    },

    // 更新登录状态 → 同步到两个扁平字段，触发响应式重渲染
    updateLoginState() {
      this.isLoggedIn = isLoggedIn()
      const info = getUserInfo()
      if (info != null) {
        this.userAvatarUrl = (info.avatarUrl != null && info.avatarUrl !== '') ? info.avatarUrl : ''
        this.userNickname = (info.nickname != null && info.nickname !== '') ? info.nickname : ''
      } else {
        this.userAvatarUrl = ''
        this.userNickname = ''
      }
    },

    // 处理用户区域点击
    handleUserClick() {
      if (!this.isLoggedIn) {
        // 未登录 → 拉起手机号登录弹窗
        this.showLoginPopup = true
        return
      }
      // 已登录 → 拉起头像昵称授权/修改弹窗
      // 场景：用户在其他页面（首页/详情页）完成手机号登录后，
      // 若当时选择跳过或未弹出 profile popup，此处兜底允许其补齐或修改头像昵称
      this.openProfilePopup()
    },

    // 关闭登录弹窗
    closeLoginPopup() {
      this.showLoginPopup = false
      this.loginAgreementChecked = false
      // 用户主动取消登录，reject 所有挂起的 401 请求
      rejectAllPending()
      rejectAllPendingUploads()
    },

    toggleLoginAgreement() {
      this.loginAgreementChecked = !this.loginAgreementChecked
    },

    showLoginAgreementToast() {
      uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
    },

    openUserAgreement() {
      openUserAgreement()
    },

    openPrivacyPolicy() {
      openPrivacyPolicy()
    },

    // 手机号授权回调
    async onGetPhoneNumber(e: any) {
      if (!this.loginAgreementChecked) {
        this.showLoginAgreementToast()
        return
      }
      const detail = e.detail || {}
      console.log('[login] step0 getPhoneNumber detail=', JSON.stringify(detail))

      // 用户拒绝授权
      if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
        if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
          uni.showToast({ title: '已取消授权', icon: 'none' })
        } else {
          console.error('[login] 手机号授权失败:', detail.errMsg)
          uni.showToast({ title: '授权失败，请重试', icon: 'none' })
        }
        return
      }

      const phoneCode = detail.code
      if (!phoneCode) {
        console.error('[login] 未获取到 phoneCode，detail:', JSON.stringify(detail))
        uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
        return
      }

      try {
        uni.showLoading({ title: '登录中...', mask: true })
        // 登录三步骤已下沉到 utils/loginFlow.uts
        const result = await runPhoneLogin(phoneCode)
        uni.hideLoading()

        if (!result.ok) {
          if (result.errorKind === 'login') {
            uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
          } else {
            uni.showToast({ title: result.errorMsg || '登录失败', icon: 'none' })
          }
          return
        }

        // 关闭手机号登录弹窗
        this.showLoginPopup = false
        if (result.phoneHasFullProfile) {
          // 后端已带头像昵称 → 直接登录完成，刷新 UI
          this.updateLoginState()
          uni.showToast({ title: '登录成功', icon: 'success' })
        } else {
          // 缺头像或昵称 → 弹出授权弹窗补齐
          console.log('[login] step4 before openProfilePopup')
          this.profileFromLogin = true
          this.openProfilePopup()
        }
      } catch (err) {
        console.error('[login] 手机号登录失败(catch):', err)
        uni.hideLoading()
        uni.showToast({ title: '登录失败，请重试', icon: 'none' })
      }
    },

    // 打开头像昵称授权弹窗，并用当前已保存信息作为初始值
    openProfilePopup() {
      const info = getUserInfo()
      this.profileAvatarUrl = info?.avatarUrl || ''
      this.profileNickname = info?.nickname || ''
      this.showProfilePopup = true
      console.log('[openProfilePopup] showProfilePopup=', this.showProfilePopup, 'avatar=', this.profileAvatarUrl, 'nickname=', this.profileNickname)
    },

    // 用户选择头像回调（open-type="chooseAvatar"）
    onChooseAvatar(e: any) {
      const url = e?.detail?.avatarUrl
      if (url) {
        this.profileAvatarUrl = String(url)
      }
    },

    // 提交头像昵称：调用 PUT /api/wx/userinfo 更新后台用户信息
    // 不再调用 wxLogin，避免刷新 token 与覆盖其他字段
    async submitProfile() {
      const nickname = (this.profileNickname || '').trim()
      const avatarUrl = this.profileAvatarUrl || ''
      // 都未授权，等同跳过
      if (nickname === '' && avatarUrl === '') {
        this.skipProfile()
        return
      }
      // 乐观写入：先把用户刚选的头像/昵称同步到本地，
      // 保证后端响应不带 avatarUrl 时，本地仍能立即展示当会话头像。
      const optimistic: UserInfo = {
        id: 0,
        openid: '',
        phone: null,
        nickname: nickname !== '' ? nickname : null,
        avatarUrl: avatarUrl !== '' ? avatarUrl : null
      }
      mergeUserInfo(optimistic)
      try {
        uni.showLoading({ title: '更新中...', mask: true })
        const result = await submitUserProfile({
          nickname: nickname !== '' ? nickname : undefined,
          avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
        })
        uni.hideLoading()
        if (!result.ok) {
          uni.showToast({ title: result.errorMsg || '更新失败', icon: 'none' })
        }
      } catch (err) {
        // 兜底：utils 已 catch 异常并返回 ok=false，这里仅防御式处理
        console.error('更新头像昵称失败:', err)
        uni.hideLoading()
        uni.showToast({ title: '更新失败，请重试', icon: 'none' })
      } finally {
        this.finishProfile()
      }
    },

    // 跳过头像昵称授权
    skipProfile() {
      this.finishProfile()
    },

    confirmLogout() {
      uni.showModal({
        title: '确认退出登录',
        content: '退出后将清除当前账号登录状态',
        cancelText: '取消',
        confirmText: '确认',
        success: (res) => {
          if (res.confirm) {
            logout()
            this.showLoginPopup = false
            this.showProfilePopup = false
            this.loginAgreementChecked = false
            this.updateLoginState()
            uni.showToast({ title: '已退出登录', icon: 'success' })
          }
        }
      })
    },

    // 关闭头像昵称弹窗并刷新登录态
    finishProfile() {
      this.showProfilePopup = false
      this.profileAvatarUrl = ''
      this.profileNickname = ''
      this.updateLoginState()
      // 只有登录流程拉起的弹窗关闭时才提示登录成功；
      // 已登录态点头像修改资料后关闭（跳过/点蒙层）不提示
      if (this.profileFromLogin) {
        uni.showToast({ title: '登录成功', icon: 'success' })
      }
      this.profileFromLogin = false
    },

    // 判断是否为外部链接
    isExternalUrl(url: string): boolean {
      return url.startsWith('http://') || url.startsWith('https://')
    },

    // 统一跳转方法：自动区分内部路径和外部链接
    navigateToUrl(url: string) {
      if (this.isExternalUrl(url)) {
        uni.navigateTo({
          url: `/pages/webview/index?url=${encodeURIComponent(url)}`
        })
      } else {
        uni.navigateTo({
          url: url
        })
      }
    },

    // 处理金刚区点击
    handleMenuClick(item: any) {
      // 触感反馈：菜单点击轻振动
      hapticTap()
      if (item.linkUrl) {
        // 需要登录的页面，先判断登录态
        if (item.needLogin && !isLoggedIn()) {
          this.showLoginPopup = true
          return
        }
        this.navigateToUrl(item.linkUrl)
      } else {
        uni.showToast({
          title: '功能开发中',
          icon: 'none'
        })
      }
    },

    // 处理 Banner 点击
    handleBannerClick(banner: any) {
      if (banner.link) {
        this.navigateToUrl(banner.link)
      }
    }
  }
}
</script>

<style>
.container {
  background: var(--color-bg);
  height: 100vh;
  display: flex;
  flex-direction: column;
  color: var(--color-primary);
}

/* 顶部氛围光晕：金色弥散，视觉重心落在上半区 */
.bg-aura {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 640rpx;
  pointer-events: none;
  background: radial-gradient(ellipse 92% 62% at 50% 0%, rgba(241, 205, 145, 0.2), rgba(241, 205, 145, 0.06) 46%, rgba(22, 15, 4, 0) 78%);
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.content-list {
  flex: 1;
}

/* 用户卡片（列表行样式，与功能菜单统一） */
/* 资料+功能列表 合成一块（统一容器） */
.profile-group {
  margin: var(--spacing-lg) var(--spacing-lg) 0;
  border-radius: var(--radius-container);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.user-card {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 150rpx;
  padding: 0 var(--spacing-md);
  background: linear-gradient(135deg, rgba(241, 205, 145, 0.18), rgba(241, 205, 145, 0.06) 55%, rgba(241, 205, 145, 0.02));
  overflow: hidden;
  transition: opacity 0.15s ease-out;
}

/* 用户卡片右侧金色光斑 */
.user-card-glow {
  position: absolute;
  right: -60rpx;
  top: -40rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(241, 205, 145, 0.18), rgba(241, 205, 145, 0) 70%);
  pointer-events: none;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #333;
  overflow: hidden;
  border: 2rpx solid rgba(241, 205, 145, 0.35);
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.user-info {
  margin-left: 24rpx;
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 400;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.user-sub {
  margin-top: 10rpx;
  font-size: var(--font-size-body-sm);
  color: rgba(241, 205, 145, 0.7);
  letter-spacing: 1rpx;
}

.user-arrow {
  font-size: 40rpx;
  color: rgba(241, 205, 145, 0.45);
  padding: 0 4rpx;
}

/* 功能列表行（Phase2：88rpx 标准行高 + 顶部高光层级） */
.menu-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 92rpx;
  margin: 0;
  padding: 0 var(--spacing-md);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: opacity 0.15s ease-out;
}

.menu-title {
  flex: 1;
  font-size: var(--font-size-body-plus);
  color: var(--color-primary);
  font-weight: 400;
  letter-spacing: 1rpx;
}

.menu-arrow {
  color: rgba(255, 255, 255, 0.35);
  font-size: 36rpx;
  padding: 0 4rpx;
}

.special-font {
  background: linear-gradient(76deg, #ffb26f 15%, #fcc18e 25%, #bbb0ff 38%, #8d7aff 61%, #699bff 79%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-fill-color: transparent;
}

/* 轮播图 Banner */
.banner-section {
  margin: var(--spacing-lg) var(--spacing-lg) 0;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
  overflow: hidden;
  border-radius: var(--radius-container);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
}

.banner-image {
  width: 100%;
  height: 100%;
}

.logout-spacer {
  height: 200rpx;
}

/* 退出登录按钮（完全重写：view 实现，避免 button 原生样式干扰） */
.logout-btn {
  width: calc(100% - 64rpx);
  margin: 0 var(--spacing-lg);
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: rgba(255, 255, 255, 0.08);
  color: #ff6b6b;
  font-size: var(--font-size-body-plus);
  font-weight: 400;
  border: 2rpx solid rgba(255, 107, 107, 0.45);
  transition: opacity 0.15s ease-out;
}

/* 列表底部留白 */
.footer-space {
  height: 48rpx;
}

