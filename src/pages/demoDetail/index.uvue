		height: 54rpx;
		font-size: var(--font-size-body);
		color: var(--color-primary);
		font-weight: 400;
		border-radius: var(--radius-avatar);
		background: linear-gradient(99.85deg, rgba(241, 205, 145, 0.12) 0%, rgba(241, 205, 145, 0) 100%), var(--color-bg);
	}
	.choosed-wrap{
		background: var(--color-primary);
