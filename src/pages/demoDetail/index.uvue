	}
	/* 分类标题 */
	.cat-title-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin: 8rpx 24rpx var(--spacing-sm);
	}
	.cat-title {
		font-size: var(--font-size-display);
		font-weight: 400;
		color: var(--color-primary);
		letter-spacing: 2rpx;
		flex-shrink: 0;
	}
	.cat-title-deco-wrap {
		flex: 1;
		height: 28rpx;
		margin-left: 12rpx;
		overflow: hidden;
	}
	.cat-title-deco {
		height: 28rpx;
	}
	/* 分类胶囊标签 */
	.tabcontainer{
		width: 100%;
		overflow-x: scroll;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 0 24rpx;
	}
	/* 胶囊标签：外层 tab-wrap 为 1rpx 渐变描边圆环；内层 tab 填充 =
	   半透明金渐变 + 页面底色 var(--color-bg) 合成（实色底层挡住描边透出）；选中态两层实金 */
	.tab-wrap{
		margin-right: 16rpx;
		margin-bottom: 16rpx;
		/* 纯色描边（标准 border，去 padding hack） */
		border: 1rpx solid var(--color-primary-30);
		border-radius: var(--radius-avatar);
		flex-shrink: 0;
	}
	.tab{
		display: flex;
		align-items: center;
		justify-content: center;
		/* 最小宽度 140rpx，左右 padding 24rpx，宽度由内容撑开 */
		min-width: 140rpx;
