	}
	/* 渐变描边：外层 1rpx 渐变圆环 + 内层填充。
	   内层填充 = 半透明金渐变 + 页面底色 var(--color-bg) 合成（下层实色挡住描边透出），
	   视觉效果等同于半透明渐变直接叠在页面上，边缘过渡自然 */
	.search-bar-wrap {
		width: 65%;
