<template>
	<view class="page">
		<!-- 自定义导航栏：搜索框常驻标题栏位置 -->
		<view class="custom-nav">
			<view :style="{height: statusBarHeight + 'px'}"></view>
			<view class="nav-content">
				<image class="back-btn" src="/static/back-arrow.svg" mode="aspectFit" @click="goBack"></image>
				<view class="search-bar-nav">
					<image class="search-icon-small" src="/static/search.svg" mode="aspectFit"></image>
					<input
						class="search-input-nav"
						type="text"
						placeholder="搜索客片"
						placeholder-style="color: rgba(255,255,255,0.3)"
						v-model="searchKeyword"
						confirm-type="search"
						@confirm="handleSearch"
					/>
				</view>
			</view>
		</view>
		<!-- 占位 -->
		<view :style="{height: (statusBarHeight + 44) + 'px'}"></view>

		<!-- Loading 骨架屏 -->
		<view v-if="loading" class="skeleton-container">
			<view class="skeleton-tabs">
				<view v-for="i in 4" :key="i" class="skeleton-tab skeleton-animate"></view>
			</view>
			<view class="skeleton-photos">
				<view v-for="i in 6" :key="i" class="skeleton-photo skeleton-animate"></view>
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else>
			<!-- 搜索结果模式 -->
			<view v-if="isSearching" class="search-results">
				<view v-if="searchList.length === 0 && searchDone" class="empty-state">
					<view class="empty-title">暂无搜索结果</view>
					<view class="empty-desc">换个关键词试试吧</view>
				</view>
				<view v-else class="photolistContainer">
					<view
						v-for="(item, index) in searchList"
						:key="index"
						class="photoItem"
					>
						<image :src="item.coverImageUrl" class="photo" mode="aspectFill" />
						<view class="mask" @click="gotoDetail(item)">
							<view class="desc">
								<view class="photoName">{{ item.title }}</view>
								<view class="collect">
									<image
										class="heart"
										mode="aspectFit"
										:src="item.liked ? '/static/liked.svg' : '/static/like.svg'"
									>
										<view class="clickArea" @click.stop="handleLike(item)"></view>
									</image>
									<text class="stat-count">{{ formatCount(item.likeCount || 0) }}</text>
								</view>
							</view>
						</view>
					</view>
				</view>
				<view v-if="searchList.length > 0 && !searchNoMore" class="load-more" @click="loadMoreSearch">
					<text class="load-more-text">{{ searchLoading ? '加载中...' : '加载更多' }}</text>
				</view>
				<view v-if="searchNoMore && searchList.length > 0" class="load-more">
					<text class="load-more-text">已经到底了</text>
				</view>
			</view>

			<!-- 正常分类模式 -->
			<view v-if="!isSearching && alltabs.length > 0">
				<view class="title">套餐与子系分类：</view>
				<view class="tabcontainer">
					<view
						v-for="(item, idx) in alltabs"
						:key="idx"
						:class="selectedTab.parentTab === item.id ? 'tab choosed': 'tab'"
						@click="changeTab(item.id, 'parent')"
					>
						{{item.parentName}}
					</view>
				</view>
				<view class="tabcontainer">
					<view
						v-for="(item, idx) in getSecondTab"
						:key="idx"
						:class="selectedTab.childTab === item.id ? 'tab choosed': 'tab'"
						@click="changeTab(item.id, 'child')"
					>
						{{item.name}}
					</view>
				</view>
				<view class="photolistContainer">
					<view
						v-for="(item, index) in getCurPhotoList"
						:key="index"
						class="photoItem"
					>
						<image :src="item?.coverImageUrl" class="photo" mode="aspectFill" />
						<view class="mask" @click="gotoDetail(item)">
							<view class="desc">
								<view class="photoName">{{ item?.title }}</view>
								<view class="collect">
									<image
										class="heart"
										mode="aspectFit"
										:src="item.liked ? '/static/liked.svg' : '/static/like.svg'"
									>
										<view class="clickArea" @click.stop="handleLike(item)"></view>
									</image>
									<text class="stat-count">{{ formatCount(item.likeCount || 0) }}</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<view class="divide"></view>
			<view class="bottomdesc">Copyright 2025 蓝梅旗袍·汉服·民族服体验馆 - 版权所有</view>
		</view>
	</view>
</template>

<script>
	import { getalbum, searchAlbums, toggleLike, getLikeStatus, wxLogin } from '../../utils/api.uts'
	import { isLoggedIn, loginSuccess } from '../../utils/auth.uts'

	export default {
		data() {
			return {
				idx: '',
				from: '',
				statusBarHeight: 20,
				loading: true, // 页面加载状态
				selectedTab: {
					parentTab: '',
					childTab: ''
				},
				alltabs: [],
				// 搜索相关
				isSearching: false,
				searchKeyword: '',
				searchDone: false,
				searchList: [],
				searchPage: 1,
				searchPageSize: 10,
				searchLoading: false,
				searchNoMore: false
			}
		},
		computed: {
			getSecondTab() {
				const match = this.alltabs.filter(item => item.id === this.selectedTab.parentTab)
				if (match.length === 0) return []
				return match[0].subCategory || []
			},
			getCurPhotoList() {
				const parentMatch = this.alltabs.filter(item => item.id === this.selectedTab.parentTab)
				if (parentMatch.length === 0) return []
				const curtab = parentMatch[0].subCategory || []
				const childMatch = curtab.filter(item => item.id === this.selectedTab.childTab)
				if (childMatch.length === 0) return []
				return childMatch[0].albumList || []
			},
		},
		onLoad(query) {
			const systemInfo = uni.getSystemInfoSync()
			this.statusBarHeight = systemInfo.statusBarHeight || 20
			this.idx = query?.idx ?? ''
			this.from = query?.from ?? ''
			this.getAlbumInfo(query?.idx || '')
		},
		onShow() {
			const list = this.getCurPhotoList
			if (Array.isArray(list) && list.length > 0) {
				this.refreshLikeStatus(list)
			}
		},
		methods: {
			goBack() {
				uni.navigateBack()
			},
			// 搜索：键盘搜索按钮触发
			async handleSearch() {
				const keyword = this.searchKeyword.trim()
				if (!keyword) {
					// 搜索词为空，退出搜索模式
					this.isSearching = false
					this.searchList = []
					this.searchDone = false
					this.searchPage = 1
					this.searchNoMore = false
					return
				}
				this.isSearching = true
				this.searchPage = 1
				this.searchNoMore = false
				this.searchList = []
				this.searchDone = false
				await this.doSearch(keyword, 1)
				this.searchDone = true
			},
			// 清除搜索，回到分类模式
			clearSearch() {
				this.searchKeyword = ''
				this.isSearching = false
				this.searchList = []
				this.searchDone = false
				this.searchPage = 1
				this.searchNoMore = false
			},
			async doSearch(keyword, page) {
				if (this.searchLoading) return
				try {
					this.searchLoading = true
					const res = await searchAlbums(keyword, page, this.searchPageSize)
					if (res.code === 200 && res.data) {
						if (page === 1) {
							this.searchList = res.data
						} else {
							this.searchList = this.searchList.concat(res.data)
						}
						if (res.data.length < this.searchPageSize) {
							this.searchNoMore = true
						}
						this.searchPage = page
						if (this.searchList.length > 0) {
							this.refreshLikeStatus(this.searchList)
						}
					} else {
						if (page === 1) this.searchList = []
						this.searchNoMore = true
					}
				} catch (err) {
					console.error('搜索失败:', err)
					uni.showToast({ title: '搜索失败', icon: 'none' })
				} finally {
					this.searchLoading = false
				}
			},
			async loadMoreSearch() {
				if (this.searchNoMore || this.searchLoading) return
				await this.doSearch(this.searchKeyword.trim(), this.searchPage + 1)
			},
			async getAlbumInfo(id) {
				if (!id) {
					this.loading = false
					return
				}
				try {
					this.loading = true
					const res = await getalbum('get', { type: id })
					const { code, data } = res
					if (code !== 200) {
						this.alltabs = []
						return
					}
					this.alltabs = data.alltabs
					this.selectedTab = {
						parentTab: data.alltabs[0]?.id,
						childTab: data.alltabs[0]?.subCategory[0]?.id
					}
					this.$nextTick(() => {
						const list = this.getCurPhotoList
						if (Array.isArray(list) && list.length > 0) {
							this.refreshLikeStatus(list)
						}
					})
				} catch (err) {
					console.error('获取专辑信息失败:', err)
					this.alltabs = []
				} finally {
					this.loading = false
				}
			},
			// 从云端刷新点赞状态（点赞=收藏）
			async refreshLikeStatus(list) {
				if (!Array.isArray(list) || list.length === 0) return
				const ids = list.map(item => item.id).filter(id => id != null)
				if (ids.length === 0) return
				const albumIds = ids.join(',')
				try {
					const likeRes = await getLikeStatus(albumIds).catch(() => null)
					if (likeRes && likeRes.code === 200 && likeRes.data) {
						likeRes.data.forEach(item => {
							const target = list.find(p => p.id === item.albumId)
							if (target) {
								target.liked = item.liked
								target.likeCount = item.likeCount
							}
						})
					}
				} catch (err) {
					console.warn('获取点赞状态失败:', err)
				}
			},
			changeTab(id, pos) {
				if (pos === 'parent') {
					const target = this.alltabs.filter(item => item.id === id)[0]
					this.selectedTab = {
						parentTab: id,
						childTab: target.subCategory[0].id
					}
				}
				if (pos === 'child') {
					this.selectedTab = {
						...this.selectedTab,
						childTab: id
					}
				}
				this.$nextTick(() => {
					const list = this.getCurPhotoList
					if (Array.isArray(list) && list.length > 0) {
						this.refreshLikeStatus(list)
					}
				})
			},
			// 点赞（点赞=收藏，复用原有心形交互）
			async handleLike(item) {
				if (!item?.id) return
				if (!isLoggedIn()) {
					await this.doLogin()
					return
				}
				try {
					const res = await toggleLike(item.id)
					if (res.code === 200 && res.data) {
						item.liked = res.data.liked
						item.likeCount = res.data.likeCount
					}
				} catch (err) {
					console.error('点赞失败:', err)
					uni.showToast({ title: '操作失败', icon: 'none' })
				}
			},
			async doLogin() {
				try {
					const loginRes = await uni.login({ provider: 'weixin' })
					if (loginRes.code) {
						const res = await wxLogin({ code: loginRes.code })
						if (res.code === 200 && res.data) {
							loginSuccess(res.data.token, res.data.userInfo)
							uni.showToast({ title: '登录成功', icon: 'success' })
						} else {
							uni.showToast({ title: res.message || '登录失败', icon: 'none' })
						}
					}
				} catch (err) {
					console.error('登录失败:', err)
				}
			},
			gotoDetail(item) {
				uni.navigateTo({
					url: `/pages/targetPhotoDetail/index?idx=${item.id}&liked=${item.liked}&type=${this.idx}`
				})
			},
			formatCount(count) {
				if (count >= 10000) {
					return `${(count / 10000).toFixed(1)}万`
				}
				return String(count || 0)
			}
		}
	}
</script>

<style>
	.page {
		background: #000;
		min-height: 100vh;
		overflow-y: scroll;
	}
	/* 自定义导航栏 */
	.custom-nav {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		background: #000;
		z-index: 100;
	}
	.nav-content {
		height: 44px;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 0 16rpx;
	}
	.back-btn {
		width: 48rpx;
		height: 48rpx;
		padding: 10rpx;
	}
	.search-bar-nav {
		display: flex;
		width: 65%;
		flex-direction: row;
		align-items: center;
		background: rgba(255, 255, 255, 0.1);
		border-radius: 32rpx;
		padding: 0 20rpx;
		height: 64rpx;
		margin-left: 20rpx;
	}
	.search-icon-small {
		width: 32rpx;
		height: 32rpx;
	}
	.search-input-nav {
		flex: 1;
		font-size: 26rpx;
		color: #fff;
		margin-left: 12rpx;
	}
	/* 搜索结果 */
	.search-results {
		min-height: 50vh;
	}
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 200rpx 32rpx;
	}
	.empty-title {
		font-size: 32rpx;
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 16rpx;
	}
	.empty-desc {
		font-size: 24rpx;
		color: rgba(255, 255, 255, 0.3);
	}
	.load-more {
		padding: 32rpx;
		text-align: center;
	}
	.load-more-text {
		font-size: 24rpx;
		color: rgba(255, 255, 255, 0.4);
	}
	/* 分类样式 */
	.title{
		color: rgba(255, 255, 255, 0.5);
		font-size: 24rpx;
		margin: 8rpx 32rpx;
	}
	.tabcontainer{
		width: 100%;
		overflow-x: scroll;
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.tab{
		margin-left: 8rpx;
		margin-bottom: 16rpx;
		width: 128rpx;
		height: 42rpx;
		text-align: center;
		line-height: 42rpx;
		font-size: 28rpx;
		color: rgba(255, 255, 255, 0.5);
		flex-shrink: 0;
		min-width: 128rpx;
	}
	.choosed{
		color: rgba(255, 255, 255, 0.9);
		font-size: 32rpx;
		font-weight: 500;
	}
	.photolistContainer{
		margin: 16rpx 8rpx;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}
	.photoItem{
		width: 362rpx;
		height: 482rpx;
		margin: 0 8rpx 8rpx 0;
		position: relative;
	}
	.photoItem:nth-child(2n){
		margin: 0 0 8rpx;
	}
	.photo{
		width: 100%;
		height: 100%;
		border-radius: 8rpx;
	}
	.mask {
		position: absolute;
		width: 362rpx;
		height: 482rpx;
		top: 0;
		left: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.4) 75%, rgba(0, 0, 0, 0.7) 89%, #000000 100%);
	}
	.desc{
		margin: 436rpx 16rpx 0;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}
	.photoName{
		font-size: 28rpx;
		font-weight: 500;
		color: #fff;
	}
	.collect{
		display: flex;
		align-items: center;
		font-size: 24rpx;
		color: #fff;
	}
	.heart{
		width: 48rpx;
		height: 40rpx;
		position: relative;
	}
	.clickArea{
		position: absolute;
		width: 60rpx;
		height: 60rpx;
		left: 0;
		top: 0;
	}
	.stat-count {
		font-size: 22rpx;
		color: rgba(255, 255, 255, 0.7);
		margin-left: 4rpx;
	}
	.divide{
		height: 2rpx;
		width: 100%;
		background: rgba(255, 255, 255, 0.15);
	}
	.bottomdesc{
		margin: 32rpx auto;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.5);
	}
	/* 骨架屏 */
	.skeleton-container {
		padding: 32rpx 8rpx;
	}
	.skeleton-tabs {
		display: flex;
		flex-direction: row;
		margin-bottom: 24rpx;
		padding: 0 8rpx;
	}
	.skeleton-tab {
		width: 128rpx;
		height: 42rpx;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 8rpx;
		margin-right: 16rpx;
	}
	.skeleton-photos {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		padding: 0 8rpx;
	}
	.skeleton-photo {
		width: 362rpx;
		height: 482rpx;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 8rpx;
		margin: 0 8rpx 8rpx 0;
	}
	.skeleton-photo:nth-child(2n) {
		margin: 0 0 8rpx;
	}
	@keyframes skeletonPulse {
		0% { opacity: 0.4; }
		50% { opacity: 0.8; }
		100% { opacity: 0.4; }
	}
	.skeleton-animate {
		animation: skeletonPulse 1.5s ease-in-out infinite;
	}
</style>
