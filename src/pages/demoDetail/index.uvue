		align-items: center;
		justify-content: center;
		padding: 200rpx var(--spacing-lg);
	}
	.empty-title {
		font-size: 32rpx;
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 16rpx;
	}
	.empty-desc {
		font-size: var(--font-size-body);
		color: rgba(255, 255, 255, 0.3);
	}
