<template>
	<view class="page">
		<!-- 自定义导航栏：搜索框常驻标题栏位置 -->
		<view class="custom-nav">
			<view :style="{height: statusBarHeight + 'px'}"></view>
			<view class="nav-content">
				<image class="back-btn" src="/static/back-arrow.svg" mode="aspectFit" @click="goBack"></image>
				<view class="search-bar-wrap">
				<view class="search-bar-nav">
					<image class="search-icon-small" src="/static/search.png" mode="aspectFit"></image>
					<input
						class="search-input-nav"
						type="text"
						placeholder="搜索客片"
						placeholder-style="color: var(--color-primary-70)"
						v-model="searchKeyword"
						confirm-type="search"
						@confirm="handleSearch"
					/>
				</view>
				</view>
			</view>
		</view>
		<!-- 占位 -->
		<view :style="{height: (statusBarHeight + 44) + 'px'}"></view>

		<!-- Loading 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-row" style="margin-bottom: 24rpx;">
				<view v-for="i in 4" :key="i" class="sk-tab sk-animate"></view>
			</view>
			<view class="sk-row" style="flex-wrap: wrap;">
				<view v-for="i in 6" :key="i" class="sk-photo-item sk-animate"></view>
			</view>
		</view>

		<!-- 主内容 -->
		<view v-else class="main-content">
			<!-- 搜索结果模式 -->
			<view v-if="isSearching" class="search-results">
				<view v-if="searchList.length === 0 && searchDone" class="empty-state">
					<view class="empty-title">暂无搜索结果</view>
					<view class="empty-desc">换个关键词试试吧</view>
				</view>
				<view v-else class="photolistContainer">
					<view
						v-for="(item, index) in searchList"
						:key="index"
						class="photoItem-wrap"
					>
						<view class="photoItem">
							<image :src="item.coverImageUrl" class="photo fade-in" mode="aspectFill" />
							<view class="mask" hover-class="press-dim"
					@click="gotoDetail(item)">
								<view class="desc">
									<view class="photoName font-noto-serif">{{ item.title }}</view>
									<view class="desc-row">
										<view class="collect">
											<image
												class="heart"
												mode="aspectFit"
												:src="item.liked ? '/static/liked.svg' : '/static/like.svg'"
											>
												<view class="clickArea" hover-class="press-dim"
					@click.stop="handleLike(item)"></view>
											</image>
											<text class="stat-count">{{ formatCount(item.likeCount || 0) }}</text>
										</view>
										<view v-if="item.tryonDisabled !== true" hover-class="press-dim"
					@click.stop="goToAiTryOn(item)">
											<image mode="aspectFit" class="ai-tryon-tag" src="/static/aitry-btn.png"/>
										</view>
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>
				<view v-if="searchList.length > 0 && !searchNoMore" class="load-more" @click="loadMoreSearch">
					<text class="load-more-text">{{ searchLoading ? '加载中...' : '加载更多' }}</text>
				</view>
				<view v-if="searchNoMore && searchList.length > 0" class="load-more">
					<text class="load-more-text">已经到底了</text>
				</view>
			</view>

			<!-- 正常分类模式 -->
			<view v-if="!isSearching && alltabs.length > 0">
				<!-- AI智能推荐入口 -->
				<view class="ai-recommend-banner" hover-class="press-dim"
					@click="goToAiRecommend">
					<image class="ai-recommend-bg" src="/static/ai-recom-banner.png" mode="aspectFill"></image>
					<view class="ai-recommend-content">
						<text class="ai-recommend-title font-noto-serif">AI智能推荐·拍照选服饰</text>
						<text class="ai-recommend-subtitle">上传照片，AI为您推荐最合适的服饰风格</text>
					</view>
				</view>
				<view class="cat-title-row">
					<text class="cat-title font-noto-serif">套系与子系分类</text>
					<view class="cat-title-deco-wrap">
						<image class="cat-title-deco" src="/static/category-title-line.png" mode="heightFix"></image>
					</view>
				</view>
				<view class="tabcontainer">
					<view
						v-for="(item, idx) in alltabs"
						:key="idx"
						:class="selectedTab.parentIndex === idx ? 'tab-wrap choosed-wrap' : 'tab-wrap'"
						hover-class="press-dim"
					@click="changeTab(idx, 'parent')"
					>
						<view :class="selectedTab.parentIndex === idx ? 'tab choosed font-noto-serif' : 'tab font-noto-serif'">{{item.parentName}}</view>
					</view>
				</view>
				<view class="tabcontainer">
					<view
						v-for="(item, idx) in getSecondTab"
						:key="idx"
						:class="selectedTab.childIndex === idx ? 'tab-wrap choosed-wrap' : 'tab-wrap'"
						hover-class="press-dim"
					@click="changeTab(idx, 'child')"
					>
						<view :class="selectedTab.childIndex === idx ? 'tab choosed font-noto-serif' : 'tab font-noto-serif'">{{item.name}}</view>
					</view>
				</view>
				<view class="photolistContainer">
					<view
						v-for="(item, index) in getCurPhotoList"
						:key="index"
						class="photoItem-wrap"
					>
						<view class="photoItem">
							<image :src="item?.coverImageUrl" class="photo fade-in" mode="aspectFill" />
							<view class="mask" hover-class="press-dim"
					@click="gotoDetail(item)">
								<view class="desc">
									<view class="photoName font-noto-serif">{{ item?.title }}</view>
									<view class="desc-row">
										<view class="collect">
											<image
												class="heart"
												mode="aspectFit"
												:src="item.liked ? '/static/liked.svg' : '/static/like.svg'"
											>
												<view class="clickArea" hover-class="press-dim"
					@click.stop="handleLike(item)"></view>
											</image>
											<text class="stat-count">{{ formatCount(item.likeCount || 0) }}</text>
										</view>
										<view v-if="item?.tryonDisabled !== true" hover-class="press-dim"
					@click.stop="goToAiTryOn(item)">
											<image mode="aspectFit" class="ai-tryon-tag" src="/static/aitry-btn.png"/>
										</view>
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>
				<!-- 分类模式加载更多提示 -->
				<view v-if="getCurPhotoList.length > 0 && !albumNoMore" class="load-more" @click="loadMoreAlbum">
					<text class="load-more-text">{{ albumLoading ? '加载中...' : '加载更多' }}</text>
				</view>
				<view v-if="getCurPhotoList.length > 0 && albumNoMore" class="load-more">
					<text class="load-more-text">已经到底了</text>
				</view>
			</view>

			<view class="page-footer">
				<view class="divide"></view>
				<view class="bottomdesc"><AppFooter /></view>
			</view>
		</view>

		<!-- 登录弹窗 -->
		<LoginPopup
	v-if="showLoginPopup"
	:agreement-checked="loginAgreementChecked"
	:user-agreement-name="userAgreementName"
	:privacy-policy-name="privacyPolicyName"
	@close="closeLoginPopup"
	@toggle-agreement="toggleLoginAgreement"
	@show-toast="showLoginAgreementToast"
	@open-user="openUserAgreement"
	@open-privacy="openPrivacyPolicy"
	@get-phone="onGetPhoneNumber"
/>

		<!-- 头像昵称授权弹窗 -->
		<ProfilePopup
	v-if="showProfilePopup"
	:avatar-url="profileAvatarUrl"
	:nickname="profileNickname"
	@choose-avatar="onChooseAvatar"
	@update-nickname="(v: string) => { this.profileNickname = v }"
	@submit="submitProfile"
	@skip="skipProfile"
/>
	</view>
</template>

<script>
	import { getCategories, getAlbumList, toggleLike, getLikeStatus, wxLogin, wxBindPhone, wxUpdateUserInfo, rejectAllPendingUploads } from '../../utils/api.uts'
	import { isLoggedIn, loginSuccess, setUserInfo, mergeUserInfo, getUserInfo, consumeLoginExpired } from '../../utils/auth.uts'
	import { runPhoneLogin } from '../../utils/loginFlow.uts'
	import { submitUserProfile } from '../../utils/profileSubmit.uts'
	import { rejectAllPending } from '../../utils/http.uts'
	import {
		USER_AGREEMENT_NAME,
		PRIVACY_POLICY_NAME,
		openUserAgreement,
		openPrivacyPolicy
	} from '../../utils/legal.uts'
	import { formatCount as _formatCount } from '../../utils/format.uts'
	import { preloadImage as _preloadImage, preloadImages as _preloadImages } from '../../utils/imageLoader.uts'

	export default {
		data() {
			return {
				idx: '',
				from: '',
				statusBarHeight: 20,
				loading: true, // 页面加载状态
				selectedTab: {
					parentIndex: 0,
					childIndex: 0
				},
				alltabs: [],
				// 分类模式：客片列表 & 分页
				albumList: [],
				albumTotal: 0,
				albumPage: 1,
				albumSize: 10,
				albumNoMore: false,
				albumLoading: false,
				// 搜索相关
				isSearching: false,
				searchKeyword: '',
				searchDone: false,
				searchList: [],
				searchPage: 1,
				searchSize: 10,
				searchLoading: false,
				searchNoMore: false,
				// 登录弹窗
				showLoginPopup: false,
				loginAgreementChecked: false,
				userAgreementName: USER_AGREEMENT_NAME,
				privacyPolicyName: PRIVACY_POLICY_NAME,
				pendingLikeItem: null, // 等待点赞的客片项
				// 头像昵称授权弹窗
				showProfilePopup: false,
				profileAvatarUrl: '',
				profileNickname: ''
			}
		},
		computed: {
			getSecondTab() {
				const parent = this.alltabs[this.selectedTab.parentIndex]
				if (!parent) return []
				return parent.subCategory || []
			},
			getCurPhotoList() {
				return this.albumList
			},
		},
		onShareAppMessage() {
			const list = this.getCurPhotoList
			const cover = list.length > 0 && list[0].coverImageUrl ? list[0].coverImageUrl : ''
			return {
				title: '蓝梅旅拍 · 客片欣赏',
				path: this.idx ? `/pages/demoDetail/index?idx=${this.idx}` : '/pages/index/index',
				imageUrl: cover
			}
		},
		onLoad(query) {
			const systemInfo = uni.getSystemInfoSync()
			this.statusBarHeight = systemInfo.statusBarHeight || 20
			// 小程序码扫码进入时，参数在 scene 字段中（如 scene=idx%3D1）
			let idx = query?.idx ?? ''
			if (idx === '' && query?.scene != null && query!.scene !== '') {
				const scene = decodeURIComponent(query!.scene as string)
				const pairs = scene.split('&')
				for (let i = 0; i < pairs.length; i++) {
					const kv = pairs[i].split('=')
					if (kv.length === 2 && kv[0] === 'idx') {
						idx = kv[1]
					}
				}
			}
			this.idx = idx
			this.from = query?.from ?? ''
			this.initPage(idx)
		},
		onShow() {
			// 监听 401 登录过期事件，自动拉起登录弹窗
			uni.$off('login-required')
			uni.$on('login-required', () => {
				this.showLoginPopup = true
			})
			// 兑底：其他页面触发 401 后导航回来时自动弹出
			if (consumeLoginExpired()) {
				this.showLoginPopup = true
			}
			const list = this.getCurPhotoList
			if (Array.isArray(list) && list.length > 0) {
				this.refreshLikeStatus(list)
			}
		},
		onHide() {
			uni.$off('login-required')
		},
		// 滚动触底加载更多
		onReachBottom() {
			if (this.isSearching && !this.searchNoMore && !this.searchLoading) {
				// 搜索模式
				this.loadMoreSearch()
			} else if (!this.isSearching && !this.albumNoMore && !this.albumLoading) {
				// 分类模式
				this.loadMoreAlbum()
			}
		},
		methods: {
			goBack() {
				if (this.searchKeyword.trim()) {
					// 搜索框有值：清空搜索并恢复分类模式
					this.searchKeyword = ''
					this.isSearching = false
					this.searchList = []
					this.searchDone = false
					this.searchPage = 1
					this.searchNoMore = false
					// 重新加载分类数据
					this.albumPage = 1
					this.albumNoMore = false
					this.albumList = []
					this.fetchAlbumList(1)
				} else {
					uni.navigateBack()
				}
			},
			// ====== 图片预加载工具方法（转发至 utils/imageLoader） ======
			preloadImage(url) {
				return _preloadImage(url)
			},
			// 预加载一组图片，带超时保护（避免无限等待）
			async preloadImages(urls, timeout = 5000) {
				return _preloadImages(urls, timeout)
			},
			// ====== 初始化：先加载分类，再加载第一页客片 ======
			async initPage(shopId) {
				if (!shopId) {
					this.loading = false
					return
				}
				try {
					this.loading = true
					// 1. 获取分类
					const catRes = await getCategories(shopId)
					const catSuccess = catRes && (catRes.code === 0 || catRes.code === 200)
					if (!catSuccess || !catRes.data || !Array.isArray(catRes.data)) {
						this.alltabs = []
						return
					}
					this.alltabs = catRes.data
					if (this.alltabs.length === 0) return

					// 2. 默认选中第一个分类（索引方式）
					this.selectedTab = {
						parentIndex: 0,
						childIndex: 0
					}
					console.log('[initPage] selectedTab:', JSON.stringify(this.selectedTab))

					// 3. 加载第一页客片
					await this.fetchAlbumList(1)

					// 4. 预加载首屏封面图（最多前6张），图片缓存就绪后再隐藏骨架屏
					const coverUrls = this.albumList
						.slice(0, 6)
						.map(item => item.coverImageUrl)
						.filter(Boolean)
					await this.preloadImages(coverUrls, 2000)
				} catch (err) {
					console.error('初始化页面失败:', err)
					this.alltabs = []
				} finally {
					this.loading = false
				}
			},
			// ====== 获取客片列表（分类模式） ======
			async fetchAlbumList(page) {
				try {
					const parent = this.alltabs[this.selectedTab.parentIndex]
					const child = parent?.subCategory?.[this.selectedTab.childIndex]
					if (!child || !child.query) {
						this.albumList = []
						this.albumNoMore = true
						return
					}
					const res = await getAlbumList({
						shopId: this.idx,
						...child.query,
						page: page,
						size: this.albumSize
					})
					const albumSuccess = res && (res.code === 0 || res.code === 200)
					if (albumSuccess && res.data) {
						const newAlbums = res.data.albums || []
						if (page === 1) {
							this.albumList = newAlbums
						} else {
							this.albumList = this.albumList.concat(newAlbums)
						}
						this.albumTotal = res.data.total || 0
						this.albumPage = res.data.page || page

						// 判断是否还有更多
						const totalPages = Math.ceil(this.albumTotal / this.albumSize)
						if (this.albumPage >= totalPages || newAlbums.length < this.albumSize) {
							this.albumNoMore = true
						}
						// 新接口已返回 liked 字段，无需再批量刷新
					} else {
						if (page === 1) this.albumList = []
						this.albumNoMore = true
					}
				} catch (err) {
					console.error('获取客片列表失败:', err)
					if (page === 1) this.albumList = []
					this.albumNoMore = true
				}
			},
			// 搜索：键盘搜索按钮触发
			async handleSearch() {
				const keyword = this.searchKeyword.trim()
				if (!keyword) {
					// 搜索词为空，退出搜索模式
					this.isSearching = false
					this.searchList = []
					this.searchDone = false
					this.searchPage = 1
					this.searchNoMore = false
					return
				}
				this.isSearching = true
				this.searchPage = 1
				this.searchNoMore = false
				this.searchList = []
				this.searchDone = false
				await this.doSearch(keyword, 1)
				this.searchDone = true
			},
			// 清除搜索，回到分类模式
			clearSearch() {
				this.searchKeyword = ''
				this.isSearching = false
				this.searchList = []
				this.searchDone = false
				this.searchPage = 1
				this.searchNoMore = false
			},
			// 搜索也使用新的 getAlbumList 接口（传 keyword）
			async doSearch(keyword, page) {
				if (this.searchLoading) return
				try {
					this.searchLoading = true
					const parent = this.alltabs[this.selectedTab.parentIndex]
					const child = parent?.subCategory?.[this.selectedTab.childIndex]
					const queryObj = (child && child.query) ? child.query : {}
					const res = await getAlbumList({
						shopId: this.idx,
						...queryObj,
						keyword: keyword,
						page: page,
						size: this.searchSize
					})
					const searchSuccess = res && (res.code === 0 || res.code === 200)
					if (searchSuccess && res.data) {
						const dataList = res.data.albums || []
						if (page === 1) {
							this.searchList = dataList
						} else {
							this.searchList = this.searchList.concat(dataList)
						}
						// 判断是否还有更多数据
						const total = res.data.total || 0
						const totalPages = Math.ceil(total / this.searchSize)
						if (page >= totalPages || dataList.length < this.searchSize) {
							this.searchNoMore = true
						}
						this.searchPage = page
					} else {
						if (page === 1) this.searchList = []
						this.searchNoMore = true
					}
				} catch (err) {
					console.error('搜索失败:', err)
					uni.showToast({ title: '搜索失败', icon: 'none' })
				} finally {
					this.searchLoading = false
				}
			},
			async loadMoreSearch() {
				if (this.searchNoMore || this.searchLoading) return
				await this.doSearch(this.searchKeyword.trim(), this.searchPage + 1)
			},
			// 分类模式加载更多
			async loadMoreAlbum() {
				if (this.albumNoMore || this.albumLoading) return
				if (this.alltabs.length === 0) return

				this.albumLoading = true
				const nextPage = this.albumPage + 1

				try {
					await this.fetchAlbumList(nextPage)
				} catch (err) {
					console.error('加载更多客片失败:', err)
					uni.showToast({ title: '加载失败', icon: 'none' })
				} finally {
					this.albumLoading = false
				}
			},
			// 从云端刷新点赞状态 — 仅登录用户才请求（onShow 时使用）
			async refreshLikeStatus(list) {
				if (!isLoggedIn()) return
				if (!Array.isArray(list) || list.length === 0) return
				const ids = list.map(item => item.id).filter(id => id != null)
				if (ids.length === 0) return
				const albumIds = ids.join(',')
				try {
					const likeRes = await getLikeStatus(albumIds).catch(() => null)
					if (likeRes && likeRes.code === 200 && likeRes.data) {
						likeRes.data.forEach(item => {
							const target = list.find(p => p.id === item.albumId)
							if (target) {
								target.liked = item.liked
								target.likeCount = item.likeCount
							}
						})
					}
				} catch (err) {
					console.warn('获取点赞状态失败:', err)
				}
			},
			changeTab(index, pos) {
				if (pos === 'parent') {
					this.selectedTab = {
						parentIndex: index,
						childIndex: 0
					}
				}
				if (pos === 'child') {
					this.selectedTab = {
						...this.selectedTab,
						childIndex: index
					}
				}
				// 切换分类时重置分页并重新加载
				this.albumPage = 1
				this.albumNoMore = false
				this.albumList = []
				this.fetchAlbumList(1)
			},
			// 点赞（点赞=收藏，复用原有心形交互）
			async handleLike(item) {
				if (!item?.id) return
				if (!isLoggedIn()) {
					// 未登录，保存待点赞项并弹出登录弹窗
					this.pendingLikeItem = item
					this.showLoginPopup = true
					return
				}
				await this.doToggleLike(item)
			},
			// 执行点赞切换
			async doToggleLike(item) {
				try {
					const res = await toggleLike(item.id)
					if (res.code === 200 && res.data) {
						item.liked = res.data.liked
						item.likeCount = res.data.likeCount
					}
				} catch (err) {
					console.error('点赞失败:', err)
					uni.showToast({ title: '操作失败', icon: 'none' })
				}
			},
			async doLogin() {
				try {
					const loginRes = await uni.login({ provider: 'weixin' })
					if (loginRes.code) {
						const res = await wxLogin({ code: loginRes.code })
						if (res.code === 200 && res.data) {
							loginSuccess(res.data.token, res.data.userInfo)
							uni.showToast({ title: '登录成功', icon: 'success' })
						} else {
							uni.showToast({ title: res.message || '登录失败', icon: 'none' })
						}
					}
				} catch (err) {
					console.error('登录失败:', err)
				}
			},
			gotoDetail(item) {
				const parent = this.alltabs[this.selectedTab.parentIndex]
				const child = parent?.subCategory?.[this.selectedTab.childIndex]
				const category = (parent?.parentName === '全部') ? '' : (parent?.id ?? '')
				const subCategory = (child?.name === '全部') ? '' : (child?.query?.childId ?? '')
				uni.navigateTo({
					url: `/pages/targetPhotoDetail/index?idx=${item.id}&liked=${item.liked}&type=${this.idx}&category=${category}&subCategory=${subCategory}&style=${encodeURIComponent(item.title || '')}`
				})
			},
			goToAiTryOn(item) {
				const parent = this.alltabs[this.selectedTab.parentIndex]
				const child = parent?.subCategory?.[this.selectedTab.childIndex]
				const category = (parent?.parentName === '全部') ? '' : (parent?.id ?? '')
				const subCategory = (child?.name === '全部') ? '' : (child?.query?.childId ?? '')
				const shopId = this.idx
				const style = encodeURIComponent(item.title || '')
				uni.navigateTo({
					url: `/pages/aiTryOn/index?albumId=${item.id}&shopId=${shopId}&category=${category}&subCategory=${subCategory}&style=${style}`
				})
			},
			goToAiRecommend() {
				uni.navigateTo({
					url: `/pages/aiRecommend/index?shopId=${this.idx}`
				})
			},
			formatCount(count) {
				return _formatCount(count)
			},
			// 关闭登录弹窗
			closeLoginPopup() {
				this.showLoginPopup = false
				this.loginAgreementChecked = false
				this.pendingLikeItem = null
				// 用户主动取消登录，reject 所有挂起的 401 请求
				rejectAllPending()
				rejectAllPendingUploads()
			},
			toggleLoginAgreement() {
				this.loginAgreementChecked = !this.loginAgreementChecked
			},
			showLoginAgreementToast() {
				uni.showToast({ title: '请先同意用户协议和隐私政策', icon: 'none' })
			},
			openUserAgreement() {
				openUserAgreement()
			},
			openPrivacyPolicy() {
				openPrivacyPolicy()
			},
			// 手机号授权回调
			async onGetPhoneNumber(e) {
				if (!this.loginAgreementChecked) {
					this.showLoginAgreementToast()
					return
				}
				const detail = e.detail || {}
				// 用户拒绝授权
				if (detail.errMsg && detail.errMsg !== 'getPhoneNumber:ok') {
					if (detail.errMsg.indexOf('deny') !== -1 || detail.errMsg.indexOf('cancel') !== -1) {
						uni.showToast({ title: '已取消授权', icon: 'none' })
					} else {
						console.error('手机号授权失败:', detail.errMsg)
						uni.showToast({ title: '授权失败，请重试', icon: 'none' })
					}
					this.closeLoginPopup()
					return
				}

				const phoneCode = detail.code
				if (!phoneCode) {
					console.error('未获取到 phoneCode，detail:', JSON.stringify(detail))
					uni.showToast({ title: '获取手机号失败，请检查小程序认证状态', icon: 'none' })
					this.closeLoginPopup()
					return
				}

				try {
					uni.showLoading({ title: '登录中...', mask: true })
					// 登录三步骤已下沉到 utils/loginFlow.uts
					const result = await runPhoneLogin(phoneCode)
					uni.hideLoading()

					if (!result.ok) {
						if (result.errorKind === 'login') {
							uni.showToast({ title: '获取登录凭证失败', icon: 'none' })
						} else {
							uni.showToast({ title: result.errorMsg || '登录失败', icon: 'none' })
						}
						this.closeLoginPopup()
						return
					}

					// 关闭手机号登录弹窗
					this.showLoginPopup = false
					if (result.phoneHasFullProfile) {
						// 后端已带头像昵称 → 直接登录完成 + 执行 pendingLikeItem
						uni.showToast({ title: '登录成功', icon: 'success' })
						if (this.pendingLikeItem) {
							await this.doToggleLike(this.pendingLikeItem)
							this.pendingLikeItem = null
						}
					} else {
						// 缺头像或昵称 → 弹出授权弹窗补齐
						this.openProfilePopup()
					}
				} catch (err) {
					uni.hideLoading()
					console.error('登录失败:', err)
					uni.showToast({ title: '登录失败，请重试', icon: 'none' })
				}
			},

			// 打开头像昵称授权弹窗
			openProfilePopup() {
				const info = getUserInfo()
				this.profileAvatarUrl = info?.avatarUrl || ''
				this.profileNickname = info?.nickname || ''
				this.showProfilePopup = true
			},

			// 用户选择头像回调
			onChooseAvatar(e) {
				const url = e?.detail?.avatarUrl
				if (url) this.profileAvatarUrl = String(url)
			},

			// 提交头像昵称：调用 POST /api/wx/userinfo 更新后台用户信息
			// 不再调用 wxLogin，避免刷新 token 与覆盖其他字段
			async submitProfile() {
				const nickname = (this.profileNickname || '').trim()
				const avatarUrl = this.profileAvatarUrl || ''
				// 两项都未填，等同跳过
				if (nickname === '' && avatarUrl === '') {
					this.skipProfile()
					return
				}
				try {
					uni.showLoading({ title: '更新中...', mask: true })
					const result = await submitUserProfile({
						nickname: nickname !== '' ? nickname : undefined,
						avatarUrl: avatarUrl !== '' ? avatarUrl : undefined
					})
					uni.hideLoading()
					if (!result.ok) {
						uni.showToast({ title: result.errorMsg || '更新失败', icon: 'none' })
					}
				} catch (err) {
					console.error('更新头像昵称失败:', err)
					uni.hideLoading()
					uni.showToast({ title: '更新失败，请重试', icon: 'none' })
				} finally {
					await this.finishProfile()
				}
			},

			skipProfile() {
				this.finishProfile()
			},

			async finishProfile() {
				this.showProfilePopup = false
				this.profileAvatarUrl = ''
				this.profileNickname = ''
				uni.showToast({ title: '登录成功', icon: 'success' })
				// 登录成功后，执行待处理的点赞操作
				if (this.pendingLikeItem) {
					await this.doToggleLike(this.pendingLikeItem)
					this.pendingLikeItem = null
				}
			}
		}
	}
</script>

<style>
	.page {
