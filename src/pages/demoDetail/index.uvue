<template>
	<view class="page">
		<view class="title">套餐与子系分类：</view>
		<view class="tabcontainer">
			<view
			  v-for="(item, idx) in alltabs"
			  :key="idx"
			  :class="selectedTab.parentTab === item.id ? 'tab choosed': 'tab'"
			  @click="changeTab(item.id, 'parent')"
			>
				{{item.parentName}}
			</view>
		</view>
		<view class="tabcontainer">
			<view
			  v-for="(item, idx) in getSecondTab"
			  :key="idx"
			  :class="selectedTab.childTab === item.id ? 'tab choosed': 'tab'"
			  @click="changeTab(item.id, 'child')"
			>
				{{item.name}}
			</view>
		</view>
		<view class="photolistContainer">
			<view
			  v-for="(item, index) in getCurPhotoList"
			  :key="index"
			  class="photoItem"
			>
				<image :src="item?.coverImageUrl" class="photo" mode="aspectFill" />
				<view class="mask" @click="gotoDetail(item)">
					<view class="desc">
						<view class="photoName">{{ item?.title }}</view>
						<view class="collect">
					    <image
							class="heart"
							mode="aspectFit"
							:src="item.liked ? '/static/liked.svg' : '/static/like.svg'"
						>
							<view class="clickArea" @click.stop="handleCollect(item)"></view>
						</image>
							<!-- <view>123万</view> -->
						</view>
					</view>
				</view>
			</view>
		</view>
		<view class="divide"></view>
		<view class="bottomdesc">Copyright 2025 蓝梅旗袍·汉服·民族服体验馆 - 版权所有</view>
	</view>

</template>

<script>
	import { getalbum } from '../../utils/api'
	export default {
		data() {
			return {
				idx: '', // 门店
				from: '',
				selectedTab: {
					parentTab: '',
					childTab: ''
				},
				alltabs: []
			}
		},
		computed: {
			getSecondTab() {
				return this.alltabs.filter(item => item.id === this.selectedTab.parentTab)[0].subCategory
			},
			getCurPhotoList() {
				const curtab = this.alltabs.filter(item => item.id === this.selectedTab.parentTab)[0].subCategory
				const list = curtab.filter(item => item.id === this.selectedTab.childTab)[0].albumList || []
				return list
			},
		},
		onLoad(query) {
			this.idx = query?.idx ?? ''
			this.from = query?.from ?? ''
			this.getAlbumInfo(query?.idx || '')
		},
		onShow() {
			const list = this.getCurPhotoList
			if (Array.isArray(list)) {
				this.refreshLikeStatus(list)
			}
		},
		methods: {
			async getAlbumInfo (id: string) {
				if (!id) return
				const res = await getalbum('get', {
					type: id
				})
				const { code, data } = res
				if (code !== 200) return
				this.alltabs = data.alltabs
				this.selectedTab = {
					parentTab: data.alltabs[0]?.id,
					childTab: data.alltabs[0]?.subCategory[0]?.id
				}
			},
			refreshLikeStatus(list) {
				if (!Array.isArray(list) || list.length === 0) return
				// 先重置，再根据存储置 true，避免“只增不减”造成的假象
				list.forEach(item => { item.liked = false })
				uni.getStorage({
					key: 'collectList',
					success: (res) => {
						let value = []
						if (Array.isArray(res.data)) {
							value = res.data
						} else if (res.data && Array.isArray(res.data.value)) {
							value = res.data.value
						}
						if (!Array.isArray(value)) value = []
						list.forEach(item => {
							if (value.includes(item.title)) {
								item.liked = true
							}
						})
					},
					fail: () => {
						// 无存储时保持全 false
					}
				})
			},
			changeTab(id, pos) {
				if (pos === 'parent') {
					const target = this.alltabs.filter(item => item.id === id)[0]
					this.selectedTab = {
						parentTab: id,
						childTab: target.subCategory[0].id
					}
				}
				if (pos === 'child') {
					const list = this.alltabs.filter(item => item.id === this.selectedTab.parentTab)[0]?.subCategory
					const target = list.filter(item => item.id === id)[0]
					this.selectedTab = {
						...this.selectedTab,
						childTab: target.id
					}
				}
				// 选项变化后刷新一次收藏态
				this.$nextTick(() => {
					const list = this.getCurPhotoList
					if (Array.isArray(list)) {
						this.refreshLikeStatus(list)
					}
				})
			},
			handleCollect(item) {
				const title = item?.title
				if (!title) {
					uni.showToast({ title: '无效的标题', icon: 'none' })
					return
				}
				uni.getStorage({
					key: 'collectList',
					success: (res) => {
						let value = []
						if (Array.isArray(res.data)) {
							value = res.data
						} else if (res.data && Array.isArray(res.data.value)) {
							value = res.data.value
						}
						if (!value.includes(title)) {
							value.push(title)
							uni.setStorage({
								key: 'collectList',
								data: { id: 'list', value },
								success: () => {
									item.liked = true
								}
							})
							return;
						}
						const newlist = value.filter(item => item !== title) ?? []
						uni.setStorage({
							key: 'collectList',
							data: { id: 'list', value: newlist },
							success: () => {
								item.liked = false
							}
						})
					},
					fail: () => {
						const value = [title]
						uni.setStorage({
							key: 'collectList',
							data: { id: 'list', value },
							success: () => {
								item.liked = true
							}
						})
					}
				})
			},
			gotoDetail(item) {
				uni.navigateTo({
					url: `/pages/targetPhotoDetail/index?from=banner&idx=${item.id}&liked=${item.liked}&type=${this.idx}`
				})
			},
		}
	}
</script>

<style>
	.page {
		background: #000;
		height: 100%;
		overflow-y: scroll;
	}
	.title{
		color: rgba(255, 255, 255, 0.5);
		font-size: 24rpx;
		margin: 8rpx 32rpx;
	}
	.tabcontainer{
		width: 100%;
		overflow-x: scroll;
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.tab{
		margin-left: 8rpx;
		margin-bottom: 16rpx;
		width: 128rpx;
		height: 42rpx;
		text-align: center;
		line-height: 42rpx;
		font-size: 28rpx;
		color: rgba(255, 255, 255, 0.5);
		flex-shrink: 0;
		min-width: 128rpx;
	}
	.choosed{
		color: rgba(255, 255, 255, 0.9);
		font-size: 32rpx;
		font-weight: 500;
	}

	.photolistContainer{
		margin: 16rpx 8rpx;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}
	.photoItem{
		width: 362rpx;
		height: 482rpx;
		margin: 0 8rpx 8rpx 0;
		position: relative;
	}
	.photoItem:nth-child(2n){
		margin: 0 0 8rpx;
	}
	.photo{
		width: 100%;
		height: 100%;
		border-radius: 8rpx;
	}
	.mask {
		position: absolute;
		width: 362rpx;
		height: 482rpx;
		top: 0;
		left: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.4) 75%, rgba(0, 0, 0, 0.7) 89%, #000000 100%);
	}
	.desc{
		margin: 436rpx 16rpx 0;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}
	.photoName{
		font-size: 28rpx;
		font-weight: 500;
		color: #fff;
	}
	.collect{
		display: flex;
		align-items: center;
		font-size: 24rpx;
		color: #fff;
	}
	.heart{
		width: 48rpx;
		height: 40rpx;
		position: relative;
	}
	.clickArea{
		position: absolute;
		width: 60rpx;
		height: 60rpx;
		left: 0;
		top: 0;
	}
	.divide{
		height: 2rpx;
		width: 100%;
		background: rgba(255, 255, 255, 0.15);
	}
	.bottomdesc{
		margin: 32rpx auto;
		font-size: 20rpx;
		color: rgba(255, 255, 255, 0.5);
	}
</style>