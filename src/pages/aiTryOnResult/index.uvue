<template>
	<view class="page">
		<CustomNavBar :title="navTitle" :back-fallback-url="'/pages/index/index'" />

		<!-- 加载态 -->
		<view v-if="status === 'processing'" class="center-content">
			<view class="loading-wrapper">
				<!-- 生成等待体验优化（2026-09-14 主人指示）：伪进度三步条替代倒计时 + Tips + 底部双按钮 -->
				<view v-if="!shareReadOnly" class="gen-panel">
					<view class="gen-tips">离开当前页也会继续生成，完成后将会通知您</view>
					<GenerationProgress :steps="progressSteps" :active-index="currentProgressStep" :percent="progressPercent" />
					<view class="gen-actions">
						<button class="gen-btn" hover-class="press-dim" @click="goBrowseAlbums">逛逛其他客片</button>
						<button class="gen-btn" hover-class="press-dim" @click="goGenerationQueue">查看生成队列</button>
					</view>
				</view>
				<!-- 只读分享落地：他人作品生成中，保持轻提示 -->
				<view v-else class="gen-panel">
					<view class="loading-spinner"></view>
					<text class="loading-tip">作品正在生成中，请稍后再来</text>
				</view>
			</view>
		</view>

		<!-- 成功态 -->
		<view v-if="status === 'completed'" class="result-content">
			<view class="result-image-wrapper">
				<image
					class="result-image image-fade fade-in"
					:class="{ 'image-visible': imageLoaded }"
					:src="resultImageUrl"
					mode="widthFix"
					@load="onImageLoad"
				></image>
				<!-- 图片区全屏水印（小程序内部/只读/单页模式统一，2026-09-14 主人指示）：
				     仅视觉覆盖，付费保存下载的是原图 URL，绝不含水印 -->
				<view class="wm-layer">
					<view v-for="i in 24" :key="i" class="wm-item">{{ watermarkText }}</view>
				</view>
			</view>
			<!-- 分享落地只读：仅结果图 + 「我也要试」（bug #8 只读模式） -->
			<view v-if="shareReadOnly" class="action-bar">
				<view class="btn-primary" hover-class="press-dim" @click="tryThisOut">
					<text>我也要试</text>
				</view>
			</view>
			<view v-else class="action-bar">
				<!-- 付费模式且无剩余次数且未买断：价格按钮，点击直接拉起支付（已买断永久免费保存） -->
				<view v-if="isPaidMode && creditBalance <= 0 && !taskBought" class="save-btn-wrap">
					<view class="btn-primary" hover-class="press-dim"
					@click="saveToAlbum">
						<text>¥{{ priceText }}</text>
						<text> 保存到相册</text>
					</view>
				</view>
				<!-- 非付费模式或有剩余次数：原按钮，有次数时右上角展示角标 -->
				<view v-else class="save-btn-wrap">
					<view class="btn-primary" hover-class="press-dim"
					@click="saveToAlbum">
						<text>保存到相册</text>
					</view>
					<view v-if="isPaidMode && (creditBalance > 0 || taskBought)" class="save-btn-badge">
						<text class="save-btn-badge-text">{{ taskBought ? '已解锁 · 永久保存' : '限时免费 ' + creditBalance + ' 次' }}</text>
					</view>
				</view>
				<button class="share-btn btn-secondary" open-type="share" hover-class="press-dim">分享</button>
				<button class="share-btn btn-secondary" @click="guideShareTimeline" hover-class="press-dim">
					<image class="moments-icon" src="/static/friend_circle.svg" mode="aspectFit"></image>
				</button>
			</view>
		</view>

		<!-- 失败态 -->
		<view v-if="status === 'failed'" class="center-content">
			<view class="fail-wrapper">
				<!-- 分享落地只读：不显示重试，仅友好提示 + 「我也要试」 -->
				<text v-if="shareReadOnly" class="fail-text">该作品暂不可查看</text>
				<!-- 失败文案保持通用：后端 error_message 仅记 console 日志，避免向用户泄露内部错误（CR 🟡） -->
				<text v-else-if="failCount >= 3" class="fail-text">当前服务繁忙，请稍后再试</text>
				<text v-else class="fail-text">生成失败，请重试</text>
				<view v-if="!shareReadOnly && failCount < 3" class="retry-btn" hover-class="press-dim"
					@click="handleRetry">
					<text class="retry-btn-text">重试</text>
				</view>
				<view v-if="shareReadOnly" class="btn-primary" hover-class="press-dim" @click="tryThisOut">
					<text>我也要试</text>
				</view>
				<view class="back-btn-wrapper" hover-class="press-dim"
					@click="handleBack">
					<text class="back-btn-text">返回</text>
				</view>
			</view>
		</view>

		<!-- 底部 Copyright -->
		<view class="page-footer">
			<view class="divide"></view>
			<view class="bottomdesc"><AppFooter /></view>
		</view>

		<!-- 分享准备中 loading（点击分享后生成封面期间展示） -->
		<view v-if="sharePreparing" class="share-preparing-mask">
			<view class="share-preparing-card">
				<LoadingBlock text="正在准备分享…" />
			</view>
		</view>
	</view>
</template>

<script lang="uts">
import { getAiTryOnResult, getSharedAiTryOnResult, downloadAiTryOnResult, createCreditRecharge, getCreditRechargeStatus, getCreditBalance, getShops } from '../../utils/api.uts'
import { isLoggedIn } from '../../utils/auth.uts'
import { getBrandId, setBrandId } from '../../utils/brand.uts'
import { generateFaceCenteredCard } from '../../utils/faceShareCard.uts'
import GenerationProgress from '../../components/GenerationProgress/GenerationProgress.uvue'
import { cosThumb, cosThumbJpg } from '../../utils/imageLoader.uts'

export default {
	components: { GenerationProgress },
	data() {
		return {
			taskId: '',
			// 分享落地只读模式（B 用户从分享卡片进入，匿名查看 A 的试衣作品）
			shareReadOnly: false,
			shareToken: '',
			isTimelinePage: false,   // 朋友圈单页模式（scene 1154，禁跳页）
			taskErrorMessage: '',    // 失败文案（后端 error_message 兜底展示）
			// 自定义导航栏标题：生成完成后由“正在生成”切换为“AI试衣结果”
			navTitle: '正在生成',
			status: 'processing' as string,  // 'pending' | 'processing' | 'completed' | 'failed'
			resultImageUrl: '',
			failCount: 0,
			pollErrorStreak: 0,   // 连续网络异常计数（容忍 3 次抖动，避免单次闪断即打断等待）
			progressDone: false,    // 任务完成时置真 → 伪进度走满 100%（主人指示：不得任务结束仍停在中间步骤）
			pollingTimer: null as any,
			elapsedSeconds: 0,
			countdownTimer: null as any,
			imageLoaded: false,
			shopId: '',
			isSaving: false,     // 保存流程防重入（扣费+下载保存期间拦截重复点击）
			creditBalance: -1,        // 下载池剩余次数，-1 = 未查询到
			priceFenPerCredit: 0,     // 单次价格（分），0 = 未开通付费购买（非付费模式）
			taskBought: false,        // 该任务是否已永久买断（付款一次后无限次免费保存）
			creditLoaded: false,      // 是否已成功查询到余额
			// 下载次数不足（4001）时的充值支付
			isPaying: false,
			payPollToken: 0,      // 到账轮询会话标记，自增即失效
			// 分享（人脸居中 5:4 封面卡片）
			shareCardImage: '',
			shareCardReady: false,
			sharePreparing: false,   // 点击分享后生成封面中（UI 展示 loading+正在准备分享）
			styleName: '',
			shopName: '',
			albumId: '',
			templateId: 0
		}
	},
	computed: {
		// 付费模式：已查询到余额且商户配置了单次价格
		isPaidMode(): boolean {
			return this.creditLoaded && this.priceFenPerCredit > 0
		},
		// 图片区全屏水印文案：蓝梅AI + 商家名 + 固定提示（商家名缺失时退化为品牌+提示）
		watermarkText(): string {
			if (this.shopName !== '') {
				return `蓝梅AI · ${this.shopName} · AI试衣效果 仅供预览`
			}
			return '蓝梅AI · AI试衣效果 仅供预览'
		},
		// 生成等待伪进度：百分比封顶 99%，完成时 progressDone → 100（主人指示：可卡 99 但不得任务结束仍停中间步骤）
		progressPercent(): number {
			if (this.progressDone) return 100
			// 异步任务约 30–60s：按 45s 走满 99%
			const p = Math.floor(this.elapsedSeconds / 45 * 100)
			return p > 99 ? 99 : p
		},
		// 当前步骤下标：按百分比推进（4 步：分析照片面部细节/分析五官类型/正在面部匹配/生成图像）
		currentProgressStep(): number {
			const p = this.progressPercent
			if (p < 20) return 0
			if (p < 45) return 1
			if (p < 75) return 2
			return 3
		},
		// 四步动态文案（试衣版）：已完成显示「完毕」文案，当前/未到显示进行中文案
		progressSteps(): string[] {
			const base = ['分析照片面部细节', '分析五官类型', '正在匹配面部', '生成试衣图像']
			const done = ['照片面部细节分析完毕', '五官类型分析完毕', '面部匹配完成', '试衣图像生成完毕']
			// CR 🔴：computed 是属性不是函数，必须属性访问（否则运行期 TypeError）
			const cur = this.currentProgressStep
			const list: string[] = []
			for (let i = 0; i < 4; i++) {
				list.push(i < cur ? done[i] : base[i])
			}
			return list
		},
		// 单次价格文案（分 → 元，整元去小数）
		priceText(): string {
			const fen = this.priceFenPerCredit
			if (fen <= 0) return '0'
			if (fen % 100 === 0) return `${fen / 100}`
			return (fen / 100).toFixed(2)
		}
	},
	onLoad(options : any) {
		this.taskId = options?.taskId ?? ''
		this.shopId = options?.shopId ?? ''
		if (options?.shareToken != null && String(options.shareToken) !== '') {
			this.shareToken = String(options.shareToken)
		}
		// 分享落地（朋友圈单页模式/好友卡片带参）→ 只读模式
		this.shareReadOnly = options?.share_from === 'tryon_result'
		// 恢复品牌上下文（分享链接携带，保证只读查询与「我也要试」同品牌）
		if (options?.brandId != null && String(options.brandId) !== '') {
			setBrandId(String(options.brandId))
		}
		// 朋友圈单页模式判定：scene 1154（禁跳页，仅内容展示）
		try {
			const enter = uni.getEnterOptionsSync()
			this.isTimelinePage = (enter != null && enter.scene === 1154)
		} catch (e) {
			this.isTimelinePage = false
		}
		if (this.shareReadOnly) {
			// 只读模式：拉取一次即止，不轮询、不重试、不要求登录
			this.navTitle = 'AI试衣作品'
			this.loadSharedTask()
		} else if (this.taskId !== '') {
			this.startPolling()
		} else {
			this.status = 'failed'
		}
	},
	onReady() {
	},
	onShow() {
		// 防截屏：进页开启（微信原生 API，仅小程序端生效）
		this.enableCaptureProtection()
		// 右上角菜单开放「分享到朋友圈」（单页模式卡片：标题+图，最接近网页链接卡的效果）
		// #ifdef MP-WEIXIN
		if (typeof wx !== 'undefined' && (wx as any).showShareMenu != null) {
			try {
				(wx as any).showShareMenu({ menus: ['shareAppMessage', 'shareTimeline'] })
			} catch (e) {}
		}
		// #endif
		// 查询下载次数余额（需登录；未登录时保持原按钮，避免进页即拉起登录）
		if (isLoggedIn()) {
			this.loadCreditInfo()
		}
	},
	onHide() {
		// 防截屏解限：从结果页前进到其他页面（navigateTo 等）时必须恢复，防止过分防御
		this.disableCaptureProtection()
	},
	onUnload() {
		this.stopPolling()
		// 终止可能进行中的到账轮询
		this.payPollToken = this.payPollToken + 1
		// 防截屏：离页恢复
		this.disableCaptureProtection()
	},
	onShareAppMessage() : any {
		// 点分享才准备封面：返回 Promise，微信客户端等待 resolve（官方 onShareAppMessage 支持 Promise 返回）
		return this.ensureShareCard()
	},
	onShareTimeline() : any {
		// bug #11：朋友圈卡片固定用「网络可达 JPG」缩略图——WebP / 本地临时文件偶发卡片不显示图
		const img = this.resultImageUrl !== ''
			? cosThumbJpg(this.resultImageUrl, 500)
			: (this.shareCardReady && this.shareCardImage !== '' ? this.shareCardImage : '')
		return {
			title: this.buildShareTitle(),
			query: this.buildShareQuery(),
			imageUrl: img
		}
	},
	methods: {
		// 防截屏防御：wx.setVisualEffectOnCapture(hidden)，基础库 ≥2.13.0 安卓/iOS 真机生效；条件编译仅打包微信端
		enableCaptureProtection() {
			// #ifdef MP-WEIXIN
			try {
				if (typeof wx !== 'undefined' && wx.canIUse != null && wx.canIUse('setVisualEffectOnCapture')) {
					(wx as any).setVisualEffectOnCapture({
						visualEffect: 'hidden',
						success: () => {},
						fail: () => {}
					})
				}
			} catch (e) {
				// 低版本/开发者工具不支持时静默忽略
			}
			// #endif
		},
		disableCaptureProtection() {
			// #ifdef MP-WEIXIN
			try {
				if (typeof wx !== 'undefined' && wx.canIUse != null && wx.canIUse('setVisualEffectOnCapture')) {
					(wx as any).setVisualEffectOnCapture({
						visualEffect: 'none',
						success: () => {},
						fail: () => {}
					})
				}
			} catch (e) {
				// 静默忽略
			}
			// #endif
		},
		startPolling() {
			this.status = 'processing'
			this.elapsedSeconds = 0
			this.pollErrorStreak = 0
			this.progressDone = false
			this.countdownTimer = setInterval(() => {
				this.elapsedSeconds += 1
				// 超时 180 秒（3分钟），停止轮询，展示失败
				if (this.elapsedSeconds >= 180) {
					this.stopPolling()
					this.status = 'failed'
				}
			}, 1000)

			// 立即查询一次
			this.pollResult()

			// bug #12：自适应轮询（替代固定 20s——通知已到但页面最坏再等 20s 才跳转）
			this.schedulePoll()
		},

		// 轮询调度：每次按当前等待时长选择间隔，任务 30–60s 场景下把跳转延迟压到 ≤3s
		schedulePoll() {
			this.pollingTimer = setTimeout(() => {
				this.pollResult()
				if (this.status === 'processing') {
					this.schedulePoll()
				}
			}, this.nextPollDelay())
		},

		nextPollDelay(): number {
			const e = this.elapsedSeconds
			if (e < 20) return 8000
			if (e < 45) return 3000
			return 2500
		},

		async pollResult() {
			// 空任务兜底：直接失败，不空转轮询（bug #8：分享落地错位致 taskId 为空）
			if (this.taskId === '') {
				this.stopPolling()
				this.status = 'failed'
				return
			}
			try {
				const res = await getAiTryOnResult(this.taskId)
				// aiface 接口 code === 0 或 200 表示成功
				if ((res.code === 0 || res.code === 200) && res.data) {
					this.pollErrorStreak = 0
					const taskStatus = res.data.status
					if (taskStatus === 'completed') {
						this.stopPolling()
						// 主人指示：任务已结束不得仍停中间步骤 → 进度走满 100% 再切结果页
						this.progressDone = true
						const r = res.data
						setTimeout(() => {
							this.imageLoaded = false
							this.resultImageUrl = r.result_image_url || ''
							this.status = 'completed'
							// 更新导航栏标题（自定义导航栏）
							this.navTitle = 'AI试衣结果'
							this.styleName = r.style_name ?? ''
							this.shopName = r.shop_name ?? ''
							this.shareToken = r.share_token ?? ''
							if (this.shopId === '' && r.shop_id > 0) {
								this.shopId = String(r.shop_id)
							}
							if (r.album_id > 0) {
								this.albumId = String(r.album_id)
							}
							this.templateId = r.template_id != null ? (r.template_id as number) : 0
						}, 260)
					} else if (taskStatus === 'failed') {
						this.stopPolling()
						this.status = 'failed'
						this.taskErrorMessage = res.data.error_message ?? ''
						console.error('[aiTryOnResult] 任务生成失败:', this.taskErrorMessage)
					}
					// pending / processing → 继续轮询
				} else {
					// 确定失败（任务不存在/无权限/业务码）→ 立即失败，不再空等 180 秒（bug #8）
					this.stopPolling()
					this.status = 'failed'
					this.taskErrorMessage = res.message || '任务查询失败'
					console.error('[aiTryOnResult] 任务查询确定失败:', this.taskErrorMessage)
				}
			} catch (err) {
				// 网络抖动容忍 3 次（CR 🟡）：瞬时闪断继续轮询，连续 3 次才判定失败
				this.pollErrorStreak = this.pollErrorStreak + 1
				console.error('轮询AI试衣结果失败:', err, 'streak=', this.pollErrorStreak)
				if (this.pollErrorStreak >= 3) {
					this.stopPolling()
					this.status = 'failed'
				}
			}
		},
		stopPolling() {
			if (this.pollingTimer != null) {
				clearTimeout(this.pollingTimer)
				this.pollingTimer = null
			}
			if (this.countdownTimer != null) {
				clearInterval(this.countdownTimer)
				this.countdownTimer = null
			}
		},

		// 生成等待中：逛逛其他相册 → 跳到该门店相册列表页
		goBrowseAlbums() {
			if (this.shopId !== '') {
				uni.navigateTo({ url: '/pages/demoDetail/index?idx=' + this.shopId })
			} else {
				uni.navigateTo({ url: '/pages/demoDetail/index' })
			}
		},

		// 生成队列：跳转 我-AI试衣 记录页（等待体验底部第二个按钮，2026-09-14 主人指示）
		goGenerationQueue() {
			uni.navigateTo({ url: '/pages/aiTryOnHistory/index' })
		},

		// 分享标题：带店铺名称（主人 2026-09-10 指示）；无店铺名时退化为品牌+相册名
		buildShareTitle() : string {
			const style = this.styleName !== '' ? this.styleName : '新中式'
			if (this.shopName !== '') {
				return `我也在蓝梅旅拍「${this.shopName}」AI 换装，试一下你「${style}」的样子`
			}
			return `我也在蓝梅旅拍 AI 换装，试一下你「${style}」的样子`
		},

		// 朋友圈单页模式 query（onShareTimeline 用）。单页模式打开的是「当前页（结果页）」：
		// 必须带 taskId + shareToken 走只读落地（bug #8 根因修复），模板/门店/相册参数供「我也要试」回跳试衣页
		buildShareQuery() : string {
			const p = this.buildSharePath()
			let q = p.indexOf('?') >= 0 ? p.substring(p.indexOf('?') + 1) : ''
			if (this.taskId !== '') {
				q = q + (q === '' ? '' : '&') + 'taskId=' + this.taskId
			}
			if (this.shareToken !== '') {
				q = q + (q === '' ? '' : '&') + 'shareToken=' + this.shareToken
			}
			return q
		},

		// 分享落地路径：直达试衣页并预选该套系模板 + 品牌/门店完整上下文（行业方案：带参直达业务页）
		buildSharePath() : string {
			let path = '/pages/aiTryOn/index?share_from=tryon_result'
			if (this.templateId > 0) path += `&templateId=${this.templateId}`
			if (this.shopId !== '') path += `&shopId=${this.shopId}`
			if (this.albumId !== '') path += `&albumId=${this.albumId}`
			const brandId = getBrandId()
			if (brandId !== '') path += `&brandId=${brandId}`
			return path
		},

		// 分享封面生成（点击分享后才调用）：端侧人脸检测 → 人脸居中 5:4 卡片；失败回退中心裁剪，再失败回退网络图
		prepareShareCard() : Promise<void> {
			return new Promise<void>((resolve) => {
				const done = () => {
					this.sharePreparing = false
					resolve()
				}
				if (this.resultImageUrl === '' || this.shareCardReady) { done(); return }
				// #ifdef MP-WEIXIN
				generateFaceCenteredCard(this.resultImageUrl).then((card) => {
					if (card != null && card.imagePath !== '') {
						this.shareCardImage = card.imagePath
					} else {
						this.shareCardImage = cosThumb(this.resultImageUrl, 400)
					}
					this.shareCardReady = true
					done()
				}).catch(() => {
					this.shareCardImage = cosThumb(this.resultImageUrl, 400)
					this.shareCardReady = true
					done()
				})
				// #endif
				// #ifndef MP-WEIXIN
				this.shareCardImage = cosThumb(this.resultImageUrl, 400)
				this.shareCardReady = true
				done()
				// #endif
			})
		},

		// 点击分享才准备封面：返回 Promise，微信客户端等待 resolve 后再拉起分享（官方支持 Promise 返回）
		async ensureShareCard() : Promise<any> {
			if (!this.shareCardReady && !this.sharePreparing) {
				this.sharePreparing = true
				await this.prepareShareCard()
			}
			const img = this.shareCardImage !== '' ? this.shareCardImage : cosThumb(this.resultImageUrl, 400)
			return {
				title: this.buildShareTitle(),
				path: this.buildSharePath(),
				imageUrl: img
			}
		},

		// 朋友圈按钮：微信单页模式只能由右上角菜单触发，按钮改为引导（主人指示）
		guideShareTimeline() {
			uni.showModal({
				title: '分享到朋友圈',
				content: '请点击右上角「···」，选择「分享到朋友圈」',
				showCancel: false,
				confirmText: '知道了'
			})
		},

		// ===== 分享落地只读模式（bug #8）：匿名查看 A 的试衣作品 =====
		// 凭 share_token 拉取一次即止：不轮询、不要求登录、不显示重试
		async loadSharedTask() {
			if (this.shareToken === '') {
				this.status = 'failed'
				return
			}
			try {
				const res = await getSharedAiTryOnResult(this.shareToken)
				if ((res.code === 0 || res.code === 200) && res.data) {
					this.taskId = String(res.data.id)
					this.templateId = res.data.template_id != null ? (res.data.template_id as number) : 0
					this.styleName = res.data.style_name ?? ''
					this.shopName = res.data.shop_name ?? ''
					this.shopId = res.data.shop_id > 0 ? String(res.data.shop_id) : this.shopId
					this.albumId = res.data.album_id > 0 ? String(res.data.album_id) : ''
					if (res.data.status === 'completed' && res.data.result_image_url !== '') {
						this.resultImageUrl = res.data.result_image_url
						this.status = 'completed'
						this.imageLoaded = false
					} else if (res.data.status === 'failed') {
						this.status = 'failed'
						this.taskErrorMessage = res.data.error_message ?? ''
					} else {
						// pending/processing：作品生成中，仅展示进度态（不轮询、不重试）
						this.status = 'processing'
					}
				} else {
					this.status = 'failed'
					this.taskErrorMessage = res.message || '作品不存在或已被删除'
				}
			} catch (err) {
				console.error('[aiTryOnResult] 分享落地只读查询失败:', err)
				this.status = 'failed'
			}
		},

		// 只读模式 CTA「我也要试」：跳试衣页（单页模式禁跳页 → 引导点底部「前往小程序」）
		tryThisOut() {
			if (this.isTimelinePage) {
				uni.showModal({
					title: '蓝梅旅拍',
					content: '请点击下方「前往小程序」，进入完整服务后即可上传照片体验 AI 试衣',
					showCancel: false,
					confirmText: '知道了'
				})
				return
			}
			const params: string[] = []
			if (this.shopId !== '') params.push('shopId=' + this.shopId)
			if (this.albumId !== '') params.push('albumId=' + this.albumId)
			if (this.templateId > 0) params.push('templateId=' + this.templateId)
			const brandId = getBrandId()
			if (brandId !== '') params.push('brandId=' + brandId)
			uni.navigateTo({ url: '/pages/aiTryOn/index' + (params.length > 0 ? '?' + params.join('&') : '') })
		},

		handleRetry() {
			// 空任务兜底：无 taskId 不进入轮询（bug #8：分享落地错位/链接缺参）
			if (this.taskId === '') {
				this.status = 'failed'
				return
			}
			this.failCount += 1
			if (this.failCount >= 3) {
				// 连续3次失败，不再重试
				this.status = 'failed'
				return
			}
			// 重新启动轮询
			this.imageLoaded = false
			this.startPolling()
		},

		onImageLoad() {
			this.imageLoaded = true
		},

		async saveToAlbum() {
			if (this.resultImageUrl === '') {
				uni.showToast({ title: '图片地址为空', icon: 'none' })
				return
			}
			if (this.isSaving) return

			// 付费模式且已知无剩余次数且未买断：直接拉起支付，省一次必败请求（已买断永久免费保存）
			if (this.isPaidMode && this.creditBalance <= 0 && !this.taskBought) {
				this.handleRecharge()
				return
			}

			// 先请求相册授权再扣费，避免扣费后因未授权保存失败浪费次数
			const authed = await this.ensureAlbumAuth()
			if (!authed) return

			// 授权通过后扣下载次数池 1 次并取签名下载 URL；4001 = 下载次数不足 → 拉起充值支付，到账后自动重试保存
			this.isSaving = true
			const downloadUrl = await this.chargeDownloadCredit()
			if (downloadUrl === '') {
				this.isSaving = false
				return
			}

			try {
				uni.showLoading({ title: '保存中...', mask: true })

				// 用扣费接口返回的 5 分钟签名 URL 下载（超时需重新走扣费接口获取）
				const downloadRes = await new Promise<any>((resolve, reject) => {
					uni.downloadFile({
						url: downloadUrl,
						success: (res : any) => {
							if (res.statusCode === 200) {
								resolve(res)
							} else {
								reject(new Error('下载失败'))
							}
						},
						fail: (err : any) => {
							reject(err)
						}
					})
				})

				// 保存到相册
				await new Promise<void>((resolve, reject) => {
					uni.saveImageToPhotosAlbum({
						filePath: downloadRes.tempFilePath,
						success: () => {
							resolve()
						},
						fail: (err : any) => {
							reject(err)
						}
					})
				})

				uni.hideLoading()
				this.isSaving = false
				uni.showToast({ title: '已保存到相册', icon: 'success' })
			} catch (err : any) {
				uni.hideLoading()
				this.isSaving = false
				uni.showToast({ title: '保存失败，请重试', icon: 'none' })
			}
		},

		// 保存前申请相册写入授权：已授权直接通过；拒绝过则引导去设置页开启；最终未授权返回 false（不扣费）
		async ensureAlbumAuth(): Promise<boolean> {
			const granted = await new Promise<boolean>((resolve) => {
				uni.authorize({
					scope: 'scope.writePhotosAlbum',
					success: () => resolve(true),
					fail: () => resolve(false)
				})
			})
			if (granted) return true
			return await new Promise<boolean>((resolve) => {
				uni.showModal({
					title: '提示',
					content: '需要您授权保存图片到相册',
					confirmText: '去设置',
					success: (modalRes : any) => {
						if (!modalRes.confirm) {
							resolve(false)
							return
						}
						uni.openSetting({
							success: (settingRes : any) => {
								const authSetting = settingRes?.authSetting ?? {}
								resolve(authSetting['scope.writePhotosAlbum'] === true)
							},
							fail: () => resolve(false)
						})
					}
				})
			})
		},

		// 获取店铺 ID：页面参数缺失时（历史记录入口）取首个启用店铺兜底，返回 0 表示无可用店铺
		async ensureShopId(): Promise<number> {
			let shopIdNum = parseInt(this.shopId) || 0
			if (shopIdNum <= 0) {
				try {
					const shopsRes = await getShops()
					if (shopsRes.code === 200 && shopsRes.data.length > 0) {
						shopIdNum = shopsRes.data[0].id
						this.shopId = String(shopIdNum)
					}
				} catch (err) {
					console.error('[aiTryOnResult] 获取店铺列表失败:', err)
				}
			}
			return shopIdNum
		},

		// 查询下载次数余额与单次定价（失败时静默，保持原按钮）
		async loadCreditInfo() {
			try {
				const shopIdNum = await this.ensureShopId()
				const tid = parseInt(this.taskId) || 0
				const res = await getCreditBalance(shopIdNum > 0 ? shopIdNum : undefined, 'download', tid)
				if (res.code === 200 && res.data) {
					this.creditBalance = res.data.balance
					this.priceFenPerCredit = res.data.priceFenPerCredit
					this.taskBought = res.data.taskBought === true
					this.creditLoaded = true
				}
			} catch (err) {
				console.error('[aiTryOnResult] 查询下载余额失败:', err)
			}
		},

		// 下载池扣费：成功返回 5 分钟签名下载 URL 继续保存；4001 拉起充值支付；其他错误提示后中断（返回空串）
		async chargeDownloadCredit(): Promise<string> {
			try {
				const res = await downloadAiTryOnResult(this.taskId)
				// aiface 接口 code === 0 或 200 表示成功
				if ((res.code === 0 || res.code === 200) && res.data) {
					// 扣费成功，本地余额同步 -1（角标实时刷新）
					if (this.isPaidMode && this.creditBalance > 0) {
						this.creditBalance = this.creditBalance - 1
					}
					this.taskBought = true
					return res.data.url
				}
				if (res.code === 4001) {
					// 下载次数不足：刷新本地余额为 0（按钮切换为价格态）并拉起支付
					this.creditBalance = 0
					this.handleRecharge()
					return ''
				}
				uni.showToast({ title: res.message || '扣费失败，请重试', icon: 'none' })
				return ''
			} catch (err) {
				console.error('[aiTryOnResult] 下载扣费请求失败:', err)
				uni.showToast({ title: '网络异常，请重试', icon: 'none' })
				return ''
			}
		},

		// 4001 下载次数不足：创建充值订单（feature='download'）→ 拉起微信支付 → 轮询到账 → 自动重试保存
		async handleRecharge() {
			if (this.isPaying) return
			this.isPaying = true
			uni.showToast({ title: '下载次数不足，请完成支付', icon: 'none' })
			try {
				const shopIdNum = await this.ensureShopId()
				if (shopIdNum <= 0) {
					this.isPaying = false
					uni.showToast({ title: '缺少店铺信息，请稍后重试', icon: 'none' })
					return
				}
				const res = await createCreditRecharge({ shopId: shopIdNum, credits: 1, feature: 'download', taskId: parseInt(this.taskId) || 0 })
				if (res.code !== 200 || !res.data) {
					this.isPaying = false
					uni.showToast({ title: res.message || '下单失败，请重试', icon: 'none' })
					return
				}
				const order = res.data
				const outTradeNo = order.outTradeNo
				uni.requestPayment({
					provider: 'wxpay',
					timeStamp: order.timeStamp,
					nonceStr: order.nonceStr,
					package: order.package,
					signType: order.signType,
					paySign: order.paySign,
					success: () => {
						// 支付成功：到账为微信异步回调入账，轮询订单状态确认
						this.pollRechargeStatus(outTradeNo)
					},
					fail: (payErr : any) => {
						this.isPaying = false
						const errMsg: string = payErr?.errMsg ?? ''
						if (errMsg.indexOf('cancel') !== -1) {
							uni.showToast({ title: '已取消支付', icon: 'none' })
						} else {
							uni.showToast({ title: '支付失败，请重试', icon: 'none' })
						}
					}
				})
			} catch (err) {
				this.isPaying = false
				console.error('[aiTryOnResult] 创建下载充值订单失败:', err)
				uni.showToast({ title: '下单失败，请重试', icon: 'none' })
			}
		},

		// 轮询充值订单状态：每 2.5 秒一次，最多 48 次（约 2 分钟兜底），paid = true 即到账
		pollRechargeStatus(outTradeNo : string) {
			this.payPollToken = this.payPollToken + 1
			const token = this.payPollToken
			const maxTimes = 48
			let count = 0
			uni.showLoading({ title: '确认到账中...', mask: true })
			const check = async () => {
				if (token !== this.payPollToken) {
					uni.hideLoading()
					return
				}
				count = count + 1
				try {
					const res = await getCreditRechargeStatus(outTradeNo)
					if (res.code === 200 && res.data && res.data.paid) {
						uni.hideLoading()
						this.isPaying = false
						// 同步最新余额（角标实时刷新），再自动重试保存
						this.creditBalance = res.data.balance
						this.taskBought = true
						uni.showToast({ title: '支付成功，该结果已永久解锁', icon: 'none' })
						// 到账后自动重试保存（该任务已永久买断，扣费直接放行）
						this.saveToAlbum()
						return
					}
				} catch (err) {
					console.error('[aiTryOnResult] 查询充值状态失败:', err)
				}
				if (count >= maxTimes) {
					uni.hideLoading()
					this.isPaying = false
					uni.showToast({ title: '到账确认超时，请重试', icon: 'none' })
					return
				}
				setTimeout(check, 2500)
			}
			check()
		},

		handleBack() {
			this.stopPolling()
			// 朋友圈单页模式禁跳页：引导用左上角 ✕ 关闭（CR 🟡）
			if (this.isTimelinePage) {
				uni.showModal({
					title: '蓝梅旅拍',
					content: '请点击左上角「✕」关闭返回朋友圈',
					showCancel: false,
					confirmText: '知道了'
				})
				return
			}
			// 分享冷启动栈深=1：navigateBack 会直接退出小程序 → 回首页（行业最佳实践）
			if (getCurrentPages().length > 1) {
				uni.navigateBack()
			} else {
				uni.reLaunch({ url: '/pages/index/index' })
			}
		}
	}
}
</script>

<style>
.page {
	background: var(--color-bg);
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	position: relative;
}

/* 购买照片按钮 */
.buy-photo-btn {
	margin: 24rpx auto 0;
	background: rgba(255, 255, 255, 0.15);
	border-radius: var(--radius-pill);
	padding: 16rpx 48rpx;
	align-self: center;
}
.buy-photo-text {
	font-size: var(--font-size-body-plus);
	color: #fff;
}

/* 居中内容区域（加载态/失败态） */
.center-content {
	position: relative;
}
/* 生成等待体验：Tips / 进度面板 / 双按钮 */
.gen-panel {
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
}
.gen-tips {
	font-size: var(--font-size-body-sm);
	color: rgba(255, 255, 255, 0.45);
	text-align: center;
	padding: 12rpx 24rpx;
	margin-bottom: 8rpx;
}
.gen-actions {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-top: 28rpx;
}
/* 双按钮（button 组件，主人指示）：重置原生样式，视觉与 btn-secondary 一致 */
.gen-btn {
	padding: 16rpx 36rpx;
	border-radius: var(--radius-lg);
	margin: 0 12rpx;
	font-size: var(--font-size-body);
	line-height: 1.4;
	background: var(--color-primary-10);
	border: 1rpx solid var(--color-primary-50);
	color: var(--color-primary);
}
.gen-btn::after {
	border: none;
}
.gen-panel .loading-spinner {
	margin-bottom: 16rpx;
}
.center-content {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 64rpx;
}

/* 加载态 */
.loading-wrapper {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.loading-spinner {
	width: 80rpx;
	height: 80rpx;
	border: 6rpx solid rgba(255, 255, 255, 0.2);
	border-top-color: rgba(255, 255, 255, 0.8);
	border-radius: 50%;
	margin-bottom: 48rpx;
	animation: spin 1s linear infinite;
}
@keyframes spin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}
.loading-tip {
	font-size: var(--font-size-body-plus);
	color: rgba(255, 255, 255, 0.7);
	text-align: center;
	line-height: 44rpx;
}
.elapsed-text {
	font-size: var(--font-size-body);
	color: rgba(255, 255, 255, 0.4);
	margin-top: 24rpx;
}
.browse-btn {
	margin-top: 48rpx;
}

/* 成功态 */
.result-content {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 8rpx;
}
.result-image-wrapper {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	position: relative;
	/* CR 🟡：overflow 不放在 wrapper，避免裁切超出容器高度的竖图（原布局为居中溢出可见） */
}
/* 图片区全屏水印层：斜向平铺、低透明度，只覆盖预览，不改图片源文件 */
.wm-layer {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: space-around;
	justify-content: space-around;
	z-index: 2;
	/* CR 🟡：裁剪只作用于水印层自身（旋转子项溢出裁剪），不裁图片 */
	overflow: hidden;
}
.wm-item {
	width: 33.33%;
	text-align: center;
	transform: rotate(-30deg);
	font-size: 20rpx;
	color: #FFFFFF;
	opacity: 0.16;
	font-weight: 400;
}
.result-image {
	width: 100%;
	border-radius: var(--radius-sm);
}
.image-fade {
	opacity: 0;
	transition: opacity 0.8s ease-in-out;
}
.image-visible {
	opacity: 1;
}
.action-bar {
	width: 100%;
	padding: 24rpx 0;
	display: flex;
	flex-direction: row;
	justify-content: center;
}
.save-btn-wrap {
	position: relative;
	padding-top: var(--spacing-sm);
}
/* 限免角标（整体落在容器 padding 预留空间内，不用负偏移，避免被裁剪） */
.save-btn-badge {
	position: absolute;
	top: 0rpx;
	right: 0rpx;
	z-index: 1;
	background: #ff3b30;
	border-radius: var(--radius-sm);
	padding: 4rpx 12rpx;
}
.save-btn-badge-text {
	font-size: var(--font-size-body-xs);
	color: #fff;
}
/* 操作栏按钮：view 与 button 原生差异抹平——统一高度 92rpx（button 原生表单组件自带默认样式，不能只靠类名对齐） */
.action-bar .btn-primary {
	height: 92rpx;
	box-sizing: border-box;
}
.action-bar .btn-primary text {
	color: var(--color-bg);
	font-size: 32rpx;
	line-height: 1.2;
}
.share-btn {
	margin: var(--spacing-sm) 0 0 var(--spacing-lg);
	min-width: 160rpx;
	height: 92rpx;
	line-height: 1;
	box-sizing: border-box;
}
.share-btn::after {
	border: none;
}
.moments-icon {
	width: 36rpx;
	height: 36rpx;
}

/* 失败态 */
.fail-wrapper {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.fail-text {
	font-size: 30rpx;
	color: rgba(255, 255, 255, 0.7);
	margin-bottom: 48rpx;
	text-align: center;
}
.retry-btn {
	background: #fff;
	border-radius: var(--radius-2xl);
	padding: 24rpx 80rpx;
	margin-bottom: 24rpx;
}
.retry-btn-text {
	font-size: 32rpx;
