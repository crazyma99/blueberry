<template>
	<view class="page">
		<CustomNavBar :title="navTitle" />

		<!-- 加载态 -->
		<view v-if="status === 'processing'" class="center-content">
			<view class="loading-wrapper">
				<view class="loading-spinner"></view>
				<text class="loading-tip">正在生成中，生成需要3分钟左右，您可以在历史记录页查看哦</text>
				<text class="elapsed-text" v-if="elapsedSeconds > 0">已等待 {{ elapsedSeconds }} 秒</text>
			</view>
		</view>

		<!-- 成功态 -->
		<view v-if="status === 'completed'" class="result-content">
			<view class="result-image-wrapper">
				<image
					class="result-image image-fade"
					:class="{ 'image-visible': imageLoaded }"
					:src="resultImageUrl"
					mode="widthFix"
					@load="onImageLoad"
				></image>
			</view>
			<view class="action-bar">
				<!-- 付费模式且无剩余次数：价格按钮，点击直接拉起支付 -->
				<view v-if="isPaidMode && creditBalance <= 0" class="save-btn-wrap">
					<view class="save-btn" @click="saveToAlbum">
						<text class="save-btn-price">¥{{ priceText }}</text>
						<text class="save-btn-text"> 保存到相册</text>
					</view>
				</view>
				<!-- 非付费模式或有剩余次数：原按钮，有次数时右上角展示角标 -->
				<view v-else class="save-btn-wrap">
					<view class="save-btn" @click="saveToAlbum">
						<text class="save-btn-text">保存到相册</text>
					</view>
					<view v-if="isPaidMode && creditBalance > 0" class="save-btn-badge">
						<text class="save-btn-badge-text">限时免费 {{ creditBalance }} 次</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 失败态 -->
		<view v-if="status === 'failed'" class="center-content">
			<view class="fail-wrapper">
				<text class="fail-text" v-if="failCount >= 3">当前服务繁忙，请稍后再试</text>
				<text class="fail-text" v-else>生成失败，请重试</text>
				<view class="retry-btn" @click="handleRetry" v-if="failCount < 3">
					<text class="retry-btn-text">重试</text>
				</view>
				<view class="back-btn-wrapper" @click="handleBack">
					<text class="back-btn-text">返回</text>
				</view>
			</view>
		</view>

		<!-- 底部 Copyright -->
		<view class="page-footer">
			<view class="divide"></view>
			<view class="bottomdesc"><AppFooter /></view>
		</view>
	</view>
</template>

<script lang="uts">
import { getAiTryOnResult, downloadAiTryOnResult, createCreditRecharge, getCreditRechargeStatus, getCreditBalance, getShops } from '../../utils/api.uts'
import { isLoggedIn } from '../../utils/auth.uts'

export default {
	data() {
		return {
			taskId: '',
			// 自定义导航栏标题：生成完成后由“正在生成”切换为“AI试衣结果”
			navTitle: '正在生成',
			status: 'processing' as string,  // 'pending' | 'processing' | 'completed' | 'failed'
			resultImageUrl: '',
			failCount: 0,
			pollingTimer: null as any,
			elapsedSeconds: 0,
			countdownTimer: null as any,
			imageLoaded: false,
			shopId: '',
			isSaving: false,     // 保存流程防重入（扣费+下载保存期间拦截重复点击）
			creditBalance: -1,        // 下载池剩余次数，-1 = 未查询到
			priceFenPerCredit: 0,     // 单次价格（分），0 = 未开通付费购买（非付费模式）
			creditLoaded: false,      // 是否已成功查询到余额
			// 下载次数不足（4001）时的充值支付
			isPaying: false,
			payPollToken: 0      // 到账轮询会话标记，自增即失效
		}
	},
	computed: {
		// 付费模式：已查询到余额且商户配置了单次价格
		isPaidMode(): boolean {
			return this.creditLoaded && this.priceFenPerCredit > 0
		},
		// 单次价格文案（分 → 元，整元去小数）
		priceText(): string {
			const fen = this.priceFenPerCredit
			if (fen <= 0) return '0'
			if (fen % 100 === 0) return `${fen / 100}`
			return (fen / 100).toFixed(2)
		}
	},
	onLoad(options : any) {
		this.taskId = options?.taskId ?? ''
		this.shopId = options?.shopId ?? ''
		if (this.taskId !== '') {
			this.startPolling()
		} else {
			this.status = 'failed'
		}
	},
	onShow() {
		// 查询下载次数余额（需登录；未登录时保持原按钮，避免进页即拉起登录）
		if (isLoggedIn()) {
			this.loadCreditInfo()
		}
	},
	onUnload() {
		this.stopPolling()
		// 终止可能进行中的到账轮询
		this.payPollToken = this.payPollToken + 1
	},
	methods: {
		startPolling() {
			this.status = 'processing'
			this.elapsedSeconds = 0

			// 启动计时器，每秒更新已等待时间
			this.countdownTimer = setInterval(() => {
				this.elapsedSeconds += 1
				// 超时 180 秒（3分钟），停止轮询，展示失败
				if (this.elapsedSeconds >= 180) {
					this.stopPolling()
					this.status = 'failed'
				}
			}, 1000)

			// 立即查询一次
			this.pollResult()

			// 每 20 秒轮询
			this.pollingTimer = setInterval(() => {
				this.pollResult()
			}, 20000)
		},

		async pollResult() {
			try {
				const res = await getAiTryOnResult(this.taskId)
				// aiface 接口 code === 0 或 200 表示成功
				if ((res.code === 0 || res.code === 200) && res.data) {
					const taskStatus = res.data.status
					if (taskStatus === 'completed') {
						this.stopPolling()
						this.imageLoaded = false
						this.resultImageUrl = res.data.result_image_url || ''
						this.status = 'completed'
						// 更新导航栏标题（自定义导航栏）
						this.navTitle = 'AI试衣结果'
					} else if (taskStatus === 'failed') {
						this.stopPolling()
						this.status = 'failed'
					}
					// pending / processing → 继续轮询
				}
			} catch (err) {
				console.error('轮询AI试衣结果失败:', err)
			}
		},

		stopPolling() {
			if (this.pollingTimer != null) {
				clearInterval(this.pollingTimer)
				this.pollingTimer = null
			}
			if (this.countdownTimer != null) {
				clearInterval(this.countdownTimer)
				this.countdownTimer = null
			}
		},

		handleRetry() {
			this.failCount += 1
			if (this.failCount >= 3) {
				// 连续3次失败，不再重试
				this.status = 'failed'
				return
			}
			// 重新启动轮询
			this.imageLoaded = false
			this.startPolling()
		},

		onImageLoad() {
			this.imageLoaded = true
		},

		async saveToAlbum() {
			if (this.resultImageUrl === '') {
				uni.showToast({ title: '图片地址为空', icon: 'none' })
				return
			}
			if (this.isSaving) return

			// 付费模式且已知无剩余次数：直接拉起支付，省一次必败请求
			if (this.isPaidMode && this.creditBalance <= 0) {
				this.handleRecharge()
				return
			}

			// 保存前扣下载次数池 1 次；4001 = 下载次数不足 → 拉起充值支付，到账后自动重试保存
			this.isSaving = true
			const charged = await this.chargeDownloadCredit()
			if (!charged) {
				this.isSaving = false
				return
			}

			try {
				uni.showLoading({ title: '保存中...', mask: true })

				// 网络图片需要先下载
				let savedPath = this.resultImageUrl
				if (this.resultImageUrl.startsWith('http')) {
					const downloadRes = await new Promise<any>((resolve, reject) => {
						uni.downloadFile({
							url: this.resultImageUrl,
							success: (res : any) => {
								if (res.statusCode === 200) {
									resolve(res)
								} else {
									reject(new Error('下载失败'))
								}
							},
							fail: (err : any) => {
								reject(err)
							}
						})
					})
					savedPath = downloadRes.tempFilePath
				}

				// 保存到相册
				await new Promise<void>((resolve, reject) => {
					uni.saveImageToPhotosAlbum({
						filePath: savedPath,
						success: () => {
							resolve()
						},
						fail: (err : any) => {
							reject(err)
						}
					})
				})

				uni.hideLoading()
				this.isSaving = false
				uni.showToast({ title: '已保存到相册', icon: 'success' })
			} catch (err : any) {
				uni.hideLoading()
				this.isSaving = false
				// 处理权限拒绝
				const errMsg = (err && err.errMsg) ? String(err.errMsg) : ''
				if (errMsg.indexOf('auth deny') !== -1 || errMsg.indexOf('authorize') !== -1) {
					uni.showModal({
						title: '提示',
						content: '需要您授权保存图片到相册',
						confirmText: '去设置',
						success: (modalRes : any) => {
							if (modalRes.confirm) {
								uni.openSetting({})
							}
						}
					})
				} else {
					uni.showToast({ title: '保存失败，请重试', icon: 'none' })
				}
			}
		},

		// 获取店铺 ID：页面参数缺失时（历史记录入口）取首个启用店铺兜底，返回 0 表示无可用店铺
		async ensureShopId(): Promise<number> {
			let shopIdNum = parseInt(this.shopId) || 0
			if (shopIdNum <= 0) {
				try {
					const shopsRes = await getShops()
					if (shopsRes.code === 200 && shopsRes.data.length > 0) {
						shopIdNum = shopsRes.data[0].id
						this.shopId = String(shopIdNum)
					}
				} catch (err) {
					console.error('[aiTryOnResult] 获取店铺列表失败:', err)
				}
			}
			return shopIdNum
		},

		// 查询下载次数余额与单次定价（失败时静默，保持原按钮）
		async loadCreditInfo() {
			try {
				const shopIdNum = await this.ensureShopId()
				const res = await getCreditBalance(shopIdNum > 0 ? shopIdNum : undefined, 'download')
				if (res.code === 200 && res.data) {
					this.creditBalance = res.data.balance
					this.priceFenPerCredit = res.data.priceFenPerCredit
					this.creditLoaded = true
				}
			} catch (err) {
				console.error('[aiTryOnResult] 查询下载余额失败:', err)
			}
		},

		// 下载池扣费：成功返回 true 继续保存；4001 拉起充值支付；其他错误提示后中断
		async chargeDownloadCredit(): Promise<boolean> {
			try {
				const res = await downloadAiTryOnResult(this.taskId)
				// aiface 接口 code === 0 或 200 表示成功
				if (res.code === 0 || res.code === 200) {
					// 扣费成功，本地余额同步 -1（角标实时刷新）
					if (this.isPaidMode && this.creditBalance > 0) {
						this.creditBalance = this.creditBalance - 1
					}
					return true
				}
				if (res.code === 4001) {
					// 下载次数不足：刷新本地余额为 0（按钮切换为价格态）并拉起支付
					this.creditBalance = 0
					this.handleRecharge()
					return false
				}
				uni.showToast({ title: res.message || '扣费失败，请重试', icon: 'none' })
				return false
			} catch (err) {
				console.error('[aiTryOnResult] 下载扣费请求失败:', err)
				uni.showToast({ title: '网络异常，请重试', icon: 'none' })
				return false
			}
		},

		// 4001 下载次数不足：创建充值订单（feature='download'）→ 拉起微信支付 → 轮询到账 → 自动重试保存
		async handleRecharge() {
			if (this.isPaying) return
			this.isPaying = true
			uni.showToast({ title: '下载次数不足，请完成支付', icon: 'none' })
			try {
				const shopIdNum = await this.ensureShopId()
				if (shopIdNum <= 0) {
					this.isPaying = false
					uni.showToast({ title: '缺少店铺信息，请稍后重试', icon: 'none' })
					return
				}
				const res = await createCreditRecharge({ shopId: shopIdNum, credits: 1, feature: 'download' })
				if (res.code !== 200 || !res.data) {
					this.isPaying = false
					uni.showToast({ title: res.message || '下单失败，请重试', icon: 'none' })
					return
				}
				const order = res.data
				const outTradeNo = order.outTradeNo
				uni.requestPayment({
					provider: 'wxpay',
					timeStamp: order.timeStamp,
					nonceStr: order.nonceStr,
					package: order.package,
					signType: order.signType,
					paySign: order.paySign,
					success: () => {
						// 支付成功：到账为微信异步回调入账，轮询订单状态确认
						this.pollRechargeStatus(outTradeNo)
					},
					fail: (payErr : any) => {
						this.isPaying = false
						const errMsg: string = payErr?.errMsg ?? ''
						if (errMsg.indexOf('cancel') !== -1) {
							uni.showToast({ title: '已取消支付', icon: 'none' })
						} else {
							uni.showToast({ title: '支付失败，请重试', icon: 'none' })
						}
					}
				})
			} catch (err) {
				this.isPaying = false
				console.error('[aiTryOnResult] 创建下载充值订单失败:', err)
				uni.showToast({ title: '下单失败，请重试', icon: 'none' })
			}
		},

		// 轮询充值订单状态：每 2.5 秒一次，最多 48 次（约 2 分钟兜底），paid = true 即到账
		pollRechargeStatus(outTradeNo : string) {
			this.payPollToken = this.payPollToken + 1
			const token = this.payPollToken
			const maxTimes = 48
			let count = 0
			uni.showLoading({ title: '确认到账中...', mask: true })
			const check = async () => {
				if (token !== this.payPollToken) {
					uni.hideLoading()
					return
				}
				count = count + 1
				try {
					const res = await getCreditRechargeStatus(outTradeNo)
					if (res.code === 200 && res.data && res.data.paid) {
						uni.hideLoading()
						this.isPaying = false
						// 同步最新余额（角标实时刷新），再自动重试保存
						this.creditBalance = res.data.balance
						uni.showToast({ title: `支付成功，${res.data.credits} 次到账`, icon: 'none' })
						// 到账后自动重试保存（下载次数已到账，扣费会成功）
						this.saveToAlbum()
						return
					}
				} catch (err) {
					console.error('[aiTryOnResult] 查询充值状态失败:', err)
				}
				if (count >= maxTimes) {
					uni.hideLoading()
					this.isPaying = false
					uni.showToast({ title: '到账确认超时，请重试', icon: 'none' })
					return
				}
				setTimeout(check, 2500)
			}
			check()
		},

		handleBack() {
			this.stopPolling()
			uni.navigateBack()
		}
	}
}
</script>

<style>
.page {
	background: #160F04;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	position: relative;
}

/* 购买照片按钮 */
.buy-photo-btn {
	margin: 24rpx auto 0;
	background: rgba(255, 255, 255, 0.15);
	border-radius: 40rpx;
	padding: 16rpx 48rpx;
	align-self: center;
}
.buy-photo-text {
	font-size: 28rpx;
	color: #fff;
}

/* 居中内容区域（加载态/失败态） */
.center-content {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 64rpx;
}

/* 加载态 */
.loading-wrapper {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.loading-spinner {
	width: 80rpx;
	height: 80rpx;
	border: 6rpx solid rgba(255, 255, 255, 0.2);
	border-top-color: rgba(255, 255, 255, 0.8);
	border-radius: 50%;
	margin-bottom: 48rpx;
	animation: spin 1s linear infinite;
}
@keyframes spin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}
.loading-tip {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.7);
	text-align: center;
	line-height: 44rpx;
}
.elapsed-text {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.4);
	margin-top: 24rpx;
}

/* 成功态 */
.result-content {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 8rpx;
}
.result-image-wrapper {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
}
.result-image {
	width: 100%;
	border-radius: 16rpx;
}
.image-fade {
	opacity: 0;
	transition: opacity 0.8s ease-in-out;
}
.image-visible {
	opacity: 1;
}
.action-bar {
	width: 100%;
	padding: 24rpx 0;
	display: flex;
	flex-direction: row;
	justify-content: center;
}
.save-btn {
	background: rgba(255, 255, 255, 0.1);
	border-radius: 48rpx;
	padding: 24rpx 48rpx;
	box-shadow: 0px 6px 20px 0px rgba(0, 0, 0, 0.16);
}
.save-btn-text {
	font-size: 28rpx;
	color: #fff;
	font-weight: 500;
}
.save-btn-wrap {
	position: relative;
	padding-top: 20rpx;
}
/* 限免角标（整体落在容器 padding 预留空间内，不用负偏移，避免被裁剪） */
.save-btn-badge {
	position: absolute;
	top: 0rpx;
	right: 0rpx;
	z-index: 1;
	background: #ff3b30;
	border-radius: 16rpx;
	padding: 4rpx 12rpx;
}
.save-btn-badge-text {
	font-size: 20rpx;
	color: #fff;
}
.save-btn-price {
	font-size: 28rpx;
	color: #F3D9AC;
	font-weight: 600;
}

/* 失败态 */
.fail-wrapper {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.fail-text {
	font-size: 30rpx;
	color: rgba(255, 255, 255, 0.7);
	margin-bottom: 48rpx;
	text-align: center;
}
.retry-btn {
	background: #fff;
	border-radius: 48rpx;
	padding: 24rpx 80rpx;
	margin-bottom: 24rpx;
}
.retry-btn-text {
	font-size: 32rpx;
	color: #000;
	font-weight: 500;
}
.back-btn-wrapper {
	padding: 24rpx 80rpx;
}
.back-btn-text {
	font-size: 28rpx;
	color: rgba(241, 205, 145, 0.9);
}

/* 底部 */
.page-footer {
	margin-top: auto;
}
.divide {
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}
.bottomdesc {
	margin: 32rpx auto;
	font-size: 18rpx;
	color: rgba(241, 205, 145, 0.5);
	font-weight: 400;
}
</style>
