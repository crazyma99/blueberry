<template>
	<view class="page">
		<CustomNavBar :title="navTitle" />

		<!-- 加载态 -->
		<view v-if="status === 'processing'" class="center-content">
			<view class="loading-wrapper">
				<view class="loading-spinner"></view>
				<text class="loading-tip">正在生成中，生成需要3分钟左右，您可以在历史记录页查看哦</text>
				<text class="elapsed-text" v-if="elapsedSeconds > 0">已等待 {{ elapsedSeconds }} 秒</text>
			</view>
		</view>

		<!-- 成功态 -->
		<view v-if="status === 'completed'" class="result-content">
			<view class="result-image-wrapper">
				<image
					class="result-image image-fade fade-in"
					:class="{ 'image-visible': imageLoaded }"
					:src="resultImageUrl"
					mode="widthFix"
					@load="onImageLoad"
				></image>
			</view>
			<view class="action-bar">
				<!-- 付费模式且无剩余次数且未买断：价格按钮，点击直接拉起支付（已买断永久免费保存） -->
				<view v-if="isPaidMode && creditBalance <= 0 && !taskBought" class="save-btn-wrap">
					<view class="btn-primary" hover-class="press-dim"
					@click="saveToAlbum">
						<text>¥{{ priceText }}</text>
						<text> 保存到相册</text>
					</view>
				</view>
				<!-- 非付费模式或有剩余次数：原按钮，有次数时右上角展示角标 -->
				<view v-else class="save-btn-wrap">
					<view class="btn-primary" hover-class="press-dim"
					@click="saveToAlbum">
						<text>保存到相册</text>
					</view>
					<view v-if="isPaidMode && (creditBalance > 0 || taskBought)" class="save-btn-badge">
						<text class="save-btn-badge-text">{{ taskBought ? '已解锁 · 永久保存' : '限时免费 ' + creditBalance + ' 次' }}</text>
					</view>
				</view>
				<button class="share-btn btn-secondary" open-type="share" hover-class="press-dim">分享</button>
				<button class="share-btn btn-secondary" @click="shareToMoments" hover-class="press-dim">朋友圈</button>
			</view>
		</view>

		<!-- 失败态 -->
		<view v-if="status === 'failed'" class="center-content">
			<view class="fail-wrapper">
				<text class="fail-text" v-if="failCount >= 3">当前服务繁忙，请稍后再试</text>
				<text class="fail-text" v-else>生成失败，请重试</text>
				<view class="retry-btn" hover-class="press-dim"
					@click="handleRetry" v-if="failCount < 3">
					<text class="retry-btn-text">重试</text>
				</view>
				<view class="back-btn-wrapper" hover-class="press-dim"
					@click="handleBack">
					<text class="back-btn-text">返回</text>
				</view>
			</view>
		</view>

		<!-- 底部 Copyright -->
		<view class="page-footer">
			<view class="divide"></view>
			<view class="bottomdesc"><AppFooter /></view>
		</view>

		<!-- 分享准备中 loading（点击分享后生成封面期间展示） -->
		<view v-if="sharePreparing" class="share-preparing-mask">
			<view class="share-preparing-card">
				<LoadingBlock text="正在准备分享…" />
			</view>
		</view>
	</view>
</template>

<script lang="uts">
import { getAiTryOnResult, downloadAiTryOnResult, createCreditRecharge, getCreditRechargeStatus, getCreditBalance, getShops } from '../../utils/api.uts'
import { isLoggedIn } from '../../utils/auth.uts'
import { getBrandId } from '../../utils/brand.uts'
import { generateFaceCenteredCard } from '../../utils/faceShareCard.uts'
import { cosThumb } from '../../utils/imageLoader.uts'

export default {
	data() {
		return {
			taskId: '',
			// 自定义导航栏标题：生成完成后由“正在生成”切换为“AI试衣结果”
			navTitle: '正在生成',
			status: 'processing' as string,  // 'pending' | 'processing' | 'completed' | 'failed'
			resultImageUrl: '',
			failCount: 0,
			pollingTimer: null as any,
			elapsedSeconds: 0,
			countdownTimer: null as any,
			imageLoaded: false,
			shopId: '',
			isSaving: false,     // 保存流程防重入（扣费+下载保存期间拦截重复点击）
			creditBalance: -1,        // 下载池剩余次数，-1 = 未查询到
			priceFenPerCredit: 0,     // 单次价格（分），0 = 未开通付费购买（非付费模式）
			taskBought: false,        // 该任务是否已永久买断（付款一次后无限次免费保存）
			creditLoaded: false,      // 是否已成功查询到余额
			// 下载次数不足（4001）时的充值支付
			isPaying: false,
			payPollToken: 0,      // 到账轮询会话标记，自增即失效
			// 分享（人脸居中 5:4 封面卡片）
			shareCardImage: '',
			shareCardReady: false,
			sharePreparing: false,   // 点击分享后生成封面中（UI 展示 loading+正在准备分享）
			styleName: '',
			shopName: '',
			albumId: '',
			templateId: 0
		}
	},
	computed: {
		// 付费模式：已查询到余额且商户配置了单次价格
		isPaidMode(): boolean {
			return this.creditLoaded && this.priceFenPerCredit > 0
		},
		// 单次价格文案（分 → 元，整元去小数）
		priceText(): string {
			const fen = this.priceFenPerCredit
			if (fen <= 0) return '0'
			if (fen % 100 === 0) return `${fen / 100}`
			return (fen / 100).toFixed(2)
		}
	},
	onLoad(options : any) {
		console.log('[share-debug] aiTryOnResult onLoad options=' + JSON.stringify(options))
		this.taskId = options?.taskId ?? ''
		this.shopId = options?.shopId ?? ''
		if (this.taskId !== '') {
			this.startPolling()
		} else {
			this.status = 'failed'
		}
	},
	onReady() {
		console.log('[share-debug] aiTryOnResult onReady 页面已挂载')
	},
	onShow() {
		// 防截屏：进页开启（微信原生 API，仅小程序端生效）
		this.enableCaptureProtection()
		// 右上角菜单开放「分享到朋友圈」（单页模式卡片：标题+图，最接近网页链接卡的效果）
		// #ifdef MP-WEIXIN
		if (typeof wx !== 'undefined' && (wx as any).showShareMenu != null) {
			try {
				(wx as any).showShareMenu({ menus: ['shareAppMessage', 'shareTimeline'] })
			} catch (e) {}
		}
		// #endif
		// 查询下载次数余额（需登录；未登录时保持原按钮，避免进页即拉起登录）
		if (isLoggedIn()) {
			this.loadCreditInfo()
		}
	},
	onHide() {
		// 防截屏解限：从结果页前进到其他页面（navigateTo 等）时必须恢复，防止过分防御
		this.disableCaptureProtection()
	},
	onUnload() {
		this.stopPolling()
		// 终止可能进行中的到账轮询
		this.payPollToken = this.payPollToken + 1
		// 防截屏：离页恢复
		this.disableCaptureProtection()
	},
	onShareAppMessage() : any {
		// 点分享才准备封面：返回 Promise，微信客户端等待 resolve（官方 onShareAppMessage 支持 Promise 返回）
		return this.ensureShareCard()
	},
	onShareTimeline() : any {
		// 朋友圈单页模式卡片：标题 + 1:1 图（5:4 卡居中裁切人脸仍在中心）+ query 落地参数
		const img = this.shareCardReady && this.shareCardImage !== '' ? this.shareCardImage : cosThumb(this.resultImageUrl, 400)
		return {
			title: this.buildShareTitle(),
			query: this.buildShareQuery(),
			imageUrl: img
		}
	},
	methods: {
		// 防截屏防御：wx.setVisualEffectOnCapture(hidden)，基础库 ≥2.13.0 安卓/iOS 真机生效；条件编译仅打包微信端
		enableCaptureProtection() {
			// #ifdef MP-WEIXIN
			try {
				if (typeof wx !== 'undefined' && wx.canIUse != null && wx.canIUse('setVisualEffectOnCapture')) {
					(wx as any).setVisualEffectOnCapture({
						visualEffect: 'hidden',
						success: () => {},
						fail: () => {}
					})
				}
			} catch (e) {
				// 低版本/开发者工具不支持时静默忽略
			}
			// #endif
		},
		disableCaptureProtection() {
			// #ifdef MP-WEIXIN
			try {
				if (typeof wx !== 'undefined' && wx.canIUse != null && wx.canIUse('setVisualEffectOnCapture')) {
					(wx as any).setVisualEffectOnCapture({
						visualEffect: 'none',
						success: () => {},
						fail: () => {}
					})
				}
			} catch (e) {
				// 静默忽略
			}
			// #endif
		},
		startPolling() {
			this.status = 'processing'
			this.elapsedSeconds = 0

			// 启动计时器，每秒更新已等待时间
			this.countdownTimer = setInterval(() => {
				this.elapsedSeconds += 1
				// 超时 180 秒（3分钟），停止轮询，展示失败
				if (this.elapsedSeconds >= 180) {
					this.stopPolling()
					this.status = 'failed'
				}
			}, 1000)

			// 立即查询一次
			this.pollResult()

			// 每 20 秒轮询
			this.pollingTimer = setInterval(() => {
				this.pollResult()
			}, 20000)
		},

		async pollResult() {
			try {
				const res = await getAiTryOnResult(this.taskId)
				console.log('[share-debug] pollResult code=' + res.code + ' status=' + (res.data != null ? res.data.status : 'null'))
				// aiface 接口 code === 0 或 200 表示成功
				if ((res.code === 0 || res.code === 200) && res.data) {
					const taskStatus = res.data.status
					if (taskStatus === 'completed') {
						this.stopPolling()
						this.imageLoaded = false
						this.resultImageUrl = res.data.result_image_url || ''
						this.status = 'completed'
						// 更新导航栏标题（自定义导航栏）
						this.navTitle = 'AI试衣结果'
						this.styleName = res.data.style_name ?? ''
						this.shopName = res.data.shop_name ?? ''
						if (this.shopId === '' && res.data.shop_id > 0) {
							this.shopId = String(res.data.shop_id)
						}
						if (res.data.album_id > 0) {
							this.albumId = String(res.data.album_id)
						}
						this.templateId = res.data.template_id != null ? (res.data.template_id as number) : 0
					} else if (taskStatus === 'failed') {
						this.stopPolling()
						this.status = 'failed'
					}
					// pending / processing → 继续轮询
				}
			} catch (err) {
				console.error('轮询AI试衣结果失败:', err)
			}
		},

		stopPolling() {
			if (this.pollingTimer != null) {
				clearInterval(this.pollingTimer)
				this.pollingTimer = null
			}
			if (this.countdownTimer != null) {
				clearInterval(this.countdownTimer)
				this.countdownTimer = null
			}
		},

		// 分享标题：带店铺名称（主人 2026-09-10 指示）；无店铺名时退化为品牌+相册名
		buildShareTitle() : string {
			const style = this.styleName !== '' ? this.styleName : '新中式'
			if (this.shopName !== '') {
				return `我也在蓝梅旅拍「${this.shopName}」AI 换装，试一下你「${style}」的样子`
			}
			return `我也在蓝梅旅拍 AI 换装，试一下你「${style}」的样子`
		},

		// 朋友圈单页模式 query（onShareTimeline 用）
		buildShareQuery() : string {
			const p = this.buildSharePath()
			const i = p.indexOf('?')
			return i >= 0 ? p.substring(i + 1) : ''
		},

		// 分享落地路径：直达试衣页并预选该套系模板 + 品牌/门店完整上下文（行业方案：带参直达业务页）
		buildSharePath() : string {
			let path = '/pages/aiTryOn/index?share_from=tryon_result'
			if (this.templateId > 0) path += `&templateId=${this.templateId}`
			if (this.shopId !== '') path += `&shopId=${this.shopId}`
			if (this.albumId !== '') path += `&albumId=${this.albumId}`
			const brandId = getBrandId()
			if (brandId !== '') path += `&brandId=${brandId}`
			return path
		},

		// 分享封面生成（点击分享后才调用）：端侧人脸检测 → 人脸居中 5:4 卡片；失败回退中心裁剪，再失败回退网络图
		prepareShareCard() : Promise<void> {
			return new Promise<void>((resolve) => {
				const done = () => {
					this.sharePreparing = false
					resolve()
				}
				if (this.resultImageUrl === '' || this.shareCardReady) { done(); return }
				console.log('[share-debug] prepareShareCard 开始 urlLen=' + this.resultImageUrl.length)
				// #ifdef MP-WEIXIN
				generateFaceCenteredCard(this.resultImageUrl).then((card) => {
					if (card != null && card.imagePath !== '') {
						this.shareCardImage = card.imagePath
						console.log('[share-debug] 人脸居中卡片就绪 path=' + card.imagePath.substring(0, 40))
					} else {
						this.shareCardImage = cosThumb(this.resultImageUrl, 400)
						console.log('[share-debug] 卡片生成返回空 → 回退网络图')
					}
					this.shareCardReady = true
					done()
				}).catch(() => {
					console.log('[share-debug] 生成异常 → 回退网络图')
					this.shareCardImage = cosThumb(this.resultImageUrl, 400)
					this.shareCardReady = true
					done()
				})
				// #endif
				// #ifndef MP-WEIXIN
				this.shareCardImage = cosThumb(this.resultImageUrl, 400)
				this.shareCardReady = true
				done()
				// #endif
			})
		},

		// 点击分享才准备封面：返回 Promise，微信客户端等待 resolve 后再拉起分享（官方支持 Promise 返回）
		async ensureShareCard() : Promise<any> {
			if (!this.shareCardReady && !this.sharePreparing) {
				this.sharePreparing = true
				console.log('[share-debug] 点击分享 → 开始准备封面(生成中)')
				await this.prepareShareCard()
			}
			const img = this.shareCardImage !== '' ? this.shareCardImage : cosThumb(this.resultImageUrl, 400)
			return {
				title: this.buildShareTitle(),
				path: this.buildSharePath(),
				imageUrl: img
			}
		},

		// 分享到朋友圈：调起微信官方图片分享弹窗（发送给朋友/朋友圈/收藏/下载；本地临时卡片图）
		async shareToMoments() {
			try {
				await this.ensureShareCard()
			} catch (e) {
				console.error('[share-debug] shareToMoments ensure 异常=', e)
			}
			const path = this.shareCardImage
			if (path === '') {
				uni.showToast({ title: '分享图片准备中，请稍后再试', icon: 'none' })
				return
			}
			// #ifdef MP-WEIXIN
			if (typeof wx !== 'undefined' && (wx as any).showShareImageMenu != null) {
				try {
					(wx as any).showShareImageMenu({ path, needShowEntrance: true })
					console.log('[share-debug] showShareImageMenu 已调起 path=' + path.substring(0, 40))
				} catch (e) {
					console.error('[share-debug] showShareImageMenu 异常=', e)
					uni.showToast({ title: '请点击右上角菜单分享到朋友圈', icon: 'none' })
				}
			} else {
				uni.showToast({ title: '请点击右上角菜单分享到朋友圈', icon: 'none' })
			}
			// #endif
			// #ifndef MP-WEIXIN
			uni.showToast({ title: '请点击右上角菜单分享到朋友圈', icon: 'none' })
			// #endif
		},

		handleRetry() {
			this.failCount += 1
			if (this.failCount >= 3) {
				// 连续3次失败，不再重试
				this.status = 'failed'
				return
			}
			// 重新启动轮询
			this.imageLoaded = false
			this.startPolling()
		},

		onImageLoad() {
			this.imageLoaded = true
			console.log('[share-debug] 结果图加载完成 @load')
		},

		async saveToAlbum() {
			if (this.resultImageUrl === '') {
				uni.showToast({ title: '图片地址为空', icon: 'none' })
				return
			}
			if (this.isSaving) return

			// 付费模式且已知无剩余次数且未买断：直接拉起支付，省一次必败请求（已买断永久免费保存）
			if (this.isPaidMode && this.creditBalance <= 0 && !this.taskBought) {
				this.handleRecharge()
				return
			}

			// 先请求相册授权再扣费，避免扣费后因未授权保存失败浪费次数
			const authed = await this.ensureAlbumAuth()
			if (!authed) return

			// 授权通过后扣下载次数池 1 次并取签名下载 URL；4001 = 下载次数不足 → 拉起充值支付，到账后自动重试保存
			this.isSaving = true
			const downloadUrl = await this.chargeDownloadCredit()
			if (downloadUrl === '') {
				this.isSaving = false
				return
			}

			try {
				uni.showLoading({ title: '保存中...', mask: true })

				// 用扣费接口返回的 5 分钟签名 URL 下载（超时需重新走扣费接口获取）
				const downloadRes = await new Promise<any>((resolve, reject) => {
					uni.downloadFile({
						url: downloadUrl,
						success: (res : any) => {
							if (res.statusCode === 200) {
								resolve(res)
							} else {
								reject(new Error('下载失败'))
							}
						},
						fail: (err : any) => {
							reject(err)
						}
					})
				})

				// 保存到相册
				await new Promise<void>((resolve, reject) => {
					uni.saveImageToPhotosAlbum({
						filePath: downloadRes.tempFilePath,
						success: () => {
							resolve()
						},
						fail: (err : any) => {
							reject(err)
						}
					})
				})

				uni.hideLoading()
				this.isSaving = false
				uni.showToast({ title: '已保存到相册', icon: 'success' })
			} catch (err : any) {
				uni.hideLoading()
				this.isSaving = false
				uni.showToast({ title: '保存失败，请重试', icon: 'none' })
			}
		},

		// 保存前申请相册写入授权：已授权直接通过；拒绝过则引导去设置页开启；最终未授权返回 false（不扣费）
		async ensureAlbumAuth(): Promise<boolean> {
			const granted = await new Promise<boolean>((resolve) => {
				uni.authorize({
					scope: 'scope.writePhotosAlbum',
					success: () => resolve(true),
					fail: () => resolve(false)
				})
			})
			if (granted) return true
			return await new Promise<boolean>((resolve) => {
				uni.showModal({
					title: '提示',
					content: '需要您授权保存图片到相册',
					confirmText: '去设置',
					success: (modalRes : any) => {
						if (!modalRes.confirm) {
							resolve(false)
							return
						}
						uni.openSetting({
							success: (settingRes : any) => {
								const authSetting = settingRes?.authSetting ?? {}
								resolve(authSetting['scope.writePhotosAlbum'] === true)
							},
							fail: () => resolve(false)
						})
					}
				})
			})
		},

		// 获取店铺 ID：页面参数缺失时（历史记录入口）取首个启用店铺兜底，返回 0 表示无可用店铺
		async ensureShopId(): Promise<number> {
			let shopIdNum = parseInt(this.shopId) || 0
			if (shopIdNum <= 0) {
				try {
					const shopsRes = await getShops()
					if (shopsRes.code === 200 && shopsRes.data.length > 0) {
						shopIdNum = shopsRes.data[0].id
						this.shopId = String(shopIdNum)
					}
				} catch (err) {
					console.error('[aiTryOnResult] 获取店铺列表失败:', err)
				}
			}
			return shopIdNum
		},

		// 查询下载次数余额与单次定价（失败时静默，保持原按钮）
		async loadCreditInfo() {
			try {
				const shopIdNum = await this.ensureShopId()
				const tid = parseInt(this.taskId) || 0
				const res = await getCreditBalance(shopIdNum > 0 ? shopIdNum : undefined, 'download', tid)
				if (res.code === 200 && res.data) {
					this.creditBalance = res.data.balance
					this.priceFenPerCredit = res.data.priceFenPerCredit
					this.taskBought = res.data.taskBought === true
					this.creditLoaded = true
				}
			} catch (err) {
				console.error('[aiTryOnResult] 查询下载余额失败:', err)
			}
		},

		// 下载池扣费：成功返回 5 分钟签名下载 URL 继续保存；4001 拉起充值支付；其他错误提示后中断（返回空串）
		async chargeDownloadCredit(): Promise<string> {
			try {
				const res = await downloadAiTryOnResult(this.taskId)
				// aiface 接口 code === 0 或 200 表示成功
				if ((res.code === 0 || res.code === 200) && res.data) {
					// 扣费成功，本地余额同步 -1（角标实时刷新）
					if (this.isPaidMode && this.creditBalance > 0) {
						this.creditBalance = this.creditBalance - 1
					}
					this.taskBought = true
					return res.data.url
				}
				if (res.code === 4001) {
					// 下载次数不足：刷新本地余额为 0（按钮切换为价格态）并拉起支付
					this.creditBalance = 0
					this.handleRecharge()
					return ''
				}
				uni.showToast({ title: res.message || '扣费失败，请重试', icon: 'none' })
				return ''
			} catch (err) {
				console.error('[aiTryOnResult] 下载扣费请求失败:', err)
				uni.showToast({ title: '网络异常，请重试', icon: 'none' })
				return ''
			}
		},

		// 4001 下载次数不足：创建充值订单（feature='download'）→ 拉起微信支付 → 轮询到账 → 自动重试保存
		async handleRecharge() {
			if (this.isPaying) return
			this.isPaying = true
			uni.showToast({ title: '下载次数不足，请完成支付', icon: 'none' })
			try {
				const shopIdNum = await this.ensureShopId()
				if (shopIdNum <= 0) {
					this.isPaying = false
					uni.showToast({ title: '缺少店铺信息，请稍后重试', icon: 'none' })
					return
				}
				const res = await createCreditRecharge({ shopId: shopIdNum, credits: 1, feature: 'download', taskId: parseInt(this.taskId) || 0 })
				if (res.code !== 200 || !res.data) {
					this.isPaying = false
					uni.showToast({ title: res.message || '下单失败，请重试', icon: 'none' })
					return
				}
				const order = res.data
				const outTradeNo = order.outTradeNo
				uni.requestPayment({
					provider: 'wxpay',
					timeStamp: order.timeStamp,
					nonceStr: order.nonceStr,
					package: order.package,
					signType: order.signType,
					paySign: order.paySign,
					success: () => {
						// 支付成功：到账为微信异步回调入账，轮询订单状态确认
						this.pollRechargeStatus(outTradeNo)
					},
					fail: (payErr : any) => {
						this.isPaying = false
						const errMsg: string = payErr?.errMsg ?? ''
						if (errMsg.indexOf('cancel') !== -1) {
							uni.showToast({ title: '已取消支付', icon: 'none' })
						} else {
							uni.showToast({ title: '支付失败，请重试', icon: 'none' })
						}
					}
				})
			} catch (err) {
				this.isPaying = false
				console.error('[aiTryOnResult] 创建下载充值订单失败:', err)
				uni.showToast({ title: '下单失败，请重试', icon: 'none' })
			}
		},

		// 轮询充值订单状态：每 2.5 秒一次，最多 48 次（约 2 分钟兜底），paid = true 即到账
		pollRechargeStatus(outTradeNo : string) {
			this.payPollToken = this.payPollToken + 1
			const token = this.payPollToken
			const maxTimes = 48
			let count = 0
			uni.showLoading({ title: '确认到账中...', mask: true })
			const check = async () => {
				if (token !== this.payPollToken) {
					uni.hideLoading()
					return
				}
				count = count + 1
				try {
					const res = await getCreditRechargeStatus(outTradeNo)
					if (res.code === 200 && res.data && res.data.paid) {
						uni.hideLoading()
						this.isPaying = false
						// 同步最新余额（角标实时刷新），再自动重试保存
						this.creditBalance = res.data.balance
						this.taskBought = true
						uni.showToast({ title: '支付成功，该结果已永久解锁', icon: 'none' })
						// 到账后自动重试保存（该任务已永久买断，扣费直接放行）
						this.saveToAlbum()
						return
					}
				} catch (err) {
					console.error('[aiTryOnResult] 查询充值状态失败:', err)
				}
				if (count >= maxTimes) {
					uni.hideLoading()
					this.isPaying = false
					uni.showToast({ title: '到账确认超时，请重试', icon: 'none' })
					return
				}
				setTimeout(check, 2500)
			}
			check()
		},

		handleBack() {
			this.stopPolling()
			uni.navigateBack()
		}
	}
}
</script>

<style>
.page {
	background: var(--color-bg);
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	position: relative;
}

/* 购买照片按钮 */
.buy-photo-btn {
	margin: 24rpx auto 0;
	background: rgba(255, 255, 255, 0.15);
	border-radius: var(--radius-pill);
	padding: 16rpx 48rpx;
	align-self: center;
}
.buy-photo-text {
	font-size: var(--font-size-body-plus);
	color: #fff;
}

/* 居中内容区域（加载态/失败态） */
.center-content {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 64rpx;
}

/* 加载态 */
.loading-wrapper {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.loading-spinner {
	width: 80rpx;
	height: 80rpx;
	border: 6rpx solid rgba(255, 255, 255, 0.2);
	border-top-color: rgba(255, 255, 255, 0.8);
	border-radius: 50%;
	margin-bottom: 48rpx;
	animation: spin 1s linear infinite;
}
@keyframes spin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}
.loading-tip {
	font-size: var(--font-size-body-plus);
	color: rgba(255, 255, 255, 0.7);
	text-align: center;
	line-height: 44rpx;
}
.elapsed-text {
	font-size: var(--font-size-body);
	color: rgba(255, 255, 255, 0.4);
	margin-top: 24rpx;
}

/* 成功态 */
.result-content {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 8rpx;
}
.result-image-wrapper {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
}
.result-image {
	width: 100%;
	border-radius: var(--radius-sm);
}
.image-fade {
	opacity: 0;
	transition: opacity 0.8s ease-in-out;
}
.image-visible {
	opacity: 1;
}
.action-bar {
	width: 100%;
	padding: 24rpx 0;
	display: flex;
	flex-direction: row;
	justify-content: center;
}
.save-btn-wrap {
	position: relative;
	padding-top: var(--spacing-sm);
}
/* 限免角标（整体落在容器 padding 预留空间内，不用负偏移，避免被裁剪） */
.save-btn-badge {
	position: absolute;
	top: 0rpx;
	right: 0rpx;
	z-index: 1;
	background: #ff3b30;
	border-radius: var(--radius-sm);
	padding: 4rpx 12rpx;
}
.save-btn-badge-text {
	font-size: var(--font-size-body-xs);
	color: #fff;
}
/* 操作栏按钮：view 与 button 原生差异抹平——统一高度 92rpx（button 原生表单组件自带默认样式，不能只靠类名对齐） */
.action-bar .btn-primary {
	height: 92rpx;
	box-sizing: border-box;
}
.action-bar .btn-primary text {
	color: var(--color-bg);
	font-size: 32rpx;
	line-height: 1.2;
}
.share-btn {
	margin: var(--spacing-sm) 0 0 var(--spacing-lg);
	min-width: 160rpx;
	height: 92rpx;
	line-height: 1;
	box-sizing: border-box;
}
.share-btn::after {
	border: none;
}

/* 失败态 */
.fail-wrapper {
	display: flex;
	flex-direction: column;
	align-items: center;
}
.fail-text {
	font-size: 30rpx;
	color: rgba(255, 255, 255, 0.7);
	margin-bottom: 48rpx;
	text-align: center;
}
.retry-btn {
	background: #fff;
	border-radius: var(--radius-2xl);
	padding: 24rpx 80rpx;
	margin-bottom: 24rpx;
}
.retry-btn-text {
	font-size: 32rpx;
	color: #000;
	font-weight: 400;
}
.back-btn-wrapper {
	padding: 24rpx 80rpx;
}
.back-btn-text {
	font-size: var(--font-size-body-plus);
	color: rgba(241, 205, 145, 0.9);
}

/* 底部 */
.page-footer {
	margin-top: auto;
}
.divide {
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}
.bottomdesc {
	margin: var(--spacing-lg) auto;
	font-size: var(--font-size-caption-md);
	color: var(--color-primary-50);
	font-weight: 400;
}

/* 分享准备中 loading 遮罩 */
.share-preparing-mask {
	position: fixed;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background: rgba(0, 0, 0, 0.55);
	z-index: 999;
	display: flex;
	align-items: center;
	justify-content: center;
}
.share-preparing-card {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 48rpx 64rpx;
	background: rgba(22, 15, 4, 0.92);
	border-radius: var(--radius-card);
}
.share-preparing-text {
	margin-top: 32rpx;
	font-size: var(--font-size-body);
	color: #fff;
	font-weight: 400;
}
</style>
