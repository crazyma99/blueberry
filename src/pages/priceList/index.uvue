<template>
	<view class="page">
		<CustomNavBar :title="navTitle" />
		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-banner sk-animate"></view>
			<view class="sk-block sk-animate" style="width: 100%; height: 600rpx;"></view>
		</view>

		<!-- 主内容（店铺级 banner 已废弃 2026-09-11 主人指示） -->
		<view v-else>
			<image class="price" :src="priceImage" mode="widthFix"></image>

			<!-- 套餐条目（仅展示：1:1 头图 / 名称 / 内容 / 售价） -->
			<view v-if="packages.length > 0" class="pkg-section">
				<view class="pkg-title-wrap">
					<text class="pkg-title font-noto-serif">套餐</text>
					<text class="pkg-sub">PACKAGE</text>
				</view>
				<view class="pkg-list">
					<view v-for="(pkg, i) in packages" :key="i" class="pkg-card">
						<view class="pkg-img-wrap">
							<image v-if="pkg.imageUrl" class="pkg-img" :src="pkg.imageUrl" mode="aspectFill"></image>
							<view v-else class="pkg-img pkg-img-empty">
								<text class="pkg-img-empty-text">套餐</text>
							</view>
						</view>
						<view class="pkg-info">
							<text class="pkg-name font-noto-serif">{{ pkg.name }}</text>
							<text v-if="pkg.detail" class="pkg-detail">{{ pkg.detail }}</text>
							<view class="pkg-price-row">
								<text class="pkg-price-symbol">¥</text>
								<text class="pkg-price">{{ pkg.price }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>

			<view class="divide"></view>
			<view class="bottomdesc"><AppFooter /></view>
		</view>
	</view>
</template>

<script>
	import { getPackages as fetchPackages } from '../../utils/api.uts'
	export default {
		data() {
			return {
				id: '',
				loading: true,
				// 自定义导航栏标题（onLoad 中按店铺名动态设置）
				navTitle: '',
				priceImage: '',
				// 套餐条目（仅展示）
				packages: []
			}
		},
		onLoad(query) {
			const id = query.idx ?? ''
			const priceImage = this.decodeRouteValue(query.priceImage ?? '')
			const shopName = this.decodeRouteValue(query.shopName ?? '')
			this.id = id
			this.navTitle = shopName ? `${shopName}价目表` : '蓝梅价目表'
			this.getPackages(id)
			this.priceImage = priceImage || this.getFallbackPriceImage(id)
		},
		methods: {
			decodeRouteValue(value) {
				if (!value) return ''
				try {
					return decodeURIComponent(value)
				} catch (_err) {
					return value
				}
			},
			getFallbackPriceImage(id) {
				return id === '1' ? '/static/honghe-price.png' : '/static/price.png'
			},
			// 套餐条目：仅展示（2026-09-11 主人指示：价目表二级页渲染；店铺级 banner 同批废弃）
			async getPackages(id: string) {
				try {
					const res = await fetchPackages(id)
					if (res.code === 200 && res.data?.length) {
						this.packages = res.data
					}
				} catch (err) {
					console.error('[priceList] 获取套餐列表失败', err)
				} finally {
					this.loading = false
				}
			}
		}
	}
</script>

<style>
.page{
	width: 100%;
	height: 100%;
	background: var(--color-bg);
	overflow-y: scroll;
}
.price{
	width: 734rpx;
	margin: 8rpx;
}
/* 套餐条目区：仅展示（1:1 头图 / 名称 / 内容 / 售价） */
.pkg-section{
	margin: 16rpx var(--spacing-md) 8rpx;
}
.pkg-title-wrap{
	display: flex;
	flex-direction: row;
	align-items: baseline;
	gap: 16rpx;
	margin-bottom: 16rpx;
}
.pkg-title{
	font-size: 36rpx;
	font-weight: 400;
	color: var(--color-primary);
	letter-spacing: 2rpx;
}
.pkg-sub{
	font-size: var(--font-size-body-xs);
	color: var(--color-primary-30);
	letter-spacing: 2rpx;
}
.pkg-list{
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}
.pkg-card{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 20rpx;
	border-radius: var(--radius-container);
	background: rgba(255, 255, 255, 0.06);
	border: 1rpx solid rgba(255, 255, 255, 0.12);
}
.pkg-img-wrap{
	width: 160rpx;
	height: 160rpx;
	flex-shrink: 0;
	border-radius: var(--radius-sm);
	overflow: hidden;
}
.pkg-img{
	width: 100%;
	height: 100%;
	display: block;
}
.pkg-img-empty{
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(241, 205, 145, 0.1);
}
.pkg-img-empty-text{
	font-size: var(--font-size-body-sm);
	color: var(--color-primary-50);
	letter-spacing: 4rpx;
}
.pkg-info{
	flex: 1;
	min-width: 0;
	margin-left: 24rpx;
	display: flex;
	flex-direction: column;
}
.pkg-name{
	font-size: var(--font-size-body-plus);
	color: var(--color-primary);
	letter-spacing: 1rpx;
}
.pkg-detail{
	margin-top: 8rpx;
	font-size: var(--font-size-body-sm);
	color: rgba(241, 205, 145, 0.7);
	line-height: 1.5;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
}
.pkg-price-row{
	margin-top: 12rpx;
	display: flex;
	flex-direction: row;
	align-items: baseline;
}
.pkg-price-symbol{
	font-size: var(--font-size-body-sm);
	color: var(--color-primary);
}
.pkg-price{
	font-size: 32rpx;
	font-weight: 400;
	color: var(--color-primary);
	margin-left: 2rpx;
}
.divide{
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}
.bottomdesc{
	margin: var(--spacing-lg) auto;
	font-size: var(--font-size-caption-md);
	color: var(--color-primary-50);
	font-weight: 400;
}
</style>
