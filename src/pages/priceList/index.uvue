<template>
	<view class="page">
		<CustomNavBar :title="navTitle" />
		<!-- 骨架屏 -->
		<view v-if="loading" class="sk-container">
			<view class="sk-banner sk-animate"></view>
			<view class="sk-block sk-animate" style="width: 100%; height: 600rpx;"></view>
		</view>

		<!-- 主内容 -->
		<view v-else>
			<!-- 顶部轮播图 -->
			<view v-if="banners.length">
				<swiper class="banner" autoplay circular :interval="3000" :duration="500">
					<swiper-item v-for="(item, idx) in banners" :key="idx">
						<image class="banner-image fade-in" :src="item.imageUrl" mode="aspectFill"></image>
					</swiper-item>
				</swiper>
			</view>
			<image class="price" :src="priceImage" mode="widthFix"></image>
			<view class="divide"></view>
			<view class="bottomdesc"><AppFooter /></view>
		</view>
	</view>
</template>

<script>
	import { getImage } from '../../utils/api.uts'
	export default {
		data() {
			return {
				id: '',
				loading: true,
				// 自定义导航栏标题（onLoad 中按店铺名动态设置）
				navTitle: '',
				// 轮播图图片列表
				banners: [],
				priceImage: ''
			}
		},
		onLoad(query) {
			const id = query.idx ?? ''
			const priceImage = this.decodeRouteValue(query.priceImage ?? '')
			const shopName = this.decodeRouteValue(query.shopName ?? '')
			this.id = id
			this.navTitle = shopName ? `${shopName}价目表` : '蓝梅价目表'
			this.getBanner(id)
			this.priceImage = priceImage || this.getFallbackPriceImage(id)
		},
		methods: {
			decodeRouteValue(value) {
				if (!value) return ''
				try {
					return decodeURIComponent(value)
				} catch (_err) {
					return value
				}
			},
			getFallbackPriceImage(id) {
				return id === '1' ? '/static/honghe-price.png' : '/static/price.png'
			},
			async getBanner (id: string) {
				try {
					this.loading = true
					const res = await getImage('get', {
						type: id,
					})
					console.log('carousel api result:', res)
					const { code, data } = res
					if (code !== 200) return
					if (data?.length) this.banners = data
				} catch (err) {
					console.warn('获取轮播图失败', err)
				} finally {
					this.loading = false
				}
			}
		}
	}
</script>

<style>
.page{
	width: 100%;
	height: 100%;
	background: var(--color-bg);
	overflow-y: scroll;
}
.banner{
	margin: 24rpx 0 8rpx;
	width: 100%;
	height: 384rpx;
	overflow: hidden;
}
.banner-image{
	width: 100%;
	height: 100%;
	display: block;
}
.price{
	width: 734rpx;
	margin: 8rpx;
}
.divide{
	height: 2rpx;
	width: 100%;
	background: rgba(255, 255, 255, 0.15);
}
.bottomdesc{
	margin: var(--spacing-lg) auto;
	font-size: var(--font-size-caption-md);
	color: var(--color-primary-50);
	font-weight: 400;
}
</style>
